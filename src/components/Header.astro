                <span class="text-lg w-6 text-center">💳</span>{isEl ? "Η κάρτα πιστότητας" : "My loyalty card"}
              </a>
              {cardSlug && (
                <a href={`/u/${cardSlug}`} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-white/85 hover:bg-white/5 transition">
                  <span class="text-lg w-6 text-center">🪪</span>{isEl ? "Η κάρτα social μου" : "My social card"}
                </a>
              )}
              {role === "customer" && (
                <>
                  <a href={withLangPrefix(lang, "/loyalty")} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-white/85 hover:bg-white/5 transition">
                    <span class="text-lg w-6 text-center">👑</span>{isEl ? "Ανταμοιβές" : "Rewards & Tiers"}
                  </a>
                  <a href={withLangPrefix(lang, "/play")} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-white/85 hover:bg-white/5 transition">
                    <span class="text-lg w-6 text-center">🎁</span>{isEl ? "Παιχνίδι" : "Play & quests"}
                  </a>
                  <a href={withLangPrefix(lang, "/book")} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-white/85 hover:bg-white/5 transition">
                    <span class="text-lg w-6 text-center">📅</span>{t.user.myReservations}
                  </a>
                </>
              )}
              <a href={withLangPrefix(lang, "/settings")} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-white/85 hover:bg-white/5 transition">
                <span class="text-lg w-6 text-center">⚙️</span>{isEl ? "Ρυθμίσεις & Προφίλ" : "Settings & Profile"}
              </a>
            </nav>

            {(role === "employee" || role === "admin" || role === "super_admin") && (
              <nav class="space-y-1 pt-2 border-t border-white/10">
