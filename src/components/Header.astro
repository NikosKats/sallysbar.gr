---
import { getLangFromPath, withLangPrefix, dict } from "../i18n";

const url = new URL(Astro.request.url);
const lang = getLangFromPath(url.pathname);
const t = dict[lang];

// strip /el for switching
const pathNoLang = url.pathname.startsWith("/el")
  ? url.pathname.replace(/^\/el/, "") || "/"
  : url.pathname;

const otherLang = lang === "en" ? "el" : "en";
const switchHref = withLangPrefix(otherLang, pathNoLang);

// Auth state from middleware
const user = Astro.locals.user;
const role = Astro.locals.role;

const isEl = lang === "el";
const loginLabel = isEl ? "Σύνδεση" : "Sign In";
const logoutLabel = isEl ? "Αποσύνδεση" : "Sign Out";
const bookLabel = isEl ? "Κράτηση" : "Book";
const eventsLabel = isEl ? "Events" : "Events";
const adminLabel = "Admin";
const staffLabel = isEl ? "Παραγγελίες" : "Orders";

// IMPORTANT: build links WITH language prefix
const nav = [
  { label: t.nav.home, href: withLangPrefix(lang, "/") },
  { label: t.nav.menu, href: withLangPrefix(lang, "/menu") },
  { label: bookLabel, href: withLangPrefix(lang, "/book") },
  { label: eventsLabel, href: withLangPrefix(lang, "/events") },
  { label: t.nav.careers, href: withLangPrefix(lang, "/careers") },
];

const ctaHref = withLangPrefix(lang, "/menu");
const brandHref = withLangPrefix(lang, "/");
const loginHref = withLangPrefix(lang, "/login");
const logoutHref = "/logout";

// language button label
const switchLabel = t.switchTo;

// aria labels
const ariaSwitch = lang === "en" ? "Switch to Greek" : "Switch to English";
const ariaOpenMenu = lang === "en" ? "Open menu" : "Άνοιγμα μενού";

// User display name (first name only)
const displayName = user?.user_metadata?.full_name?.split(" ")[0]
  ?? user?.email?.split("@")[0]
  ?? "";
---

<header class="fixed top-0 inset-x-0 z-50">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mt-4 rounded-2xl border border-white/10 bg-black/40 backdrop-blur supports-[backdrop-filter]:bg-black/30">
      <div class="flex items-center justify-between gap-3 px-4 py-3">
        <!-- Brand -->
        <a href={brandHref} class="flex items-center gap-3">
          <img
            src="/logo/1-logo.png"
            alt="Sally's Bar logo"
            class="h-8 w-8 rounded-md object-contain"
            loading="eager"
          />
          <span class="text-sm font-semibold tracking-wide text-white/90">
            Sally's Bar
          </span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-6 text-sm text-white/75">
          {nav.map((i) => (
            <a href={i.href} class="hover:text-white transition">
              {i.label}
            </a>
          ))}
        </nav>

        <!-- Desktop right actions -->
        <div class="hidden md:flex items-center gap-2">
          <a
            href={switchHref}
            class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/90 hover:bg-white/10 transition"
            aria-label={ariaSwitch}
          >
            {switchLabel}
          </a>

          {user ? (
            <div class="relative" id="userMenuWrapper">
              <button
                id="userMenuBtn"
                type="button"
                class="flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/90 hover:bg-white/10 transition"
              >
                {displayName}
                {role === "admin" && (
                  <span class="rounded-full bg-amber-400/15 px-2 py-0.5 text-xs font-semibold text-amber-400">Admin</span>
                )}
                {role === "employee" && (
                  <span class="rounded-full bg-sky-400/15 px-2 py-0.5 text-xs font-semibold text-sky-400">Staff</span>
                )}
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="opacity-50 ml-0.5">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div id="userMenuDropdown" class="hidden absolute right-0 top-full mt-2 w-52 rounded-2xl border border-white/10 bg-[#0b0b10] shadow-xl overflow-hidden z-50">
                <div class="py-1.5">
                  <a href="/account" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-white hover:bg-white/5 transition">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-60"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    My Account
                  </a>

                  {role === "admin" && (
                    <>
                      <div class="mx-3 my-1.5 border-t border-white/10"></div>
                      <p class="px-4 py-1 text-xs font-semibold uppercase tracking-widest text-amber-400/50">Admin</p>
                      <a href="/admin" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/></svg>
                        Dashboard
                      </a>
                      <a href="/admin/users" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M19 8v6M16 11h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        Users
                      </a>
                      <a href="/admin/menu" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M4 6h16M4 10h16M4 14h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        Edit Menu
                      </a>
                    </>
                  )}

                  {(role === "employee" || role === "admin") && (
                    <>
                      <div class="mx-3 my-1.5 border-t border-white/10"></div>
                      <p class="px-4 py-1 text-xs font-semibold uppercase tracking-widest text-sky-400/50">Staff</p>
                      <a href="/staff" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-sky-400/80 hover:text-sky-400 hover:bg-sky-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>
                        Active Orders
                      </a>
                      <a href="/staff/order" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-sky-400/80 hover:text-sky-400 hover:bg-sky-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        New Order
                      </a>
                    </>
                  )}

                  <div class="mx-3 my-1.5 border-t border-white/10"></div>
                  <a href={logoutHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/50 hover:text-white hover:bg-white/5 transition">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-60"><path d="M16 17l5-5-5-5M21 12H9M13 7V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h6a2 2 0 002-2v-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {logoutLabel}
                  </a>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={loginHref}
              class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/90 hover:bg-white/10 transition"
            >
              {loginLabel}
            </a>
          )}

        </div>

        <!-- Mobile hamburger -->
        <button
          id="mobileMenuBtn"
          class="md:hidden inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-sm text-white/90 hover:bg-white/10"
          aria-label={ariaOpenMenu}
          aria-expanded="false"
          aria-controls="mobileMenu"
          type="button"
        >
          <span class="mr-2">{t.nav.menu}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="opacity-90">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <!-- Mobile drawer -->
      <div id="mobileMenu" class="md:hidden hidden border-t border-white/10 px-4 py-4">
        <div class="flex flex-col gap-3 text-sm">
          <!-- Language switcher in mobile -->
          <a
            href={switchHref}
            class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white/90 hover:bg-white/10"
          >
            {switchLabel}
          </a>

          {nav.map((i) => (
            <a
              href={i.href}
              class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white/90 hover:bg-white/10"
            >
              {i.label}
            </a>
          ))}

          {user ? (
            <>
              <div class="rounded-2xl border border-white/10 bg-white/5 overflow-hidden">
                <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10">
                  <span class="text-sm text-white/70 font-medium">{displayName}</span>
                  {role === "admin" && <span class="rounded-full bg-amber-400/15 px-2 py-0.5 text-xs font-semibold text-amber-400">Admin</span>}
                  {role === "employee" && <span class="rounded-full bg-sky-400/15 px-2 py-0.5 text-xs font-semibold text-sky-400">Staff</span>}
                </div>
                <a href="/account" class="flex items-center px-4 py-3 text-sm text-white/60 hover:text-white hover:bg-white/5 transition">
                  My Account
                </a>
                {role === "admin" && (
                  <>
                    <div class="border-t border-white/10"></div>
                    <p class="px-4 pt-2.5 pb-1 text-xs font-semibold uppercase tracking-widest text-amber-400/50">Admin</p>
                    <a href="/admin" class="flex items-center px-4 py-2.5 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">Dashboard</a>
                    <a href="/admin/users" class="flex items-center px-4 py-2.5 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">Users</a>
                    <a href="/admin/menu" class="flex items-center px-4 py-2.5 pb-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">Edit Menu</a>
                  </>
                )}
                {(role === "employee" || role === "admin") && (
                  <>
                    <div class="border-t border-white/10"></div>
                    <p class="px-4 pt-2.5 pb-1 text-xs font-semibold uppercase tracking-widest text-sky-400/50">Staff</p>
                    <a href="/staff" class="flex items-center px-4 py-2.5 text-sm text-sky-400/80 hover:text-sky-400 hover:bg-sky-400/5 transition">Active Orders</a>
                    <a href="/staff/order" class="flex items-center px-4 py-2.5 pb-2 text-sm text-sky-400/80 hover:text-sky-400 hover:bg-sky-400/5 transition">New Order</a>
                  </>
                )}
                <div class="border-t border-white/10"></div>
                <a href={logoutHref} class="flex items-center px-4 py-3 text-sm text-white/50 hover:text-white hover:bg-white/5 transition">
                  {logoutLabel}
                </a>
              </div>
            </>
          ) : (
            <a
              href={loginHref}
              class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white/90 hover:bg-white/10"
            >
              {loginLabel}
            </a>
          )}

        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    // Mobile menu toggle
    const btn = document.getElementById("mobileMenuBtn");
    const menu = document.getElementById("mobileMenu");

    function closeMenu() {
      if (!menu || !btn) return;
      menu.classList.add("hidden");
      btn.setAttribute("aria-expanded", "false");
    }

    btn?.addEventListener("click", () => {
      const isHidden = menu?.classList.contains("hidden");
      if (!menu) return;
      if (isHidden) {
        menu.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "true");
      } else {
        closeMenu();
      }
    });

    menu?.addEventListener("click", (e) => {
      const a = e.target.closest("a");
      if (a) closeMenu();
    });

    // User dropdown toggle
    const userBtn = document.getElementById("userMenuBtn");
    const userDropdown = document.getElementById("userMenuDropdown");

    userBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      userDropdown?.classList.toggle("hidden");
    });

    document.addEventListener("click", (e) => {
      if (!document.getElementById("userMenuWrapper")?.contains(e.target)) {
        userDropdown?.classList.add("hidden");
      }
    });

    userDropdown?.addEventListener("click", (e) => {
      const a = e.target.closest("a");
      if (a) userDropdown.classList.add("hidden");
    });
  </script>
</header>
