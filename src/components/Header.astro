        {!user ? (
          <a href={loginHref} class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black px-3 py-3 text-sm font-bold shadow-lg shadow-amber-500/20 transition">
            🔑 {loginLabel}
          </a>
        ) : (
          <a href={logoutHref} class="flex items-center justify-center gap-2 rounded-xl bg-white/5 hover:bg-white/10 px-3 py-2.5 text-sm text-white/55 transition">
            ↩ {logoutLabel}
