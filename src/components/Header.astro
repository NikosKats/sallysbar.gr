                  <span class="text-lg w-6 text-center">📅</span>{t.user.adminReservations}
                </a>
                <a href={adminOrdersHref} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-amber-100/85 hover:bg-amber-400/10 transition">
                  <span class="text-lg w-6 text-center">🧾</span>{t.user.orders}
                </a>
                <a href={adminMenuHref} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-amber-100/85 hover:bg-amber-400/10 transition">
