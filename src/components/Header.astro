                <a href={adminHelpHref} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-amber-100/85 hover:bg-amber-400/10 transition">
                  <span class="text-lg w-6 text-center">📖</span>{isEl ? "Οδηγός" : "Help & Guide"}
