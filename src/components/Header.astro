---
import { withLangPrefix, dict } from "../i18n";

// Use locals.lang set by middleware (survives Astro.rewrite — URL-based detection breaks after rewrite)
const lang = Astro.locals.lang ?? "en";
const t = dict[lang];

// strip /el for switching (use original request URL for the switcher path)
const origPath = new URL(Astro.request.url).pathname;
const pathNoLang = origPath.startsWith("/el")
  ? origPath.replace(/^\/el/, "") || "/"
  : origPath;

const otherLang = lang === "en" ? "el" : "en";
// When switching to English, add ?lang=en so middleware clears the Greek cookie
const switchHref = otherLang === "en"
  ? `${withLangPrefix("en", pathNoLang)}?lang=en`
  : withLangPrefix("el", pathNoLang);

// Auth state from middleware
const user = Astro.locals.user;
const role = Astro.locals.role;

const isEl = lang === "el";
const loginLabel = isEl ? "Σύνδεση" : "Sign In";
const logoutLabel = isEl ? "Αποσύνδεση" : "Sign Out";
const bookLabel = isEl ? "Κράτηση" : "Book";
const eventsLabel = isEl ? "Events" : "Events";
const adminLabel = "Admin";
const staffLabel = isEl ? "Παραγγελίες" : "Orders";

// IMPORTANT: build links WITH language prefix
const loyaltyLabel = isEl ? "Πόντοι" : "Rewards";
const playLabel = lang === "el" ? "Παίξε" : "Play";

const nav = [
  { label: t.nav.home,    icon: "🏠",  href: withLangPrefix(lang, "/") },
  { label: t.nav.menu,    icon: "📜",  href: withLangPrefix(lang, "/menu") },
  { label: bookLabel,     icon: "📅",  href: withLangPrefix(lang, "/book") },
  { label: eventsLabel,   icon: "🎵",  href: withLangPrefix(lang, "/events") },
  { label: playLabel,     icon: "🎁",  href: withLangPrefix(lang, "/play") },
  { label: loyaltyLabel,  icon: "👑",  href: withLangPrefix(lang, "/loyalty") },
  { label: t.nav.careers, icon: "💼",  href: withLangPrefix(lang, "/careers") },
];

function isActive(href: string) {
  // Strip lang prefix for comparison
  const cleanHref = href.replace(/^\/el/, "") || "/";
  const cleanPath = pathNoLang || "/";
  if (cleanHref === "/") return cleanPath === "/";
  return cleanPath.startsWith(cleanHref);
}

const ctaHref    = withLangPrefix(lang, "/menu");
const brandHref  = withLangPrefix(lang, "/");
const loginHref  = withLangPrefix(lang, "/login");
const logoutHref = withLangPrefix(lang, "/logout");
const accountHref   = withLangPrefix(lang, "/account");
const adminHref          = withLangPrefix(lang, "/admin");
const adminUsersHref     = withLangPrefix(lang, "/admin/users");
const adminMenuHref      = withLangPrefix(lang, "/admin/menu");
const adminQrHref        = withLangPrefix(lang, "/admin/qrcodes");
const adminHelpHref      = withLangPrefix(lang, "/admin/help");
const adminAnalyticsHref = withLangPrefix(lang, "/admin/analytics");
const adminOrdersHref    = withLangPrefix(lang, "/admin/orders");
const adminCalendarHref  = withLangPrefix(lang, "/admin/calendar");
const adminTipsHref          = withLangPrefix(lang, "/admin/tips");
const adminReservationsHref  = withLangPrefix(lang, "/admin/reservations");
const adminLoyaltyHref       = withLangPrefix(lang, "/admin/loyalty");
const adminEventsHref        = withLangPrefix(lang, "/admin/events");
const staffHref              = withLangPrefix(lang, "/staff");
const staffOrderHref     = withLangPrefix(lang, "/staff/order");

// language button label
const switchLabel = t.switchTo;

// aria labels
const ariaSwitch = lang === "en" ? "Switch to Greek" : "Switch to English";
const ariaOpenMenu = lang === "en" ? "Open menu" : "Άνοιγμα μενού";

// User display name (first name only)
const displayName = user?.user_metadata?.full_name?.split(" ")[0]
  ?? user?.email?.split("@")[0]
  ?? "";

import CustomerPwa from "./CustomerPwa.astro";
---

<CustomerPwa />

<header class="fixed top-0 inset-x-0 z-50">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mt-4 rounded-2xl border border-white/10 bg-black/40 backdrop-blur supports-[backdrop-filter]:bg-black/30">
      <div class="flex items-center justify-between gap-3 px-4 py-3">
        <!-- Brand -->
        <a href={brandHref} class="flex items-center gap-3">
          <img
            src="/logo/logo-64.webp"
            srcset="/logo/logo-64.webp 1x, /logo/logo-128.webp 2x"
            alt="Sally's Bar logo"
            width="32"
            height="32"
            class="h-8 w-8 rounded-md object-contain"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <span class="text-sm font-semibold tracking-wide text-white/90">
            Sally's Bar
          </span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-6 text-sm">
          {nav.map((i) => (
            <a
              href={i.href}
              class={isActive(i.href)
                ? "text-white font-medium relative after:absolute after:bottom-[-2px] after:left-0 after:right-0 after:h-[2px] after:rounded-full after:bg-amber-400 flex items-center gap-1.5"
                : "text-white/55 hover:text-white transition flex items-center gap-1.5"}
            >
              <span>{i.icon}</span><span>{i.label}</span>
            </a>
          ))}
        </nav>

        <!-- Desktop right actions -->
        <div class="hidden md:flex items-center gap-2">
          <a
            href={switchHref}
            class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/90 hover:bg-white/10 transition"
            aria-label={ariaSwitch}
          >
            {switchLabel}
          </a>

          {user ? (
            <div class="relative" id="userMenuWrapper">
              <button
                id="userMenuBtn"
                type="button"
                class="flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/90 hover:bg-white/10 transition"
              >
                {displayName}
                {role === "admin" && (
                  <span class="rounded-full bg-amber-400/15 px-2 py-0.5 text-xs font-semibold text-amber-400">Admin</span>
                )}
                {role === "employee" && (
                  <span class="rounded-full bg-sky-400/15 px-2 py-0.5 text-xs font-semibold text-sky-400">Staff</span>
                )}
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="opacity-50 ml-0.5">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div id="userMenuDropdown" class="hidden absolute right-0 top-full mt-2 w-60 rounded-2xl border border-white/10 bg-[#0b0b10] shadow-xl z-50 max-h-[min(80vh,600px)] overflow-y-auto overscroll-contain">
                <div class="py-1.5">
                  <a href={accountHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-white hover:bg-white/5 transition">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-60"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {t.user.myAccount}
                  </a>
                  {role === "customer" && (
                    <a href={accountHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-white hover:bg-white/5 transition">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-60"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      {t.user.myReservations}
                    </a>
                  )}

                  {role === "admin" && (
                    <>
                      <div class="mx-3 my-1.5 border-t border-white/10"></div>
                      <p class="px-4 py-1 text-xs font-semibold uppercase tracking-widest text-amber-400/50">{t.user.adminSection}</p>

                      <!-- Business -->
                      <p class="px-4 pt-1.5 pb-0.5 text-[10px] font-semibold uppercase tracking-widest text-white/20">{isEl ? "Επιχείρηση" : "Business"}</p>
                      <a href={adminHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/></svg>
                        {t.user.dashboard}
                      </a>
                      <a href={adminAnalyticsHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M3 17l4-8 4 4 4-6 4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {t.user.analytics}
                      </a>
                      <a href={adminCalendarHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        {t.user.calendar}
                      </a>

                      <!-- Customers -->
                      <div class="mx-3 my-1 border-t border-white/8"></div>
                      <p class="px-4 pt-0.5 pb-0.5 text-[10px] font-semibold uppercase tracking-widest text-white/20">{isEl ? "Πελάτες" : "Customers"}</p>
                      <a href={adminReservationsHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        {t.user.adminReservations}
                      </a>
                      <a href={adminEventsHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 9h18M8 2v4M16 2v4M8 14h4M8 17h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        {t.admin.nav.events}
                      </a>
                      <a href={adminLoyaltyHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {t.admin.nav.loyalty}
                      </a>
                      <a href={adminUsersHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M19 8v6M16 11h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        {t.user.users}
                      </a>

                      <!-- Operations -->
                      <div class="mx-3 my-1 border-t border-white/8"></div>
                      <p class="px-4 pt-0.5 pb-0.5 text-[10px] font-semibold uppercase tracking-widest text-white/20">{isEl ? "Λειτουργία" : "Operations"}</p>
                      <a href={adminOrdersHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M9 12h6M9 16h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        {t.user.orders}
                      </a>
                      <a href={adminTipsHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M12 2v2M12 20v2M6.22 6.22l-1.42-1.42M19.2 19.2l-1.42-1.42M2 12h2M20 12h2M6.22 17.78l-1.42 1.42M19.2 4.8l-1.42 1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/></svg>
                        {t.user.tips}
                      </a>
                      <a href={adminMenuHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M4 6h16M4 10h16M4 14h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        {t.user.editMenu}
                      </a>
                      <a href={adminQrHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M14 14h3v3M20 14v7M14 20h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        QR Codes
                      </a>
                      <a href={adminHelpHref} class="flex items-center gap-2.5 px-4 py-2 text-sm text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M9.5 9a2.5 2.5 0 115 0c0 1.5-2.5 2-2.5 3.5M12 17h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        {isEl ? "Οδηγός" : "Help & Guide"}
                      </a>
                    </>
                  )}

                  {(role === "employee" || role === "admin") && (
                    <>
                      <div class="mx-3 my-1.5 border-t border-white/10"></div>
                      <p class="px-4 py-1 text-xs font-semibold uppercase tracking-widest text-sky-400/50">{t.user.staffSection}</p>
                      <a href={staffHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-sky-400/80 hover:text-sky-400 hover:bg-sky-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>
                        {t.user.activeOrders}
                      </a>
                      <a href={staffOrderHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-sky-400/80 hover:text-sky-400 hover:bg-sky-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        {t.user.newOrder}
                      </a>
                    </>
                  )}

                  <div class="mx-3 my-1.5 border-t border-white/10"></div>
                  <a href={logoutHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/50 hover:text-white hover:bg-white/5 transition">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-60"><path d="M16 17l5-5-5-5M21 12H9M13 7V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h6a2 2 0 002-2v-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {logoutLabel}
                  </a>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={loginHref}
              class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/90 hover:bg-white/10 transition"
            >
              {loginLabel}
            </a>
          )}

        </div>

        <!-- Mobile hamburger -->
        <button
          id="mobileMenuBtn"
          class="md:hidden inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-sm text-white/90 hover:bg-white/10"
          style="touch-action: manipulation;"
          aria-label={ariaOpenMenu}
          aria-expanded="false"
          aria-controls="mobileMenu"
          type="button"
        >
          <span class="mr-2">{t.nav.menu}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="opacity-90">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile drawer — rendered OUTSIDE backdrop-blur container to avoid iOS repaint cost -->
  <div
    id="mobileMenu"
    class="md:hidden fixed inset-0 top-0 z-40 hidden"
    aria-hidden="true"
  >
    <div id="mobileMenuScrim" class="absolute inset-0 bg-black/60"></div>
    <div
      id="mobileMenuPanel"
      class="absolute inset-x-0 top-0 bg-[#0b0b10] border-b border-white/10 max-h-[100svh] overflow-y-auto overscroll-contain will-change-transform"
      style="padding-top: calc(env(safe-area-inset-top, 0px) + 84px);"
    >
      <div class="px-3 pb-6 pt-2 flex flex-col gap-1">

          <!-- Main nav -->
          <div class="grid grid-cols-3 gap-1 mb-1">
            {nav.map((i) => (
              <a
                href={i.href}
                class={isActive(i.href)
                  ? "flex flex-col items-center justify-center gap-1 rounded-xl border border-amber-400/30 bg-amber-400/10 px-2 py-3 text-xs text-amber-400 font-medium transition text-center leading-tight"
                  : "flex flex-col items-center justify-center gap-1 rounded-xl border border-white/10 bg-white/5 px-2 py-3 text-xs text-white/70 hover:bg-white/10 hover:text-white transition text-center leading-tight"}
              >
                <span class="text-lg leading-none">{i.icon}</span>
                <span>{i.label}</span>
              </a>
            ))}
          </div>

          <!-- Language + login row -->
          <div class="grid grid-cols-2 gap-1 mb-1">
            <a href={switchHref} class="flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-3 py-2.5 text-xs text-white/70 hover:bg-white/10 transition">
              {switchLabel}
            </a>
            {!user ? (
              <a href={loginHref} class="flex items-center justify-center rounded-xl border border-amber-400/20 bg-amber-400/5 px-3 py-2.5 text-xs text-amber-400 hover:bg-amber-400/10 transition">
                {loginLabel}
              </a>
            ) : (
              <a href={logoutHref} class="flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-3 py-2.5 text-xs text-white/50 hover:text-white hover:bg-white/10 transition">
                {logoutLabel}
              </a>
            )}
          </div>

          {user && (
            <>
              <!-- User header -->
              <div class="flex items-center gap-2 px-3 py-2 rounded-xl bg-white/3 border border-white/8">
                <span class="text-sm font-medium text-white/80">{displayName}</span>
                {role === "admin" && <span class="rounded-full bg-amber-400/15 px-2 py-0.5 text-xs font-semibold text-amber-400">Admin</span>}
                {role === "employee" && <span class="rounded-full bg-sky-400/15 px-2 py-0.5 text-xs font-semibold text-sky-400">Staff</span>}
              </div>

              <!-- Customer links -->
              <div class="grid grid-cols-2 gap-1">
                <a href={accountHref} class="flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-3 py-2.5 text-xs text-white/70 hover:text-white hover:bg-white/10 transition text-center">
                  {t.user.myAccount}
                </a>
                <a href={accountHref} class="flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-3 py-2.5 text-xs text-white/70 hover:text-white hover:bg-white/10 transition text-center">
                  {t.user.myReservations}
                </a>
              </div>

              {role === "admin" && (
                <>
                  <p class="px-1 pt-1 text-[10px] font-semibold uppercase tracking-widest text-amber-400/50">{t.user.adminSection}</p>

                  <!-- Business -->
                  <p class="px-1 text-[9px] font-semibold uppercase tracking-widest text-white/25">{isEl ? "Επιχείρηση" : "Business"}</p>
                  <div class="grid grid-cols-3 gap-1">
                    <a href={adminHref}          class="flex items-center justify-center rounded-xl border border-amber-400/15 bg-amber-400/5 px-2 py-2.5 text-xs text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/10 transition text-center leading-tight">{t.user.dashboard}</a>
                    <a href={adminAnalyticsHref} class="flex items-center justify-center rounded-xl border border-amber-400/15 bg-amber-400/5 px-2 py-2.5 text-xs text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/10 transition text-center leading-tight">{t.user.analytics}</a>
                    <a href={adminCalendarHref}  class="flex items-center justify-center rounded-xl border border-amber-400/15 bg-amber-400/5 px-2 py-2.5 text-xs text-amber-400/80 hover:text-amber-400 hover:bg-amber-400/10 transition text-center leading-tight">{t.user.calendar}</a>
                  </div>

                  <!-- Customers -->
                  <p class="px-1 text-[9px] font-semibold uppercase tracking-widest text-white/25">{isEl ? "Πελάτες" : "Customers"}</p>
                  <div class="grid grid-cols-2 gap-1">
