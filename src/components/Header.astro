---
import { withLangPrefix, dict } from "../i18n";
import { getAdminNavGroups } from "../data/adminNav";

// Use locals.lang set by middleware (survives Astro.rewrite — URL-based detection breaks after rewrite)
const lang = Astro.locals.lang ?? "en";
const t = dict[lang];

// strip /el for switching (use original request URL for the switcher path)
const origPath = new URL(Astro.request.url).pathname;
const pathNoLang = origPath.startsWith("/el")
  ? origPath.replace(/^\/el/, "") || "/"
  : origPath;

const otherLang = lang === "en" ? "el" : "en";
// When switching to English, add ?lang=en so middleware clears the Greek cookie
const switchHref = otherLang === "en"
  ? `${withLangPrefix("en", pathNoLang)}?lang=en`
  : withLangPrefix("el", pathNoLang);

// Auth state from middleware
const user = Astro.locals.user;
const role = Astro.locals.role;

// Social-card slug + tonight's quest — all fetches run in parallel for TTFB.
import { supabaseAdmin } from "../lib/supabase";
import { getGameFlags } from "../lib/gameFlags";

const gameFlags = await getGameFlags();
let cardSlug: string | null = null;
let tonightsQuest: { id: string; title_en: string; title_el: string; claimed: boolean } | null = null;

if (user) {
  // Handle comes from middleware (`locals.handle`) — saves one DB round-trip per page.
  cardSlug = ((Astro.locals as any).handle as string | null) ?? user.id.slice(0, 8);

  // Only fetch quest data if the game is on. The claim lookup is done server-side below
  // in one join-ish pattern to keep this to a single round-trip.
  if (gameFlags.quests) {
    try {
      const today = new Date().toISOString().slice(0, 10);
      const { data: q } = await supabaseAdmin
        .from("quests")
        .select("id, title_en, title_el")
        .eq("active", true).eq("active_date", today)
        .order("created_at", { ascending: false }).limit(1).maybeSingle();
      if (q) {
        let claimed = false;
        try {
          const { data: c } = await supabaseAdmin
            .from("quest_claims").select("id").eq("quest_id", q.id).eq("user_id", user.id).maybeSingle();
          claimed = !!c;
        } catch {}
        tonightsQuest = { id: q.id, title_en: q.title_en, title_el: q.title_el, claimed };
      }
    } catch {}
  }
}
const adminGroups = (role === "admin" || role === "super_admin") ? getAdminNavGroups(lang as "en" | "el", t, role) : [];

const isEl = lang === "el";
const loginLabel = isEl ? "Σύνδεση" : "Sign In";
const logoutLabel = isEl ? "Αποσύνδεση" : "Sign Out";
const bookLabel = isEl ? "Κράτηση" : "Book";
const eventsLabel = isEl ? "Events" : "Events";
const adminLabel = "Admin";
const staffLabel = isEl ? "Παραγγελίες" : "Orders";

// IMPORTANT: build links WITH language prefix
const loyaltyLabel = isEl ? "Πόντοι" : "Rewards";
const playLabel = lang === "el" ? "Παίξε" : "Play";

const nav = [
  { label: t.nav.home,    icon: "🏠",  href: withLangPrefix(lang, "/") },
  { label: t.nav.menu,    icon: "📜",  href: withLangPrefix(lang, "/menu") },
  { label: bookLabel,     icon: "📅",  href: withLangPrefix(lang, "/book") },
  { label: eventsLabel,   icon: "🎵",  href: withLangPrefix(lang, "/events") },
  { label: lang === "el" ? "Κάρτα Μέλους" : "Member Card",  icon: "💳",  href: withLangPrefix(lang, "/membership") },
];

function isActive(href: string) {
  // Strip lang prefix for comparison
  const cleanHref = href.replace(/^\/el/, "") || "/";
  const cleanPath = pathNoLang || "/";
  if (cleanHref === "/") return cleanPath === "/";
  return cleanPath.startsWith(cleanHref);
}

const ctaHref    = withLangPrefix(lang, "/menu");
const brandHref  = withLangPrefix(lang, "/");
const loginHref  = withLangPrefix(lang, "/login");
const logoutHref = withLangPrefix(lang, "/logout");
const accountHref   = withLangPrefix(lang, "/account");
const adminHref          = withLangPrefix(lang, "/admin");
const adminUsersHref     = withLangPrefix(lang, "/admin/users");
const adminMenuHref      = withLangPrefix(lang, "/admin/menu");
const adminQrHref        = withLangPrefix(lang, "/admin/qrcodes");
const adminHelpHref      = withLangPrefix(lang, "/admin/help");
const adminAnalyticsHref = withLangPrefix(lang, "/admin/analytics");
const adminOrdersHref    = withLangPrefix(lang, "/admin/orders");
const adminCalendarHref  = withLangPrefix(lang, "/admin/calendar");
const adminTipsHref          = withLangPrefix(lang, "/admin/tips");
const adminReservationsHref  = withLangPrefix(lang, "/admin/reservations");
const adminLoyaltyHref       = withLangPrefix(lang, "/admin/loyalty");
const adminEventsHref        = withLangPrefix(lang, "/admin/events");
const staffHref              = withLangPrefix(lang, "/staff");
const staffOrderHref     = withLangPrefix(lang, "/staff/order");
const staffChatHref      = withLangPrefix(lang, "/staff/chat");

// language button label
const switchLabel = t.switchTo;

// aria labels
const ariaSwitch = lang === "en" ? "Switch to Greek" : "Switch to English";
const ariaOpenMenu = lang === "en" ? "Open menu" : "Άνοιγμα μενού";

// User display name (first name only)
const displayName = user?.user_metadata?.full_name?.split(" ")[0]
  ?? user?.email?.split("@")[0]
  ?? "";

import CustomerPwa from "./CustomerPwa.astro";
---

<CustomerPwa />

<header class="fixed top-0 inset-x-0 z-50">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mt-4 rounded-2xl border border-white/10 bg-black/40 backdrop-blur supports-[backdrop-filter]:bg-black/30">
      <div class="flex items-center justify-between gap-3 px-4 py-3">
        <!-- Brand -->
        <a href={brandHref} class="flex items-center gap-3">
          <img
            src="/logo/logo-64.webp"
            srcset="/logo/logo-64.webp 1x, /logo/logo-128.webp 2x"
            alt="Sally's Bar logo"
            width="32"
            height="32"
            class="h-8 w-8 rounded-md object-contain"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <span class="text-sm font-semibold tracking-wide text-white/90">
            Sally's Bar
          </span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-6 text-sm">
          {nav.map((i) => (
            <a
              href={i.href}
              class={isActive(i.href)
                ? "text-white font-medium relative after:absolute after:bottom-[-2px] after:left-0 after:right-0 after:h-[2px] after:rounded-full after:bg-amber-400 flex items-center gap-1.5"
                : "text-white/55 hover:text-white transition flex items-center gap-1.5"}
            >
              <span>{i.icon}</span><span>{i.label}</span>
            </a>
          ))}
        </nav>

        <!-- Desktop right actions -->
        <div class="hidden md:flex items-center gap-2">
          <a
            href={switchHref}
            class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/90 hover:bg-white/10 transition"
            aria-label={ariaSwitch}
          >
            {switchLabel}
          </a>

          {user ? (
            <div class="relative" id="userMenuWrapper">
              <button
                id="userMenuBtn"
                type="button"
                class="flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/90 hover:bg-white/10 transition"
              >
                {displayName}
                {role === "admin" && (
                  <span class="rounded-full bg-amber-400/15 px-2 py-0.5 text-xs font-semibold text-amber-400">Admin</span>
                )}
                {role === "employee" && (
                  <span class="rounded-full bg-sky-400/15 px-2 py-0.5 text-xs font-semibold text-sky-400">Staff</span>
                )}
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="opacity-50 ml-0.5">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div id="userMenuDropdown" class="hidden absolute right-0 top-full mt-2 w-60 rounded-2xl border border-white/10 bg-[#0b0b10] shadow-xl z-50 max-h-[min(80vh,600px)] overflow-y-auto overscroll-contain">
                <div class="py-1.5">
                  <!-- Header card: avatar + name -->
                  <div class="flex items-center gap-3 px-4 pt-3 pb-2.5">
                    <div class="shrink-0 h-10 w-10 rounded-full bg-gradient-to-br from-amber-300 to-amber-500 text-black font-bold grid place-items-center text-sm shadow-lg shadow-amber-500/20">
                      {displayName.charAt(0).toUpperCase()}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-semibold text-white truncate">{displayName}</p>
                      <p class="text-[10px] uppercase tracking-widest text-white/40 mt-0.5">{role ?? "guest"}</p>
                    </div>
                  </div>
                  <div class="mx-3 mb-1.5 border-t border-white/10"></div>

                  {(role === "admin" || role === "super_admin") && (
                    <a href={adminHref} class="mx-3 mb-1.5 flex items-center justify-between gap-2 rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black px-3 py-2.5 text-sm font-bold shadow-lg shadow-amber-500/20 hover:scale-[1.01] active:scale-[0.99] transition">
                      <span class="flex items-center gap-2">
                        {role === "super_admin" ? "🔐" : "🛠"} {isEl ? "Πίνακας Διαχείρισης" : "Admin Panel"}
                      </span>
                      <span class="text-base">→</span>
                    </a>
                  )}

                  {tonightsQuest && (
                    <a href={`/quest/${tonightsQuest.id}`} class="mx-3 mb-1.5 flex items-start gap-2.5 rounded-xl border border-fuchsia-400/30 bg-gradient-to-br from-fuchsia-500/15 via-amber-500/10 to-sky-500/10 px-3 py-2.5 text-sm hover:from-fuchsia-500/25 transition relative">
                      <span class="text-lg shrink-0 mt-0.5">🎯</span>
                      <div class="flex-1 min-w-0">
                        <p class="text-[10px] uppercase tracking-wider font-bold text-fuchsia-300">{isEl ? "Αποψινή αποστολή" : "Tonight's quest"}</p>
                        <p class="text-xs text-white truncate">{isEl ? tonightsQuest.title_el : tonightsQuest.title_en}</p>
                      </div>
                      {!tonightsQuest.claimed && <span class="absolute top-2 right-2 h-2 w-2 rounded-full bg-fuchsia-400 animate-pulse"></span>}
                    </a>
                  )}

                  <a href={accountHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-amber-200 hover:bg-white/5 transition">
                    <span class="shrink-0 w-5 grid place-items-center">💳</span>
                    {isEl ? "Η κάρτα πιστότητας" : "My loyalty card"}
                  </a>
                  {cardSlug && (
                    <a href={`/u/${cardSlug}`} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-amber-200 hover:bg-white/5 transition">
                      <span class="shrink-0 w-5 grid place-items-center">🪪</span>
                      {isEl ? "Η κάρτα social μου" : "My social card"}
                    </a>
                  )}
                  {role === "customer" && (
                    <>
                      <a href={withLangPrefix(lang, "/loyalty")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-amber-200 hover:bg-white/5 transition">
                        <span class="shrink-0 w-5 grid place-items-center">👑</span>
                        {isEl ? "Ανταμοιβές & Επίπεδα" : "Rewards & Tiers"}
                      </a>
                      <a href={withLangPrefix(lang, "/play")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-amber-200 hover:bg-white/5 transition">
                        <span class="shrink-0 w-5 grid place-items-center">🎁</span>
                        {isEl ? "Παιχνίδι & αποστολές" : "Play & quests"}
                      </a>
                      <a href={accountHref + "#pointsHistory"} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-amber-200 hover:bg-white/5 transition">
                        <span class="shrink-0 w-5 grid place-items-center">💰</span>
                        {isEl ? "Πόντοι & εξαργύρωση" : "Points & redeem"}
                      </a>
                      <a href={withLangPrefix(lang, "/book")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-amber-200 hover:bg-white/5 transition">
                        <span class="shrink-0 w-5 grid place-items-center">📅</span>
                        {isEl ? "Κρατήσεις" : "Reservations"}
                      </a>
                      <a href={withLangPrefix(lang, "/events")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/70 hover:text-amber-200 hover:bg-white/5 transition">
                        <span class="shrink-0 w-5 grid place-items-center">🎵</span>
                        {isEl ? "Events" : "Events"}
                      </a>
                    </>
                  )}

                  {role === "admin" && (
                    <>
                      <div class="mx-3 my-1.5 border-t border-white/10"></div>
                      <p class="px-4 py-1 text-xs font-semibold uppercase tracking-widest text-amber-400/50">{t.user.adminSection}</p>
                      {adminGroups.map((g) => (
                        <>
                          <p class="px-4 pt-2 pb-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-white/30">{g.title}</p>
                          {g.items.map((i) => (
                            <a href={i.href} class="flex items-center gap-3 px-4 py-2 rounded-none text-sm text-white/75 hover:text-amber-200 hover:bg-white/5 transition">
                              <span class="shrink-0 w-5 h-5 inline-flex items-center justify-center text-white/50">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" set:html={i.icon}></svg>
                              </span>
                              <span class="flex-1 truncate">{i.label}</span>
                            </a>
                          ))}
                        </>
                      ))}
                    </>
                  )}

                  {(role === "employee" || role === "admin") && (
                    <>
                      <div class="mx-3 my-1.5 border-t border-white/10"></div>
                      <p class="px-4 py-1 text-xs font-semibold uppercase tracking-widest text-sky-400/50">{t.user.staffSection}</p>
                      <a href={staffHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-sky-400/80 hover:text-sky-400 hover:bg-sky-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>
                        {t.user.activeOrders}
                      </a>
                      <a href={staffOrderHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-sky-400/80 hover:text-sky-400 hover:bg-sky-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        {t.user.newOrder}
                      </a>
                      <a href={staffChatHref} class="relative flex items-center gap-2.5 px-4 py-2.5 text-sm text-sky-400/80 hover:text-sky-400 hover:bg-sky-400/5 transition">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {isEl ? "Ομάδα (Chat)" : "Team Chat"}
                        <span id="hdrTeamChatBadge" class="hidden ml-auto min-w-[18px] h-[18px] px-1 rounded-full bg-rose-500 text-white text-[10px] font-bold flex items-center justify-center"></span>
                      </a>
                    </>
                  )}

                  <div class="mx-3 my-1.5 border-t border-white/10"></div>
                  <a href={withLangPrefix(lang, "/settings")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/75 hover:text-white hover:bg-white/5 transition">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-70"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {isEl ? "Ρυθμίσεις & Προφίλ" : "Settings & Profile"}
                  </a>
                  <a href={logoutHref} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-white/50 hover:text-white hover:bg-white/5 transition">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="opacity-60"><path d="M16 17l5-5-5-5M21 12H9M13 7V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h6a2 2 0 002-2v-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {logoutLabel}
                  </a>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={loginHref}
              class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/90 hover:bg-white/10 transition"
            >
              {loginLabel}
            </a>
          )}

        </div>

        <!-- Mobile hamburger -->
        <button
          id="mobileMenuBtn"
          class="md:hidden inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-sm text-white/90 hover:bg-white/10"
          style="touch-action: manipulation;"
          aria-label={ariaOpenMenu}
          aria-expanded="false"
          aria-controls="mobileMenu"
          type="button"
        >
          <span class="mr-2">{t.nav.menu}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="opacity-90">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile drawer — rendered OUTSIDE backdrop-blur container to avoid iOS repaint cost -->
  <div
    id="mobileMenu"
    class="md:hidden fixed inset-0 z-40 hidden"
    aria-hidden="true"
  >
    <div id="mobileMenuScrim" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
    <div
      id="mobileMenuPanel"
      class="absolute top-0 right-0 bottom-0 w-[86vw] max-w-[360px] bg-[#0b0b10] border-l border-white/10 flex flex-col will-change-transform"
      style="padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);"
    >
      <!-- Top bar with close -->
      <div class="flex items-center justify-between px-4 py-3.5 border-b border-white/10 shrink-0">
        <span class="font-heading text-base font-bold">Sally's Bar</span>
        <button id="mobileMenuClose" aria-label="Close" class="h-9 w-9 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-white/70 text-2xl leading-none -mt-0.5">×</button>
      </div>

      <div class="flex-1 overflow-y-auto overscroll-contain px-3 py-3 space-y-3">

        {user && (
          <!-- User identity card -->
          <a href={accountHref} class="flex items-center gap-3 rounded-2xl bg-gradient-to-br from-amber-400/10 via-fuchsia-400/5 to-sky-400/10 border border-white/10 hover:border-amber-400/30 p-3 transition">
            <div class="h-11 w-11 rounded-full bg-gradient-to-br from-sky-400 to-fuchsia-500 flex items-center justify-center text-base font-bold shrink-0">
              {(displayName || "M").charAt(0).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-white truncate">{displayName}</p>
              <p class="text-[11px] text-white/50 truncate">{user.email}</p>
            </div>
            {role === "super_admin" && <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-rose-400/15 text-rose-300 border border-rose-400/30">🔐 Super</span>}
            {role === "admin"       && <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-400/15 text-amber-300">Admin</span>}
            {role === "employee"    && <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-sky-400/15 text-sky-300">Staff</span>}
          </a>
        )}

        <!-- Main nav as full-width tappable rows -->
        <nav class="space-y-1">
          <p class="px-2 text-[10px] uppercase tracking-[0.18em] text-white/40 font-semibold">{isEl ? "Πλοήγηση" : "Navigate"}</p>
          {nav.map((i) => (
            <a href={i.href}
              class={`flex items-center gap-3 rounded-xl px-3 py-3 text-sm transition ${isActive(i.href) ? "bg-amber-400/15 text-amber-200 font-semibold border border-amber-400/30" : "text-white/85 hover:bg-white/5 active:bg-white/10"}`}>
              <span class="text-xl w-6 text-center">{i.icon}</span>
              <span class="flex-1">{i.label}</span>
              {isActive(i.href) && <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>}
            </a>
          ))}
        </nav>

        {user && (
          <>
            <!-- My stuff -->
            <nav class="space-y-1 pt-2 border-t border-white/10">
              <p class="px-2 pt-2 text-[10px] uppercase tracking-[0.18em] text-white/40 font-semibold">{isEl ? "Ο λογαριασμός μου" : "My account"}</p>
              {tonightsQuest && (
                <a href={`/quest/${tonightsQuest.id}`} class="relative flex items-start gap-2.5 rounded-xl border border-fuchsia-400/30 bg-gradient-to-br from-fuchsia-500/15 via-amber-500/10 to-sky-500/10 px-3 py-2.5 text-sm hover:from-fuchsia-500/25 transition mb-1">
                  <span class="text-lg shrink-0 mt-0.5">🎯</span>
                  <div class="flex-1 min-w-0">
                    <p class="text-[10px] uppercase tracking-wider font-bold text-fuchsia-300">{isEl ? "Αποψινή αποστολή" : "Tonight's quest"}</p>
                    <p class="text-xs text-white truncate">{isEl ? tonightsQuest.title_el : tonightsQuest.title_en}</p>
                  </div>
                  {!tonightsQuest.claimed && <span class="absolute top-2 right-2 h-2 w-2 rounded-full bg-fuchsia-400 animate-pulse"></span>}
                </a>
