                  <span class="text-lg w-6 text-center">💬</span>{isEl ? "Ομάδα (Chat)" : "Team Chat"}
                </a>
              </nav>
            )}

            {(role === "admin" || role === "super_admin") && (
              <nav class="space-y-1 pt-2 border-t border-white/10">
                <p class="px-2 pt-2 text-[10px] uppercase tracking-[0.18em] text-amber-300/70 font-semibold">{t.user.adminSection}</p>
