---
import { dict, withLangPrefix } from "../i18n";

interface Props {
  /** Key identifying the active page: overview, analytics, calendar, reservations, events, loyalty, users, orders, tips, editMenu, qrcodes, help */
  active: string;
}

const { active } = Astro.props;
// redeploy trigger 2026-04-12T18:07
const lang = Astro.locals.lang ?? "en";
const t = dict[lang];
const isEl = lang === "el";

const qrLabel   = isEl ? "QR Codes" : "QR Codes";
const helpLabel = isEl ? "Οδηγός" : "Help & Guide";

const items = [
  { key: "overview",     label: t.admin.nav.overview,     href: withLangPrefix(lang, "/admin") },
  { key: "analytics",    label: t.admin.nav.analytics,    href: withLangPrefix(lang, "/admin/analytics") },
  { key: "calendar",     label: t.admin.nav.calendar,     href: withLangPrefix(lang, "/admin/calendar") },
  { key: "reservations", label: t.admin.nav.reservations, href: withLangPrefix(lang, "/admin/reservations") },
  { key: "events",       label: t.admin.nav.events,       href: withLangPrefix(lang, "/admin/events") },
  { key: "loyalty",      label: t.admin.nav.loyalty,      href: withLangPrefix(lang, "/admin/loyalty") },
  { key: "users",        label: t.admin.nav.users,        href: withLangPrefix(lang, "/admin/users") },
  { key: "orders",       label: t.admin.nav.orders,       href: withLangPrefix(lang, "/admin/orders") },
  { key: "tips",         label: t.admin.nav.tips,         href: withLangPrefix(lang, "/admin/tips") },
  { key: "editMenu",     label: t.admin.nav.editMenu,     href: withLangPrefix(lang, "/admin/menu") },
  { key: "careers",      label: isEl ? "Καριέρα" : "Careers", href: withLangPrefix(lang, "/admin/careers") },
  { key: "qrcodes",      label: qrLabel,                  href: withLangPrefix(lang, "/admin/qrcodes") },
  { key: "help",         label: helpLabel,                href: withLangPrefix(lang, "/admin/help") },
];

const activeItem = items.find(i => i.key === active) ?? items[0];
---

<div class="sticky top-20 z-40 border-b border-amber-400/20 bg-[#0b0b10]/95 backdrop-blur">
  <div class="mx-auto max-w-7xl px-3 sm:px-4">

    <!-- Mobile: current page pill + dropdown selector -->
    <div class="sm:hidden py-2 flex items-center gap-2">
      <span class="shrink-0 rounded-lg bg-amber-400/15 border border-amber-400/20 text-amber-400 font-medium text-xs px-2.5 py-1.5 whitespace-nowrap">
        {activeItem.label}
      </span>
      <div class="relative flex-1">
        <select
          id="adminNavSelect"
          class="appearance-none w-full rounded-lg border border-white/15 bg-white/5 px-3 py-2 pr-8 text-sm text-white/85 focus:border-amber-300/50 focus:outline-none"
          aria-label="Admin navigation"
        >
          <option value="" disabled selected>Go to…</option>
          {items.map(i => (
            <option value={i.href} selected={i.key === active}>{i.label}</option>
          ))}
        </select>
        <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 opacity-60" width="14" height="14" viewBox="0 0 12 12" fill="none">
          <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>

    <!-- Desktop: dropdown menu with all sections -->
    <div class="hidden sm:flex items-center py-2 relative">
      <button
        id="adminNavBtn"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        class="flex items-center gap-2 rounded-lg border border-amber-400/20 bg-amber-400/10 hover:bg-amber-400/15 text-amber-300 px-4 py-2 text-sm font-medium transition"
      >
        <span>{activeItem.label}</span>
        <svg id="adminNavChevron" width="14" height="14" viewBox="0 0 12 12" fill="none" class="transition-transform">
          <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div
        id="adminNavMenu"
        role="menu"
        aria-labelledby="adminNavBtn"
        class="hidden absolute left-0 top-full mt-2 w-64 rounded-xl border border-white/10 bg-[#141420] shadow-2xl shadow-black/60 p-1.5 z-50 max-h-[70vh] overflow-y-auto"
      >
        {items.map((i, idx) => {
          const isActive = i.key === active;
          const base = "flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm transition";
          const cls = isActive
            ? `${base} bg-amber-400/15 text-amber-300 font-medium`
            : `${base} text-white/75 hover:bg-white/5 hover:text-amber-300`;
          return (
            <>
              {(idx === 3 || idx === 7 || idx === 10) && (
                <div class="my-1 border-t border-white/10"></div>
              )}
              <a href={i.href} role="menuitem" class={cls}>
                {isActive && <span class="text-amber-400">●</span>}
                <span>{i.label}</span>
              </a>
            </>
          );
        })}
      </div>
    </div>

  </div>
</div>

<script is:inline>
  document.getElementById("adminNavSelect")?.addEventListener("change", (e) => {
    const v = e.target.value;
    if (v) window.location.href = v;
  });

  (function () {
    const btn = document.getElementById("adminNavBtn");
    const menu = document.getElementById("adminNavMenu");
    const chev = document.getElementById("adminNavChevron");
    if (!btn || !menu) return;
    function setOpen(open) {
      menu.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      if (chev) chev.style.transform = open ? "rotate(180deg)" : "";
    }
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(menu.classList.contains("hidden"));
    });
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target) && e.target !== btn) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  })();
</script>
