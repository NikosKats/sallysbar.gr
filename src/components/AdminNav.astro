---
import { dict, withLangPrefix } from "../i18n";
import { getAdminNavGroups, I as AdminIcons } from "../data/adminNav";

interface Props {
  active: string;
}

const { active } = Astro.props;
const lang = Astro.locals.lang ?? "en";
const t = dict[lang];
const isEl = lang === "el";

const vapidPublicKey = import.meta.env.VAPID_PUBLIC_KEY ?? "";

// Language switch target: keep same pathname, swap prefix
const origPath = new URL(Astro.request.url).pathname;
const pathNoLang = origPath.startsWith("/el")
  ? origPath.replace(/^\/el/, "") || "/"
  : origPath;
const otherLang = isEl ? "en" : "el";
const switchHref = otherLang === "en"
  ? `${withLangPrefix("en", pathNoLang)}?lang=en`
  : withLangPrefix("el", pathNoLang);
const switchLabel = isEl ? "English" : "Ελληνικά";
const switchFlag  = isEl ? "🇬🇧" : "🇬🇷";

const groups = getAdminNavGroups(lang as "en" | "el", t);

const activeItem = groups.flatMap(g => g.items).find(i => i.key === active);
---

<!-- PWA hooks: manifest + theme color + iOS meta (browsers accept these in body) -->
<link rel="manifest" href="/admin-manifest.webmanifest" />
<meta name="theme-color" content="#0b0b10" />
<link rel="apple-touch-icon" href="/icon-admin-192.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Sally's Admin" />

<!-- Hide the public site Header + its spacer on admin pages, and shift ALL body content
     right on desktop so the fixed sidebar never overlaps (main, pre-main <section>s, etc.). -->
<style is:global>
  html:has(.admin-nav-root) header.fixed.top-0.inset-x-0,
  html:has(.admin-nav-root) header.fixed.top-0.inset-x-0 + div.h-20 { display: none !important; }
  @media (min-width: 1024px) {
    html:has(.admin-nav-root) body { padding-left: 260px; }
  }
</style>

<div class="admin-nav-root">
  <!-- Mobile top bar -->
  <div class="lg:hidden sticky top-0 z-40 border-b border-amber-400/20 bg-[#0b0b10]/95 backdrop-blur-md">
    <div class="flex items-center gap-3 px-4 py-3">
      <button id="adminMenuBtn" type="button" aria-label="Open admin menu" class="shrink-0 rounded-lg border border-white/10 bg-white/5 p-2 text-white/80 hover:bg-white/10 transition">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <div class="min-w-0 flex-1">
        <p class="text-[10px] uppercase tracking-[0.2em] text-amber-300/70">{isEl ? "Πίνακας Διαχείρισης" : "Admin Panel"}</p>
        <p class="text-sm font-semibold text-amber-200 truncate">{activeItem?.label ?? ""}</p>
      </div>
      <a href={switchHref} aria-label="Switch language" class="shrink-0 rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 px-2.5 py-2 text-xs text-white/75 hover:text-amber-200 transition">
        <span class="mr-1">{switchFlag}</span><span class="font-medium">{otherLang.toUpperCase()}</span>
      </a>
    </div>
  </div>

  <!-- Desktop sidebar (fixed, full-height since public header is hidden) -->
  <aside id="adminSidebar" class="lg:fixed lg:top-0 lg:bottom-0 lg:left-0 lg:w-[260px] lg:border-r lg:border-white/10 lg:bg-[#0e0e16]/95 lg:backdrop-blur-md lg:z-40 lg:flex lg:flex-col hidden">
    <div class="px-5 py-5 border-b border-white/10 flex items-center gap-3">
      <div class="h-9 w-9 rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black grid place-items-center font-bold shadow-lg shadow-amber-500/20">S</div>
      <div class="leading-tight min-w-0">
        <p class="text-[10px] uppercase tracking-[0.2em] text-amber-300/70">{isEl ? "Πίνακας Διαχείρισης" : "Admin Panel"}</p>
        <p class="text-sm font-semibold text-white truncate">Sally's Bar</p>
      </div>
    </div>
    <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-5">
      {groups.map(g => (
        <div>
          <p class="px-2 mb-1.5 text-[10px] uppercase tracking-[0.18em] text-white/40 font-semibold">{g.title}</p>
          <div class="space-y-0.5">
            {g.items.map(i => {
              const isActive = i.key === active;
              return (
                <a
                  href={i.href}
                  class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition group ${isActive ? "bg-amber-400/15 text-amber-200 font-medium" : "text-white/70 hover:bg-white/5 hover:text-amber-200"}`}
                >
                  <span class={`shrink-0 w-5 h-5 inline-flex items-center justify-center ${isActive ? "text-amber-300" : "text-white/50 group-hover:text-amber-300"}`}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" set:html={i.icon}></svg>
                  </span>
                  <span class="flex-1 truncate">{i.label}</span>
                  {isActive && <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </nav>
    <div class="border-t border-white/10 p-3 space-y-2" data-vapid={vapidPublicKey}>
      <button id="adminEnableNotif" type="button" class="flex items-center justify-center gap-2 w-full rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 hover:border-amber-400/40 text-white/80 hover:text-amber-200 px-3 py-2 text-sm font-medium transition">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M10 21a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span id="adminNotifLabel">{isEl ? "Ενεργοποίηση ειδοποιήσεων" : "Enable notifications"}</span>
      </button>
      <a href={switchHref} class="flex items-center justify-center gap-2 w-full rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 hover:border-amber-400/40 text-white/80 hover:text-amber-200 px-3 py-2 text-sm font-medium transition">
        <span class="text-base leading-none">{switchFlag}</span>
        <span>{switchLabel}</span>
      </a>
      <a href={withLangPrefix(lang, "/")} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 w-full rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black px-3 py-2.5 text-sm font-semibold shadow-lg shadow-amber-500/10 hover:shadow-amber-500/30 hover:scale-[1.01] active:scale-[0.99] transition">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 3h7v7M10 14L21 3M19 14v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {isEl ? "Επίσκεψη ιστότοπου" : "Visit site"}
      </a>
    </div>
  </aside>

  <!-- Mobile drawer -->
  <div id="adminMobileDrawer" class="lg:hidden fixed inset-0 z-[60] hidden">
    <div id="adminDrawerBackdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
    <aside class="absolute left-0 top-0 bottom-0 w-[88vw] max-w-[320px] bg-[#0e0e16] border-r border-white/10 flex flex-col">
      <div class="px-5 py-5 border-b border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black grid place-items-center font-bold shadow-lg">S</div>
          <div class="leading-tight">
            <p class="text-[10px] uppercase tracking-[0.2em] text-amber-300/70">{isEl ? "Πίνακας" : "Admin"}</p>
            <p class="text-sm font-semibold text-white">Sally's Bar</p>
          </div>
        </div>
        <button id="adminDrawerClose" aria-label="Close" class="text-white/50 hover:text-white text-3xl leading-none -mt-1">×</button>
      </div>
      <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-5">
        {groups.map(g => (
          <div>
            <p class="px-2 mb-1.5 text-[10px] uppercase tracking-[0.18em] text-white/40 font-semibold">{g.title}</p>
            <div class="space-y-0.5">
              {g.items.map(i => {
                const isActive = i.key === active;
                return (
                  <a
                    href={i.href}
                    class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition ${isActive ? "bg-amber-400/15 text-amber-200 font-medium" : "text-white/75 hover:bg-white/5 hover:text-amber-200"}`}
                  >
                    <span class={`shrink-0 w-5 h-5 inline-flex items-center justify-center ${isActive ? "text-amber-300" : "text-white/50"}`}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" set:html={i.icon}></svg>
                    </span>
                    <span class="flex-1 truncate">{i.label}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </nav>
      <div class="border-t border-white/10 p-3 space-y-2" data-vapid={vapidPublicKey}>
        <button id="adminEnableNotifMobile" type="button" class="flex items-center justify-center gap-2 w-full rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 hover:border-amber-400/40 text-white/80 hover:text-amber-200 px-3 py-2 text-sm font-medium transition">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M10 21a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span id="adminNotifLabelMobile">{isEl ? "Ενεργοποίηση ειδοποιήσεων" : "Enable notifications"}</span>
        </button>
        <a href={switchHref} class="flex items-center justify-center gap-2 w-full rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 hover:border-amber-400/40 text-white/80 hover:text-amber-200 px-3 py-2 text-sm font-medium transition">
          <span class="text-base leading-none">{switchFlag}</span>
          <span>{switchLabel}</span>
        </a>
        <a href={withLangPrefix(lang, "/")} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 w-full rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black px-3 py-2.5 text-sm font-semibold shadow-lg shadow-amber-500/10 hover:shadow-amber-500/30 transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 3h7v7M10 14L21 3M19 14v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {isEl ? "Επίσκεψη ιστότοπου" : "Visit site"}
        </a>
      </div>
    </aside>
  </div>
</div>

<script is:inline>
  (function () {
    const btn = document.getElementById("adminMenuBtn");
    const drawer = document.getElementById("adminMobileDrawer");
    const backdrop = document.getElementById("adminDrawerBackdrop");
    const closeBtn = document.getElementById("adminDrawerClose");
    if (!btn || !drawer) return;
    function open() { drawer.classList.remove("hidden"); document.body.style.overflow = "hidden"; }
    function close() { drawer.classList.add("hidden"); document.body.style.overflow = ""; }
    btn.addEventListener("click", open);
    backdrop && backdrop.addEventListener("click", close);
    closeBtn && closeBtn.addEventListener("click", close);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  })();

  // Register service worker for PWA (installable + offline-ready)
  (function () {
    if (!("serviceWorker" in navigator)) return;
    navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => {});
  })();

  // Admin push notification subscribe flow — wires both desktop + mobile drawer buttons
  (function () {
    const pairs = [
      { btn: document.getElementById("adminEnableNotif"),       label: document.getElementById("adminNotifLabel") },
      { btn: document.getElementById("adminEnableNotifMobile"), label: document.getElementById("adminNotifLabelMobile") },
    ].filter(p => p.btn && p.label);
    if (pairs.length === 0) return;

    const vapidPub = (pairs[0].btn.parentElement && pairs[0].btn.parentElement.dataset.vapid) || "";

    function urlB64ToUint8(b64) {
      const pad = "=".repeat((4 - (b64.length % 4)) % 4);
      const s = (b64 + pad).replace(/-/g, "+").replace(/_/g, "/");
      const raw = atob(s);
      const out = new Uint8Array(raw.length);
      for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
      return out;
    }

    function setAll(text, cls, disabled) {
      pairs.forEach(({ btn, label }) => {
        label.textContent = text;
        if (cls) btn.className = cls;
        btn.disabled = !!disabled;
      });
    }
    const onCls = "flex items-center justify-center gap-2 w-full rounded-xl bg-emerald-400/15 border border-emerald-400/40 text-emerald-200 px-3 py-2 text-sm font-medium";
    function setOn()      { setAll("✓ Notifications on", onCls, true); }
    function setBlocked() { setAll("Notifications blocked", null, true); }

    if (!("Notification" in window) || !("serviceWorker" in navigator) || !("PushManager" in window)) {
      setAll("Notifications not supported", null, true); return;
    }
    if (!vapidPub) { setAll("VAPID key missing", null, true); return; }

    if (Notification.permission === "granted") {
      (async () => {
        try {
          const reg = await navigator.serviceWorker.ready;
          let sub = await reg.pushManager.getSubscription();
          if (!sub) sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlB64ToUint8(vapidPub) });
          await fetch("/api/push/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(sub.toJSON()) });
          setOn();
        } catch {}
      })();
      return;
    }
    if (Notification.permission === "denied") { setBlocked(); return; }

    async function handleClick() {
      setAll("⏳", null, true);
      const perm = await Notification.requestPermission();
      if (perm !== "granted") {
        if (perm === "denied") setBlocked();
        else setAll("Enable notifications", null, false);
        return;
      }
      try {
        const reg = await navigator.serviceWorker.ready;
        const sub = (await reg.pushManager.getSubscription())
          ?? await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlB64ToUint8(vapidPub) });
        await fetch("/api/push/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(sub.toJSON()) });
        setOn();
      } catch {
        setAll("Subscribe failed", null, false);
      }
    }
    pairs.forEach(({ btn }) => btn.addEventListener("click", handleClick));
  })();

  // Install-to-home-screen prompt (Android / desktop Chrome)
  (function () {
    let deferred = null;
    window.addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      deferred = e;
      if (document.getElementById("adminInstallBtn")) return;
      const btn = document.createElement("button");
      btn.id = "adminInstallBtn";
      btn.type = "button";
      btn.textContent = "⬇ Install admin app";
      btn.style.cssText = "position:fixed;bottom:16px;right:16px;z-index:9999;padding:10px 14px;border-radius:12px;background:#fbbf24;color:#000;font-weight:600;font-size:13px;border:0;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.5);";
      btn.addEventListener("click", async () => {
        if (!deferred) return;
        deferred.prompt();
        const res = await deferred.userChoice;
        if (res.outcome === "accepted") btn.remove();
        deferred = null;
      });
      document.body.appendChild(btn);
    });
    window.addEventListener("appinstalled", () => {
      const b = document.getElementById("adminInstallBtn"); if (b) b.remove();
    });
  })();
</script>
