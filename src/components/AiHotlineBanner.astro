---
// Promo banner for the 24/7 AI receptionist hotline.
// Drop into any page — two variants via the `compact` prop:
//   <AiHotlineBanner />          // full hero-style banner (default)
//   <AiHotlineBanner compact />  // tighter one-liner inside a form/panel
export interface Props {
  compact?: boolean;
  lang?: "en" | "el";
}
const { compact = false, lang = "en" } = Astro.props;
const isEl = lang === "el";

const US = "+12075037391";
const UK = "+447441475768";
const US_DISPLAY = "+1 207 503 7391";
const UK_DISPLAY = "+44 7441 475768";

const title = isEl ? "📞 Καλέστε την AI ρεσεψιονίστ μας 24/7" : "📞 Call our AI receptionist 24/7";
const sub = isEl
  ? "Για κρατήσεις, ωράριο, μενού ή απλά να πείτε ένα γεια. Μιλάει Αγγλικά & Ελληνικά."
  : "For bookings, hours, menu questions, or just to say hi. Speaks English & Greek.";
const bullets = isEl
  ? ["📅 Κράτηση τραπεζιού", "🍸 Ερωτήσεις μενού (αλλεργίες, κοκτέιλ, τιμές)", "🕘 Ωράριο & events αποψινά", "🎤 Ελληνικά ή Αγγλικά"]
  : ["📅 Book a table", "🍸 Menu questions (allergens, cocktails, prices)", "🕘 Hours & tonight's events", "🎤 English or Greek"];
---
{compact ? (
  <div class="rounded-2xl border border-violet-400/30 bg-gradient-to-br from-violet-500/[0.12] via-sky-500/[0.05] to-transparent p-4 text-sm text-white/85">
    <p class="font-semibold text-violet-100">🤖 {isEl ? "Προτιμάς να μιλήσεις;" : "Prefer to just speak?"}</p>
    <p class="mt-1 text-white/70">
      {isEl ? "Κάλεσε την AI μας ρεσεψιονίστ 24/7 — κράτηση σε 30 δευτερόλεπτα." : "Call our AI receptionist 24/7 — book in under 30 seconds."}
    </p>
    <div class="mt-3 flex flex-wrap gap-2">
      <a href={`tel:${UK}`} class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/5 hover:bg-white/10 px-3 py-1.5 text-xs text-white font-mono">
        🇬🇧 {UK_DISPLAY}
      </a>
      <a href={`tel:${US}`} class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/5 hover:bg-white/10 px-3 py-1.5 text-xs text-white font-mono">
        🇺🇸 {US_DISPLAY}
      </a>
    </div>
  </div>
) : (
  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="relative overflow-hidden rounded-3xl border border-violet-400/30 bg-gradient-to-br from-violet-500/[0.12] via-fuchsia-500/[0.06] to-sky-500/[0.08] p-8 md:p-12">
      <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-violet-400/20 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-sky-400/20 blur-3xl"></div>

      <div class="relative grid gap-10 md:grid-cols-[1.4fr_1fr] items-center">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-violet-400/40 bg-violet-400/15 text-violet-200 text-xs font-semibold px-3 py-1">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-violet-400 animate-pulse"></span>
            {isEl ? "ΝΕΟ" : "NEW"} · {isEl ? "ΠΟΤΕ ΔΕΝ ΚΟΙΜΑΤΑΙ" : "NEVER SLEEPS"}
          </div>
          <h2 class="mt-3 font-heading text-3xl md:text-4xl font-bold leading-tight">
            {title}
          </h2>
          <p class="mt-3 text-white/70 max-w-xl leading-relaxed">
            {sub}
          </p>
          <ul class="mt-5 grid gap-2 sm:grid-cols-2 text-sm text-white/80 max-w-xl">
            {bullets.map(b => <li class="flex items-start gap-2"><span class="text-violet-300">✓</span><span>{b}</span></li>)}
          </ul>
        </div>

        <div class="flex flex-col gap-3">
          <a href={`tel:${UK}`} class="group relative overflow-hidden rounded-2xl border border-white/15 bg-white/[0.06] hover:bg-white/[0.12] hover:border-amber-300/50 px-5 py-4 transition">
            <div class="flex items-center gap-3">
              <span class="text-2xl">🇬🇧</span>
              <div class="flex-1 min-w-0">
                <p class="text-[10px] uppercase tracking-wider text-white/55">UK / {isEl ? "Διεθνές" : "International"}</p>
                <p class="font-heading text-xl font-bold font-mono mt-0.5">{UK_DISPLAY}</p>
              </div>
              <span class="text-white/40 group-hover:text-amber-200 transition">→</span>
            </div>
          </a>
          <a href={`tel:${US}`} class="group relative overflow-hidden rounded-2xl border border-white/15 bg-white/[0.06] hover:bg-white/[0.12] hover:border-amber-300/50 px-5 py-4 transition">
            <div class="flex items-center gap-3">
              <span class="text-2xl">🇺🇸</span>
              <div class="flex-1 min-w-0">
                <p class="text-[10px] uppercase tracking-wider text-white/55">{isEl ? "ΗΠΑ" : "US"}</p>
                <p class="font-heading text-xl font-bold font-mono mt-0.5">{US_DISPLAY}</p>
              </div>
              <span class="text-white/40 group-hover:text-amber-200 transition">→</span>
            </div>
          </a>
          <p class="text-[11px] text-white/45 text-center px-2">
            {isEl
              ? "Η κλήση χρεώνεται στην τιμή του παρόχου σας. Χωρίς επιπλέον χρέωση από εμάς."
              : "Call charged at your carrier's standard rate. No extra fee from us."}
          </p>
        </div>
      </div>
    </div>
  </section>
)}
