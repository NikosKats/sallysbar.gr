---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getGameFlags } from "../lib/gameFlags";
import { withLangPrefix } from "../i18n";

const flags = await getGameFlags();
if (!flags.wheel && !flags.scratch && !flags.quests) return new Response("Not found", { status: 404 });

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

const T = {
  kicker:  isEl ? "Παιχνίδια στο Sally's" : "Games at Sally's",
  title_a: isEl ? "Παίξε" : "Play.",
  title_b: isEl ? "Κέρδισε" : "Win.",
  title_c: isEl ? "Ξαναέλα" : "Come back.",
  sub:     isEl
    ? "Τρία παιχνίδια, κάθε επίσκεψη μία ευκαιρία. Από άμεσα έπαθλα μέχρι νυχτερινές αποστολές."
    : "Three games, every visit a new shot. Instant prizes, nightly missions, daily spins.",
  learnMore: isEl ? "Μάθε περισσότερα →" : "Learn more →",
};

type Tile = { key: "quests" | "wheel" | "scratch"; icon: string; title_en: string; title_el: string; teaser_en: string; teaser_el: string; bullets_en: string[]; bullets_el: string[]; href: string; gradient: string; border: string };
const tiles: Tile[] = [
  flags.quests && {
    key: "quests" as const,
    icon: "🎯",
    title_en: "Tonight's Quests",
    title_el: "Αποψινές Αποστολές",
    teaser_en: "A fresh mission every night. Complete it while you're here, earn bonus points + prizes.",
    teaser_el: "Μία νέα αποστολή κάθε βράδυ. Ολοκλήρωσέ την όσο είσαι εδώ, πάρε bonus πόντους + δώρα.",
    bullets_en: ["Daily 19:00 drop", "Push notification alert", "Staff-confirmed claim"],
    bullets_el: ["Καθημερινά στις 19:00", "Ειδοποίηση push", "Επιβεβαίωση από staff"],
    href: withLangPrefix(lang, "/quests"),
    gradient: "from-amber-500/20 via-fuchsia-500/10 to-sky-500/10",
    border:   "border-amber-400/40",
  },
  flags.wheel && {
    key: "wheel" as const,
    icon: "🎡",
    title_en: "Wheel of Luck",
    title_el: "Ρόδα Τύχης",
    teaser_en: "Casino-style wheel with 8 prizes. One spin per day, every spin wins something.",
    teaser_el: "Casino wheel με 8 έπαθλα. Μία περιστροφή την ημέρα, πάντα κερδίζεις κάτι.",
    bullets_en: ["+10 → +100 pts", "Free shots & cocktails", "Instant redemption"],
    bullets_el: ["+10 → +100 πόντοι", "Δωρεάν shots & cocktails", "Άμεση εξαργύρωση"],
    href: withLangPrefix(lang, "/wheel"),
    gradient: "from-fuchsia-500/20 via-amber-500/10 to-red-500/10",
    border:   "border-fuchsia-400/40",
  },
  flags.scratch && {
    key: "scratch" as const,
    icon: "🎟",
    title_en: "Scratch Cards",
    title_el: "Scratch Cards",
    teaser_en: "Digital scratch cards — earned on signup, birthdays, and referrals. Tap to reveal.",
    teaser_el: "Ψηφιακές ξυστές κάρτες — με signup, γενέθλια, referrals. Πάτα για αποκάλυψη.",
    bullets_en: ["Every card wins", "Earned, not bought", "Shots, cocktails, points"],
    bullets_el: ["Κάθε κάρτα κερδίζει", "Δεν αγοράζονται", "Shots, cocktails, πόντοι"],
    href: withLangPrefix(lang, "/scratch"),
    gradient: "from-cyan-500/20 via-emerald-500/10 to-amber-500/10",
    border:   "border-cyan-400/40",
  },
].filter(Boolean) as Tile[];
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>🎮 {T.kicker} — Sally's Bar</title>
    <meta name="description" content={T.sub} />
    <meta name="theme-color" content="#0b0b10" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased overflow-x-hidden">
    <Header />
    <div class="h-20"></div>

    <div class="pointer-events-none fixed inset-0 -z-10 opacity-70">
      <div class="absolute -top-40 left-1/3 h-[600px] w-[600px] rounded-full bg-amber-400/15 blur-[150px]"></div>
      <div class="absolute bottom-0 right-0 h-[500px] w-[500px] rounded-full bg-fuchsia-500/15 blur-[140px]"></div>
    </div>

    <main class="mx-auto max-w-4xl px-5 sm:px-8">
      <section class="pt-10 sm:pt-16 pb-10 text-center">
        <p class="text-xs uppercase tracking-[0.28em] text-amber-200/80 font-semibold">{T.kicker}</p>
        <h1 class="mt-4 font-heading text-5xl sm:text-7xl font-bold leading-[0.95] bg-gradient-to-br from-white via-amber-50 to-amber-200/80 bg-clip-text text-transparent">
          {T.title_a} {T.title_b} {T.title_c}
        </h1>
        <p class="mt-5 text-base sm:text-lg text-white/65 max-w-2xl mx-auto leading-relaxed">{T.sub}</p>
      </section>

      <section class="grid gap-4 md:grid-cols-3 pb-16">
        {tiles.map(t => (
          <a href={t.href}
            class={`group flex flex-col rounded-3xl border ${t.border} bg-gradient-to-br ${t.gradient} p-6 hover:scale-[1.02] active:scale-[0.99] transition relative overflow-hidden`}>
            <div class="absolute -top-8 -right-8 text-[120px] opacity-10 group-hover:opacity-20 transition">{t.icon}</div>
            <div class="relative">
              <span class="text-5xl">{t.icon}</span>
              <h2 class="mt-4 font-heading text-2xl font-bold">{isEl ? t.title_el : t.title_en}</h2>
              <p class="mt-2 text-sm text-white/75 leading-relaxed">{isEl ? t.teaser_el : t.teaser_en}</p>
              <ul class="mt-4 space-y-1 text-[12px] text-white/70">
                {(isEl ? t.bullets_el : t.bullets_en).map(b => <li>• {b}</li>)}
              </ul>
              <p class="mt-5 text-xs font-bold text-amber-200 inline-flex items-center gap-1 group-hover:text-amber-100 transition">{T.learnMore}</p>
            </div>
          </a>
        ))}
      </section>

      {tiles.length < 3 && (
        <p class="text-center text-[11px] text-white/40 pb-8">{isEl ? "Κάποια παιχνίδια είναι προσωρινά κλειστά." : "Some games are temporarily off."}</p>
      )}
    </main>

    <Footer />
  </body>
</html>
