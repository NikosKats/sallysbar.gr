---
// Handles invite flow — user lands here after clicking the invite email link.
// Supabase appends ?code=xxx (PKCE) — we exchange it for a session, then let
// the user pick a password before sending them to their dashboard.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set Password — Sally's Bar</title>
    <link rel="icon" href="/favicon/favicon.ico" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #0b0b10; color: #fff; font-family: Inter, system-ui, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 3rem 1rem; }
      .card { width: 100%; max-width: 24rem; }
      .brand { display: flex; align-items: center; justify-content: center; gap: .75rem; margin-bottom: 2rem; text-decoration: none; }
      .brand img { height: 2.25rem; width: 2.25rem; border-radius: .375rem; object-fit: contain; }
      .brand span { font-weight: 600; letter-spacing: .05em; color: rgba(255,255,255,.9); }
      .box { border-radius: 1rem; border: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.4); backdrop-filter: blur(12px); padding: 2rem; }
      h1 { font-size: 1.25rem; font-weight: 600; text-align: center; margin-bottom: .5rem; }
      .sub { text-align: center; font-size: .875rem; color: rgba(255,255,255,.4); margin-bottom: 1.5rem; }
      .field { display: flex; flex-direction: column; gap: .375rem; margin-bottom: 1rem; }
      label { font-size: .875rem; color: rgba(255,255,255,.6); }
      input { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; color: #fff; outline: none; width: 100%; transition: border-color .15s; }
      input::placeholder { color: rgba(255,255,255,.3); }
      input:focus { border-color: rgba(255,255,255,.3); }
      .hint { margin-top: .375rem; font-size: .75rem; color: rgba(255,255,255,.3); }
      .btn { width: 100%; border-radius: .75rem; background: #fff; padding: .75rem 1rem; font-size: .875rem; font-weight: 600; color: #000; border: none; cursor: pointer; transition: opacity .15s; margin-top: .25rem; }
      .btn:hover { opacity: .9; }
      .btn:disabled { opacity: .5; cursor: not-allowed; }
      .alert { display: none; border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; margin-bottom: 1rem; }
      .alert.error { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.2); color: #f87171; }
      .alert.success { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.2); color: #4ade80; }
      .alert.visible { display: block; }
      #loadingState { text-align: center; color: rgba(255,255,255,.4); font-size: .875rem; }
    </style>
  </head>
  <body>
    <div class="card">
      <a href="/" class="brand">
        <img src="/logo/logo-128.webp" alt="Sally's Bar" width="64" height="64" loading="eager" />
        <span>Sally's Bar</span>
      </a>

      <div class="box">
        <h1>Set your password</h1>
        <p class="sub">Choose a password to complete your account setup.</p>

        <div id="loadingState">Verifying invite link…</div>

        <div id="errorMsg" class="alert error"></div>
        <div id="successMsg" class="alert success"></div>

        <form id="passwordForm" style="display:none">
          <div class="field">
            <label for="password">New password</label>
            <input id="password" type="password" required minlength="6" autocomplete="new-password" placeholder="••••••••" />
            <p class="hint">At least 6 characters</p>
          </div>
          <div class="field">
            <label for="confirm">Confirm password</label>
            <input id="confirm" type="password" required minlength="6" autocomplete="new-password" placeholder="••••••••" />
            <p id="matchHint" class="hint" style="display:none"></p>
          </div>
          <button type="submit" id="submitBtn" class="btn">Set password</button>
        </form>
      </div>
    </div>

    <script>
      import { createBrowserClient } from "@supabase/ssr";

      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      const loadingEl  = document.getElementById("loadingState");
      const formEl     = document.getElementById("passwordForm");
      const errorEl    = document.getElementById("errorMsg");
      const successEl  = document.getElementById("successMsg");
      const submitBtn  = document.getElementById("submitBtn");

      function showError(msg) {
        errorEl.textContent = msg;
        errorEl.classList.add("visible");
        successEl.classList.remove("visible");
      }

      async function init() {
        // ── 1. Try PKCE flow (?code= in query string) ─────────────────────────
        const params = new URLSearchParams(window.location.search);
        const code = params.get("code");
        if (code) {
          const { error } = await supabase.auth.exchangeCodeForSession(code);
          if (error) {
            loadingEl.style.display = "none";
            showError("Invalid or expired invite link. Please ask an admin to resend the invite.");
            return;
          }
          loadingEl.style.display = "none";
          formEl.style.display = "block";
          return;
        }

        // ── 2. Try implicit/hash flow (#access_token=...&type=invite) ─────────
        const hash = new URLSearchParams(window.location.hash.slice(1));
        const accessToken  = hash.get("access_token");
        const refreshToken = hash.get("refresh_token");
        const tokenType    = hash.get("type"); // "invite" | "recovery" | etc.

        if (accessToken && refreshToken && tokenType === "invite") {
          // Sign out any existing session first so we don't update the wrong user
          await supabase.auth.signOut();
          const { error } = await supabase.auth.setSession({
            access_token: accessToken,
            refresh_token: refreshToken,
          });
          if (error) {
            loadingEl.style.display = "none";
            showError("Invalid or expired invite link. Please ask an admin to resend the invite.");
            return;
          }
          // Remove tokens from URL bar to prevent reuse on refresh
          history.replaceState(null, "", window.location.pathname);
          loadingEl.style.display = "none";
          formEl.style.display = "block";
          return;
        }

        // ── 3. No invite tokens — deny ─────────────────────────────────────────
        loadingEl.style.display = "none";
        showError("Invalid or expired invite link. Please ask an admin to resend the invite.");
      }

      init();

      const confirmInput = document.getElementById("confirm") as HTMLInputElement;
      const passwordInput = document.getElementById("password") as HTMLInputElement;
      const matchHint = document.getElementById("matchHint") as HTMLElement;

      function checkMatch() {
        if (!confirmInput.value) {
          matchHint.style.display = "none";
          return;
        }
        if (confirmInput.value === passwordInput.value) {
          matchHint.textContent = "✓ Passwords match";
          matchHint.style.color = "#4ade80";
        } else {
          matchHint.textContent = "✗ Passwords do not match";
          matchHint.style.color = "#f87171";
        }
        matchHint.style.display = "block";
      }

      confirmInput.addEventListener("input", checkMatch);
      passwordInput.addEventListener("input", checkMatch);

      formEl.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.remove("visible");

        const password = document.getElementById("password").value;
        const confirm  = document.getElementById("confirm").value;

        if (password.length < 6) {
          showError("Password must be at least 6 characters.");
          return;
        }
        if (password !== confirm) {
          showError("Passwords do not match.");
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Saving…";

        const { error } = await supabase.auth.updateUser({ password });

        if (error) {
          showError(error.message ?? "Something went wrong. Try again.");
          submitBtn.disabled = false;
          submitBtn.textContent = "Set password";
          return;
        }

        successEl.textContent = "Password set! Redirecting…";
        successEl.classList.add("visible");

        // Give the user a moment to see the success message, then redirect
        setTimeout(() => { window.location.href = "/"; }, 1500);
      });
    </script>
  </body>
</html>
