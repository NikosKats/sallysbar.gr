---
// No server-side auth check needed — the code exchange happens client-side
// so the session is established in the browser before the form is shown.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password — Sally's Bar</title>
    <link rel="icon" href="/favicon/favicon.ico" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #0b0b10; color: #fff; font-family: Inter, system-ui, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 3rem 1rem; }
      .card { width: 100%; max-width: 24rem; }
      .brand { display: flex; align-items: center; justify-content: center; gap: .75rem; margin-bottom: 2rem; text-decoration: none; }
      .brand img { height: 2.25rem; width: 2.25rem; border-radius: .375rem; object-fit: contain; }
      .brand span { font-weight: 600; letter-spacing: .05em; color: rgba(255,255,255,.9); }
      .box { border-radius: 1rem; border: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.4); backdrop-filter: blur(12px); padding: 2rem; }
      h1 { font-size: 1.25rem; font-weight: 600; text-align: center; margin-bottom: .5rem; }
      .subtitle { font-size: .875rem; color: rgba(255,255,255,.5); text-align: center; margin-bottom: 1.5rem; }
      .field { display: flex; flex-direction: column; gap: .375rem; }
      label { font-size: .875rem; color: rgba(255,255,255,.6); }
      input { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; color: #fff; outline: none; width: 100%; transition: border-color .15s; }
      input::placeholder { color: rgba(255,255,255,.3); }
      input:focus { border-color: rgba(255,255,255,.3); }
      .hint { margin-top: .375rem; font-size: .75rem; color: rgba(255,255,255,.3); }
      .form { display: flex; flex-direction: column; gap: 1rem; }
      .btn-primary { width: 100%; border-radius: .75rem; background: #fff; padding: .75rem 1rem; font-size: .875rem; font-weight: 600; color: #000; border: none; cursor: pointer; transition: opacity .15s; margin-top: .25rem; }
      .btn-primary:hover { opacity: .9; }
      .btn-primary:disabled { opacity: .5; cursor: not-allowed; }
      .alert { display: none; border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; margin-bottom: 1rem; }
      .alert.error { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.2); color: #f87171; }
      .alert.success { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.2); color: #4ade80; }
      .alert.visible { display: block; }
      #loading { text-align: center; color: rgba(255,255,255,.5); font-size: .875rem; padding: 1rem 0; }
      #invalidLink { display: none; text-align: center; }
      #invalidLink p { color: rgba(255,255,255,.5); font-size: .875rem; margin-bottom: 1rem; }
      #invalidLink a { color: rgba(255,255,255,.7); font-size: .875rem; text-decoration: underline; text-underline-offset: 2px; }
    </style>
  </head>
  <body>
    <div class="card">
      <a href="/" class="brand">
        <img src="/logo/logo-128.webp" alt="Sally's Bar" width="64" height="64" loading="eager" />
        <span>Sally's Bar</span>
      </a>

      <div class="box">
        <h1>Set New Password</h1>
        <p class="subtitle">Choose a new password for your account.</p>

        <!-- States -->
        <div id="loading">Verifying link…</div>

        <div id="invalidLink">
          <p>This reset link is invalid or has expired.</p>
          <a href="/forgot-password">Request a new link →</a>
        </div>

        <div id="formWrap" style="display:none;">
          <div id="errorMsg"   class="alert error"></div>
          <div id="successMsg" class="alert success"></div>

          <form id="resetForm" class="form">
            <div class="field">
              <label for="password">New Password</label>
              <input id="password" type="password" required minlength="6" autocomplete="new-password" placeholder="••••••••" />
              <p class="hint">At least 6 characters</p>
            </div>
            <div class="field">
              <label for="confirm">Confirm Password</label>
              <input id="confirm" type="password" required minlength="6" autocomplete="new-password" placeholder="••••••••" />
              <p id="matchHint" class="hint" style="display:none"></p>
            </div>
            <button type="submit" id="submitBtn" class="btn-primary">Update Password</button>
          </form>
        </div>
      </div>
    </div>

    <script>
      import { createClient } from "@supabase/supabase-js";

      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      const loadingEl = document.getElementById("loading")!;
      const invalidEl = document.getElementById("invalidLink")!;
      const formWrap  = document.getElementById("formWrap")!;
      const form      = document.getElementById("resetForm") as HTMLFormElement;
      const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
      const errorEl   = document.getElementById("errorMsg")!;
      const successEl = document.getElementById("successMsg")!;

      function showError(msg: string) {
        errorEl.textContent = msg;
        errorEl.classList.add("visible");
        successEl.classList.remove("visible");
      }

      function showForm() {
        loadingEl.style.display = "none";
        formWrap.style.display = "block";
        window.history.replaceState({}, "", "/auth/reset-password");
      }

      function showInvalid() {
        loadingEl.style.display = "none";
        invalidEl.style.display = "block";
      }

      async function init() {
        // PKCE flow: ?code= in query string
        const params = new URLSearchParams(window.location.search);
        const code = params.get("code");

        if (code) {
          const { error } = await supabase.auth.exchangeCodeForSession(code);
          if (error) { showInvalid(); return; }
          showForm();
          return;
        }

        // Implicit flow: #access_token=...&type=recovery in hash
        const hash = new URLSearchParams(window.location.hash.slice(1));
        const accessToken  = hash.get("access_token");
        const refreshToken = hash.get("refresh_token");
        const type         = hash.get("type");

        if (accessToken && type === "recovery") {
          const { error } = await supabase.auth.setSession({
            access_token:  accessToken,
            refresh_token: refreshToken ?? "",
          });
          if (error) { showInvalid(); return; }
          showForm();
          return;
        }

        showInvalid();
      }

      const passwordInput = document.getElementById("password") as HTMLInputElement;
      const confirmInput  = document.getElementById("confirm")  as HTMLInputElement;
      const matchHint     = document.getElementById("matchHint")!;

      function checkMatch() {
        if (!confirmInput.value) { matchHint.style.display = "none"; return; }
        if (confirmInput.value === passwordInput.value) {
          matchHint.textContent = "✓ Passwords match";
          matchHint.style.color = "#4ade80";
        } else {
          matchHint.textContent = "✗ Passwords do not match";
          matchHint.style.color = "#f87171";
        }
        matchHint.style.display = "block";
      }

      confirmInput.addEventListener("input", checkMatch);
      passwordInput.addEventListener("input", checkMatch);

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.remove("visible");

        const password = (document.getElementById("password") as HTMLInputElement).value;
        const confirm  = (document.getElementById("confirm")  as HTMLInputElement).value;

        if (password !== confirm) {
          showError("Passwords do not match.");
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Updating…";

        const { error } = await supabase.auth.updateUser({ password });

        if (error) {
          showError(error.message || "Something went wrong. Try again.");
          submitBtn.disabled = false;
          submitBtn.textContent = "Update Password";
          return;
        }

        successEl.textContent = "Password updated! Redirecting to sign in…";
        successEl.classList.add("visible");
        form.style.display = "none";

        setTimeout(() => { window.location.href = "/login"; }, 2000);
      });

      init();
    </script>
  </body>
</html>
