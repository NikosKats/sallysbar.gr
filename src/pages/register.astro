---
import { withLangPrefix } from "../i18n";

const lang = Astro.locals.lang ?? "en";
// After a fresh signup, go straight to the dashboard so the user sees their signup-bonus scratch card + welcome state.
const redirectTo = withLangPrefix(lang, "/account") + "?signup=1";
const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? "";

const isEl = lang === "el";
const t = {
  title:        isEl ? "Εγγραφή"                      : "Create Account",
  name:         isEl ? "Όνομα"                         : "Full Name",
  email:        "Email",
  password:     isEl ? "Κωδικός"                      : "Password",
  passwordHint: isEl ? "Τουλάχιστον 6 χαρακτήρες"    : "At least 6 characters",
  submit:       isEl ? "Δημιουργία λογαριασμού"       : "Create Account",
  submitting:   isEl ? "Δημιουργία…"                   : "Creating…",
  google:       isEl ? "Εγγραφή με Google"             : "Sign up with Google",
  hasAccount:   isEl ? "Έχεις ήδη λογαριασμό;"        : "Already have an account?",
  signIn:       isEl ? "Σύνδεση"                      : "Sign In",
  orDivider:    isEl ? "ή"                             : "or",
  successConfirm: isEl
    ? "Λογαριασμός δημιουργήθηκε! Έλεγξε το email σου για επιβεβαίωση."
    : "Account created! Check your email to confirm.",
  errorExists:  isEl ? "Υπάρχει ήδη λογαριασμός με αυτό το email." : "An account with this email already exists.",
  errorWeak:    isEl ? "Ο κωδικός πρέπει να έχει τουλάχιστον 6 χαρακτήρες." : "Password must be at least 6 characters.",
  errorGeneric: isEl ? "Κάτι πήγε στραβά. Δοκίμασε ξανά." : "Something went wrong. Try again.",
};

const loginHref = withLangPrefix(lang, "/login");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title} — Sally's Bar</title>
    <link rel="icon" href="/favicon/favicon.ico" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #0b0b10; color: #fff; font-family: Inter, system-ui, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 3rem 1rem; }
      .card { width: 100%; max-width: 24rem; }
      .brand { display: flex; align-items: center; justify-content: center; gap: .75rem; margin-bottom: 2rem; text-decoration: none; }
      .brand img { height: 2.25rem; width: 2.25rem; border-radius: .375rem; object-fit: contain; }
      .brand span { font-weight: 600; letter-spacing: .05em; color: rgba(255,255,255,.9); }
      .box { border-radius: 1rem; border: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.4); backdrop-filter: blur(12px); padding: 2rem; }
      h1 { font-size: 1.25rem; font-weight: 600; text-align: center; margin-bottom: 1.5rem; }
      .field { display: flex; flex-direction: column; gap: .375rem; }
      label { font-size: .875rem; color: rgba(255,255,255,.6); }
      input { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; color: #fff; outline: none; width: 100%; transition: border-color .15s; }
      input::placeholder { color: rgba(255,255,255,.3); }
      input:focus { border-color: rgba(255,255,255,.3); }
      .hint { margin-top: .375rem; font-size: .75rem; color: rgba(255,255,255,.3); }
      .form { display: flex; flex-direction: column; gap: 1rem; }
      .btn-primary { width: 100%; border-radius: .75rem; background: #fff; padding: .75rem 1rem; font-size: .875rem; font-weight: 600; color: #000; border: none; cursor: pointer; transition: opacity .15s; margin-top: .25rem; }
      .btn-primary:hover { opacity: .9; }
      .btn-primary:disabled { opacity: .5; cursor: not-allowed; }
      .divider { display: flex; align-items: center; gap: .75rem; margin: 1.25rem 0; }
      .divider div { flex: 1; height: 1px; background: rgba(255,255,255,.1); }
      .divider span { font-size: .75rem; color: rgba(255,255,255,.3); }
      .btn-google { width: 100%; display: flex; align-items: center; justify-content: center; gap: .75rem; border-radius: .75rem; border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.05); padding: .75rem 1rem; font-size: .875rem; color: rgba(255,255,255,.9); cursor: pointer; transition: background .15s; }
      .btn-google:hover { background: rgba(255,255,255,.1); }
      .btn-google:disabled { opacity: .5; cursor: not-allowed; }
      .footer-link { margin-top: 1.5rem; text-align: center; font-size: .875rem; color: rgba(255,255,255,.4); }
      .footer-link a { color: rgba(255,255,255,.7); text-decoration: underline; text-underline-offset: 2px; }
      .alert { display: none; border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; margin-bottom: 1rem; }
      .alert.error { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.2); color: #f87171; }
      .alert.success { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.2); color: #4ade80; }
      .alert.visible { display: block; }
      .cf-turnstile { margin-top: .25rem; }
    </style>
  </head>
  <body>
    <div id="cfg"
      data-redirect={redirectTo}
      data-success-confirm={t.successConfirm}
      data-error-exists={t.errorExists}
      data-error-weak={t.errorWeak}
      data-error-generic={t.errorGeneric}
      data-label-submit={t.submit}
      data-label-submitting={t.submitting}
      hidden></div>

    <div class="card">
      <a href={withLangPrefix(lang, "/")} class="brand">
        <img src="/logo/logo-128.webp" alt="Sally's Bar" width="64" height="64" loading="eager" />
        <span>Sally's Bar</span>
      </a>

      <div class="box">
        <h1>{t.title}</h1>

        <div id="errorMsg"   class="alert error"></div>
        <div id="successMsg" class="alert success"></div>

        <form id="registerForm" class="form">
          <div class="field">
            <label for="name">{t.name}</label>
            <input id="name" type="text" required autocomplete="name" placeholder="Maria Papadopoulou" />
          </div>
          <div class="field">
            <label for="email">{t.email}</label>
            <input id="email" type="email" required autocomplete="email" placeholder="you@example.com" />
          </div>
          <div class="field">
            <label for="password">{t.password}</label>
            <input id="password" type="password" required minlength="6" autocomplete="new-password" placeholder="••••••••" />
            <p class="hint">{t.passwordHint}</p>
          </div>
          {turnstileSitekey && (
            <div
              id="turnstileWidget"
              class="cf-turnstile"
              data-sitekey={turnstileSitekey}
              data-theme="dark"
              data-callback="onTurnstileSuccess"
              data-expired-callback="onTurnstileExpired"
            ></div>
          )}
          <p id="captchaHint" style="display:none;font-size:.75rem;color:rgba(255,255,255,.4);text-align:center;margin-top:.25rem;">
            {isEl ? "Ολοκλήρωσε την επαλήθευση ασφαλείας παραπάνω." : "Complete the security check above to continue."}
          </p>
          <button type="submit" id="submitBtn" class="btn-primary" disabled={turnstileSitekey ? true : undefined}>{t.submit}</button>
        </form>

        <div class="divider">
          <div></div><span>{t.orDivider}</span><div></div>
        </div>

        <button id="googleBtn" class="btn-google" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          {t.google}
        </button>

        <p class="footer-link">
          {t.hasAccount}{" "}
          <a href={loginHref}>{t.signIn}</a>
        </p>
      </div>
    </div>

    <script>
      import { createBrowserClient } from "@supabase/ssr";

      const cfg = document.getElementById("cfg") as HTMLElement;
      const redirectTo      = cfg.dataset.redirect!;
      const successConfirm  = cfg.dataset.successConfirm!;
      const errorExists     = cfg.dataset.errorExists!;
      const errorWeak       = cfg.dataset.errorWeak!;
      const errorGeneric    = cfg.dataset.errorGeneric!;
      const labelSubmit     = cfg.dataset.labelSubmit!;
      const labelBusy       = cfg.dataset.labelSubmitting!;

      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      const form       = document.getElementById("registerForm") as HTMLFormElement;
      const submitBtn  = document.getElementById("submitBtn")    as HTMLButtonElement;
      const googleBtn  = document.getElementById("googleBtn")    as HTMLButtonElement;
      const errorEl    = document.getElementById("errorMsg")     as HTMLElement;
      const successEl  = document.getElementById("successMsg")   as HTMLElement;

      const captchaHint  = document.getElementById("captchaHint") as HTMLElement;
      const widgetEl     = document.getElementById("turnstileWidget");

      // Turnstile token — set by Cloudflare widget callbacks
      let captchaToken = "";

      const isLocalhost = ["localhost", "127.0.0.1"].includes(window.location.hostname);

      if (widgetEl) {
        captchaHint.style.display = "block";

        (window as any).onTurnstileSuccess = (token: string) => {
          captchaToken = token;
          submitBtn.disabled = false;
          captchaHint.style.display = "none";
        };
        (window as any).onTurnstileExpired = () => {
          captchaToken = "";
          captchaHint.style.display = isLocalhost ? "none" : "block";
          submitBtn.disabled = isLocalhost ? false : true;
        };

        // On localhost Turnstile may not complete — enable after 1.5s
        if (isLocalhost) {
          setTimeout(() => {
            submitBtn.disabled = false;
            captchaHint.style.display = "none";
          }, 1500);
        }
      } else {
        submitBtn.disabled = false;
      }

      function showError(msg: string) {
        errorEl.textContent = msg;
        errorEl.classList.add("visible");
        successEl.classList.remove("visible");
        errorEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      function showSuccess(msg: string) {
        successEl.textContent = msg;
        successEl.classList.add("visible");
        errorEl.classList.remove("visible");
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.remove("visible");
        successEl.classList.remove("visible");
        submitBtn.disabled = true;
        submitBtn.textContent = labelBusy;

        const name     = (document.getElementById("name")     as HTMLInputElement).value.trim();
        const email    = (document.getElementById("email")    as HTMLInputElement).value;
        const password = (document.getElementById("password") as HTMLInputElement).value;

        if (password.length < 6) {
          showError(errorWeak);
          submitBtn.disabled = false;
          submitBtn.textContent = labelSubmit;
          return;
        }

        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: { data: { full_name: name }, ...(captchaToken ? { captchaToken } : {}) },
        });

        if (error) {
          showError(error.message?.includes("already registered") ? errorExists : errorGeneric);
          // Reset Turnstile so user can try again
          (window as any).turnstile?.reset();
          captchaToken = "";
          submitBtn.disabled = true;
          submitBtn.textContent = labelSubmit;
          return;
        }

        // Capture referral code from URL (?ref=<uuid>) and persist for later claim
        const refId = new URLSearchParams(window.location.search).get("ref");
        if (refId) try { localStorage.setItem("pending_ref", refId); } catch {}

        // Flag a pending signup-bonus claim (consumed on /account first-login if email-confirm flow).
        try { localStorage.setItem("pending_signup_bonus", "1"); } catch {}

        // Email confirmation disabled — user is logged in immediately
        if (data.session) {
          if (refId) {
            try {
              await fetch("/api/loyalty/claim-referral", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ referrer_id: refId }),
              });
              localStorage.removeItem("pending_ref");
            } catch {}
          }
          try {
            await fetch("/api/loyalty/claim-signup-bonus", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
            localStorage.removeItem("pending_signup_bonus");
          } catch {}
          window.location.href = redirectTo;
          return;
        }

        // Email confirmation required
        showSuccess(successConfirm);
        form.reset();
        (window as any).turnstile?.reset();
        captchaToken = "";
        submitBtn.disabled = true;
        submitBtn.textContent = labelSubmit;
      });

      googleBtn.addEventListener("click", async () => {
        errorEl.classList.remove("visible");
        googleBtn.disabled = true;
        const { error } = await supabase.auth.signInWithOAuth({
          provider: "google",
          options: { redirectTo: `${window.location.origin}/auth/callback` },
        });
        if (error) {
          showError(errorGeneric);
          googleBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>
