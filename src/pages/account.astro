---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { createSupabaseServerClient, supabaseAdmin } from "../lib/supabase";
import { withLangPrefix, dict } from "../i18n";
import { getTiers, getRewards, currentTier, nextTier } from "../lib/loyalty";
import { TODOS, getTodoStates } from "../lib/todos";

const user = Astro.locals.user;
const lang = Astro.locals.lang ?? "en";
if (!user) return Astro.redirect(withLangPrefix(lang, "/login") + "?next=/account");

const t    = dict[lang];
const ta   = t.account;
const isEl = lang === "el";

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: profile } = await supabase
  .from("profiles")
  .select("full_name, role, created_at, birthday, birthday_updated_at, card_issued_at, phone, country, gender, address, city, postal_code")
  .eq("id", user.id)
  .single();

const displayName = profile?.full_name ?? user.user_metadata?.full_name ?? user.email?.split("@")[0] ?? "Guest";
const memberSince = profile?.created_at
  ? new Date(profile.created_at).toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "numeric", month: "long", year: "numeric" })
  : "—";

// Fetch upcoming reservations (today and future)
const todayIso = new Date().toISOString().slice(0, 10);
const { data: reservations } = await supabaseAdmin
  .from("reservations")
  .select("id, date, time, party_size, status, notes")
  .eq("user_id", user.id)
  .gte("date", todayIso)
  .order("date", { ascending: true })
  .order("time", { ascending: true })
  .limit(10);

// Fetch upcoming event RSVPs
const { data: eventRsvps } = await supabaseAdmin
  .from("event_rsvps")
  .select("id, guests, events(id, title, title_el, event_date, event_time)")
  .eq("user_id", user.id)
  .eq("status", "confirmed")
  .order("created_at", { ascending: false })
  .limit(10);

const upcomingRsvps = (eventRsvps ?? []).filter(r => {
  const ev = r.events as any;
  return ev && ev.event_date >= todayIso;
}).sort((a, b) => {
  const da = (a.events as any)?.event_date ?? "";
  const db = (b.events as any)?.event_date ?? "";
  return da < db ? -1 : 1;
});

// Fetch loyalty points balance and recent history
const { data: loyaltyEvents } = await supabaseAdmin
  .from("loyalty_events")
  .select("id, points, reason, created_at")
  .eq("user_id", user.id)
  .order("created_at", { ascending: false })
  .limit(20);

const loyaltyBalance = (loyaltyEvents ?? []).reduce((s, e) => s + e.points, 0);
const hasCard = !!profile?.card_issued_at;

const COUNTRIES: Array<{ code: string; en: string; el: string }> = [
  { code: "GR", en: "Greece", el: "Ελλάδα" },
  { code: "CY", en: "Cyprus", el: "Κύπρος" },
  { code: "GB", en: "United Kingdom", el: "Ηνωμένο Βασίλειο" },
  { code: "US", en: "United States", el: "Η.Π.Α." },
  { code: "DE", en: "Germany", el: "Γερμανία" },
  { code: "FR", en: "France", el: "Γαλλία" },
  { code: "IT", en: "Italy", el: "Ιταλία" },
  { code: "ES", en: "Spain", el: "Ισπανία" },
  { code: "NL", en: "Netherlands", el: "Ολλανδία" },
  { code: "BE", en: "Belgium", el: "Βέλγιο" },
  { code: "CH", en: "Switzerland", el: "Ελβετία" },
  { code: "AT", en: "Austria", el: "Αυστρία" },
  { code: "DK", en: "Denmark", el: "Δανία" },
  { code: "SE", en: "Sweden", el: "Σουηδία" },
  { code: "NO", en: "Norway", el: "Νορβηγία" },
  { code: "FI", en: "Finland", el: "Φινλανδία" },
  { code: "PL", en: "Poland", el: "Πολωνία" },
  { code: "PT", en: "Portugal", el: "Πορτογαλία" },
  { code: "IE", en: "Ireland", el: "Ιρλανδία" },
  { code: "CZ", en: "Czechia", el: "Τσεχία" },
  { code: "SK", en: "Slovakia", el: "Σλοβακία" },
  { code: "HU", en: "Hungary", el: "Ουγγαρία" },
  { code: "RO", en: "Romania", el: "Ρουμανία" },
  { code: "BG", en: "Bulgaria", el: "Βουλγαρία" },
  { code: "HR", en: "Croatia", el: "Κροατία" },
  { code: "SI", en: "Slovenia", el: "Σλοβενία" },
  { code: "LT", en: "Lithuania", el: "Λιθουανία" },
  { code: "LV", en: "Latvia", el: "Λετονία" },
  { code: "EE", en: "Estonia", el: "Εσθονία" },
  { code: "TR", en: "Turkey", el: "Τουρκία" },
  { code: "RU", en: "Russia", el: "Ρωσία" },
  { code: "UA", en: "Ukraine", el: "Ουκρανία" },
  { code: "IL", en: "Israel", el: "Ισραήλ" },
  { code: "AE", en: "UAE", el: "Η.Α.Ε." },
  { code: "AU", en: "Australia", el: "Αυστραλία" },
  { code: "NZ", en: "New Zealand", el: "Νέα Ζηλανδία" },
  { code: "CA", en: "Canada", el: "Καναδάς" },
];

// Dynamic tier logic (configurable from admin)
const tiers     = await getTiers();
const rewards   = await getRewards(true);
const tierRow   = currentTier(tiers, loyaltyBalance);
const nextRow   = nextTier(tiers, loyaltyBalance);
const tierLabel = tierRow ? (isEl ? tierRow.label_el : tierRow.label_en) : "—";
const tierPerk  = tierRow ? (isEl ? tierRow.perk_el  : tierRow.perk_en)  : "";
const tierColor = tierRow?.color ?? "#94a3b8";
const tierIcon  = tierRow?.icon  ?? "";
const tierBg    = `${tierColor}1f`;
const tierBorder= `${tierColor}4d`;
const tierMin   = tierRow?.threshold ?? 0;
const tierNextAt= nextRow?.threshold ?? null;
const nextLabel = nextRow ? (isEl ? nextRow.label_el : nextRow.label_en) : "";
const tierProgress = tierNextAt
  ? Math.min(100, Math.round(((loyaltyBalance - tierMin) / (tierNextAt - tierMin)) * 100))
  : 100;
const ptsToNext = tierNextAt ? tierNextAt - loyaltyBalance : 0;

// Active (pending) redemptions
const { data: activeRedemptions } = await supabaseAdmin
  .from("loyalty_redemptions")
  .select("id, code, cost, status, created_at, loyalty_rewards(name_en, name_el)")
  .eq("user_id", user.id)
  .eq("status", "pending")
  .order("created_at", { ascending: false });

// ─── Dashboard extras ─────────────────────────────────────────
const referralLink = `https://sallysbar.gr/register?ref=${user.id}`;

const { count: friendsReferredCount } = await supabaseAdmin
  .from("profiles").select("id", { count: "exact", head: true })
  .eq("referred_by", user.id);

const referralPoints = (loyaltyEvents ?? [])
  .filter(e => String(e.reason || "").startsWith("referral:"))
  .reduce((s, e) => s + (e.points ?? 0), 0);

const { data: unrevealedCards } = await supabaseAdmin
  .from("scratch_cards")
  .select("id, reward_label, created_at, expires_at")
  .eq("user_id", user.id)
  .is("revealed_at", null)
  .order("created_at", { ascending: false })
  .limit(10);

const { data: claimedQuests } = await supabaseAdmin
  .from("quest_claims")
  .select("claimed_at, quests(title_en, title_el, reward_points)")
  .eq("user_id", user.id)
  .order("claimed_at", { ascending: false })
  .limit(5);

const { count: visitsCount } = await supabaseAdmin
  .from("orders").select("id", { count: "exact", head: true })
  .eq("customer_user_id", user.id);

const vapidPublicKey = import.meta.env.VAPID_PUBLIC_KEY ?? "";

// Todos state
const todoStates = await getTodoStates(user.id);
const todoStateByKey = new Map(todoStates.map(s => [s.key, s]));
const todosCompleted = todoStates.filter(s => s.status === "completed").length;
const totalTodoPoints = TODOS.reduce((s, t) => s + t.points, 0);
const earnedTodoPoints = TODOS.filter(t => todoStateByKey.get(t.key)?.status === "completed").reduce((s, t) => s + t.points, 0);

function reasonLabel(r: string | null): string {
  if (!r) return isEl ? "Πόντοι" : "Points";
  if (r.startsWith("order:"))    return isEl ? "Παραγγελία" : "Order";
  if (r.startsWith("rsvp:"))     return isEl ? "Κράτηση event" : "Event RSVP";
  if (r.startsWith("referral:")) return isEl ? "Σύσταση φίλου" : "Friend referral";
  if (r === "scratch_card")      return isEl ? "Scratch card" : "Scratch card";
  if (r === "quest")             return isEl ? "Αποστολή" : "Quest";
  return r;
}

function fmtDate(d: string) {
  return new Date(d + "T00:00:00").toLocaleDateString(isEl ? "el-GR" : "en-GB", {
    weekday: "short", day: "numeric", month: "short",
  });
}

function statusColor(s: string) {
  return s === "confirmed" ? "#4ade80" : s === "cancelled" ? "#f87171" : "#fbbf24";
}

function statusLabel(s: string) {
  return (ta as any)["status" + s.charAt(0).toUpperCase() + s.slice(1)] ?? s;
}
---

<html lang={lang} data-vapid={vapidPublicKey}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ta.title} — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <Header />

    <main class="mx-auto max-w-3xl px-4 pt-28 pb-10 flex flex-col gap-6">

      <!-- Welcome -->
      <div>
        <h1 class="text-2xl font-bold text-white">Hi, {displayName}</h1>
        <p class="mt-1 text-sm text-white/40">{ta.subtitle}</p>
      </div>

      <!-- Notifications + Install (TOP — highest-priority actions) -->
      <section class="order-1 grid md:grid-cols-2 gap-3">
        <div id="notifCard" class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <div class="flex items-center justify-between gap-2">
            <div>
              <p class="text-[10px] uppercase tracking-[0.22em] text-white/50 font-bold">🔔 {isEl ? "Ειδοποιήσεις" : "Notifications"}</p>
              <p class="text-sm text-white/70 mt-1">{isEl ? "Αποψινές αποστολές, secret drops, events." : "Tonight's quests, secret drops, events."}</p>
            </div>
            <button id="notifToggle" type="button" class="shrink-0 rounded-xl bg-amber-400 text-black text-xs font-bold px-4 py-2 transition hover:bg-amber-300">
              {isEl ? "Ενεργοποίησε" : "Enable"}
            </button>
          </div>
          <p id="notifMsg" class="text-xs text-white/40 mt-2"></p>
        </div>

        <div id="installCard" class="rounded-2xl border border-white/10 bg-white/5 p-5 hidden">
          <div class="flex items-center justify-between gap-2">
            <div>
              <p class="text-[10px] uppercase tracking-[0.22em] text-white/50 font-bold">📲 {isEl ? "Εφαρμογή" : "App"}</p>
              <p id="installLabel" class="text-sm text-white/70 mt-1">{isEl ? "Κατέβασε το Sally's στο κινητό σου." : "Install Sally's on your phone."}</p>
            </div>
            <button id="installBtn" type="button" class="shrink-0 rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black text-xs font-bold px-4 py-2 transition hover:scale-[1.02]">
              {isEl ? "Εγκατάσταση" : "Install"}
            </button>
          </div>
        </div>
      </section>

      {!hasCard && (
        <div class="order-2 rounded-2xl border border-amber-400/40 bg-gradient-to-br from-amber-500/10 via-amber-400/5 to-transparent p-6 space-y-4">
          <div class="flex items-start gap-4">
            <div class="text-4xl">🎁</div>
            <div class="flex-1">
              <h2 class="text-lg font-bold text-amber-200">{isEl ? "Δημιουργήστε την Κάρτα Πιστότητάς σας" : "Get Your Loyalty Card"}</h2>
              <p class="text-sm text-white/70 mt-1">
                {isEl
                  ? "Συμπληρώστε τα στοιχεία σας για να ενεργοποιήσετε την κάρτα πιστότητας και να αρχίσετε να κερδίζετε πόντους, δώρα & εκπτώσεις."
                  : "Fill in your details to activate your loyalty card and start earning points, rewards & discounts."}
              </p>
            </div>
          </div>
          <button id="openCardFormBtn"
            class="w-full rounded-xl bg-amber-400 text-black px-4 py-3 text-sm font-semibold hover:bg-amber-300 transition">
            ✨ {isEl ? "Δημιουργία κάρτας τώρα" : "Create my card now"}
          </button>
        </div>
      )}

      <!-- Dashboard KPIs -->
      <section class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="rounded-2xl border border-amber-400/20 bg-amber-400/5 p-4">
          <p class="text-[10px] uppercase tracking-[0.2em] text-amber-300/70">{isEl ? "Πόντοι" : "Points"}</p>
          <p class="text-2xl font-bold text-amber-300 mt-1">{loyaltyBalance}</p>
        </div>
        <div class="rounded-2xl border p-4" style={`border-color:${tierBorder};background:${tierBg}`}>
          <p class="text-[10px] uppercase tracking-[0.2em]" style={`color:${tierColor}`}>{isEl ? "Επίπεδο" : "Tier"}</p>
          <p class="text-2xl font-bold mt-1" style={`color:${tierColor}`}>{tierIcon} {tierLabel}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-[10px] uppercase tracking-[0.2em] text-white/40">{isEl ? "Επισκέψεις" : "Visits"}</p>
          <p class="text-2xl font-bold text-white mt-1">{visitsCount ?? 0}</p>
        </div>
        <div class="rounded-2xl border border-fuchsia-400/20 bg-fuchsia-400/5 p-4">
          <p class="text-[10px] uppercase tracking-[0.2em] text-fuchsia-300/70">{isEl ? "Συστάσεις" : "Referred"}</p>
          <p class="text-2xl font-bold text-fuchsia-300 mt-1">{friendsReferredCount ?? 0} <span class="text-xs font-normal text-fuchsia-300/60">{isEl ? "φίλοι" : "friends"}</span></p>
        </div>
      </section>

      <!-- Quick actions -->
      <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <a href={withLangPrefix(lang, "/menu")}    class="flex flex-col items-center gap-2 rounded-2xl border border-white/10 bg-white/5 hover:bg-white/10 p-4 text-center transition group"><span class="text-2xl">📜</span><span class="text-xs font-semibold text-white/70 group-hover:text-amber-300">{isEl ? "Μενού" : "Menu"}</span></a>
        <a href={withLangPrefix(lang, "/book")}    class="flex flex-col items-center gap-2 rounded-2xl border border-white/10 bg-white/5 hover:bg-white/10 p-4 text-center transition group"><span class="text-2xl">📅</span><span class="text-xs font-semibold text-white/70 group-hover:text-amber-300">{isEl ? "Κράτηση" : "Book"}</span></a>
        <a href={withLangPrefix(lang, "/events")}  class="flex flex-col items-center gap-2 rounded-2xl border border-white/10 bg-white/5 hover:bg-white/10 p-4 text-center transition group"><span class="text-2xl">🎵</span><span class="text-xs font-semibold text-white/70 group-hover:text-amber-300">{isEl ? "Events" : "Events"}</span></a>
        <a href={withLangPrefix(lang, "/loyalty")} class="flex flex-col items-center gap-2 rounded-2xl border border-amber-400/30 bg-amber-400/10 hover:bg-amber-400/20 p-4 text-center transition group"><span class="text-2xl">🎁</span><span class="text-xs font-semibold text-amber-200">{isEl ? "Επιβραβεύσεις" : "Rewards"}</span></a>
      </section>

      <!-- Tasks -->
      <section class="rounded-2xl border border-white/10 bg-white/5 p-5">
        <div class="flex items-center justify-between gap-2 flex-wrap mb-2">
          <div>
            <p class="text-[10px] uppercase tracking-[0.24em] text-amber-300 font-bold">🎯 {isEl ? "Αποστολές σου" : "My Tasks"}</p>
            <h2 class="font-heading text-xl font-bold mt-1">{todosCompleted} / {TODOS.length} {isEl ? "ολοκληρωμένες" : "completed"} <span class="text-sm font-normal text-white/50">· {earnedTodoPoints} / {totalTodoPoints} pts</span></h2>
          </div>
          <div class="text-xs text-white/50">{isEl ? "Πάτα για διεκδίκηση" : "Tap to claim"}</div>
        </div>
        <div class="w-full h-1.5 rounded-full bg-white/5 overflow-hidden mb-4">
          <div class="h-full rounded-full bg-gradient-to-r from-amber-400 to-fuchsia-500" style={"width:" + Math.round((todosCompleted / TODOS.length) * 100) + "%"}></div>
        </div>

        {(["onboarding","achievement","social"] as const).map(cat => {
          const items = TODOS.filter(t => t.category === cat);
          const title = cat === "onboarding" ? (isEl ? "Ξεκίνημα" : "Onboarding")
                      : cat === "achievement" ? (isEl ? "Επιτεύγματα" : "Achievements")
                      : (isEl ? "Κοινωνικά" : "Social");
          return (
            <div class="mt-3">
              <p class="text-[10px] uppercase tracking-wider text-white/40 font-semibold mb-2 px-1">{title}</p>
              <div class="grid sm:grid-cols-2 gap-2">
                {items.map(t => {
                  const s = todoStateByKey.get(t.key);
                  const status = s?.status ?? "locked";
                  const pill = status === "completed" ? "bg-emerald-400/15 text-emerald-300"
                             : status === "available" ? "bg-amber-400/15 text-amber-300"
                             : "bg-white/5 text-white/40";
                  return (
                    <div class={`flex items-center gap-3 rounded-xl border p-3 ${status === "completed" ? "border-emerald-400/20 bg-emerald-400/5" : "border-white/10 bg-white/[0.03]"}`}
                         data-todo-key={t.key} data-todo-type={t.type} data-todo-link={t.link ?? ""}>
                      <div class="shrink-0 text-2xl">{t.emoji}</div>
                      <div class="min-w-0 flex-1">
                        <p class="text-sm font-semibold text-white truncate">{isEl ? t.title_el : t.title_en}</p>
                        <p class="text-xs text-white/50 truncate">{isEl ? t.desc_el : t.desc_en}</p>
                      </div>
                      <div class="shrink-0 text-right">
                        <span class={`text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full ${pill}`}>
                          {status === "completed" ? (isEl ? "✓ OK" : "✓ Done")
                           : status === "available" ? `+${t.points}`
                           : (isEl ? "Κλειδωμένο" : "Locked")}
                        </span>
                        {status === "available" && (
                          <button type="button" class="todo-claim-btn mt-1 block text-[11px] text-amber-300 hover:text-amber-200 font-semibold">
                            {isEl ? "Διεκδίκηση" : "Claim"}
                          </button>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </section>

      <!-- Invite friends (referrals) -->
      <section class="rounded-2xl border border-fuchsia-400/30 bg-gradient-to-br from-fuchsia-500/10 to-amber-400/10 p-5 relative overflow-hidden">
        <div class="absolute -top-10 -right-10 h-36 w-36 rounded-full bg-fuchsia-400/20 blur-3xl"></div>
        <div class="relative">
          <p class="text-[10px] uppercase tracking-[0.24em] text-fuchsia-300 font-bold">🤝 {isEl ? "Πρόσκαλεσε φίλους" : "Invite friends"}</p>
          <h2 class="font-heading text-2xl font-bold mt-1">
            {isEl ? "Κέρδισε πόντους & scratch cards" : "Earn points & scratch cards"}
          </h2>
          <p class="text-sm text-white/70 mt-2 leading-relaxed">
            {isEl
              ? "Στείλε αυτό το link. Μόλις γραφτεί ο φίλος σου, παίρνεις πόντους αυτόματα. Κάθε σύσταση μετράει."
              : "Share your link. The moment your friend signs up, points land in your account. Every referral counts."}
          </p>

          <div class="mt-4 flex items-center gap-2 rounded-xl border border-white/10 bg-black/30 p-2">
            <code id="refLink" class="flex-1 text-xs text-amber-200 font-mono truncate px-2">{referralLink}</code>
            <button id="copyRefBtn" type="button" class="shrink-0 rounded-lg bg-white/10 hover:bg-white/15 text-white text-xs font-semibold px-3 py-2 transition">📋 {isEl ? "Αντιγραφή" : "Copy"}</button>
          </div>

          <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2">
            <a id="shareWa" target="_blank" rel="noopener" class="rounded-lg bg-[#25d366]/15 hover:bg-[#25d366]/25 text-[#25d366] text-xs font-semibold px-3 py-2 text-center transition">💬 WhatsApp</a>
            <a id="shareTg" target="_blank" rel="noopener" class="rounded-lg bg-[#229ED9]/15 hover:bg-[#229ED9]/25 text-[#229ED9] text-xs font-semibold px-3 py-2 text-center transition">✈️ Telegram</a>
            <a id="shareEmail" class="rounded-lg bg-white/10 hover:bg-white/15 text-white text-xs font-semibold px-3 py-2 text-center transition">✉️ Email</a>
            <button id="shareNative" type="button" class="rounded-lg bg-amber-400 text-black text-xs font-bold px-3 py-2 transition hover:bg-amber-300">📤 {isEl ? "Κοινοποίηση" : "Share"}</button>
          </div>

          <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs text-white/60">
            <span>{isEl ? "Σύνολο συστάσεων" : "Total referrals"}: <strong class="text-fuchsia-200">{friendsReferredCount ?? 0}</strong></span>
            <span>{isEl ? "Πόντοι από συστάσεις" : "Points from referrals"}: <strong class="text-amber-200">{referralPoints}</strong></span>
          </div>
        </div>
      </section>

      <!-- Unrevealed scratch cards — interactive reveal -->
      {(unrevealedCards ?? []).length > 0 && (
        <section id="scratchSection" class="rounded-2xl border border-amber-400/30 bg-gradient-to-br from-amber-500/10 to-fuchsia-500/10 p-5">
          <div class="flex items-center justify-between gap-3 flex-wrap mb-4">
            <div>
              <p class="text-[10px] uppercase tracking-[0.24em] text-amber-300 font-bold">🎫 {isEl ? "Σε περιμένουν" : "Waiting for you"}</p>
              <h2 class="font-heading text-2xl font-bold mt-1">
                <span id="scratchCount">{(unrevealedCards ?? []).length}</span> {isEl ? "κάρτες" : "cards"}
              </h2>
              <p class="text-sm text-white/70 mt-1">{isEl ? "Πάτα για να αποκαλύψεις." : "Tap any card to reveal."}</p>
            </div>
          </div>
