                    <option value="+380">🇺🇦 +380</option>
                    <option value="+972">🇮🇱 +972</option>
                    <option value="+971">🇦🇪 +971</option>
                    <option value="+61">🇦🇺 +61</option>
                    <option value="+64">🇳🇿 +64</option>
                  </select>
                  <input name="phone_num" id="phoneNum" required type="tel" inputmode="tel" placeholder="69..."
                    class="flex-1 min-w-0 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" />
                </div>
                <div id="otpWrap" class="mt-2 flex items-stretch gap-2">
                  <button id="sendOtpBtn" type="button" class="rounded-xl border border-amber-400/40 bg-amber-400/10 text-amber-200 px-3 py-2 text-xs font-semibold hover:bg-amber-400/20 transition whitespace-nowrap">
                    {isEl ? "Αποστολή κωδικού SMS" : "Send SMS code"}
                  </button>
                  <input id="otpInput" type="text" inputmode="numeric" maxlength="6" placeholder="______" autocomplete="one-time-code"
                    class="hidden flex-1 min-w-0 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white font-mono tracking-widest text-center focus:outline-none focus:border-amber-400/50" />
                  <button id="verifyOtpBtn" type="button" class="hidden rounded-xl bg-amber-400 text-black px-3 py-2 text-xs font-bold hover:bg-amber-300 transition">
                    {isEl ? "Επαλήθευση" : "Verify"}
                  </button>
                  <span id="otpOk" class="hidden self-center text-xs font-semibold text-emerald-400">✓ {isEl ? "Επαληθεύτηκε" : "Verified"}</span>
                </div>
                <p id="otpMsg" class="mt-1 text-[11px] text-white/40"></p>
              </label>
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Ημ. Γέννησης" : "Date of birth"}</span>
                <input name="birthday" required type="date" value={profile?.birthday ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Φύλο" : "Gender"}</span>
                <select name="gender" required
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50">
                  <option value="">{isEl ? "Επιλέξτε…" : "Select…"}</option>
                  <option value="female" selected={profile?.gender === "female"}>{isEl ? "Γυναίκα" : "Female"}</option>
                  <option value="male"   selected={profile?.gender === "male"}>{isEl ? "Άνδρας" : "Male"}</option>
                  <option value="non_binary" selected={profile?.gender === "non_binary"}>{isEl ? "Μη δυαδικό" : "Non-binary"}</option>
                  <option value="prefer_not_to_say" selected={profile?.gender === "prefer_not_to_say"}>{isEl ? "Προτιμώ να μην απαντήσω" : "Prefer not to say"}</option>
                </select></label>
              <label class="block sm:col-span-2"><span class="text-xs text-white/50">{isEl ? "Διεύθυνση" : "Address"}</span>
                <input name="address" required minlength="2" maxlength="200" value={profile?.address ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Πόλη" : "City"}</span>
                <input name="city" required minlength="2" maxlength="80" value={profile?.city ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Τ.Κ." : "Postal code"}</span>
                <input name="postal_code" required minlength="2" maxlength="20" value={profile?.postal_code ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block sm:col-span-2"><span class="text-xs text-white/50">{isEl ? "Χώρα" : "Country"}</span>
                <select name="country" required
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50">
                  <option value="">{isEl ? "Επιλέξτε χώρα…" : "Select country…"}</option>
                  {COUNTRIES.map(c => (
                    <option value={isEl ? c.el : c.en} selected={profile?.country === (isEl ? c.el : c.en) || profile?.country === c.en || profile?.country === c.el}>
                      {isEl ? c.el : c.en}
                    </option>
                  ))}
                </select></label>
            </div>
            <label class="flex items-start gap-2 text-xs text-white/60">
              <input type="checkbox" name="marketing_consent" class="mt-0.5" />
              <span>{isEl ? "Θέλω να λαμβάνω προσφορές & εκπτώσεις από το Sally's Bar." : "I want to receive offers & discounts from Sally's Bar."}</span>
            </label>
            <p id="cardFormMsg" class="text-xs hidden"></p>
            <button type="submit" id="cardFormSubmit"
              class="w-full rounded-xl bg-amber-400 text-black px-4 py-3 text-sm font-semibold hover:bg-amber-300 transition disabled:opacity-40">
              ✨ {isEl ? "Ενεργοποίηση κάρτας" : "Activate my card"}
            </button>
          </form>
        </div>
      </div>
    )}

  <script is:inline>
    (function () {
      const isEl = document.documentElement.lang === "el";
      const link = document.getElementById("refLink")?.textContent?.trim() || "";
      const pitch = isEl
        ? `Γράψου στο Sally's Bar με το link μου και παίρνω μπόνους. Τσέκαρέ το: ${link}`
        : `Sign up to Sally's Bar through my link so I get bonus points — check it out: ${link}`;

      document.getElementById("copyRefBtn")?.addEventListener("click", async (e) => {
        try { await navigator.clipboard.writeText(link); const b = e.currentTarget; const orig = b.textContent; b.textContent = "✓"; setTimeout(() => b.textContent = orig, 1200); } catch {}
      });
      const wa = document.getElementById("shareWa");
      if (wa) wa.href = `https://wa.me/?text=${encodeURIComponent(pitch)}`;
      const tg = document.getElementById("shareTg");
      if (tg) tg.href = `https://t.me/share/url?url=${encodeURIComponent(link)}&text=${encodeURIComponent(pitch)}`;
      const em = document.getElementById("shareEmail");
      if (em) em.href = `mailto:?subject=${encodeURIComponent("Sally's Bar")}&body=${encodeURIComponent(pitch)}`;

      const nativeBtn = document.getElementById("shareNative");
      if (nativeBtn) {
        if (!navigator.share) nativeBtn.style.display = "none";
        else nativeBtn.addEventListener("click", async () => {
          try { await navigator.share({ title: "Sally's Bar", text: pitch, url: link }); } catch {}
        });
      }

      // Install card — programmatic install on Android/Chrome + iOS guidance otherwise
      const installCard = document.getElementById("installCard");
      const installBtn  = document.getElementById("installBtn");
      const installLabel = document.getElementById("installLabel");
      const isStandalone = window.matchMedia("(display-mode: standalone)").matches || window.navigator.standalone === true;
      const isIos = /iPhone|iPad|iPod/i.test(navigator.userAgent);
      let deferredInstall = null;

      window.addEventListener("beforeinstallprompt", (e) => {
        e.preventDefault();
        deferredInstall = e;
      });

      if (installCard && !isStandalone) {
        installCard.classList.remove("hidden");
        if (isIos && installLabel) {
          installLabel.innerHTML = isEl
            ? "Άνοιξε στο Safari → πάτα <strong>Κοινοποίηση ↗</strong> → <strong>Προσθήκη στην Οθόνη Αφετηρίας</strong>."
            : "Open in Safari → tap <strong>Share ↗</strong> → <strong>Add to Home Screen</strong>.";
          if (installBtn) installBtn.textContent = isEl ? "Οδηγίες" : "How";
        }
      }

      if (installBtn) {
        installBtn.addEventListener("click", async () => {
          if (deferredInstall) {
            deferredInstall.prompt();
            const r = await deferredInstall.userChoice;
            if (r.outcome === "accepted") installCard?.classList.add("hidden");
            deferredInstall = null;
            return;
          }
          // No prompt available → open the dedicated /app page for instructions.
          window.location.href = "/app";
        });
      }

      // Notifications
      const notifBtn = document.getElementById("notifToggle");
      const notifMsg = document.getElementById("notifMsg");
      function setNotifState() {
        if (!("Notification" in window) || !("serviceWorker" in navigator)) {
          notifBtn.textContent = isEl ? "Μη υποστηρίζεται" : "Not supported";
          notifBtn.disabled = true;
          return;
        }
        if (Notification.permission === "granted") {
          notifBtn.textContent = isEl ? "✓ Ενεργές" : "✓ Enabled";
          notifBtn.className = "shrink-0 rounded-xl bg-emerald-400/15 text-emerald-300 text-xs font-bold px-4 py-2";
          notifMsg.textContent = isEl ? "Θα λαμβάνεις ειδοποιήσεις για αποστολές και drops." : "You'll receive alerts for quests and drops.";
        } else if (Notification.permission === "denied") {
          notifBtn.textContent = isEl ? "Μπλοκαρισμένες" : "Blocked";
          notifBtn.disabled = true;
          notifMsg.textContent = isEl ? "Ενεργοποίησέ τις από τις ρυθμίσεις του browser." : "Re-enable in your browser settings.";
        } else {
          notifBtn.textContent = isEl ? "Ενεργοποίησε" : "Enable";
        }
      }
      setNotifState();

      async function urlB64ToUint8(b64) {
        const pad = "=".repeat((4 - (b64.length % 4)) % 4);
        const s = (b64 + pad).replace(/-/g, "+").replace(/_/g, "/");
        const raw = atob(s);
        const out = new Uint8Array(raw.length);
        for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
        return out;
      }

      // Task claim handler
      document.querySelectorAll(".todo-claim-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const row = btn.closest("[data-todo-key]");
          if (!row) return;
          const key  = row.dataset.todoKey;
          const type = row.dataset.todoType;
          const link = row.dataset.todoLink;

          // For honor tasks with a link, open it first so the user actually does the thing.
          if (type === "honor" && link) {
            window.open(link, "_blank", "noopener");
          }

          const payload = { key };
          // install_app needs client-side verification — check display-mode.
          if (key === "install_app") {
            payload.installed = window.matchMedia("(display-mode: standalone)").matches || window.navigator.standalone === true;
            if (!payload.installed) {
              alert(isEl ? "Εγκατάστησε την εφαρμογή πρώτα (➕ Προσθήκη στην αρχική οθόνη)." : "Install the app first (➕ Add to Home Screen).");
              return;
            }
          }

          btn.disabled = true;
          const prev = btn.textContent;
          btn.textContent = "⏳";
          const r = await fetch("/api/todos/claim", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const j = await r.json();
          if (r.ok) { window.location.reload(); }
          else { alert((isEl ? "Σφάλμα: " : "Error: ") + (j.error ?? "unknown")); btn.disabled = false; btn.textContent = prev; }
        });
      });

      // Inline scratch reveal (same animation as /loyalty)
      document.querySelectorAll(".scratch-card").forEach((card) => {
        card.addEventListener("click", async () => {
          if (card.dataset.done) return;
          card.dataset.done = "1";
          const id = card.dataset.id;
          const cover  = card.querySelector(".scratch-cover");
          const reveal = card.querySelector(".scratch-reveal");
          const label  = card.querySelector(".scratch-label");
          const emoji  = card.querySelector(".scratch-emoji");
          const meta   = card.querySelector(".scratch-meta");
          try {
            const res = await fetch("/api/loyalty/scratch-reveal", {
              method: "POST", headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id }),
            });
            const j = await res.json();
            if (!res.ok || !j.reward) {
              card.dataset.done = "";
              const msg = j.message
                || (j.error === "activate_card_first"   ? (isEl ? "Ενεργοποίησε πρώτα την κάρτα πιστότητας." : "Activate your loyalty card first.") :
                    j.error === "phone_already_claimed" ? (isEl ? "Αυτό το τηλέφωνο έχει ήδη χρησιμοποιηθεί." : "This phone number already claimed a signup bonus.") :
                    (isEl ? "Σφάλμα: " : "Error: ") + (j.error ?? "unknown"));
              alert(msg); return;
            }
            const r = j.reward;
            const emojiMap = { points: "🏆", free_shot: "🥃", free_drink: "🍸", discount: "💸", merch: "🎁", custom: "✨" };
            emoji.textContent = emojiMap[r.type] ?? "🎁";
            label.textContent = r.label;
            meta.textContent = r.auto_claimed
              ? (isEl ? "✓ προστέθηκε στο λογαριασμό σου" : "✓ added to your account")
              : (isEl ? "Δείξε στον σερβιτόρο" : "Show a waiter to claim");
            cover.style.transition = "opacity .35s, transform .35s";
            cover.style.opacity = "0";
            cover.style.transform = "scale(0.9)";
            reveal.style.transition = "opacity .4s .15s";
            reveal.style.opacity = "1";
          } catch { card.dataset.done = ""; alert(isEl ? "Σφάλμα δικτύου" : "Network error"); }
        });
      });

      // Welcome toast on fresh signup — auto-scrolls to scratch cards
      (function () {
        const qs = new URLSearchParams(window.location.search);
        if (!qs.has("signup")) return;

        // Strip the query param so reload doesn't re-show
        const clean = window.location.pathname + (window.location.hash || "");
        window.history.replaceState({}, "", clean);

        const hasScratch = document.querySelectorAll(".scratch-card").length > 0;
        const title = isEl ? "🎉 Καλωσήρθες!" : "🎉 Welcome!";
        const body  = hasScratch
          ? (isEl ? "Έχεις μια δωρεάν scratch card για να αποκαλύψεις." : "You have a free scratch card waiting to be revealed.")
          : (isEl ? "Ο λογαριασμός σου δημιουργήθηκε." : "Your account is ready.");

        const toast = document.createElement("div");
        toast.style.cssText = "position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-20px);z-index:9999;background:linear-gradient(135deg,#fbbf24,#f59e0b);color:#000;padding:14px 20px;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.5);max-width:90vw;text-align:center;opacity:0;transition:opacity .3s,transform .3s;font-weight:600;";
        toast.innerHTML = `<div style="font-size:14px;font-weight:800">${title}</div><div style="font-size:13px;margin-top:2px;opacity:.85">${body}</div>`;
        document.body.appendChild(toast);
        requestAnimationFrame(() => { toast.style.opacity = "1"; toast.style.transform = "translateX(-50%) translateY(0)"; });
        setTimeout(() => { toast.style.opacity = "0"; setTimeout(() => toast.remove(), 400); }, 4500);

        if (hasScratch) {
          setTimeout(() => {
            const target = document.getElementById("scratchSection");
            target?.scrollIntoView({ behavior: "smooth", block: "center" });
          }, 900);
        }
      })();

      notifBtn?.addEventListener("click", async () => {
        const perm = await Notification.requestPermission();
        if (perm !== "granted") { setNotifState(); return; }
        try {
          const reg = await navigator.serviceWorker.ready;
          const vapidPub = document.documentElement.dataset.vapid || "";
          if (!vapidPub) { notifMsg.textContent = "VAPID key missing"; return; }
          const sub = await reg.pushManager.getSubscription()
                   ?? await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: await urlB64ToUint8(vapidPub) });
          await fetch("/api/push/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(sub.toJSON()) });
          setNotifState();
        } catch (e) {
          notifMsg.textContent = isEl ? "Σφάλμα εγγραφής" : "Subscribe failed";
        }
      });
    })();
  </script>

  <script>
    import { createBrowserClient } from "@supabase/ssr";
    import QRCode from "qrcode";

    // ── Phone OTP verification for Loyalty Card activation ─────────────
    (function () {
      const isEl = document.documentElement.lang === "el";
      const sendBtn   = document.getElementById("sendOtpBtn");
      const verifyBtn = document.getElementById("verifyOtpBtn");
      const otpInput  = document.getElementById("otpInput") as HTMLInputElement | null;
      const okPill    = document.getElementById("otpOk");
      const msg       = document.getElementById("otpMsg");
      const ccEl      = document.getElementById("phoneCc") as HTMLSelectElement | null;
      const numEl     = document.getElementById("phoneNum") as HTMLInputElement | null;
      const submitBtn = document.getElementById("cardFormSubmit") as HTMLButtonElement | null;
      const form      = document.getElementById("cardForm") as HTMLFormElement | null;
      if (!sendBtn || !verifyBtn || !otpInput || !ccEl || !numEl || !submitBtn || !form) return;

      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
      );

      let verifiedPhone = "";

      function setMsg(text: string, ok = false) {
        if (!msg) return;
        msg.textContent = text;
        msg.className = `mt-1 text-[11px] ${ok ? "text-emerald-400" : "text-white/50"}`;
      }

      function currentPhone() {
        const cc = ccEl!.value;
        const num = numEl!.value.replace(/^0+/, "").replace(/\D/g, "");
        return `${cc}${num}`;
      }

      function lockSubmit() {
        submitBtn!.disabled = true;
        submitBtn!.title = isEl ? "Ολοκλήρωσε την επαλήθευση τηλεφώνου." : "Complete phone verification first.";
      }
      function unlockSubmit() {
        submitBtn!.disabled = false;
        submitBtn!.title = "";
      }
      lockSubmit();

      // If user edits phone after verifying → invalidate the state
      [ccEl, numEl].forEach(el => el.addEventListener("input", () => {
        if (verifiedPhone && currentPhone() !== verifiedPhone) {
          verifiedPhone = "";
          okPill!.classList.add("hidden");
          otpInput!.classList.add("hidden");
          verifyBtn!.classList.add("hidden");
          sendBtn!.classList.remove("hidden");
          sendBtn!.textContent = isEl ? "Αποστολή κωδικού SMS" : "Send SMS code";
          lockSubmit();
          setMsg(isEl ? "Το τηλέφωνο άλλαξε — επιβεβαίωσε ξανά." : "Phone changed — verify again.");
        }
      }));

      sendBtn.addEventListener("click", async () => {
        const phone = currentPhone();
        if (phone.replace(/\D/g, "").length < 8) { setMsg(isEl ? "Εισήγαγε έγκυρο τηλέφωνο." : "Enter a valid phone number."); return; }
        sendBtn.disabled = true;
        const orig = sendBtn.textContent;
        sendBtn.textContent = "⏳";
        setMsg(isEl ? "Αποστολή…" : "Sending…");

        const { error } = await supabase.auth.updateUser({ phone });
        sendBtn.disabled = false;
        sendBtn.textContent = orig!;
        if (error) {
          setMsg((isEl ? "Σφάλμα: " : "Error: ") + error.message);
          return;
        }
        // Hide Send, show OTP input + Verify
        sendBtn.classList.add("hidden");
        otpInput.classList.remove("hidden");
        verifyBtn.classList.remove("hidden");
        setMsg(isEl ? `Στείλαμε 6ψήφιο κωδικό στο ${phone}.` : `We sent a 6-digit code to ${phone}.`, true);
        setTimeout(() => otpInput.focus(), 50);
      });

      verifyBtn.addEventListener("click", async () => {
        const token = otpInput.value.replace(/\D/g, "").slice(0, 6);
        if (token.length !== 6) { setMsg(isEl ? "Εισήγαγε 6ψήφιο κωδικό." : "Enter the 6-digit code."); return; }
        const phone = currentPhone();
        verifyBtn.disabled = true;
        const orig = verifyBtn.textContent;
        verifyBtn.textContent = "⏳";
        // `phone_change` is the OTP type used when phone is attached to an existing session via updateUser
        const { error } = await supabase.auth.verifyOtp({ phone, token, type: "phone_change" });
        verifyBtn.disabled = false;
        verifyBtn.textContent = orig!;
        if (error) {
          setMsg((isEl ? "Λάθος κωδικός: " : "Wrong code: ") + error.message);
          return;
        }
        verifiedPhone = phone;
        otpInput.classList.add("hidden");
        verifyBtn.classList.add("hidden");
        okPill!.classList.remove("hidden");
        setMsg(isEl ? "Επαληθεύτηκε. Μπορείς να ολοκληρώσεις την ενεργοποίηση." : "Verified. You can activate your card.", true);
        unlockSubmit();
      });
    })();
    const loyaltyCanvas = document.getElementById("loyaltyQr") as HTMLCanvasElement | null;
    const loyaltyCode = (loyaltyCanvas?.dataset.code) || "";
    if (loyaltyCanvas && loyaltyCode) {
      QRCode.toCanvas(loyaltyCanvas, loyaltyCode, {
        width: 140,
        margin: 1,
        color: { dark: "#0a0a0f", light: "#ffffff" },
      }).catch((e) => console.error("loyalty qr failed", e));
    }
    const isEl = document.documentElement.lang === "el";

    // Pending referral claim (for users who signed up via ?ref=… and confirmed via email)
    try {
      const pendingRef = localStorage.getItem("pending_ref");
      if (pendingRef) {
        fetch("/api/loyalty/claim-referral", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ referrer_id: pendingRef }),
        }).finally(() => localStorage.removeItem("pending_ref"));
      }
    } catch {}

    // Pending signup bonus (scratch card) for users confirming via email flow
    try {
      if (localStorage.getItem("pending_signup_bonus")) {
        fetch("/api/loyalty/claim-signup-bonus", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" })
          .finally(() => localStorage.removeItem("pending_signup_bonus"));
      }
    } catch {}

    // Profile update
    const profileForm = document.getElementById("profileForm") as HTMLFormElement | null;
    profileForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = document.getElementById("profileMsg")!;
      const btn = profileForm.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      msg.className = "text-xs hidden";
      const bdEl = document.getElementById("fBirthday") as HTMLInputElement;
      const payload: Record<string, unknown> = {
        full_name: (document.getElementById("fName") as HTMLInputElement).value,
      };
      if (bdEl && bdEl.dataset.locked !== "1") {
        payload.birthday = bdEl.value || null;
      }
      const res = await fetch("/api/account/update", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        msg.textContent = isEl ? "✓ Αποθηκεύτηκε." : "✓ Saved.";
        msg.className = "text-xs text-green-400 block";
      } else {
        const j = await res.json().catch(() => ({}));
        msg.textContent = j.error ?? (isEl ? "Σφάλμα." : "Error.");
        msg.className = "text-xs text-red-400 block";
      }
      btn.disabled = false;
    });

    // Delete account
    document.getElementById("deleteAccountBtn")?.addEventListener("click", async () => {
      const email = prompt(isEl
        ? "Για επιβεβαίωση διαγραφής, πληκτρολόγησε το email σου:"
        : "To confirm deletion, type your email:");
      if (!email) return;
      if (!confirm(isEl ? "Όλα τα δεδομένα σου θα διαγραφούν οριστικά. Σίγουρα;" : "All your data will be permanently deleted. Are you sure?")) return;
      const res = await fetch("/api/account/delete", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ confirm_email: email }),
      });
      if (res.ok) {
        alert(isEl ? "Ο λογαριασμός διαγράφηκε." : "Account deleted.");
        window.location.href = "/";
      } else {
        const j = await res.json().catch(() => ({}));
        alert(j.error === "confirm_mismatch"
          ? (isEl ? "Το email δεν ταιριάζει." : "Email doesn't match.")
          : (isEl ? "Σφάλμα. Δοκίμασε ξανά." : "Error. Try again."));
      }
    });

    // Wallet buttons
    document.getElementById("appleWalletBtn")?.addEventListener("click", async () => {
      const res = await fetch("/api/wallet/apple-pass", { method: "POST" });
      if (res.ok) {
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url; a.download = "sallys-loyalty.pkpass"; a.click();
        URL.revokeObjectURL(url);
      } else {
        const j = await res.json().catch(() => ({}));
        alert(j.fallback ?? j.message ?? (isEl ? "Δεν είναι διαθέσιμο." : "Not available yet."));
      }
    });

    const gwBtn = document.getElementById("googleWalletBtn") as HTMLButtonElement | null;
    gwBtn?.addEventListener("click", async () => {
      const orig = gwBtn.innerHTML;
      gwBtn.disabled = true;
      gwBtn.innerHTML = "⏳ " + (isEl ? "Φόρτωση…" : "Loading…");
      try {
        const res = await fetch("/api/wallet/google-pass", { method: "POST" });
        const j = await res.json().catch(() => ({}));
        if (res.ok && j.saveUrl) {
          // Open in same tab on mobile (Wallet handoff), new tab on desktop
          const isMobile = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);
          if (isMobile) window.location.href = j.saveUrl;
          else window.open(j.saveUrl, "_blank", "noopener");
        } else {
          alert(j.message ?? (isEl ? "Δεν είναι διαθέσιμο ακόμα." : "Not available yet."));
        }
      } catch {
        alert(isEl ? "Σφάλμα δικτύου" : "Network error");
      } finally {
        gwBtn.disabled = false;
        gwBtn.innerHTML = orig;
      }
    });

    // Redeem buttons
    document.querySelectorAll<HTMLButtonElement>(".redeem-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        const cost = btn.dataset.cost;
        const msg = isEl ? `Εξαργύρωση ${cost} πόντων;` : `Redeem ${cost} points?`;
        if (!confirm(msg)) return;
        btn.disabled = true;
        btn.textContent = "…";
        const res = await fetch("/api/loyalty/redeem", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reward_id: btn.dataset.rewardId }),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) {
          alert(j.error === "insufficient_points"
            ? (isEl ? "Δεν έχεις αρκετούς πόντους." : "Not enough points.")
            : (isEl ? "Σφάλμα. Δοκίμασε ξανά." : "Error. Try again."));
          btn.disabled = false;
          btn.textContent = `${cost} ${isEl ? "πόντοι" : "pts"}`;
          return;
        }
        alert(isEl ? `✓ Κωδικός: ${j.code}\nΔείξε τον στον σερβιτόρο.` : `✓ Code: ${j.code}\nShow this to your waiter.`);
        location.reload();
      });
    });

    document.getElementById("resList")?.addEventListener("click", async (e) => {
      const btn = (e.target as Element).closest(".cancel-res-btn") as HTMLElement | null;
      if (!btn) return;

      const confirmMsg = isEl ? "Ακύρωση κράτησης;" : "Cancel this reservation?";
      if (!confirm(confirmMsg)) return;

      const id  = btn.dataset.id!;
      const row = btn.closest("[data-res-id]") as HTMLElement | null;

      btn.disabled = true;
      btn.textContent = "…";

      const res = await fetch("/api/reservations/cancel", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id }),
      });

      if (!res.ok) {
        alert(isEl ? "Σφάλμα. Δοκιμάστε ξανά." : "Error. Please try again.");
        btn.disabled = false;
        btn.textContent = isEl ? "Ακύρωση" : "Cancel";
        return;
      }

      // Update badge colour + label, remove cancel button
      const badge = row?.querySelector(".res-badge") as HTMLElement | null;
      if (badge) {
        badge.textContent = isEl ? "Ακυρωμένη" : "Cancelled";
        badge.style.background = "#f8717122";
        badge.style.color = "#f87171";
      }
      btn.remove();
    });

    // Loyalty card activation modal
    const openCardBtn = document.getElementById("openCardFormBtn");
    const cardModal   = document.getElementById("cardFormModal");
    const closeCardBtn= document.getElementById("closeCardFormBtn");
    const cardForm    = document.getElementById("cardForm") as HTMLFormElement | null;
    function openCardModal() { cardModal?.classList.remove("hidden"); cardModal?.classList.add("flex"); }
    function closeCardModal(){ cardModal?.classList.add("hidden"); cardModal?.classList.remove("flex"); }
    openCardBtn?.addEventListener("click", openCardModal);
    closeCardBtn?.addEventListener("click", closeCardModal);
    cardModal?.addEventListener("click", (e) => { if (e.target === cardModal) closeCardModal(); });
    // Prefill phone split if existing value starts with + and matches a known code
    const ccEl = document.getElementById("phoneCc") as HTMLSelectElement | null;
    const numEl = document.getElementById("phoneNum") as HTMLInputElement | null;
    if (ccEl && numEl && cardForm) {
      const rawPhone = (cardForm.dataset.phone ?? "").trim();
      if (rawPhone.startsWith("+")) {
        const options = Array.from(ccEl.options).map(o => o.value).sort((a, b) => b.length - a.length);
        const hit = options.find(v => rawPhone.startsWith(v));
        if (hit) { ccEl.value = hit; numEl.value = rawPhone.slice(hit.length).trim(); }
      } else if (rawPhone) {
        numEl.value = rawPhone;
      }
    }

    cardForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(cardForm);
      const payload = Object.fromEntries(fd.entries()) as Record<string, unknown>;
      payload.marketing_consent = fd.get("marketing_consent") === "on";
      const cc = String(fd.get("phone_cc") ?? "");
      const num = String(fd.get("phone_num") ?? "").replace(/^0+/, "").trim();
      payload.phone = `${cc}${num}`;
      delete payload.phone_cc; delete payload.phone_num;
      const submitBtn = document.getElementById("cardFormSubmit") as HTMLButtonElement;
      const msg = document.getElementById("cardFormMsg")!;
      submitBtn.disabled = true;
      msg.className = "text-xs hidden";
      const res = await fetch("/api/account/create-card", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        msg.textContent = isEl ? "✓ Ενεργοποιήθηκε! Φόρτωση κάρτας…" : "✓ Activated! Loading your card…";
        msg.className = "text-xs text-green-400 block";
        setTimeout(() => window.location.reload(), 800);
      } else {
        const j = await res.json().catch(() => ({}));
        msg.textContent = (isEl ? "Σφάλμα: " : "Error: ") + (j.error ?? "unknown");
        msg.className = "text-xs text-red-400 block";
        submitBtn.disabled = false;
      }
    });
  </script>

  </body>
</html>
