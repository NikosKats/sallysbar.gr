---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { createSupabaseServerClient, supabaseAdmin } from "../lib/supabase";
import { withLangPrefix, dict } from "../i18n";
import { getTiers, getRewards, currentTier, nextTier } from "../lib/loyalty";

const user = Astro.locals.user;
const lang = Astro.locals.lang ?? "en";
if (!user) return Astro.redirect(withLangPrefix(lang, "/login") + "?next=/account");

const t    = dict[lang];
const ta   = t.account;
const isEl = lang === "el";

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: profile } = await supabase
  .from("profiles")
  .select("full_name, role, created_at, birthday, birthday_updated_at, card_issued_at, phone, country, gender, address, city, postal_code")
  .eq("id", user.id)
  .single();

const displayName = profile?.full_name ?? user.user_metadata?.full_name ?? user.email?.split("@")[0] ?? "Guest";
const memberSince = profile?.created_at
  ? new Date(profile.created_at).toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "numeric", month: "long", year: "numeric" })
  : "—";

// Fetch upcoming reservations (today and future)
const todayIso = new Date().toISOString().slice(0, 10);
const { data: reservations } = await supabaseAdmin
  .from("reservations")
  .select("id, date, time, party_size, status, notes")
  .eq("user_id", user.id)
  .gte("date", todayIso)
  .order("date", { ascending: true })
  .order("time", { ascending: true })
  .limit(10);

// Fetch upcoming event RSVPs
const { data: eventRsvps } = await supabaseAdmin
  .from("event_rsvps")
  .select("id, guests, events(id, title, title_el, event_date, event_time)")
  .eq("user_id", user.id)
  .eq("status", "confirmed")
  .order("created_at", { ascending: false })
  .limit(10);

const upcomingRsvps = (eventRsvps ?? []).filter(r => {
  const ev = r.events as any;
  return ev && ev.event_date >= todayIso;
}).sort((a, b) => {
  const da = (a.events as any)?.event_date ?? "";
  const db = (b.events as any)?.event_date ?? "";
  return da < db ? -1 : 1;
});

// Fetch loyalty points balance and recent history
const { data: loyaltyEvents } = await supabaseAdmin
  .from("loyalty_events")
  .select("id, points, reason, created_at")
  .eq("user_id", user.id)
  .order("created_at", { ascending: false })
  .limit(20);

const loyaltyBalance = (loyaltyEvents ?? []).reduce((s, e) => s + e.points, 0);
const hasCard = !!profile?.card_issued_at;

// Dynamic tier logic (configurable from admin)
const tiers     = await getTiers();
const rewards   = await getRewards(true);
const tierRow   = currentTier(tiers, loyaltyBalance);
const nextRow   = nextTier(tiers, loyaltyBalance);
const tierLabel = tierRow ? (isEl ? tierRow.label_el : tierRow.label_en) : "—";
const tierPerk  = tierRow ? (isEl ? tierRow.perk_el  : tierRow.perk_en)  : "";
const tierColor = tierRow?.color ?? "#94a3b8";
const tierIcon  = tierRow?.icon  ?? "";
const tierBg    = `${tierColor}1f`;
const tierBorder= `${tierColor}4d`;
const tierMin   = tierRow?.threshold ?? 0;
const tierNextAt= nextRow?.threshold ?? null;
const nextLabel = nextRow ? (isEl ? nextRow.label_el : nextRow.label_en) : "";
const tierProgress = tierNextAt
  ? Math.min(100, Math.round(((loyaltyBalance - tierMin) / (tierNextAt - tierMin)) * 100))
  : 100;
const ptsToNext = tierNextAt ? tierNextAt - loyaltyBalance : 0;

// Active (pending) redemptions
const { data: activeRedemptions } = await supabaseAdmin
  .from("loyalty_redemptions")
  .select("id, code, cost, status, created_at, loyalty_rewards(name_en, name_el)")
  .eq("user_id", user.id)
  .eq("status", "pending")
  .order("created_at", { ascending: false });

function fmtDate(d: string) {
  return new Date(d + "T00:00:00").toLocaleDateString(isEl ? "el-GR" : "en-GB", {
    weekday: "short", day: "numeric", month: "short",
  });
}

function statusColor(s: string) {
  return s === "confirmed" ? "#4ade80" : s === "cancelled" ? "#f87171" : "#fbbf24";
}

function statusLabel(s: string) {
  return (ta as any)["status" + s.charAt(0).toUpperCase() + s.slice(1)] ?? s;
}
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ta.title} — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <Header />

    <main class="mx-auto max-w-3xl px-4 pt-28 pb-10 space-y-6">

      <!-- Welcome -->
      <div>
        <h1 class="text-2xl font-bold text-white">Hi, {displayName}</h1>
        <p class="mt-1 text-sm text-white/40">{ta.subtitle}</p>
      </div>

      <!-- Profile card (editable) -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 space-y-4">
        <h2 class="text-sm font-semibold text-white/50 uppercase tracking-widest">{ta.profileSection}</h2>
        <form id="profileForm" class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="text-xs text-white/30 mb-1 block">{ta.name}</label>
            <input id="fName" type="text" value={profile?.full_name ?? ""} maxlength="120"
              class="w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" />
          </div>
          <div>
            <label class="text-xs text-white/30 mb-1 block">{ta.email}</label>
            <input type="email" value={user.email} disabled
              class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-white/60 cursor-not-allowed" />
          </div>
          {(() => {
            const THIRTY = 30 * 24 * 60 * 60 * 1000;
            const lastAt = profile?.birthday_updated_at ? new Date(profile.birthday_updated_at).getTime() : 0;
            const locked = lastAt > 0 && (Date.now() - lastAt) < THIRTY;
            const unlockAt = locked ? new Date(lastAt + THIRTY) : null;
            const unlockStr = unlockAt ? unlockAt.toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "2-digit", year: "numeric" }) : "";
            const bdStr = profile?.birthday
              ? new Date(profile.birthday + "T00:00:00").toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "2-digit", year: "numeric" })
              : "—";
            return (
              <div>
                <label class="text-xs text-white/30 mb-1 block">{isEl ? "Γενέθλια (ηη/μμ/εεεε)" : "Birthday (dd/mm/yyyy)"}</label>
                {locked ? (
                  <>
                    <input type="text" value={bdStr} disabled
                      class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-white/60 cursor-not-allowed" />
                    <input id="fBirthday" type="hidden" value={profile?.birthday ?? ""} data-locked="1" />
                    <p class="text-xs text-amber-200/70 mt-1">
                      {isEl
                        ? `Κλείδωμα για προστασία πόντων. Επόμενη αλλαγή: ${unlockStr}.`
                        : `Locked to protect rewards. Next change: ${unlockStr}.`}
                    </p>
                  </>
                ) : (
                  <>
                    <input id="fBirthday" type="date" value={profile?.birthday ?? ""}
                      class="w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" />
                    <p class="text-xs text-white/25 mt-1">
                      {isEl
                        ? "Για μπόνους μήνα γενεθλίων. Αλλαγή επιτρέπεται κάθε 30 ημέρες."
                        : "For birthday-month bonus points. Editable once every 30 days."}
                    </p>
                  </>
                )}
              </div>
            );
          })()}
          <div>
            <label class="text-xs text-white/30 mb-1 block">{ta.accountType}</label>
            <input type="text" value={profile?.role ?? "customer"} disabled
              class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-white/60 capitalize cursor-not-allowed" />
          </div>
          <div class="sm:col-span-2 flex items-center gap-3">
            <button type="submit" class="px-4 py-2 rounded-xl bg-amber-400 text-black text-sm font-semibold hover:bg-amber-300 transition disabled:opacity-40">
              {isEl ? "Αποθήκευση" : "Save"}
            </button>
            <p id="profileMsg" class="text-xs hidden"></p>
          </div>
        </form>
        <div class="pt-4 border-t border-white/10 flex flex-wrap items-center gap-4">
          <p class="text-xs text-white/40">{ta.memberSince}: <span class="text-white/70">{memberSince}</span></p>
          <a href="/forgot-password" class="text-sm text-white/50 hover:text-white transition underline underline-offset-2">
            {ta.changePassword}
          </a>
          <button id="deleteAccountBtn" class="ml-auto text-xs text-red-400/70 hover:text-red-400 underline underline-offset-2">
            {isEl ? "Διαγραφή λογαριασμού" : "Delete account"}
          </button>
        </div>
      </div>

      {!hasCard && (
        <div class="rounded-2xl border border-amber-400/40 bg-gradient-to-br from-amber-500/10 via-amber-400/5 to-transparent p-6 space-y-4">
          <div class="flex items-start gap-4">
            <div class="text-4xl">🎁</div>
            <div class="flex-1">
              <h2 class="text-lg font-bold text-amber-200">{isEl ? "Δημιουργήστε την Κάρτα Πιστότητάς σας" : "Get Your Loyalty Card"}</h2>
              <p class="text-sm text-white/70 mt-1">
                {isEl
                  ? "Συμπληρώστε τα στοιχεία σας για να ενεργοποιήσετε την κάρτα πιστότητας και να αρχίσετε να κερδίζετε πόντους, δώρα & εκπτώσεις."
                  : "Fill in your details to activate your loyalty card and start earning points, rewards & discounts."}
              </p>
            </div>
          </div>
          <button id="openCardFormBtn"
            class="w-full rounded-xl bg-amber-400 text-black px-4 py-3 text-sm font-semibold hover:bg-amber-300 transition">
            ✨ {isEl ? "Δημιουργία κάρτας τώρα" : "Create my card now"}
          </button>
        </div>
      )}

      <!-- Loyalty Points -->
      {hasCard && (
      <div class="rounded-2xl border bg-white/5 p-6 space-y-4" style={`border-color:${tierBorder}`}>
        <!-- Header row: section label + balance -->
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold text-white/50 uppercase tracking-widest">{ta.loyaltySection}</h2>
          <div class="flex items-baseline gap-1.5">
            <span class="text-2xl font-bold" style={`color:${tierColor}`}>{loyaltyBalance}</span>
            <span class="text-xs text-white/40">{ta.loyaltyPoints}</span>
          </div>
        </div>

        <!-- Loyalty Card QR -->
        <div class="rounded-xl bg-white p-4 flex items-center gap-4">
          <canvas id="loyaltyQr" width="140" height="140" class="shrink-0" data-code={`loyalty:${user.id}`}></canvas>
          <div class="min-w-0">
            <p class="text-xs uppercase tracking-wider text-neutral-500">{isEl ? "Κάρτα Πιστότητας" : "Loyalty Card"}</p>
            <p class="text-base font-bold text-neutral-900 truncate">{displayName}</p>
            <p class="text-xs text-neutral-600 mt-1">{isEl ? "Δείξε τον κωδικό στον σερβιτόρο για να κερδίσεις πόντους." : "Show this code to the waiter to earn points."}</p>
          </div>
        </div>

        <!-- Wallet buttons -->
        <div class="grid grid-cols-2 gap-2">
          <button id="appleWalletBtn" class="flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-black px-3 py-2.5 text-xs text-white hover:bg-white/5 transition">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 12.5c0-2.5 2-3.7 2.1-3.8-1.1-1.6-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.6.9-.7 0-1.9-.9-3.1-.9-1.6 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2-.1 1.6-.8 3-.8s1.8.8 3 .8c1.2 0 2-1.1 2.8-2.3.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.3-.9-2.3-3.2M14.8 5.3c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.7-1.3"/></svg>
            {isEl ? "Apple Wallet" : "Add to Apple Wallet"}
          </button>
          <button id="googleWalletBtn" class="flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 px-3 py-2.5 text-xs text-white hover:bg-white/10 transition">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.5"/></svg>
            {isEl ? "Google Wallet" : "Save to Google Wallet"}
          </button>
        </div>

        <!-- Tier badge + progress -->
        <div class="space-y-2">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <span
              class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full"
              style={`background:${tierBg};color:${tierColor};border:1px solid ${tierBorder}`}
            >
              {tierIcon}
              {tierLabel}
            </span>
            <span class="text-xs text-white/30">
              {tierNextAt ? `${ptsToNext} ${ta.tierProgressLabel} ${nextLabel}` : ta.tierMaxLabel}
            </span>
          </div>
          {tierPerk && <p class="text-xs italic text-white/50">“{tierPerk}”</p>}
          <!-- Progress bar -->
          <div class="h-1.5 rounded-full bg-white/10 overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width:${tierProgress}%;background:${tierColor}`}></div>
          </div>
          <p class="text-xs text-white/25">{ta.loyaltyEarnHint}</p>
        </div>

        <!-- Active redemptions -->
        {activeRedemptions && activeRedemptions.length > 0 && (
          <div class="space-y-2 pt-1 border-t border-white/8">
            <p class="text-xs font-semibold text-white/50 uppercase tracking-wider">{isEl ? "Ενεργοί κωδικοί εξαργύρωσης" : "Active redemption codes"}</p>
            {activeRedemptions.map((r: any) => (
              <div class="flex items-center justify-between gap-3 rounded-xl border border-amber-400/30 bg-amber-400/5 px-3 py-2">
                <div class="min-w-0">
                  <p class="text-sm text-white font-medium truncate">{isEl ? r.loyalty_rewards?.name_el : r.loyalty_rewards?.name_en}</p>
                  <p class="text-xs text-white/40">{isEl ? "Δείξε στον σερβιτόρο" : "Show to your waiter"}</p>
                </div>
                <code class="text-base font-bold tracking-widest text-amber-400">{r.code}</code>
              </div>
            ))}
          </div>
        )}

        <!-- Rewards catalog -->
        {rewards.length > 0 && (
          <div class="space-y-2 pt-1 border-t border-white/8">
            <p class="text-xs font-semibold text-white/50 uppercase tracking-wider">{isEl ? "Εξαργύρωση πόντων" : "Redeem points"}</p>
            <div class="space-y-1.5">
              {rewards.map(rw => {
                const canAfford = loyaltyBalance >= rw.cost;
                const name = isEl ? rw.name_el : rw.name_en;
                const desc = isEl ? rw.description_el : rw.description_en;
                return (
                  <div class="flex items-center justify-between gap-3 rounded-xl border border-white/8 bg-white/[0.03] px-3 py-2">
                    <div class="min-w-0">
                      <p class="text-sm text-white font-medium truncate">{name}</p>
                      {desc && <p class="text-xs text-white/40 truncate">{desc}</p>}
                    </div>
                    <button
                      class="redeem-btn shrink-0 text-xs px-3 py-1.5 rounded-lg font-semibold transition disabled:opacity-40 disabled:cursor-not-allowed"
                      style={canAfford ? "background:#f59e0b;color:#000" : "background:rgba(255,255,255,.06);color:rgba(255,255,255,.4);border:1px solid rgba(255,255,255,.1)"}
                      data-reward-id={rw.id}
                      data-cost={rw.cost}
                      disabled={!canAfford}
                    >
                      {rw.cost} {isEl ? "πόντοι" : "pts"}
                    </button>
                  </div>
                );
              })}
            </div>
            <p class="text-xs text-white/25">{isEl ? "Μετά την εξαργύρωση, δείξε τον κωδικό στον σερβιτόρο." : "After redeeming, show the code to your waiter."}</p>
          </div>
        )}

        <!-- History -->
        {loyaltyEvents && loyaltyEvents.length > 0 ? (
          <div class="space-y-1 pt-1 border-t border-white/8">
            {loyaltyEvents.map(ev => (
              <div class="flex items-center justify-between py-1.5 border-b border-white/5 last:border-0">
                <div>
                  <p class="text-sm text-white/70">{ev.reason}</p>
                  <p class="text-xs text-white/30">
                    {new Date(ev.created_at).toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "numeric", month: "short", year: "numeric" })}
                  </p>
                </div>
                <span class={`text-sm font-bold ${ev.points >= 0 ? "text-green-400" : "text-red-400"}`}>
                  {ev.points >= 0 ? "+" : ""}{ev.points}
                </span>
              </div>
            ))}
          </div>
        ) : (
          <div class="space-y-1 pt-1 border-t border-white/8">
            <p class="text-sm text-white/40">{ta.loyaltyNoHistory}</p>
            <p class="text-xs text-white/25">{ta.loyaltyEarn}</p>
          </div>
        )}
      </div>
      )}

      <!-- Reservations -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-white/50 uppercase tracking-widest">{ta.reservationsSection}</h2>
          <a href={withLangPrefix(lang, "/book")} class="text-xs text-amber-400 hover:text-amber-300 transition">
            {ta.bookNow}
          </a>
        </div>

        {reservations && reservations.length > 0 ? (
          <div class="space-y-2" id="resList">
            {reservations.map(r => (
              <div class="flex items-center justify-between gap-3 rounded-xl border border-white/8 bg-white/[0.03] px-4 py-3" data-res-id={r.id}>
                <div class="min-w-0">
                  <p class="text-sm font-medium text-white">{fmtDate(r.date)}</p>
                  <p class="text-xs text-white/40">{r.time} &bull; {r.party_size} {isEl ? "άτομα" : "guests"}</p>
                  {r.notes && <p class="text-xs text-white/25 mt-0.5 truncate max-w-xs">{r.notes}</p>}
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="res-badge text-xs font-semibold px-2 py-0.5 rounded-full"
                    style={`background:${statusColor(r.status)}22;color:${statusColor(r.status)}`}>
                    {statusLabel(r.status)}
                  </span>
                  {r.status !== "cancelled" && (
                    <button
                      class="cancel-res-btn text-xs text-white/25 hover:text-red-400 transition px-2 py-0.5 rounded-lg border border-transparent hover:border-red-400/20"
                      data-id={r.id}
                    >
                      {isEl ? "Ακύρωση" : "Cancel"}
                    </button>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="space-y-2">
            <p class="text-sm text-white/40">{ta.noReservations}</p>
            <a href={withLangPrefix(lang, "/book")} class="inline-block text-sm text-amber-400 hover:text-amber-300 transition underline underline-offset-2">
              {ta.bookNow}
            </a>
          </div>
        )}
      </div>

      <!-- Events RSVPs -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-white/50 uppercase tracking-widest">{ta.eventsSection}</h2>
          <a href={withLangPrefix(lang, "/events")} class="text-xs text-amber-400 hover:text-amber-300 transition">
            {isEl ? "Όλα τα events →" : "All events →"}
          </a>
        </div>

        {upcomingRsvps.length > 0 ? (
          <div class="space-y-2">
            {upcomingRsvps.map(r => {
              const ev = r.events as any;
              const title = isEl && ev.title_el ? ev.title_el : ev.title;
              const dateStr = new Date(ev.event_date + "T00:00:00").toLocaleDateString(isEl ? "el-GR" : "en-GB", { weekday: "short", day: "numeric", month: "short" });
              return (
                <div class="flex items-center justify-between gap-3 rounded-xl border border-white/8 bg-white/[0.03] px-4 py-3">
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-white truncate">{title}</p>
                    <p class="text-xs text-white/40">
                      {dateStr}{ev.event_time ? ` · ${ev.event_time.slice(0, 5)}` : ""}
                      {" · "}{r.guests} {isEl ? (r.guests === 1 ? "άτομο" : "άτομα") : (r.guests === 1 ? "guest" : "guests")}
                    </p>
                  </div>
                  <span class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full bg-green-400/10 text-green-400 border border-green-400/20">
                    {isEl ? "Επιβεβαιωμένο" : "Confirmed"}
                  </span>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="space-y-1">
            <p class="text-sm text-white/40">{ta.noReservations.replace("reservations", "event RSVPs") || (isEl ? "Δεν έχεις κρατήσεις για events." : "No upcoming event RSVPs.")}</p>
            <a href={withLangPrefix(lang, "/events")} class="inline-block text-sm text-amber-400 hover:text-amber-300 transition underline underline-offset-2">
              {isEl ? "Δες τα upcoming events →" : "Browse upcoming events →"}
            </a>
          </div>
        )}
      </div>

    </main>

    {!hasCard && (
      <div id="cardFormModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="relative w-full max-w-lg my-8 rounded-2xl border border-white/10 bg-[#141420] p-6 space-y-4">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-bold text-amber-200">{isEl ? "Ενεργοποίηση Κάρτας Πιστότητας" : "Activate Loyalty Card"}</h3>
              <p class="text-xs text-white/50 mt-1">{isEl ? "Όλα τα πεδία είναι υποχρεωτικά." : "All fields are required."}</p>
            </div>
            <button id="closeCardFormBtn" class="text-white/40 hover:text-white text-2xl leading-none">×</button>
          </div>

          <form id="cardForm" class="space-y-3">
            <div class="grid sm:grid-cols-2 gap-3">
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Ονοματεπώνυμο" : "Full name"}</span>
                <input name="full_name" required minlength="2" maxlength="120" value={profile?.full_name ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Τηλέφωνο" : "Phone"}</span>
                <input name="phone" required type="tel" placeholder="+30 69..." value={profile?.phone ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Ημ. Γέννησης" : "Date of birth"}</span>
                <input name="birthday" required type="date" value={profile?.birthday ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Φύλο" : "Gender"}</span>
                <select name="gender" required
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50">
                  <option value="">{isEl ? "Επιλέξτε…" : "Select…"}</option>
                  <option value="female" selected={profile?.gender === "female"}>{isEl ? "Γυναίκα" : "Female"}</option>
                  <option value="male"   selected={profile?.gender === "male"}>{isEl ? "Άνδρας" : "Male"}</option>
                  <option value="non_binary" selected={profile?.gender === "non_binary"}>{isEl ? "Μη δυαδικό" : "Non-binary"}</option>
                  <option value="prefer_not_to_say" selected={profile?.gender === "prefer_not_to_say"}>{isEl ? "Προτιμώ να μην απαντήσω" : "Prefer not to say"}</option>
                </select></label>
              <label class="block sm:col-span-2"><span class="text-xs text-white/50">{isEl ? "Διεύθυνση" : "Address"}</span>
                <input name="address" required minlength="2" maxlength="200" value={profile?.address ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Πόλη" : "City"}</span>
                <input name="city" required minlength="2" maxlength="80" value={profile?.city ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block"><span class="text-xs text-white/50">{isEl ? "Τ.Κ." : "Postal code"}</span>
                <input name="postal_code" required minlength="2" maxlength="20" value={profile?.postal_code ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
              <label class="block sm:col-span-2"><span class="text-xs text-white/50">{isEl ? "Χώρα" : "Country"}</span>
                <input name="country" required minlength="2" maxlength="60" placeholder={isEl ? "Ελλάδα" : "Greece"} value={profile?.country ?? ""}
                  class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
            </div>
            <label class="flex items-start gap-2 text-xs text-white/60">
              <input type="checkbox" name="marketing_consent" class="mt-0.5" />
              <span>{isEl ? "Θέλω να λαμβάνω προσφορές & εκπτώσεις από το Sally's Bar." : "I want to receive offers & discounts from Sally's Bar."}</span>
            </label>
            <p id="cardFormMsg" class="text-xs hidden"></p>
            <button type="submit" id="cardFormSubmit"
              class="w-full rounded-xl bg-amber-400 text-black px-4 py-3 text-sm font-semibold hover:bg-amber-300 transition disabled:opacity-40">
              ✨ {isEl ? "Ενεργοποίηση κάρτας" : "Activate my card"}
            </button>
          </form>
        </div>
      </div>
    )}

  <script>
    import QRCode from "qrcode";
    const loyaltyCanvas = document.getElementById("loyaltyQr") as HTMLCanvasElement | null;
    const loyaltyCode = (loyaltyCanvas?.dataset.code) || "";
    if (loyaltyCanvas && loyaltyCode) {
      QRCode.toCanvas(loyaltyCanvas, loyaltyCode, {
        width: 140,
        margin: 1,
        color: { dark: "#0a0a0f", light: "#ffffff" },
      }).catch((e) => console.error("loyalty qr failed", e));
    }
    const isEl = document.documentElement.lang === "el";

    // Pending referral claim (for users who signed up via ?ref=… and confirmed via email)
    try {
      const pendingRef = localStorage.getItem("pending_ref");
      if (pendingRef) {
        fetch("/api/loyalty/claim-referral", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ referrer_id: pendingRef }),
        }).finally(() => localStorage.removeItem("pending_ref"));
      }
    } catch {}

    // Profile update
    const profileForm = document.getElementById("profileForm") as HTMLFormElement | null;
    profileForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = document.getElementById("profileMsg")!;
      const btn = profileForm.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      msg.className = "text-xs hidden";
      const bdEl = document.getElementById("fBirthday") as HTMLInputElement;
      const payload: Record<string, unknown> = {
        full_name: (document.getElementById("fName") as HTMLInputElement).value,
      };
      if (bdEl && bdEl.dataset.locked !== "1") {
        payload.birthday = bdEl.value || null;
      }
      const res = await fetch("/api/account/update", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        msg.textContent = isEl ? "✓ Αποθηκεύτηκε." : "✓ Saved.";
        msg.className = "text-xs text-green-400 block";
      } else {
        const j = await res.json().catch(() => ({}));
        msg.textContent = j.error ?? (isEl ? "Σφάλμα." : "Error.");
        msg.className = "text-xs text-red-400 block";
      }
      btn.disabled = false;
    });

    // Delete account
    document.getElementById("deleteAccountBtn")?.addEventListener("click", async () => {
      const email = prompt(isEl
        ? "Για επιβεβαίωση διαγραφής, πληκτρολόγησε το email σου:"
        : "To confirm deletion, type your email:");
      if (!email) return;
      if (!confirm(isEl ? "Όλα τα δεδομένα σου θα διαγραφούν οριστικά. Σίγουρα;" : "All your data will be permanently deleted. Are you sure?")) return;
      const res = await fetch("/api/account/delete", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ confirm_email: email }),
      });
      if (res.ok) {
        alert(isEl ? "Ο λογαριασμός διαγράφηκε." : "Account deleted.");
        window.location.href = "/";
      } else {
        const j = await res.json().catch(() => ({}));
        alert(j.error === "confirm_mismatch"
          ? (isEl ? "Το email δεν ταιριάζει." : "Email doesn't match.")
          : (isEl ? "Σφάλμα. Δοκίμασε ξανά." : "Error. Try again."));
      }
    });

    // Wallet buttons
    document.getElementById("appleWalletBtn")?.addEventListener("click", async () => {
      const res = await fetch("/api/wallet/apple-pass", { method: "POST" });
      if (res.ok) {
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url; a.download = "sallys-loyalty.pkpass"; a.click();
        URL.revokeObjectURL(url);
      } else {
        const j = await res.json().catch(() => ({}));
        alert(j.fallback ?? j.message ?? (isEl ? "Δεν είναι διαθέσιμο." : "Not available yet."));
      }
    });

    document.getElementById("googleWalletBtn")?.addEventListener("click", async () => {
      const res = await fetch("/api/wallet/google-pass", { method: "POST" });
      const j = await res.json().catch(() => ({}));
      if (res.ok && j.saveUrl) {
        window.location.href = j.saveUrl;
      } else {
        alert(j.message ?? (isEl ? "Δεν είναι διαθέσιμο." : "Not available yet."));
      }
    });

    // Redeem buttons
    document.querySelectorAll<HTMLButtonElement>(".redeem-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        const cost = btn.dataset.cost;
        const msg = isEl ? `Εξαργύρωση ${cost} πόντων;` : `Redeem ${cost} points?`;
        if (!confirm(msg)) return;
        btn.disabled = true;
        btn.textContent = "…";
        const res = await fetch("/api/loyalty/redeem", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reward_id: btn.dataset.rewardId }),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) {
          alert(j.error === "insufficient_points"
            ? (isEl ? "Δεν έχεις αρκετούς πόντους." : "Not enough points.")
            : (isEl ? "Σφάλμα. Δοκίμασε ξανά." : "Error. Try again."));
          btn.disabled = false;
          btn.textContent = `${cost} ${isEl ? "πόντοι" : "pts"}`;
          return;
        }
        alert(isEl ? `✓ Κωδικός: ${j.code}\nΔείξε τον στον σερβιτόρο.` : `✓ Code: ${j.code}\nShow this to your waiter.`);
        location.reload();
      });
    });

    document.getElementById("resList")?.addEventListener("click", async (e) => {
      const btn = (e.target as Element).closest(".cancel-res-btn") as HTMLElement | null;
      if (!btn) return;

      const confirmMsg = isEl ? "Ακύρωση κράτησης;" : "Cancel this reservation?";
      if (!confirm(confirmMsg)) return;

      const id  = btn.dataset.id!;
      const row = btn.closest("[data-res-id]") as HTMLElement | null;

      btn.disabled = true;
      btn.textContent = "…";

      const res = await fetch("/api/reservations/cancel", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id }),
      });

      if (!res.ok) {
        alert(isEl ? "Σφάλμα. Δοκιμάστε ξανά." : "Error. Please try again.");
        btn.disabled = false;
        btn.textContent = isEl ? "Ακύρωση" : "Cancel";
        return;
      }

      // Update badge colour + label, remove cancel button
      const badge = row?.querySelector(".res-badge") as HTMLElement | null;
      if (badge) {
        badge.textContent = isEl ? "Ακυρωμένη" : "Cancelled";
        badge.style.background = "#f8717122";
        badge.style.color = "#f87171";
      }
      btn.remove();
    });

    // Loyalty card activation modal
    const openCardBtn = document.getElementById("openCardFormBtn");
    const cardModal   = document.getElementById("cardFormModal");
    const closeCardBtn= document.getElementById("closeCardFormBtn");
    const cardForm    = document.getElementById("cardForm") as HTMLFormElement | null;
    function openCardModal() { cardModal?.classList.remove("hidden"); cardModal?.classList.add("flex"); }
    function closeCardModal(){ cardModal?.classList.add("hidden"); cardModal?.classList.remove("flex"); }
    openCardBtn?.addEventListener("click", openCardModal);
    closeCardBtn?.addEventListener("click", closeCardModal);
    cardModal?.addEventListener("click", (e) => { if (e.target === cardModal) closeCardModal(); });
    cardForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(cardForm);
      const payload = Object.fromEntries(fd.entries()) as Record<string, unknown>;
      payload.marketing_consent = fd.get("marketing_consent") === "on";
      const submitBtn = document.getElementById("cardFormSubmit") as HTMLButtonElement;
      const msg = document.getElementById("cardFormMsg")!;
      submitBtn.disabled = true;
      msg.className = "text-xs hidden";
      const res = await fetch("/api/account/create-card", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        msg.textContent = isEl ? "✓ Ενεργοποιήθηκε! Φόρτωση κάρτας…" : "✓ Activated! Loading your card…";
        msg.className = "text-xs text-green-400 block";
        setTimeout(() => window.location.reload(), 800);
      } else {
        const j = await res.json().catch(() => ({}));
        msg.textContent = (isEl ? "Σφάλμα: " : "Error: ") + (j.error ?? "unknown");
        msg.className = "text-xs text-red-400 block";
        submitBtn.disabled = false;
      }
    });
  </script>

  </body>
</html>
