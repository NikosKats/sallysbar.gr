              <a href="/" class="rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-5 py-2.5 text-sm font-semibold">{isEl ? "Δες το live site →" : "Live site →"}</a>
              <a href="/menu" class="rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-5 py-2.5 text-sm font-semibold">{isEl ? "Δοκίμασε το μενού →" : "Try the menu →"}</a>
              <a href="/play" class="rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-5 py-2.5 text-sm font-semibold">{isEl ? "Παίξε ένα παιχνίδι →" : "Play a game →"}</a>
              <a href="/loyalty" class="rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-5 py-2.5 text-sm font-semibold">{isEl ? "Κάρτα πιστότητας →" : "Loyalty card →"}</a>
              <a href="/pistotita-os/compare" class="rounded-xl border border-amber-400/40 bg-amber-400/10 hover:bg-amber-400/20 text-amber-200 px-5 py-2.5 text-sm font-semibold">{isEl ? "⚖️ Σύγκριση με ανταγωνιστές →" : "⚖️ vs. competitors →"}</a>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 text-center">
            <div class="rounded-2xl border border-white/10 bg-white/[0.05] p-5">
              <p class="font-heading text-4xl font-bold text-amber-200">2,185</p>
              <p class="text-xs text-white/60 mt-1">{isEl ? "Ώρες ανάπτυξης" : "Hours of build"}</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.05] p-5">
              <p class="font-heading text-4xl font-bold text-amber-200">55+</p>
              <p class="text-xs text-white/60 mt-1">{isEl ? "Λειτουργίες" : "Features"}</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.05] p-5">
              <p class="font-heading text-4xl font-bold text-amber-200">~4h</p>
              <p class="text-xs text-white/60 mt-1">{isEl ? "Setup ανά venue" : "Setup per venue"}</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.05] p-5">
              <p class="font-heading text-4xl font-bold text-amber-200">0€</p>
              <p class="text-xs text-white/60 mt-1">{isEl ? "Προμήθεια παραγγελίας" : "Per-order fee"}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-5 py-12">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-center">{T.faqTitle}</h2>
      <div class="mt-8 space-y-3">
        {faqs.map(f => (
          <details class="group rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4">
            <summary class="cursor-pointer flex items-center justify-between gap-4 font-semibold list-none">
              <span>{f.q}</span>
              <span class="text-white/40 group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <p class="mt-3 text-sm text-white/70 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="mx-auto max-w-5xl px-5 py-16">
      <div class="rounded-3xl border border-amber-400/40 bg-gradient-to-br from-amber-500/20 via-fuchsia-500/10 to-sky-500/10 p-8 md:p-12 text-center">
        <h2 class="font-heading text-3xl md:text-5xl font-bold leading-tight">{T.finalCta}</h2>
        <p class="mt-4 text-white/80 max-w-2xl mx-auto">
          {isEl
            ? "Στείλε WhatsApp, παίρνεις demo την ίδια μέρα. Αν σου αρέσει το PistotitaOS, είσαι live μέσα σε 48 ώρες."
            : "Send a WhatsApp, get a live demo the same day. If PistotitaOS clicks, you go live in 48 hours."}
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          <a href={waUrl} class="rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-black font-bold px-7 py-3.5 shadow-xl shadow-amber-500/30 transition">{T.ctaWa}</a>
          <a href={telUrl} class="rounded-2xl border border-white/15 bg-white/5 hover:bg-white/10 px-7 py-3.5 font-semibold transition">{T.ctaTel}</a>
        </div>
        <p class="mt-6 text-xs text-white/55">
          {isEl ? "Μία περιοχή = ένα μαγαζί. Όποιος κλείσει πρώτος, κλειδώνει τιμή και πόρτα." : "One area = one venue. Whoever signs first locks the price — and the territory."}
        </p>
      </div>
    </section>

    <Footer />
  </body>
</html>
