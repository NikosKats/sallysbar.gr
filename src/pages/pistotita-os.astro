---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

const waUrl = `https://wa.me/${site.phoneE164.replace(/\D/g, "")}?text=${encodeURIComponent(isEl ? "Γεια σας, ενδιαφέρομαι για το PistotitaOS." : "Hi — interested in PistotitaOS for my venue.")}`;
const telUrl = `tel:${site.phoneE164}`;

const T = {
  kicker: isEl ? "Η πλατφόρμα που τρέχει πίσω από το Sally's Bar" : "The platform that runs Sally's Bar",
  h1a: "PistotitaOS",
  h1b: isEl ? "Το λειτουργικό σύστημα του μπαρ σου." : "The operating system for your bar.",
  sub: isEl
    ? "QR παραγγελίες, ψηφιακή πιστότητα, παιχνίδια, WhatsApp/SMS αυτοματισμοί, analytics — ένα σύστημα, κάθε κανάλι επικοινωνίας με τον πελάτη σου."
    : "QR ordering, digital loyalty, games, WhatsApp/SMS automations, analytics — one system for every customer channel you own.",
  ctaDemo: isEl ? "🎯 Δες το live demo" : "🎯 See the live demo",
  ctaWa: isEl ? "💬 WhatsApp τώρα" : "💬 WhatsApp now",
  ctaTel: isEl ? "📞 Κάλεσέ μας" : "📞 Call us",
  modulesTitle: isEl ? "Τέσσερα modules, ένα σύστημα" : "Four modules, one system",
  valueTitle: isEl ? "Γιατί οι ιδιοκτήτες το διαλέγουν" : "Why owners pick PistotitaOS",
  featuresTitle: isEl ? "Όλα περιλαμβάνονται — χωρίς tiers" : "Everything included — no tiers",
  pricingTitle: isEl ? "Ένα μαγαζί ανά περιοχή. Κλείδωσε την τιμή." : "One venue per area. Lock your price.",
  exclusivityTitle: isEl ? "Αποκλειστικότητα ανά περιοχή" : "Territorial exclusivity",
  proofTitle: isEl ? "Δοκιμασμένο σε πραγματική σεζόν" : "Battle-tested on a real season",
  faqTitle: isEl ? "Συχνές ερωτήσεις" : "Frequently asked",
  finalCta: isEl ? "Κάνε το μπαρ σου έξυπνο." : "Make your bar smart.",
};

const modules = [
  {
    icon: "🤖",
    name: isEl ? "ANSWER" : "ANSWER",
    title: isEl ? "AI Ρεσεψιονίστ τηλεφώνου 24/7" : "AI phone receptionist · 24/7",
    desc: isEl
      ? "Το τηλέφωνο χτυπάει και δεν προλαβαίνεις; Η AI απαντά — δίγλωσση, κλείνει κρατήσεις, απαντά για το μενού, κάνει transfer σε εσένα όταν χρειάζεται."
      : "Can't reach the phone? Our AI answers every call — bilingual, books tables, answers menu questions, transfers to you when needed. Never miss a booking at 3AM again.",
    bullets: isEl ? [
      "Απαντά στα Αγγλικά ή Ελληνικά (auto-detect)",
      "Κλείνει τραπέζια — εσύ εγκρίνεις πριν το SMS επιβεβαίωσης",
      "Δίνει ωράριο, διεύθυνση, events της βραδιάς",
      "Απαντά για μενού (αλλεργίες, κοκτέιλ, τιμές)",
      "Warm-transfer σε εσένα όταν ο πελάτης ζητήσει άνθρωπο",
      "Transcript + ηχογράφηση κάθε κλήσης στο admin panel",
    ] : [
      "Auto-detects EN or EL from the caller's first sentence",
      "Books tables — you approve before the SMS goes out",
      "Gives hours, address, tonight's events",
      "Answers menu Q&A (allergens, cocktails, prices)",
      "Warm-transfer to you when caller asks for a human",
      "Transcript + recording of every call in your admin panel",
    ],
    color: "from-violet-400 to-fuchsia-600",
  },
  {
    icon: "🛎️",
    name: isEl ? "ORDER" : "ORDER",
    title: isEl ? "QR παραγγελίες & staff ops" : "QR ordering & staff ops",
    desc: isEl
      ? "Ο πελάτης σκανάρει QR στο τραπέζι → παραγγέλνει → το staff βλέπει ζωντανά τι να ετοιμάσει και πότε να παραδώσει."
      : "Guest scans the table QR → orders → staff sees live what to prepare and when to deliver.",
    bullets: isEl ? [
      "QR ανά τραπέζι, rounds, modifiers",
      "Staff app: waiter / barman / deliver",
      "Telegram bot για παραγγελίες",
      "Timestamps: prepared / ready / delivered",
      "Waiter call button με push",
    ] : [
      "QR per table, rounds, modifiers",
      "Staff app: waiter / barman / deliver",
      "Telegram order bot",
      "Timestamps: prepared / ready / delivered",
      "Waiter call button with push",
    ],
    color: "from-sky-400 to-sky-600",
  },
  {
    icon: "🎟️",
    name: "LOYAL",
    title: isEl ? "Κάρτα πιστότητας + Wallet" : "Loyalty card + Wallet",
    desc: isEl
      ? "Ψηφιακή κάρτα με tiers, πόντους, rewards. Εγκαθίσταται σαν native app στο Apple/Google Wallet."
      : "Digital card with tiers, points, rewards. Installs like a native app to Apple/Google Wallet.",
    bullets: isEl ? [
      "Bronze/Silver/Gold auto-tier-up",
      "Apple & Google Wallet passes",
      "Rewards catalog + staff redemption QR",
      "Referral πόντοι (δικό σου ref link)",
      "Social card /u/handle για viral share",
    ] : [
      "Bronze/Silver/Gold auto-tier-up",
      "Apple & Google Wallet passes",
      "Rewards catalog + staff redemption QR",
      "Referral points (your ref link)",
      "Social card /u/handle for viral share",
    ],
    color: "from-amber-400 to-amber-600",
  },
  {
    icon: "🎮",
    name: "PLAY",
    title: isEl ? "Gamification (casino-grade)" : "Gamification (casino-grade)",
    desc: isEl
      ? "Ρόδα τύχης, scratch cards, AI-generated quests με staff confirmation. Γιατί ο πελάτης να γυρίσει — με λόγο."
      : "Wheel of Luck, scratch cards, AI-generated quests with staff confirmation. A reason for guests to come back.",
    bullets: isEl ? [
      "Daily Wheel με geofence & limits",
      "Scratch cards με editable rewards",
      "Tonight's Quests (AI + staff confirm QR)",
      "Ήχοι casino-grade (Web Audio)",
      "Master kill-switch για όλα τα games",
    ] : [
      "Daily Wheel with geofence & limits",
      "Scratch cards with editable rewards",
      "Tonight's Quests (AI + staff-confirm QR)",
      "Casino-grade Web Audio SFX",
      "Master kill-switch for all games",
    ],
    color: "from-fuchsia-400 to-fuchsia-600",
  },
  {
    icon: "📣",
    name: "GROW",
    title: isEl ? "CRM, καμπάνιες & αυτοματισμοί" : "CRM, campaigns & automation",
    desc: isEl
      ? "10 έτοιμοι αυτοματισμοί + bulk CRM καμπάνιες σε 7 κανάλια. Unified inbox με delivery receipts και ηχογραφημένες κλήσεις."
      : "10 built-in triggers + bulk CRM campaigns over 7 channels. Unified inbox with delivery receipts and recorded calls.",
    bullets: isEl ? [
      "10 έτοιμα triggers (γενέθλια, κρατήσεις, κριτικές, re-engagement, happy hour…)",
      "Bulk CRM καμπάνιες: 7 κανάλια (WA/SMS/Viber/Messenger/IG/Push/Email)",
      "Paste list για ad-hoc blast (CSV-friendly)",
      "URL shortener sallysbar.gr/s/xxxxx (κρατάει SMS σε 1 segment)",
      "Unified inbox: απαντήσεις, delivery, κλήσεις με recording playback",
      "Messenger/Instagram linking με +20 πόντοι booster",
    ] : [
      "10 built-in triggers (birthday, reservations, reviews, re-engagement, happy-hour…)",
      "Bulk CRM campaigns: 7 channels (WA/SMS/Viber/Messenger/IG/Push/Email)",
      "Pasted-list audience for ad-hoc blasts (CSV-friendly)",
      "URL shortener sallysbar.gr/s/xxxxx (keeps SMS in 1 segment)",
      "Unified inbox: replies, delivery receipts, calls with recording playback",
      "Messenger/Instagram linking with +20 point booster",
    ],
    color: "from-emerald-400 to-emerald-600",
  },
];

const valueProps = [
  { icon: "📞", title: isEl ? "Καμία χαμένη κλήση 24/7" : "Never miss a call — 24/7",
    desc: isEl ? "Η AI απαντά όταν εσύ δεν μπορείς. Κλείνει τραπέζια και στις 3πμ." : "Our AI answers when you can't. Books tables at 3AM, on your day off, mid-shift." },
  { icon: "💸", title: isEl ? "+40% επιστροφές πελατών" : "+40% return visits",
    desc: isEl ? "Πόντοι, σκρατς, ρόδα τύχης. Κάθε επίσκεψη έχει λόγο." : "Points, scratch, wheel. Every visit has a reason." },
  { icon: "📲", title: isEl ? "Λίστα πελατών δική σου" : "A customer list you own",
    desc: isEl ? "Όχι Facebook. WhatsApp/SMS/push απευθείας στους πελάτες σου." : "Not Facebook. Direct WhatsApp/SMS/push to your own customers." },
  { icon: "🤖", title: isEl ? "Marketing που τρέχει μόνο του" : "Marketing on autopilot",
    desc: isEl ? "Γενέθλια, 2h reminder, κριτικές — αυτόματα, 24/7." : "Birthdays, 2h reminders, reviews — automatic, 24/7." },
  { icon: "🛡️", title: isEl ? "Χωρίς App Store, χωρίς προμήθειες" : "No App Store, no commissions",
    desc: isEl ? "PWA στο browser. Δεν πληρώνεις Apple / Google / Wolt." : "PWA in the browser. No Apple/Google/Wolt cut." },
  { icon: "⚡", title: isEl ? "Live σε 48 ώρες" : "Live in 48 hours",
    desc: isEl ? "~4 ώρες setup. Το στήνουμε εμείς, εσύ ανοίγεις." : "~4h setup. We install it, you open the doors." },
];

const bullets = [
  isEl ? "🤖 AI τηλεφωνήτρια 24/7 (δίγλωσση)" : "🤖 AI phone receptionist · 24/7 · bilingual",
  isEl ? "Κράτηση τραπεζιού μέσω τηλεφώνου με AI" : "AI-handled table bookings by phone",
  isEl ? "Transcript + ηχογράφηση κάθε κλήσης" : "Full transcript + recording of every AI call",
  isEl ? "Warm-transfer σε ιδιοκτήτη όταν χρειάζεται" : "Warm-transfer to owner on request",
  isEl ? "QR παραγγελίες ανά τραπέζι" : "QR ordering per table",
  isEl ? "Κάρτα πιστότητας + Apple/Google Wallet" : "Loyalty card + Apple/Google Wallet",
  isEl ? "Ρόδα Τύχης καθημερινά" : "Daily Wheel of Luck",
  isEl ? "Scratch cards με επεξεργάσιμα δώρα" : "Scratch cards with editable rewards",
  isEl ? "Tonight's Quests (AI + staff confirm)" : "Tonight's Quests (AI + staff confirm)",
  isEl ? "Push ειδοποιήσεις (PWA)" : "Push notifications (PWA)",
  isEl ? "WhatsApp / SMS αυτοματισμοί" : "WhatsApp / SMS automations",
  isEl ? "Email transactional (Resend)" : "Transactional email (Resend)",
  isEl ? "Κρατήσεις + 2h υπενθύμιση" : "Reservations + 2h reminder",
  isEl ? "Telegram bot" : "Telegram bot",
  isEl ? "Chat ομάδας (shift coord)" : "Team chat (shift coord)",
  isEl ? "Staff app: waiter / barman" : "Staff app: waiter / barman",
  isEl ? "Tips tracking ανά βάρδια" : "Per-shift tip tracking",
  isEl ? "Social card /u/handle" : "Social card /u/handle",
  isEl ? "Referral πόντοι" : "Referral points",
  isEl ? "Trackable QR καμπάνιες" : "Trackable QR campaigns",
  isEl ? "Bulk CRM καμπάνιες (7 κανάλια)" : "Bulk CRM campaigns (7 channels)",
  isEl ? "Paste-list κοινό (CSV-friendly)" : "Pasted-list audience (CSV-friendly)",
  isEl ? "URL shortener με click tracking" : "URL shortener with click tracking",
  isEl ? "Unified inbox (απαντήσεις/delivery/κλήσεις)" : "Unified inbox (replies/delivery/calls)",
  isEl ? "Recording playback εισερχομένων κλήσεων" : "Inbound call recording playback",
  isEl ? "Messenger/Instagram linking (+20 πόντοι)" : "Messenger/Instagram linking (+20 points)",
  isEl ? "Profile completion bar" : "Profile completion bar",
  isEl ? "Auto-STOP unsubscribe" : "Auto-STOP unsubscribe handling",
  isEl ? "Marketing analytics" : "Marketing analytics",
  isEl ? "Εκτυπώσιμα σουβέρ, αφίσες" : "Printable coasters, posters",
  isEl ? "Δίγλωσσο EN/EL" : "Bilingual EN/EL",
  isEl ? "GDPR compliance + DPA template" : "GDPR compliance + DPA template",
];

// Pricing math:
// - Seasonal (6 mo):  early-bird €690  / list €1,380  = 50% off
// - Year-round (12 mo): priced as 20% cheaper than buying 2× seasonal
//     2 × €690 = €1,380 → year-round early-bird = €1,380 × 0.80 = €1,104
//     at 54% off list: list = €1,104 / 0.46 = €2,400
const plans = [
  {
    name: isEl ? "🏝️ Seasonal — 6 μήνες" : "🏝️ Seasonal — 6 months",
    tagline: isEl ? "Για τουριστικά, νησιά, παραλίες" : "For tourist / island / beach venues",
    months: 6,
    list: 1380, price: 690, pct: 50,
    setup: 850,
    subscriptionNote: isEl ? "Χρέωση άπαξ τον Απρίλιο · καλύπτει 6 μήνες σεζόν (Μάι–Οκτ)." : "Billed once in April · covers 6 months (May–Oct).",
    subscriptionPeriod: isEl ? "για 6 μήνες" : "for 6 months",
    billing: isEl ? "Ολόκληρο το ποσό καταβάλλεται μπροστά τον Απρίλιο." : "Full amount paid upfront in April.",
    featured: false,
  },
  {
    name: isEl ? "🏙️ Year-round — 12 μήνες" : "🏙️ Year-round — 12 months",
    tagline: isEl ? "Για bars/cafés που δουλεύουν όλο τον χρόνο" : "For city bars / cafés open all year",
    months: 12,
    list: 2400, price: 1104, pct: 54,
    setup: 850,
    subscriptionNote: isEl ? "12-μηνη συνδρομή · 20% φθηνότερα από 2× seasonal · μπροστά." : "12-month subscription · 20% cheaper than buying 2× seasonal · paid upfront.",
    subscriptionPeriod: isEl ? "για 12 μήνες" : "for 12 months",
    billing: isEl ? "Ολόκληρο το ποσό καταβάλλεται μπροστά." : "Full amount paid upfront.",
    featured: true,
  },
];

const faqs = [
  { q: isEl ? "Τι είναι το PistotitaOS;" : "What is PistotitaOS?",
    a: isEl ? "Ένα OS για bar/café: QR παραγγελίες + πιστότητα + παιχνίδια + marketing αυτοματισμοί + AI τηλεφωνήτρια 24/7, όλα σε ένα. Η ίδια πλατφόρμα που τρέχει στο sallysbar.gr." : "A full OS for bar/café: QR ordering + loyalty + games + marketing automation + 24/7 AI phone receptionist, all in one. The same platform running on sallysbar.gr." },
  { q: isEl ? "Πώς δουλεύει η AI τηλεφωνήτρια;" : "How does the AI phone receptionist work?",
    a: isEl ? "Παίρνεις ένα νούμερο (UK ή US — ή μεταφέρεις το δικό σου). Κάθε κλήση απαντιέται δίγλωσσα από AI agent που: κλείνει τραπέζια, απαντά για μενού, δίνει ωράριο και οδηγίες, κάνει transfer σε εσένα όταν χρειάζεται. Εσύ βλέπεις transcript + σύνοψη + ηχογράφηση κάθε κλήσης στο admin panel. +€39/μήνα (Starter · 130 λεπτά) ή +€79 (Pro · 400 λεπτά)." : "You get a phone number (UK or US — or port your own). Every inbound call is answered bilingually by an AI agent that: books tables, answers menu questions, gives hours and directions, transfers to you on request. You see the transcript + summary + recording of every call in your admin panel. +€39/mo (Starter · 130 min) or +€79 (Pro · 400 min)." },
  { q: isEl ? "Η AI είναι ξεχωριστή συνδρομή;" : "Is the AI a separate subscription?",
    a: isEl ? "Ναι — add-on πάνω από την βασική συνδρομή PistotitaOS. Starter €39/μήνα για ~45 κλήσεις. Pro €79 για ~140 κλήσεις. Unlimited €149 για απεριόριστη χρήση (1000 λεπτά soft cap). Overage €0.30/λεπτό. Ένα τυπικό μπαρ χρησιμοποιεί Starter." : "Yes — an add-on on top of the base PistotitaOS plan. Starter €39/mo for ~45 calls. Pro €79 for ~140 calls. Unlimited €149 for unlimited use (1000-min soft cap). Overage €0.30/min. A typical bar uses the Starter tier." },
  { q: isEl ? "Πώς δουλεύει η αποκλειστικότητα ανά περιοχή;" : "How does territorial exclusivity work?",
    a: isEl ? "Το PistotitaOS δίνεται σε έναν ιδιοκτήτη ανά δρόμο/ZIP code. Μόλις υπογράψεις, η περιοχή κλειδώνει για 12 μήνες — κανένας ανταγωνιστής σου δίπλα δεν μπορεί να πάρει το ίδιο σύστημα. Αν ανανεώσεις, κρατάς την περιοχή. Αν όχι, ανοίγει ξανά." : "PistotitaOS is offered to one venue per street / postal code. The moment you sign, that area locks for 12 months — no competitor nearby can get the same system. Renew and you keep the territory. Don't renew and it reopens." },
  { q: isEl ? "Πόσο γρήγορα μπαίνει;" : "How fast can we go live?",
    a: isEl ? "~4 ώρες setup. Μενού, loyalty, QR σε τραπέζια — έτοιμα την ίδια μέρα." : "~4 hours setup. Menu, loyalty, table QRs — live the same day." },
  { q: isEl ? "Χρειάζομαι καινούρια μηχανήματα;" : "Do I need new hardware?",
    a: isEl ? "Όχι. Δουλεύει σε οποιοδήποτε κινητό / tablet / laptop. NFC κάρτες + QR σουβέρ είναι προαιρετικό upsell." : "No. Runs on any phone/tablet/laptop. NFC cards + QR coasters are optional upsells." },
  { q: isEl ? "Τα δεδομένα μου;" : "Who owns the data?",
    a: isEl ? "Εσύ. Δικιά σου βάση δεδομένων, δικιά σου λίστα πελατών. Κατεβάζεις CSV όποτε θες." : "You do. Your database, your customer list. Export to CSV any time." },
  { q: isEl ? "Χωρίς προμήθεια ανά παραγγελία;" : "Really no per-order commission?",
    a: isEl ? "Ναι. Πληρώνεις σταθερή συνδρομή. Καμία προμήθεια ανά παραγγελία, κανένα percentage split." : "Yes. Flat subscription. No per-order cut, no percentage split." },
  { q: isEl ? "Τι αν δεν μ' αρέσει;" : "What if it doesn't work out?",
    a: isEl ? "Seasonal plan λήγει μετά τους 6 μήνες — χωρίς δέσμευση. Year-round έχει 60 ημέρες εγγύηση αποτελέσματος." : "Seasonal plan ends after 6 months — no lock-in. Year-round has a 60-day results guarantee." },
  { q: isEl ? "Το στήνετε εσείς;" : "Do you do the setup?",
    a: isEl ? "Ναι. Setup fee €890 καλύπτει εγκατάσταση, branding, εισαγωγή μενού, εκπαίδευση staff." : "Yes. €890 setup fee covers install, branding, menu import, staff training." },
];
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PistotitaOS — {isEl ? "Το λειτουργικό σύστημα του μπαρ σου" : "The operating system for your bar"}</title>
    <meta name="description" content={isEl
      ? "PistotitaOS: QR παραγγελίες, πιστότητα, παιχνίδια, WhatsApp/SMS αυτοματισμοί. Η πλατφόρμα που τρέχει το Sally's Bar."
      : "PistotitaOS: QR ordering, loyalty, games, WhatsApp/SMS automations. The platform behind Sally's Bar."} />
    <meta property="og:title" content="PistotitaOS" />
    <meta property="og:description" content={isEl ? "Το λειτουργικό σύστημα του μπαρ σου." : "The operating system for your bar."} />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased">
    <Header />
    <div class="h-20"></div>

    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-40 -left-40 h-[30rem] w-[30rem] rounded-full bg-amber-500/25 blur-3xl"></div>
        <div class="absolute top-20 -right-40 h-[34rem] w-[34rem] rounded-full bg-fuchsia-500/20 blur-3xl"></div>
        <div class="absolute -bottom-20 left-1/3 h-[24rem] w-[24rem] rounded-full bg-sky-500/15 blur-3xl"></div>
      </div>

      <div class="relative mx-auto max-w-6xl px-5 pt-10 pb-16 md:pt-20 md:pb-24 text-center">
        <p class="text-[11px] uppercase tracking-[0.28em] text-amber-300/90 font-bold">{T.kicker}</p>

        <h1 class="mt-5 leading-tight">
          <span class="block font-heading text-6xl md:text-8xl font-black bg-gradient-to-br from-white via-amber-100 to-amber-400 bg-clip-text text-transparent">{T.h1a}</span>
          <span class="mt-3 block font-heading text-3xl md:text-5xl font-bold text-white/90">{T.h1b}</span>
        </h1>

        <p class="mt-6 text-lg md:text-xl text-white/75 max-w-3xl mx-auto leading-relaxed">{T.sub}</p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href={waUrl} class="rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-black font-bold px-6 py-3 shadow-xl shadow-amber-500/30 transition">{T.ctaDemo}</a>
          <a href={waUrl} class="rounded-2xl border border-white/15 bg-white/5 hover:bg-white/10 px-6 py-3 font-semibold transition">{T.ctaWa}</a>
          <a href={telUrl} class="rounded-2xl border border-white/15 bg-white/5 hover:bg-white/10 px-6 py-3 font-semibold transition">{T.ctaTel}</a>
        </div>

        <p class="mt-6 text-xs text-white/50">
          {isEl ? "✔ Χωρίς App Store · ✔ Χωρίς προμήθεια παραγγελίας · ✔ Δικά σου τα δεδομένα · ✔ Live σε 48h" : "✔ No App Store · ✔ No per-order commission · ✔ You own your data · ✔ Live in 48h"}
        </p>
      </div>
    </section>

    <!-- MODULES -->
    <section class="mx-auto max-w-6xl px-5 py-14">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-center">{T.modulesTitle}</h2>
      <p class="text-center text-sm text-white/55 mt-3 max-w-2xl mx-auto">
        {isEl ? "ORDER + LOYAL + PLAY + GROW δουλεύουν μαζί. Δεν πληρώνεις ανά module — τα παίρνεις όλα." : "ORDER + LOYAL + PLAY + GROW work as one system. No per-module pricing — you get all four."}
      </p>

      <div class="mt-10 grid md:grid-cols-2 gap-5">
        {modules.map(m => (
          <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 md:p-7 hover:bg-white/[0.05] transition">
            <div class="flex items-center gap-3">
