---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import { site } from "../data/site";

import { getMenu, formatPriceEUR } from "../lib/menuService";
import { dict } from "../i18n";

const lang = Astro.locals.lang ?? "en";
const t = dict[lang];

const menuBase = lang === "el" ? "/el/menu" : "/menu";
const canonical = lang === "el" ? "https://sallysbar.gr/el/menu" : "https://sallysbar.gr/menu";
const ogLocale = lang === "el" ? "el_GR" : "en_US";

const title = `${t.meta.menuTitle} • ${site.name}`;
const desc = lang === "el"
  ? `Κοκτέιλ, μπύρα, κρασί και ποτά στο ${site.name} στη Σκάλα, Κεφαλονιά.`
  : `Cocktails, beer, wine and spirits at ${site.name} in Skala, Kefalonia.`;
const keywords = lang === "el"
  ? "μενού, κοκτέιλ, μπύρα, κρασί, Σκάλα, Κεφαλονιά, Sally's Bar"
  : "menu, cocktails, beer, wine, Skala, Kefalonia, Sally's Bar";

// Lang-aware UI strings
const ui = lang === "el"
  ? {
      subtitle: "Ποτά & Μεζέδες",
      fallbackTitle: t.meta.menuTitle,
      allChip: "Όλα",
      topShort: "↑ Πάνω",
      directionsLabel: "📍 Οδηγίες",
      instagramLabel: "Instagram",
      cocktailsPill: `🍸 ${t.meta.cocktailsRange}`,
      allergiesNote: `🍋 ${t.meta.allergiesNote}`,
    }
  : {
      subtitle: "Drinks & Bites",
      fallbackTitle: "Our Menu",
      allChip: "All",
      topShort: "↑ Top",
      directionsLabel: "📍 Directions",
      instagramLabel: "Instagram",
      cocktailsPill: `🍸 ${t.meta.cocktailsRange}`,
      allergiesNote: `🍋 ${t.meta.allergiesNote}`,
    };

const menuSlug = new URL(Astro.request.url).searchParams.get("menu") ?? undefined;
const { menu: currentMenu, menus: activeMenus, categories, items } = await (async () => {
  const all = await getMenu(lang);
  if (menuSlug) {
    const pick = all.menus?.find(m => m.slug === menuSlug);
    if (pick && pick.id !== all.menu?.id) return await getMenu(lang, pick.id);
  }
  return all;
})();

const currentMenuName = lang === "el"
  ? (currentMenu?.name_el ?? ui.fallbackTitle)
  : (currentMenu?.name_en ?? ui.fallbackTitle);

// Group items by category
const byCategory = new Map<number, typeof items>();
for (const it of items) {
  const list = byCategory.get(it.category_id) ?? [];
  list.push(it);
  byCategory.set(it.category_id, list);
}

// Collect unique tags for filter chips
const tagSet = new Set<string>();
for (const it of items) {
  (it.tags ?? []).forEach((tg) => tagSet.add(tg));
}
const allTags = Array.from(tagSet).sort((a, b) => a.localeCompare(b));
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content="website" />
  </head>

  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased pb-24 md:pb-0 overflow-x-hidden">
    <div class="pointer-events-none fixed inset-0 -z-10 opacity-60">
      <div class="hidden md:block absolute -top-40 left-1/3 h-[520px] w-[520px] rounded-full bg-amber-400/10 blur-[140px]"></div>
      <div class="hidden md:block absolute bottom-0 right-0 h-[420px] w-[420px] rounded-full bg-fuchsia-500/10 blur-[140px]"></div>
    </div>

    <a id="top" class="block scroll-mt-24"></a>
    <Header />

    <main class="mx-auto max-w-3xl px-6 py-10 pt-28">
      <!-- Header -->
      <div class="flex flex-col gap-4">
        <div class="text-xs uppercase tracking-[0.28em] text-amber-200/80">{ui.subtitle}</div>
        <h1 class="font-heading text-5xl md:text-6xl font-bold leading-[0.95] bg-gradient-to-br from-white via-amber-50 to-amber-200/80 bg-clip-text text-transparent">{currentMenuName}</h1>

        {activeMenus && activeMenus.length > 1 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {activeMenus.map((m) => (
              <a href={`${menuBase}?menu=${m.slug}`}
                class={`rounded-full px-4 py-1.5 text-sm border transition ${currentMenu?.id === m.id ? "bg-amber-300/20 border-amber-300/50 text-amber-200" : "border-white/15 bg-white/5 text-white/70 hover:bg-white/10"}`}>
                {lang === "el" ? m.name_el : m.name_en}
              </a>
            ))}
          </div>
        )}

        <div class="flex flex-col gap-3 text-white/70">
          <p class="text-white/70">{ui.cocktailsPill} · {site.hours.text}</p>

          <div class="flex flex-wrap gap-2">
            <a
              href={site.mapsShareUrl}
              target="_blank"
              class="inline-flex items-center justify-center rounded-full border border-amber-300/30 bg-amber-300/5 px-4 py-2 text-sm text-amber-100 hover:bg-amber-300/10 hover:border-amber-300/50 transition"
            >
              {ui.directionsLabel}
            </a>
            <a
              href={site.socials.instagram}
              target="_blank"
              class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/80 hover:text-white hover:bg-white/10 transition"
            >
              {ui.instagramLabel}
            </a>
          </div>
        </div>
      </div>

      <!-- Search + Tag filter -->
      <div class="mt-8 rounded-2xl border border-white/10 bg-white/[0.03] md:backdrop-blur p-4">
        <div class="flex flex-col gap-3">
          <label class="text-sm text-white/70" for="menuSearch">{t.cta.searchLabel}</label>

          <div class="flex items-center gap-3">
            <input
              id="menuSearch"
              type="search"
              placeholder={t.cta.searchPlaceholder}
              class="w-full rounded-2xl border border-white/10 bg-black/30 px-4 py-3 text-white placeholder:text-white/40 outline-none focus:border-white/20"
            />

            <button
              id="clearSearch"
              type="button"
              class="shrink-0 rounded-2xl border border-white/10 bg-black/30 px-4 py-3 text-sm text-white/80 hover:bg-white/10 transition"
              aria-label={t.cta.clear}
            >
              {t.cta.clear}
            </button>
          </div>

          {allTags.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-1">
              <button
                type="button"
                data-tag="__all__"
                class="tag-chip rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs text-white"
              >
                {ui.allChip}
              </button>

              {allTags.map((tg) => (
                <button
                  type="button"
                  data-tag={tg}
                  class="tag-chip rounded-full border border-white/10 bg-black/30 px-3 py-1.5 text-xs text-white/70 hover:bg-white/10 hover:text-white transition"
                >
                  {tg}
                </button>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Sticky jump chips -->
      <div class="sticky top-16 z-40 mt-6 -mx-6 border-y border-white/10 bg-[#0a0a0f]/85 px-6 py-3 md:backdrop-blur-xl">
        <div class="flex flex-wrap gap-2">
          {categories.map((c) => (
            <a
              href={`#${c.slug}`}
              class="rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs text-white/80 hover:text-amber-200 hover:border-amber-300/30 hover:bg-amber-300/5 transition"
            >
              {c.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Sections -->
      <div class="mt-10 space-y-12" id="menuRoot">
        {categories.map((c) => {
          const list = byCategory.get(c.id) ?? [];
          return (
            <section id={c.slug} class="scroll-mt-28 menu-section">
              <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
                <div>
                  <div class="h-px w-10 bg-gradient-to-r from-amber-300/60 to-transparent mb-3"></div>
                  <h2 class="font-heading text-3xl font-bold">{c.name}</h2>
                </div>
                <a href="#top" class="text-xs uppercase tracking-widest text-white/40 hover:text-amber-200 transition">{ui.topShort}</a>
              </div>

              {list.length === 0 ? (
                <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 text-sm text-white/60">
                  {t.meta.comingSoon}
                </div>
              ) : (
                <div class="rounded-2xl border border-white/10 bg-white/[0.03] md:backdrop-blur overflow-hidden">
                  <div class="divide-y divide-white/10">
                    {list.map((item) => (
                      <div
                        class="menu-item group flex items-start justify-between gap-6 p-5 md:p-6 hover:bg-amber-300/[0.03] transition"
                        data-name={item.name}
                        data-desc={item.description ?? ""}
                        data-tags={(item.tags ?? []).join(",")}
                      >
                        <div class="min-w-0 flex-1">
                          <div class="flex flex-wrap items-center gap-2">
                            <div class="font-semibold text-[15px] group-hover:text-amber-100 transition">{item.name}</div>

                            {item.tags?.map((tg) => (
                              <span class="rounded-full border border-white/10 bg-black/30 px-2 py-0.5 text-[10px] uppercase tracking-wider text-white/60">
                                {tg}
                              </span>
                            ))}
                          </div>

                          {item.description && item.description.length > 0 && (
                            <p class="mt-2 text-sm text-white/60 leading-relaxed">
                              {item.description}
                            </p>
                          )}
                        </div>

                        <div class="shrink-0">
                          <div class="font-heading text-lg font-bold text-amber-200">
                            {formatPriceEUR(item.price_cents)}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </section>
          );
        })}
      </div>

      <div class="mt-12 rounded-2xl border border-amber-300/15 bg-gradient-to-br from-amber-500/5 to-transparent p-5 text-sm text-white/70 text-center">
        {ui.allergiesNote}
      </div>
    </main>

    <Footer />

    <StickyCta
      mapsUrl={site.mapsShareUrl}
      phoneE164={site.phoneE164}
      instagramUrl={site.socials.instagram}
      facebookUrl={site.socials.facebook}
      tripadvisorUrl={site.socials.tripadvisor}
    />

    <script is:inline>
      (() => {
        const searchEl = document.getElementById("menuSearch");
        const clearBtn = document.getElementById("clearSearch");
        const chips = Array.from(document.querySelectorAll(".tag-chip"));
        const items = Array.from(document.querySelectorAll(".menu-item"));
        const sections = Array.from(document.querySelectorAll(".menu-section"));

        let activeTag = "__all__";

        function norm(s) {
          return (s || "").toString().toLowerCase().trim();
        }

        function applyFilters() {
          const q = norm(searchEl?.value);

          items.forEach((el) => {
            const name = norm(el.getAttribute("data-name"));
            const desc = norm(el.getAttribute("data-desc"));
            const tagsRaw = (el.getAttribute("data-tags") || "");
            const tags = tagsRaw.split(",").map(norm).filter(Boolean);

            const matchesSearch = !q || name.includes(q) || desc.includes(q) || tags.some(t => t.includes(q));
            const matchesTag = activeTag === "__all__" || tags.includes(norm(activeTag));

            const show = matchesSearch && matchesTag;
            el.style.display = show ? "" : "none";
          });

          // hide empty sections
          sections.forEach((sec) => {
            const anyVisible = Array.from(sec.querySelectorAll(".menu-item")).some((el) => el.style.display !== "none");
            sec.style.display = anyVisible ? "" : "none";
          });
        }

        function setActiveChip(tag) {
          activeTag = tag;

          chips.forEach((c) => {
            const isActive = c.getAttribute("data-tag") === tag;

            c.classList.toggle("bg-white/10", isActive);
            c.classList.toggle("border-white/15", isActive);
            c.classList.toggle("text-white", isActive);

            c.classList.toggle("bg-black/30", !isActive);
            c.classList.toggle("border-white/10", !isActive);
            c.classList.toggle("text-white/70", !isActive);
          });

          applyFilters();
        }

        if (searchEl) searchEl.addEventListener("input", applyFilters);

        if (clearBtn) {
          clearBtn.addEventListener("click", () => {
            if (searchEl) searchEl.value = "";
            setActiveChip("__all__");
            searchEl?.focus();
          });
        }

        chips.forEach((chip) => {
          chip.addEventListener("click", () => setActiveChip(chip.getAttribute("data-tag") || "__all__"));
        });

        setActiveChip("__all__");
        applyFilters();
      })();
    </script>
  </body>
</html>
