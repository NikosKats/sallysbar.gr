---
import "../../styles/global.css";
import AdminNav from "../../components/AdminNav.astro";
import { supabaseAdmin } from "../../lib/supabase";
import { withLangPrefix } from "../../i18n";

export const prerender = false;

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!["admin", "super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}
const isSuper = Astro.locals.role === "super_admin";

const { data: messages } = await supabaseAdmin
  .from("vonage_inbound_messages")
  .select("id, message_uuid, channel, from_address, to_address, message_type, text, matched_user_id, handled, received_at")
  .order("received_at", { ascending: false })
  .limit(100);

const { data: profiles } = await supabaseAdmin
  .from("profiles")
  .select("id, full_name")
  .in("id", [...new Set((messages ?? []).map(m => m.matched_user_id).filter(Boolean))]);

const nameMap = new Map<string, string>();
for (const p of profiles ?? []) nameMap.set(p.id, p.full_name ?? "—");

const { data: recentStatus } = await supabaseAdmin
  .from("vonage_message_status")
  .select("message_uuid, channel, status, to_address, error_reason, price_eur, received_at")
  .order("received_at", { ascending: false })
  .limit(50);

const { data: calls } = await supabaseAdmin
  .from("vonage_voice_calls")
  .select("id, call_uuid, direction, from_address, to_address, status, duration_sec, price_eur, recording_url, matched_user_id, started_at, ended_at")
  .order("started_at", { ascending: false })
  .limit(50);

const callNameMap = new Map<string, string>();
if ((calls ?? []).some(c => c.matched_user_id)) {
  const ids = [...new Set((calls ?? []).map(c => c.matched_user_id).filter(Boolean))];
  const { data: ps } = await supabaseAdmin.from("profiles").select("id, full_name").in("id", ids);
  for (const p of ps ?? []) callNameMap.set(p.id, p.full_name ?? "—");
}

function fmtDuration(sec: number | null) {
  if (!sec) return "—";
  const m = Math.floor(sec / 60), s = sec % 60;
  return `${m}:${String(s).padStart(2, "0")}`;
}

const channelIcon: Record<string, string> = {
  sms: "📱", whatsapp: "💬", viber_service: "🟣", messenger: "📘", instagram: "📸",
};
const statusColor: Record<string, string> = {
  submitted: "text-white/50", delivered: "text-emerald-300", read: "text-sky-300",
  rejected: "text-rose-300", undeliverable: "text-rose-300", failed: "text-rose-300",
};

const total = (messages ?? []).length;
const unhandled = (messages ?? []).filter(m => !m.handled).length;
const matched = (messages ?? []).filter(m => !!m.matched_user_id).length;
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{isEl ? "Εισερχόμενα" : "Inbox"} — Admin</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <AdminNav active="inbox" />
    <main class="mx-auto max-w-6xl px-5 py-10">
      <h1 class="font-heading text-3xl md:text-4xl font-bold">📬 {isEl ? "Εισερχόμενα μηνύματα & Delivery" : "Inbox & delivery status"}</h1>
      <p class="mt-2 text-sm text-white/60 max-w-2xl">
        {isEl
          ? "Κάθε απάντηση πελάτη σε SMS/WhatsApp/Viber/Messenger/IG, και τα status delivery όσων στέλνεις."
          : "Every customer reply across SMS/WhatsApp/Viber/Messenger/IG, plus delivery receipts for messages you send."}
      </p>

      <!-- KPIs -->
      <section class="mt-6 grid sm:grid-cols-3 gap-3">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <p class="text-[10px] uppercase tracking-wider text-white/50">{isEl ? "Τελευταίες 100" : "Recent (100 max)"}</p>
          <p class="font-heading text-3xl font-bold mt-1">{total}</p>
        </div>
        <div class="rounded-2xl border border-rose-400/20 bg-rose-400/[0.06] p-4">
          <p class="text-[10px] uppercase tracking-wider text-rose-300">{isEl ? "Δεν έχουν απαντηθεί" : "Unhandled"}</p>
          <p class="font-heading text-3xl font-bold mt-1">{unhandled}</p>
        </div>
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.06] p-4">
          <p class="text-[10px] uppercase tracking-wider text-emerald-300">{isEl ? "Ταιριαγμένα με πελάτη" : "Matched to customer"}</p>
          <p class="font-heading text-3xl font-bold mt-1">{matched}</p>
        </div>
      </section>

      <!-- Inbound table -->
      <section class="mt-8" data-table-wrap="inbound">
        <h2 class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">📥 {isEl ? "Εισερχόμενα μηνύματα" : "Inbound messages"}</h2>
        <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
          <input type="text" class="js-filter-from rounded-lg bg-black/40 border border-white/10 px-2 py-1 w-36" placeholder={isEl ? "Φίλτρο Από" : "Filter From"} />
          <input type="text" class="js-filter-to rounded-lg bg-black/40 border border-white/10 px-2 py-1 w-36" placeholder={isEl ? "Φίλτρο Προς" : "Filter To"} />
          <input type="date" class="js-filter-date-from rounded-lg bg-black/40 border border-white/10 px-2 py-1 [color-scheme:dark]" />
          <span class="text-white/40">→</span>
          <input type="date" class="js-filter-date-to rounded-lg bg-black/40 border border-white/10 px-2 py-1 [color-scheme:dark]" />
          <button class="js-filter-clear rounded-lg bg-white/10 hover:bg-white/20 px-3 py-1">✕ {isEl ? "Καθαρισμός" : "Clear"}</button>
          <span class="js-filter-count ml-2 text-white/50"></span>
          {isSuper && (
            <button class="js-delete-all ml-auto rounded-lg bg-rose-600 hover:bg-rose-500 text-white px-3 py-1 font-semibold" data-table-key="inbound">🗑 {isEl ? "Διαγραφή όλων" : "Delete all"}</button>
          )}
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[11px] uppercase tracking-wider text-white/55">
              <tr class="border-b border-white/10">
                <th class="text-left py-2 px-3"></th>
                <th class="text-left py-2 px-3">{isEl ? "Από" : "From"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Προς" : "To"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Χρήστης" : "User"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Μήνυμα" : "Message"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Πότε" : "When"}</th>
                <th class="text-right py-2 px-3"></th>
              </tr>
            </thead>
            <tbody>
              {(messages ?? []).length === 0 ? (
                <tr><td colspan="7" class="py-10 text-center text-white/40">{isEl ? "Καμία εισερχόμενη επικοινωνία ακόμη." : "No inbound messages yet."}</td></tr>
              ) : (messages ?? []).map((m: any) => (
                <>
                <tr class={`border-b border-white/5 js-filter-row ${!m.handled ? "bg-amber-400/[0.03]" : ""}`} data-msg={m.id} data-from={m.from_address ?? ""} data-to={m.to_address ?? ""} data-when={m.received_at}>
                  <td class="py-2 px-3 text-xl">{channelIcon[m.channel] ?? "📨"}</td>
                  <td class="py-2 px-3 font-mono text-xs text-white/70">{m.from_address}</td>
                  <td class="py-2 px-3 font-mono text-xs text-white/50">{m.to_address ?? "—"}</td>
                  <td class="py-2 px-3 text-xs">
                    {m.matched_user_id
                      ? <span class="text-emerald-300">✓ {nameMap.get(m.matched_user_id) ?? "—"}</span>
                      : <span class="text-white/40">—</span>}
                  </td>
                  <td class="py-2 px-3 max-w-md">
                    <p class="text-white/85 whitespace-pre-wrap line-clamp-3">{m.text ?? <span class="text-white/40">[{m.message_type}]</span>}</p>
                  </td>
                  <td class="py-2 px-3 text-xs text-white/60 whitespace-nowrap">{new Date(m.received_at).toLocaleString()}</td>
                  <td class="py-2 px-3 text-right whitespace-nowrap">
                    <button class="js-reply-open rounded-lg bg-emerald-500/80 hover:bg-emerald-500 text-white px-3 py-1 text-xs font-semibold mr-1">↩ {isEl ? "Απάντηση" : "Reply"}</button>
                    {m.handled
                      ? <span class="text-emerald-300 text-xs">✓</span>
                      : <button class="js-handle rounded-lg bg-white/10 hover:bg-white/20 px-3 py-1 text-xs font-semibold">{isEl ? "✓" : "✓"}</button>}
                  </td>
                </tr>
                <tr class="js-reply-row hidden bg-black/40" data-reply-row={m.id}>
                  <td colspan="7" class="p-3">
                    <div class="flex items-start gap-2">
                      <textarea class="js-reply-text flex-1 rounded-lg bg-black/40 border border-white/15 px-3 py-2 text-sm" rows="2" placeholder={isEl ? "Γράψε την απάντησή σου…" : "Type your reply…"}></textarea>
                      <div class="flex flex-col gap-1">
                        <button class="js-reply-send rounded-lg bg-emerald-500 hover:bg-emerald-400 text-white text-xs font-bold px-3 py-2">📤 {isEl ? "Αποστολή" : "Send"}</button>
                        <button class="js-reply-cancel rounded-lg bg-white/10 hover:bg-white/20 text-white text-xs px-3 py-1">{isEl ? "Άκυρο" : "Cancel"}</button>
                      </div>
                    </div>
                    <p class="text-[11px] text-white/45 mt-1">{isEl ? `Θα σταλεί μέσω ${m.channel} σε ${m.from_address}` : `Will send via ${m.channel} to ${m.from_address}`}</p>
                    <p class="js-reply-status mt-1 text-xs"></p>
                  </td>
                </tr>
                </>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Status receipts -->
      <section class="mt-8" data-table-wrap="status">
        <h2 class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">📤 {isEl ? "Status παράδοσης (τελευταία 50)" : "Delivery receipts (last 50)"}</h2>
        <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
          <input type="text" class="js-filter-to rounded-lg bg-black/40 border border-white/10 px-2 py-1 w-36" placeholder={isEl ? "Φίλτρο Προς" : "Filter To"} />
          <input type="date" class="js-filter-date-from rounded-lg bg-black/40 border border-white/10 px-2 py-1 [color-scheme:dark]" />
          <span class="text-white/40">→</span>
          <input type="date" class="js-filter-date-to rounded-lg bg-black/40 border border-white/10 px-2 py-1 [color-scheme:dark]" />
          <button class="js-filter-clear rounded-lg bg-white/10 hover:bg-white/20 px-3 py-1">✕ {isEl ? "Καθαρισμός" : "Clear"}</button>
          <span class="js-filter-count ml-2 text-white/50"></span>
          {isSuper && (
            <button class="js-delete-all ml-auto rounded-lg bg-rose-600 hover:bg-rose-500 text-white px-3 py-1 font-semibold" data-table-key="status">🗑 {isEl ? "Διαγραφή όλων" : "Delete all"}</button>
          )}
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[11px] uppercase tracking-wider text-white/55">
              <tr class="border-b border-white/10">
                <th class="text-left py-2 px-3">{isEl ? "Κανάλι" : "Channel"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Προς" : "To"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Κατάσταση" : "Status"}</th>
                <th class="text-left py-2 px-3">{isEl ? "UUID" : "UUID"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Σφάλμα" : "Error"}</th>
                <th class="text-right py-2 px-3">{isEl ? "Κόστος" : "Cost"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Πότε" : "When"}</th>
              </tr>
            </thead>
            <tbody>
              {(recentStatus ?? []).length === 0 ? (
                <tr><td colspan="7" class="py-10 text-center text-white/40">{isEl ? "Δεν έχει φτάσει κανένα status ακόμη." : "No status receipts yet."}</td></tr>
              ) : (recentStatus ?? []).map((s: any) => (
                <tr class="border-b border-white/5 js-filter-row" data-to={s.to_address ?? ""} data-when={s.received_at}>
                  <td class="py-2 px-3">{channelIcon[s.channel] ?? "📨"} {s.channel}</td>
                  <td class="py-2 px-3 font-mono text-xs text-white/70">{(s as any).to_address ?? "—"}</td>
                  <td class={`py-2 px-3 font-semibold ${statusColor[s.status] ?? "text-white/70"}`}>{s.status}</td>
                  <td class="py-2 px-3 font-mono text-[11px] text-white/50">{s.message_uuid ? s.message_uuid.slice(0, 8) + "…" : "—"}</td>
                  <td class="py-2 px-3 text-xs text-rose-300/80">{s.error_reason ?? "—"}</td>
                  <td class="py-2 px-3 text-right font-mono text-xs">{s.price_eur ? "€" + Number(s.price_eur).toFixed(4) : "—"}</td>
                  <td class="py-2 px-3 text-xs text-white/60 whitespace-nowrap">{new Date(s.received_at).toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
      <!-- Voice calls -->
      <section class="mt-8" data-table-wrap="calls">
        <h2 class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">📞 {isEl ? "Κλήσεις φωνής" : "Voice calls"}</h2>
        <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
          <input type="text" class="js-filter-from rounded-lg bg-black/40 border border-white/10 px-2 py-1 w-36" placeholder={isEl ? "Φίλτρο Από" : "Filter From"} />
          <input type="text" class="js-filter-to rounded-lg bg-black/40 border border-white/10 px-2 py-1 w-36" placeholder={isEl ? "Φίλτρο Προς" : "Filter To"} />
          <input type="date" class="js-filter-date-from rounded-lg bg-black/40 border border-white/10 px-2 py-1 [color-scheme:dark]" />
          <span class="text-white/40">→</span>
          <input type="date" class="js-filter-date-to rounded-lg bg-black/40 border border-white/10 px-2 py-1 [color-scheme:dark]" />
          <button class="js-filter-clear rounded-lg bg-white/10 hover:bg-white/20 px-3 py-1">✕ {isEl ? "Καθαρισμός" : "Clear"}</button>
          <span class="js-filter-count ml-2 text-white/50"></span>
          {isSuper && (
            <button class="js-delete-all ml-auto rounded-lg bg-rose-600 hover:bg-rose-500 text-white px-3 py-1 font-semibold" data-table-key="calls">🗑 {isEl ? "Διαγραφή όλων" : "Delete all"}</button>
          )}
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[11px] uppercase tracking-wider text-white/55">
              <tr class="border-b border-white/10">
                <th class="text-left py-2 px-3">{isEl ? "Κατεύθυνση" : "Direction"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Από" : "From"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Προς" : "To"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Χρήστης" : "User"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Κατάσταση" : "Status"}</th>
                <th class="text-right py-2 px-3">{isEl ? "Διάρκεια" : "Duration"}</th>
                <th class="text-right py-2 px-3">{isEl ? "Κόστος" : "Cost"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Ηχογράφηση" : "Recording"}</th>
                <th class="text-left py-2 px-3">{isEl ? "Πότε" : "When"}</th>
              </tr>
            </thead>
            <tbody>
              {(calls ?? []).length === 0 ? (
                <tr><td colspan="9" class="py-10 text-center text-white/40">{isEl ? "Δεν έχουν έρθει κλήσεις ακόμη." : "No calls yet."}</td></tr>
              ) : (calls ?? []).map((c: any) => (
                <tr class="border-b border-white/5 js-filter-row" data-from={c.from_address ?? ""} data-to={c.to_address ?? ""} data-when={c.started_at}>
                  <td class="py-2 px-3">{c.direction === "inbound" ? "📲" : "📤"} <span class="text-xs text-white/60">{c.direction}</span></td>
                  <td class="py-2 px-3 font-mono text-xs text-white/70">{c.from_address ?? "—"}</td>
                  <td class="py-2 px-3 font-mono text-xs text-white/50">{c.to_address ?? "—"}</td>
                  <td class="py-2 px-3 text-xs">
                    {c.matched_user_id
                      ? <span class="text-emerald-300">✓ {callNameMap.get(c.matched_user_id) ?? "—"}</span>
                      : <span class="text-white/40">—</span>}
                  </td>
                  <td class={`py-2 px-3 font-semibold ${statusColor[c.status] ?? "text-white/70"}`}>{c.status}</td>
                  <td class="py-2 px-3 text-right font-mono text-xs">{fmtDuration(c.duration_sec)}</td>
                  <td class="py-2 px-3 text-right font-mono text-xs">{c.price_eur ? "€" + Number(c.price_eur).toFixed(4) : "—"}</td>
                  <td class="py-2 px-3">
                    {c.recording_url
                      ? (() => {
                          // Extract the UUID from Vonage's URL and route through our authenticated proxy.
                          const m = String(c.recording_url).match(/\/v1\/files\/([a-f0-9-]{20,})/i);
                          const proxyUrl = m ? `/api/vonage/recording?uuid=${m[1]}` : c.recording_url;
                          return <a href={proxyUrl} target="_blank" class="text-sky-300 hover:text-sky-200 text-xs">🎙 {isEl ? "Ακρόαση" : "Listen"}</a>;
                        })()
                      : <span class="text-white/30 text-xs">—</span>}
                  </td>
                  <td class="py-2 px-3 text-xs text-white/60 whitespace-nowrap">{new Date(c.started_at).toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-[11px] text-white/40">
          {isEl
            ? "Συμβουλή: βάλε στο Vonage App → Voice → Answer URL: https://sallysbar.gr/api/vonage/voice-answer · Event URL: https://sallysbar.gr/api/vonage/voice-events"
            : "Tip: in Vonage App → Voice → Answer URL: https://sallysbar.gr/api/vonage/voice-answer · Event URL: https://sallysbar.gr/api/vonage/voice-events"}
        </p>
      </section>
    </main>

    <script is:inline>
      // Filters — scoped per table-wrap. Pure client-side over already-loaded rows.
      function applyFilter(wrap) {
        const f = (sel) => wrap.querySelector(sel);
        const fromQ = (f(".js-filter-from")?.value ?? "").trim().toLowerCase();
        const toQ   = (f(".js-filter-to")?.value   ?? "").trim().toLowerCase();
        const dfrom = f(".js-filter-date-from")?.value;
        const dto   = f(".js-filter-date-to")?.value;
        const dfromT = dfrom ? new Date(dfrom + "T00:00:00").getTime() : null;
        const dtoT   = dto   ? new Date(dto   + "T23:59:59").getTime() : null;

        let shown = 0, total = 0;
        wrap.querySelectorAll(".js-filter-row").forEach((row) => {
          total++;
          const from = (row.getAttribute("data-from") ?? "").toLowerCase();
          const to   = (row.getAttribute("data-to")   ?? "").toLowerCase();
          const when = row.getAttribute("data-when");
          const t    = when ? new Date(when).getTime() : null;

          const pass =
            (fromQ === "" || from.includes(fromQ)) &&
            (toQ === ""   || to.includes(toQ))   &&
            (!dfromT || (t !== null && t >= dfromT)) &&
            (!dtoT   || (t !== null && t <= dtoT));

          row.style.display = pass ? "" : "none";
          // Hide the reply-form twin row when the parent is hidden
          const id = row.getAttribute("data-msg");
          if (id) {
            const twin = wrap.querySelector(`tr[data-reply-row="${id}"]`);
            if (twin && !pass) twin.classList.add("hidden");
          }
          if (pass) shown++;
        });
        const countEl = f(".js-filter-count");
        if (countEl) countEl.textContent = shown === total ? "" : `${shown} / ${total}`;
      }

      document.querySelectorAll("[data-table-wrap]").forEach((wrap) => {
        ["input", "change"].forEach(ev => {
          wrap.querySelectorAll(".js-filter-from, .js-filter-to, .js-filter-date-from, .js-filter-date-to").forEach(el => el.addEventListener(ev, () => applyFilter(wrap)));
        });
        wrap.querySelector(".js-filter-clear")?.addEventListener("click", () => {
          wrap.querySelectorAll("input").forEach((i) => { i.value = ""; });
          applyFilter(wrap);
        });
      });

      // Delete all — per table, super_admin only (button only rendered for super_admin).
      document.querySelectorAll(".js-delete-all").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const key = btn.getAttribute("data-table-key");
          if (!confirm(`Delete ALL rows from ${key}? This cannot be undone.`)) return;
          btn.disabled = true;
          const r = await fetch("/api/admin/inbox-clear", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ table: key }),
          });
          const j = await r.json().catch(() => ({}));
          if (j.ok) location.reload();
          else { alert("Failed: " + (j.error ?? r.status)); btn.disabled = false; }
        });
      });

      document.addEventListener("click", async (e) => {
        const t = e.target;
        if (!(t instanceof HTMLElement)) return;

        // Mark handled
        const handleBtn = t.closest(".js-handle");
        if (handleBtn) {
          const tr = handleBtn.closest("tr[data-msg]");
          const id = tr.getAttribute("data-msg");
          handleBtn.disabled = true;
          const r = await fetch("/api/admin/inbox-handle", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id }),
          });
          if (r.ok) location.reload();
          else { handleBtn.disabled = false; alert("Failed"); }
          return;
        }

        // Toggle reply form
        const openBtn = t.closest(".js-reply-open");
        if (openBtn) {
          const tr = openBtn.closest("tr[data-msg]");
          const id = tr.getAttribute("data-msg");
          const row = document.querySelector(`tr[data-reply-row="${id}"]`);
          if (row) {
            row.classList.toggle("hidden");
            row.querySelector(".js-reply-text")?.focus();
          }
          return;
        }

        // Cancel reply
        const cancelBtn = t.closest(".js-reply-cancel");
        if (cancelBtn) {
          cancelBtn.closest(".js-reply-row").classList.add("hidden");
          return;
        }

        // Send reply
        const sendBtn = t.closest(".js-reply-send");
        if (sendBtn) {
          const row = sendBtn.closest(".js-reply-row");
          const id = row.getAttribute("data-reply-row");
          const text = row.querySelector(".js-reply-text").value.trim();
          const status = row.querySelector(".js-reply-status");
          if (!text) { status.innerHTML = '<span class="text-rose-300">⚠ Empty message</span>'; return; }
          sendBtn.disabled = true;
          status.innerHTML = '<span class="text-sky-300">Sending…</span>';
          const r = await fetch("/api/admin/inbox-reply", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: Number(id), text }),
          });
          const j = await r.json().catch(() => ({}));
          if (j.ok) {
            status.innerHTML = '<span class="text-emerald-300">✅ Sent</span>';
            setTimeout(() => location.reload(), 800);
          } else {
            status.innerHTML = `<span class="text-rose-300">❌ ${j.error ?? "failed"}</span>`;
            sendBtn.disabled = false;
          }
          return;
        }
      });
    </script>
  </body>
</html>
