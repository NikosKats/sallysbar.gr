---
import "../../styles/global.css";
import { supabaseAdmin } from "../../lib/supabase";
import { withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (Astro.locals.role !== "admin") {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}

const id = Astro.url.searchParams.get("id");
const { data: c } = id
  ? await supabaseAdmin.from("campaigns").select("*").eq("id", id).maybeSingle()
  : { data: null };

if (!c) {
  return Astro.redirect(withLangPrefix(lang, "/admin/marketing"));
}

const shortUrl = `https://sallysbar.gr/r/${c.slug}`;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{c.name} — Poster</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      :root { color-scheme: dark; }
      body { margin: 0; background: #0b0b10; color: white; font-family: system-ui, -apple-system, sans-serif; }
      .toolbar { position: sticky; top: 0; z-index: 10; display: flex; gap: 10px; align-items: center; justify-content: space-between;
        padding: 14px 20px; background: #111118; border-bottom: 1px solid rgba(255,255,255,0.1); }
      .toolbar a, .toolbar button { font: inherit; cursor: pointer; border-radius: 10px; padding: 8px 14px; font-weight: 600; font-size: 13px; }
      .back { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.2); text-decoration: none; }
      .print-btn { background: #fbbf24; color: #000; border: 0; }
      .stage { padding: 30px 20px; display: flex; justify-content: center; }

      .poster {
        width: 210mm; height: 297mm; background: linear-gradient(135deg, #0f0f18 0%, #1a1220 50%, #0f0f18 100%);
        color: white; position: relative; overflow: hidden; padding: 22mm 18mm; box-sizing: border-box;
        display: flex; flex-direction: column; align-items: center; text-align: center;
      }
      .poster::before {
        content: ""; position: absolute; inset: 0;
        background:
          radial-gradient(circle at 20% 10%, rgba(251,191,36,0.25), transparent 40%),
          radial-gradient(circle at 80% 90%, rgba(217,70,239,0.22), transparent 45%);
        pointer-events: none;
      }
      .poster > * { position: relative; }
      .brand { font-size: 10pt; letter-spacing: 0.3em; text-transform: uppercase; color: #fcd34d; margin-bottom: 8mm; }
      .title { font-size: 42pt; font-weight: 800; line-height: 0.95; margin: 0 0 8mm;
        background: linear-gradient(135deg, #fef3c7 0%, #fbbf24 60%, #f59e0b 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent; }
      .subtitle { font-size: 14pt; color: rgba(255,255,255,0.75); max-width: 150mm; margin: 0 0 12mm; line-height: 1.4; }

      .qr-wrap { background: white; border-radius: 8mm; padding: 8mm; box-shadow: 0 10mm 30mm rgba(0,0,0,0.5); }
      canvas { display: block; }

      .scan-cta { font-size: 18pt; font-weight: 700; color: #fcd34d; margin-top: 10mm; letter-spacing: 0.05em; }
      .url-line { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11pt; color: rgba(255,255,255,0.6); margin-top: 4mm; }
      .footer { margin-top: auto; font-size: 10pt; color: rgba(255,255,255,0.45); }

      @media print {
        @page { size: A4; margin: 0; }
        .toolbar { display: none; }
        .stage { padding: 0; }
        body { background: white; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <a class="back" href="/admin/marketing">← {isEl ? "Πίσω" : "Back"}</a>
      <button class="print-btn" onclick="window.print()">🖨 {isEl ? "Εκτύπωση A4" : "Print A4"}</button>
    </div>
    <div class="stage">
      <div class="poster">
        <div class="brand">Sally's Bar · Skala · Kefalonia</div>
        <h1 class="title">{c.name}</h1>
        {c.description && <p class="subtitle">{c.description}</p>}
        <div class="qr-wrap"><canvas id="qr" data-url={shortUrl}></canvas></div>
        <p class="scan-cta">{isEl ? "Σκάναρε & ανοίξει" : "Scan to open"}</p>
        <p class="url-line">{shortUrl.replace(/^https?:\/\//, "")}</p>
        <div class="footer">sallysbar.gr</div>
      </div>
    </div>

    <script>
      import QRCode from "qrcode";
      const canvas = document.getElementById("qr") as HTMLCanvasElement;
      const url = canvas?.dataset.url ?? "";
      if (canvas && url) {
        QRCode.toCanvas(canvas, url, {
          width: 420, margin: 1, color: { dark: "#0a0a0f", light: "#ffffff" }, errorCorrectionLevel: "H",
        }).catch((e: unknown) => console.error("QR render failed", e));
      }
    </script>
  </body>
</html>
