---
import "../../styles/global.css";
import { supabaseAdmin } from "../../lib/supabase";
import { withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!["admin","super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}

const id = Astro.url.searchParams.get("id");
const { data: c } = id
  ? await supabaseAdmin.from("campaigns").select("*").eq("id", id).maybeSingle()
  : { data: null };

if (!c) {
  return Astro.redirect(withLangPrefix(lang, "/admin/marketing"));
}

const shortUrl = `https://sallysbar.gr/r/${c.slug}`;

// Split any leading emoji + whitespace from the title so we can render it
// without the gradient clip that kills emoji colours.
function splitEmoji(title: string): { emoji: string; rest: string } {
  const m = title.match(/^([\p{Extended_Pictographic}\p{Emoji_Presentation}\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]+)\s*(.*)$/u);
  if (m) return { emoji: m[1], rest: m[2] };
  return { emoji: "", rest: title };
}
const titleParts = splitEmoji(c.name ?? "");

type Template = "gold" | "elegant" | "noir" | "aegean" | "minimal";
const TEMPLATES: Template[] = ["gold", "elegant", "noir", "aegean", "minimal"];
const templateRaw = String(Astro.url.searchParams.get("template") ?? "gold").toLowerCase();
const template: Template = (TEMPLATES as string[]).includes(templateRaw) ? (templateRaw as Template) : "gold";

const qrDark =
  template === "noir"    ? "#d4af37" :
  template === "aegean"  ? "#0e4d8b" :
  template === "minimal" ? "#14213d" :
  template === "elegant" ? "#2a3f54" :
                           "#0a0a0f"; // gold
const pngBg =
  template === "noir"    ? "#0a0a0a" :
  template === "aegean"  ? "#f7f4ea" :
  template === "minimal" ? "#ffffff" :
  template === "elegant" ? "#f5ecd3" :
                           "#0f0f18"; // gold

const TEMPLATE_OPTIONS: Array<{ value: Template; labelEn: string; labelEl: string }> = [
  { value: "gold",    labelEn: "✨ Gold (dark)",            labelEl: "✨ Χρυσό (σκοτεινό)" },
  { value: "elegant", labelEn: "🌿 Elegant (cream)",        labelEl: "🌿 Κομψό (κρεμ)" },
  { value: "noir",    labelEn: "🖤 Noir (black & gold)",    labelEl: "🖤 Noir (μαύρο & χρυσό)" },
  { value: "aegean",  labelEn: "🇬🇷 Aegean (Greek isle)",    labelEl: "🇬🇷 Αιγαίο" },
  { value: "minimal", labelEn: "⬜ Minimal (white)",         labelEl: "⬜ Minimal (λευκό)" },
];
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{c.name} — Poster</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root { color-scheme: light; }
      body { margin: 0; background: #1a1a20; font-family: "Inter", system-ui, sans-serif; }

      .toolbar { position: sticky; top: 0; z-index: 10; display: flex; gap: 10px; align-items: center; justify-content: space-between;
        padding: 14px 20px; background: #111118; border-bottom: 1px solid rgba(255,255,255,0.1); color: #fff; }
      .toolbar a, .toolbar button, .toolbar select {
        font: inherit; cursor: pointer; border-radius: 10px; padding: 8px 14px; font-weight: 600; font-size: 13px;
        background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.18);
      }
      .back { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.2); text-decoration: none; }
      .print-btn { background: #fbbf24 !important; color: #000 !important; border: 0 !important; }
      .stage { padding: 30px 20px; display: flex; justify-content: center; }

      .poster { width: 210mm; height: 297mm; position: relative; overflow: hidden;
        padding: 22mm 18mm; box-sizing: border-box;
        display: flex; flex-direction: column; align-items: center; text-align: center; }
      .title-emoji { display: inline-block; line-height: 1; flex-shrink: 0; }

      /* ─────────────────────── GOLD (dark) ─────────────────────── */
      .poster.gold { background: linear-gradient(135deg, #0f0f18 0%, #1a1220 50%, #0f0f18 100%); color: #fff; }
      .poster.gold::before {
        content: ""; position: absolute; inset: 0;
        background: radial-gradient(circle at 20% 10%, rgba(251,191,36,0.25), transparent 40%), radial-gradient(circle at 80% 90%, rgba(217,70,239,0.22), transparent 45%);
        pointer-events: none;
      }
      .poster.gold > * { position: relative; z-index: 1; }
      .poster.gold .brand { font-size: 10pt; letter-spacing: 0.3em; text-transform: uppercase; color: #fcd34d; margin-bottom: 8mm; }
      .poster.gold .title { font-size: 42pt; font-weight: 800; line-height: 1.05; margin: 0 0 8mm; display: flex; align-items: center; justify-content: center; gap: 0.2em; flex-wrap: wrap; }
      .poster.gold .title-text {
        background: linear-gradient(135deg, #fef3c7 0%, #fbbf24 60%, #f59e0b 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .poster.gold .subtitle { font-size: 14pt; color: rgba(255,255,255,0.75); max-width: 150mm; margin: 0 0 12mm; line-height: 1.4; }
      .poster.gold .qr-wrap { background: white; border-radius: 8mm; padding: 8mm; box-shadow: 0 10mm 30mm rgba(0,0,0,0.5); }
      .poster.gold canvas { display: block; width: 100mm !important; height: 100mm !important; }
      .poster.gold .scan-cta { font-size: 18pt; font-weight: 700; color: #fcd34d; margin-top: 10mm; letter-spacing: 0.05em; }
      .poster.gold .url-line { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11pt; color: rgba(255,255,255,0.7); margin-top: 4mm; }
      .poster.gold .footer { margin-top: auto; font-family: "Inter", sans-serif; font-size: 11pt; font-weight: 600; color: #fcd34d; letter-spacing: 0.04em;
        background: rgba(252,211,77,0.08); border-top: 1px solid rgba(252,211,77,0.35); border-bottom: 1px solid rgba(252,211,77,0.35); padding: 3mm 6mm; }

      /* ─────────────────────── ELEGANT ─────────────────────── */
      .poster.elegant { background: linear-gradient(180deg, #f5ecd3 0%, #efe3c2 100%); color: #2a3f54; padding: 18mm 16mm; }
      .poster.elegant .leaf { position: absolute; width: 72mm; height: 72mm; opacity: 0.55; pointer-events: none; }
      .poster.elegant .leaf.tl { top: -8mm; left: -12mm; }
      .poster.elegant .leaf.tr { top: -8mm; right: -12mm; transform: scaleX(-1); }
      .poster.elegant .leaf.bl { bottom: -8mm; left: -12mm; transform: scaleY(-1); }
      .poster.elegant .leaf.br { bottom: -8mm; right: -12mm; transform: scale(-1, -1); }
      .poster.elegant > *:not(.leaf) { position: relative; z-index: 1; }
      .poster.elegant .brand { font-family: "Inter", sans-serif; font-size: 10pt; letter-spacing: 0.3em; text-transform: uppercase; color: #8a7a4a; margin: 4mm 0 5mm; font-weight: 600; }
      .poster.elegant .title { display: flex; align-items: center; justify-content: center; gap: 0.25em; flex-wrap: wrap; margin: 0 0 4mm; }
      .poster.elegant .title-text { font-family: "Cormorant Garamond", serif; font-size: 44pt; font-weight: 700; font-style: italic; color: #2a3f54; line-height: 1.02; }
      .poster.elegant .divider { display: flex; align-items: center; justify-content: center; gap: 3mm; margin: 5mm 0 5mm; width: 90mm; }
      .poster.elegant .divider::before, .poster.elegant .divider::after { content: ""; flex: 1; height: 0.3mm; background: #c9a227; }
      .poster.elegant .divider .dot { width: 2mm; height: 2mm; background: #c9a227; transform: rotate(45deg); }
      .poster.elegant .subtitle { font-family: "Cormorant Garamond", serif; font-size: 16pt; font-style: italic; color: #4f5a68; max-width: 160mm; margin: 0 0 8mm; line-height: 1.4; }
      .poster.elegant .qr-frame { background: #d9d4c7; padding: 6mm; border-radius: 1mm; }
      .poster.elegant .qr-inner { background: #fff; border: 0.3mm solid #c9a227; padding: 5mm; border-radius: 1mm; }
      .poster.elegant canvas { display: block; width: 90mm !important; height: 90mm !important; }
      .poster.elegant .scan-cta { font-family: "Cormorant Garamond", serif; font-size: 20pt; font-weight: 700; font-style: italic; color: #2a3f54; margin-top: 6mm; }
      .poster.elegant .url-line { font-family: ui-monospace, Menlo, monospace; font-size: 11pt; color: #8a7a4a; margin-top: 2mm; }
      .poster.elegant .footer { margin-top: auto; font-family: "Inter", sans-serif; font-size: 10.5pt; font-weight: 600; color: #2a3f54; letter-spacing: 0.02em;
        background: rgba(201,162,39,0.14); border-top: 0.3mm solid #c9a227; border-bottom: 0.3mm solid #c9a227; padding: 2.5mm 6mm; }

      /* ─────────────────────── NOIR ─────────────────────── */
      .poster.noir { background: radial-gradient(ellipse at top, #1a1611 0%, #0a0a0a 70%); color: #e8d9a8; }
      .poster.noir::before { content: ""; position: absolute; inset: 10mm; border: 0.3mm solid rgba(212,175,55,0.45); pointer-events: none; }
      .poster.noir::after { content: ""; position: absolute; inset: 11mm; border: 0.15mm solid rgba(212,175,55,0.25); pointer-events: none; }
      .poster.noir > * { position: relative; z-index: 1; }
      .poster.noir .brand-rule { display: flex; align-items: center; gap: 3mm; margin: 6mm 0 4mm; }
      .poster.noir .brand-rule::before, .poster.noir .brand-rule::after { content: ""; width: 22mm; height: 0.3mm; background: #d4af37; }
      .poster.noir .brand { font-family: "Inter", sans-serif; font-size: 9pt; letter-spacing: 0.45em; text-transform: uppercase; color: #d4af37; font-weight: 600; }
      .poster.noir .title { display: flex; align-items: center; justify-content: center; gap: 0.25em; flex-wrap: wrap; margin: 5mm 0 5mm; }
      .poster.noir .title-text {
        font-family: "Playfair Display", serif; font-size: 38pt; font-weight: 700; font-style: italic; line-height: 1.02;
        background: linear-gradient(180deg, #f5d577 0%, #d4af37 50%, #a67c0a 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .poster.noir .subtitle { font-family: "Playfair Display", serif; font-size: 14pt; font-style: italic; color: #c9a855; max-width: 160mm; margin: 0 0 8mm; line-height: 1.4; }
      .poster.noir .qr-frame { padding: 3mm; border: 0.4mm solid #d4af37; border-radius: 0; }
      .poster.noir .qr-inner { background: #f5efd8; padding: 5mm; }
      .poster.noir canvas { display: block; width: 86mm !important; height: 86mm !important; }
      .poster.noir .scan-cta { font-family: "Playfair Display", serif; font-size: 18pt; font-style: italic; color: #d4af37; margin-top: 7mm; letter-spacing: 0.03em; }
      .poster.noir .url-line { font-family: ui-monospace, Menlo, monospace; font-size: 10pt; color: #a69466; margin-top: 2mm; letter-spacing: 0.04em; }
      .poster.noir .footer { margin-top: auto; font-family: "Inter", sans-serif; font-size: 10pt; font-weight: 600; color: #f1e4b8; letter-spacing: 0.08em;
        background: rgba(212,175,55,0.1); border-top: 0.3mm solid #d4af37; border-bottom: 0.3mm solid #d4af37; padding: 2.5mm 6mm; }

      /* ─────────────────────── AEGEAN ─────────────────────── */
      .poster.aegean { background: #f7f4ea; color: #0e4d8b; padding: 20mm 16mm; }
      .poster.aegean .meander { position: absolute; left: 0; right: 0; height: 14mm; background-repeat: repeat-x; background-size: 28mm 14mm; background-position: center; opacity: 0.9; }
      .poster.aegean .meander.top { top: 0; }
      .poster.aegean .meander.bot { bottom: 0; transform: scaleY(-1); }
      .poster.aegean > *:not(.meander) { position: relative; z-index: 1; }
      .poster.aegean .brand { font-family: "Inter", sans-serif; font-size: 10pt; letter-spacing: 0.32em; text-transform: uppercase; color: #cd5d42; margin: 12mm 0 3mm; font-weight: 600; }
      .poster.aegean .title { display: flex; align-items: center; justify-content: center; gap: 0.25em; flex-wrap: wrap; margin: 0 0 3mm; }
      .poster.aegean .title-text { font-family: "Playfair Display", serif; font-size: 40pt; font-weight: 700; color: #0e4d8b; line-height: 1.02; }
      .poster.aegean .divider { display: flex; align-items: center; justify-content: center; gap: 3mm; margin: 4mm 0 5mm; width: 100mm; }
      .poster.aegean .divider::before, .poster.aegean .divider::after { content: ""; flex: 1; height: 0.3mm; background: #cd5d42; }
      .poster.aegean .divider .dot { width: 2.5mm; height: 2.5mm; border: 0.3mm solid #cd5d42; background: transparent; border-radius: 50%; }
      .poster.aegean .subtitle { font-family: "Playfair Display", serif; font-size: 15pt; font-style: italic; color: #4a7bab; max-width: 160mm; margin: 0 0 8mm; line-height: 1.4; }
      .poster.aegean .qr-frame { background: #fff; padding: 4mm; border: 0.4mm solid #0e4d8b; }
      .poster.aegean .qr-inner { padding: 3mm; border: 0.2mm solid rgba(14,77,139,0.25); }
      .poster.aegean canvas { display: block; width: 88mm !important; height: 88mm !important; }
      .poster.aegean .scan-cta { font-family: "Playfair Display", serif; font-size: 18pt; font-weight: 700; color: #0e4d8b; margin-top: 6mm; }
      .poster.aegean .url-line { font-family: ui-monospace, Menlo, monospace; font-size: 11pt; color: #cd5d42; margin-top: 2mm; }
      .poster.aegean .footer { margin-top: auto; font-family: "Inter", sans-serif; font-size: 10.5pt; font-weight: 600; color: #fff; letter-spacing: 0.04em;
        background: #cd5d42; padding: 3mm 6mm; border-radius: 1mm; }

      /* ─────────────────────── MINIMAL ─────────────────────── */
      .poster.minimal { background: #fff; color: #14213d; padding: 24mm 20mm; }
      .poster.minimal .top-rule { width: 24mm; height: 0.5mm; background: #14213d; margin-bottom: 6mm; }
      .poster.minimal .brand { font-family: "Inter", sans-serif; font-size: 10pt; letter-spacing: 0.32em; text-transform: uppercase; color: #14213d; margin-bottom: 5mm; font-weight: 600; }
      .poster.minimal .title { display: flex; align-items: center; justify-content: center; gap: 0.25em; flex-wrap: wrap; margin: 6mm 0 4mm; }
      .poster.minimal .title-text { font-family: "Inter", sans-serif; font-size: 40pt; font-weight: 200; color: #14213d; letter-spacing: -0.02em; line-height: 0.98; }
      .poster.minimal .subtitle { font-family: "Inter", sans-serif; font-size: 12pt; font-weight: 300; color: #6b7280; max-width: 160mm; margin: 0 0 10mm; line-height: 1.5; }
      .poster.minimal .qr-frame { padding: 0; border: 0.4mm solid #14213d; }
      .poster.minimal .qr-inner { padding: 4mm; background: #fff; }
      .poster.minimal canvas { display: block; width: 82mm !important; height: 82mm !important; }
      .poster.minimal .scan-cta { font-family: "Inter", sans-serif; font-size: 10pt; letter-spacing: 0.32em; text-transform: uppercase; color: #14213d; margin-top: 8mm; font-weight: 600; }
      .poster.minimal .url-line { font-family: ui-monospace, Menlo, monospace; font-size: 10pt; color: #6b7280; margin-top: 2mm; }
      .poster.minimal .footer { margin-top: auto; font-family: "Inter", sans-serif; font-size: 10pt; font-weight: 600; color: #14213d; letter-spacing: 0.08em;
        border-top: 0.3mm solid #14213d; border-bottom: 0.3mm solid #14213d; padding: 2.5mm 6mm; }

      @media print {
        @page { size: A4; margin: 0; }
        .toolbar { display: none; }
        .stage { padding: 0; }
        body { background: white; }
        .poster, .poster *, .poster::before, .poster::after {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
        .poster.gold .title-text, .poster.noir .title-text {
          background: none !important;
          -webkit-background-clip: initial !important;
          background-clip: initial !important;
        }
        .poster.gold .title-text { color: #fbbf24 !important; -webkit-text-fill-color: #fbbf24 !important; }
        .poster.noir .title-text { color: #d4af37 !important; -webkit-text-fill-color: #d4af37 !important; }
        .title-emoji { -webkit-text-fill-color: initial !important; color: initial !important; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <a class="back" href="/admin/marketing">← {isEl ? "Πίσω" : "Back"}</a>
      <div style="display:flex;gap:8px;">
        <select id="tplSelect" aria-label="Template">
          {TEMPLATE_OPTIONS.map(o => (
            <option value={o.value} selected={template === o.value}>{isEl ? o.labelEl : o.labelEn}</option>
          ))}
        </select>
        <button id="pngBtn" class="print-btn" style="background:#fff;color:#000;">⬇ {isEl ? "PNG" : "Download PNG"}</button>
        <button class="print-btn" onclick="window.print()">🖨 {isEl ? "Εκτύπωση A4" : "Print A4"}</button>
      </div>
    </div>

    <div class="stage">
      {template === "gold" && (
        <div id="posterEl" class="poster gold">
          <div class="brand">Sally's Bar · Skala · Kefalonia</div>
          <h1 class="title">
            {titleParts.emoji && <span class="title-emoji">{titleParts.emoji}</span>}
            {titleParts.rest && <span class="title-text">{titleParts.rest}</span>}
          </h1>
          {c.description && <p class="subtitle">{c.description}</p>}
          <div class="qr-wrap"><canvas class="camp-qr" data-url={shortUrl} data-dark={qrDark}></canvas></div>
          <p class="scan-cta">{isEl ? "Σκάναρε & ανοίξει" : "Scan to open"}</p>
          <p class="url-line">{shortUrl.replace(/^https?:\/\//, "")}</p>
          <div class="footer">🍹 sallysbar.gr · {isEl ? "Σκάλα Κεφαλονιάς" : "Skala, Kefalonia"}</div>
        </div>
      )}

      {template === "elegant" && (
        <div id="posterEl" class="poster elegant">
          {["tl","tr","bl","br"].map(pos => (
            <svg class={`leaf ${pos}`} viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g stroke="#a8b59a" stroke-width="2" fill="#c4d0b5" opacity="0.9">
                <path d="M20 180 Q 60 120, 120 60 Q 80 80, 60 130 Q 40 160, 20 180 Z"/>
                <path d="M40 160 Q 70 130, 100 100" stroke-width="1.2" fill="none"/>
                <ellipse cx="55" cy="150" rx="6" ry="12" transform="rotate(-35 55 150)"/>
                <ellipse cx="72" cy="130" rx="6" ry="12" transform="rotate(-35 72 130)"/>
                <ellipse cx="90" cy="108" rx="6" ry="12" transform="rotate(-35 90 108)"/>
                <ellipse cx="108" cy="86" rx="6" ry="12" transform="rotate(-35 108 86)"/>
              </g>
            </svg>
          ))}
          <p class="brand">Sally's Bar · Skala · Kefalonia</p>
          <h1 class="title">
            {titleParts.emoji && <span class="title-emoji">{titleParts.emoji}</span>}
            {titleParts.rest && <span class="title-text">{titleParts.rest}</span>}
          </h1>
          <div class="divider"><span class="dot"></span></div>
          {c.description && <p class="subtitle">{c.description}</p>}
          <div class="qr-frame"><div class="qr-inner"><canvas class="camp-qr" data-url={shortUrl} data-dark={qrDark}></canvas></div></div>
          <p class="scan-cta">{isEl ? "Σκανάρετε & Ανακαλύψτε" : "Scan & Discover"}</p>
          <p class="url-line">{shortUrl.replace(/^https?:\/\//, "")}</p>
          <div class="footer">🍹 sallysbar.gr · {isEl ? "Σκάλα Κεφαλονιάς" : "Skala, Kefalonia"}</div>
        </div>
      )}

      {template === "noir" && (
        <div id="posterEl" class="poster noir">
          <div class="brand-rule"><span class="brand">Sally's Bar · Private Invitation</span></div>
          <h1 class="title">
            {titleParts.emoji && <span class="title-emoji">{titleParts.emoji}</span>}
            {titleParts.rest && <span class="title-text">{titleParts.rest}</span>}
          </h1>
          {c.description && <p class="subtitle">{c.description}</p>}
          <div class="qr-frame"><div class="qr-inner"><canvas class="camp-qr" data-url={shortUrl} data-dark={qrDark}></canvas></div></div>
          <p class="scan-cta">{isEl ? "Σκανάρετε για να αποκτήσετε πρόσβαση" : "Scan to reveal"}</p>
          <p class="url-line">{shortUrl.replace(/^https?:\/\//, "")}</p>
          <div class="footer">🍹 sallysbar.gr · {isEl ? "Σκάλα Κεφαλονιάς" : "Skala, Kefalonia"}</div>
        </div>
      )}

      {template === "aegean" && (
        <div id="posterEl" class="poster aegean">
          <div class="meander top" style={`background-image: url("data:image/svg+xml;utf8,${encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 50\"><path d=\"M0 40 L0 20 L20 20 L20 40 L10 40 L10 30 L15 30 L15 35 L12 35 L12 32 L40 32 L40 20 L60 20 L60 40 L50 40 L50 30 L55 30 L55 35 L52 35 L52 32 L80 32 L80 20 L100 20 L100 40 L90 40 L90 30 L95 30 L95 35 L92 35 L92 32 L100 32\" stroke=\"%230e4d8b\" stroke-width=\"2\" fill=\"none\"/></svg>')}")`}></div>
          <div class="meander bot" style={`background-image: url("data:image/svg+xml;utf8,${encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 50\"><path d=\"M0 40 L0 20 L20 20 L20 40 L10 40 L10 30 L15 30 L15 35 L12 35 L12 32 L40 32 L40 20 L60 20 L60 40 L50 40 L50 30 L55 30 L55 35 L52 35 L52 32 L80 32 L80 20 L100 20 L100 40 L90 40 L90 30 L95 30 L95 35 L92 35 L92 32 L100 32\" stroke=\"%230e4d8b\" stroke-width=\"2\" fill=\"none\"/></svg>')}")`}></div>
          <p class="brand">Sally's Bar · Skala · Kefalonia</p>
          <h1 class="title">
            {titleParts.emoji && <span class="title-emoji">{titleParts.emoji}</span>}
            {titleParts.rest && <span class="title-text">{titleParts.rest}</span>}
          </h1>
          <div class="divider"><span class="dot"></span></div>
          {c.description && <p class="subtitle">{c.description}</p>}
          <div class="qr-frame"><div class="qr-inner"><canvas class="camp-qr" data-url={shortUrl} data-dark={qrDark}></canvas></div></div>
          <p class="scan-cta">{isEl ? "Σκανάρετε με την κάμερα" : "Scan with your camera"}</p>
          <p class="url-line">{shortUrl.replace(/^https?:\/\//, "")}</p>
          <div class="footer">🍹 sallysbar.gr · {isEl ? "Σκάλα Κεφαλονιάς" : "Skala, Kefalonia"}</div>
        </div>
      )}

      {template === "minimal" && (
        <div id="posterEl" class="poster minimal">
          <div class="top-rule"></div>
          <p class="brand">Sally's Bar</p>
          <h1 class="title">
            {titleParts.emoji && <span class="title-emoji">{titleParts.emoji}</span>}
            {titleParts.rest && <span class="title-text">{titleParts.rest}</span>}
          </h1>
          {c.description && <p class="subtitle">{c.description}</p>}
          <div class="qr-frame"><div class="qr-inner"><canvas class="camp-qr" data-url={shortUrl} data-dark={qrDark}></canvas></div></div>
          <p class="scan-cta">{isEl ? "Σκανάρετε" : "Scan to open"}</p>
          <p class="url-line">{shortUrl.replace(/^https?:\/\//, "")}</p>
          <div class="footer">🍹 sallysbar.gr · {isEl ? "Σκάλα Κεφαλονιάς" : "Skala, Kefalonia"}</div>
        </div>
      )}
    </div>

    <script>
      import QRCode from "qrcode";
      const canvas = document.querySelector<HTMLCanvasElement>(".camp-qr");
      const url = canvas?.dataset.url ?? "";
      const dark = canvas?.dataset.dark ?? "#0a0a0f";
      if (canvas && url) {
        QRCode.toCanvas(canvas, url, {
          width: 600, margin: 1, color: { dark, light: "#ffffff" }, errorCorrectionLevel: "H",
        }).catch((e: unknown) => console.error("QR render failed", e));
      }
    </script>

    <script is:inline define:vars={{ pngBg }}>
      (function () {
        const sel = document.getElementById("tplSelect");
        if (sel) {
          sel.addEventListener("change", () => {
            const u = new URL(location.href);
            u.searchParams.set("template", sel.value);
            location.href = u.toString();
          });
        }

        const btn = document.getElementById("pngBtn");
        if (!btn) return;
        const poster = document.getElementById("posterEl");
        if (!poster) return;

        btn.addEventListener("click", async () => {
          const origLabel = btn.textContent;
          btn.disabled = true;
          btn.textContent = "…";
          try {
            if (!window.html2canvas) {
              await new Promise(function (resolve, reject) {
                var s = document.createElement("script");
                s.src = "https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js";
                s.onload = resolve; s.onerror = reject;
                document.head.appendChild(s);
              });
            }
            var canvas = await window.html2canvas(poster, {
              backgroundColor: pngBg, scale: 2, useCORS: true, logging: false,
              windowWidth: poster.scrollWidth, windowHeight: poster.scrollHeight,
              onclone: function (doc) {
                // Gradient-clipped text doesn't render in html2canvas.
                // Flatten gold and noir titles to their solid fallbacks.
                var g = doc.querySelectorAll(".poster.gold .title-text");
                for (var i = 0; i < g.length; i++) {
                  var el = g[i];
                  el.style.background = "none"; el.style.backgroundClip = "initial"; el.style.webkitBackgroundClip = "initial";
                  el.style.color = "#fbbf24"; el.style.webkitTextFillColor = "#fbbf24";
                }
                var n = doc.querySelectorAll(".poster.noir .title-text");
                for (var j = 0; j < n.length; j++) {
                  var elj = n[j];
                  elj.style.background = "none"; elj.style.backgroundClip = "initial"; elj.style.webkitBackgroundClip = "initial";
                  elj.style.color = "#d4af37"; elj.style.webkitTextFillColor = "#d4af37";
                }
                var em = doc.querySelectorAll(".title-emoji");
                for (var k = 0; k < em.length; k++) {
                  em[k].style.webkitTextFillColor = "initial";
                  em[k].style.color = "initial";
                }
              },
            });
            var url = canvas.toDataURL("image/png");
            var a = document.createElement("a");
            a.href = url;
            a.download = "sallys-poster-campaign.png";
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
          } catch (e) {
            alert("Couldn't export PNG: " + (e?.message || e));
          } finally {
            btn.disabled = false;
            btn.textContent = origLabel;
          }
        });
      })();
    </script>
  </body>
</html>
