---
import "../../styles/global.css";
import { withLangPrefix } from "../../i18n";
import { supabaseAdmin } from "../../lib/supabase";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!["admin","super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}

const params = Astro.url.searchParams;
const slug = String(params.get("slug") ?? "").trim().toLowerCase();
const ssid = String(params.get("ssid") ?? "").trim();
const password = String(params.get("password") ?? "");
const securityRaw = String(params.get("security") ?? "WPA").toUpperCase();
const security: "WPA" | "WEP" | "nopass" =
  securityRaw === "WEP" ? "WEP" : securityRaw === "NOPASS" ? "nopass" : "WPA";
const hidden = params.get("hidden") === "1";
const logoOverrideRaw = String(params.get("logo") ?? "").trim();
const logoOverride = /^https:\/\//i.test(logoOverrideRaw) ? logoOverrideRaw : "";

type Template = "elegant" | "dark" | "noir" | "aegean" | "minimal";
const TEMPLATES: Template[] = ["elegant", "dark", "noir", "aegean", "minimal"];
const templateRaw = String(params.get("template") ?? "elegant").toLowerCase();
const template: Template = (TEMPLATES as string[]).includes(templateRaw) ? templateRaw as Template : "elegant";

if (!ssid || (security !== "nopass" && !password)) {
  return Astro.redirect(withLangPrefix(lang, "/admin/marketing"));
}

let partner: { name: string; logo_url: string | null; city: string | null } | null = null;
if (slug) {
  const { data } = await supabaseAdmin
    .from("partners")
    .select("name, logo_url, city")
    .eq("slug", slug)
    .maybeSingle();
  if (data) partner = data;
}

const logoUrl = logoOverride || partner?.logo_url || null;
const nameOverride = String(params.get("name") ?? "").trim().slice(0, 120);
const selfPromo = params.get("selfpromo") === "1";

const footerLead = selfPromo
  ? (isEl ? "Ευχαριστούμε που μας επισκεφθήκατε" : "Thank you for visiting")
  : (isEl ? "Απολαύστε ένα ποτό στον συνεργάτη μας" : "Enjoy a drink at our partner");
const footerTail = selfPromo
  ? (isEl ? "Ανοιχτά καθημερινά 18:00–02:00 · Σκάλα, Κεφαλονιά" : "Open daily 6PM–2AM · Skala, Kefalonia")
  : (isEl ? "200μ κάτω στην πλατεία Σκάλας" : "200m down on Skala square");
const welcomeSub = selfPromo
  ? (isEl ? "Καλή σας διασκέδαση" : "Enjoy your evening")
  : (isEl ? "Απολαύστε τη διαμονή σας" : "Enjoy your stay");

function wifiEscape(v: string) {
  return v.replace(/([\\;,:"])/g, "\\$1");
}
const wifiPayload =
  security === "nopass"
    ? `WIFI:T:nopass;S:${wifiEscape(ssid)};${hidden ? "H:true;" : ""};`
    : `WIFI:T:${security};S:${wifiEscape(ssid)};P:${wifiEscape(password)};${hidden ? "H:true;" : ""};`;

const displayName = nameOverride || partner?.name || "";
const ampIdx = displayName.indexOf("&");
const nameMain = ampIdx > 0 ? displayName.slice(0, ampIdx).trim() : displayName;
const nameSub  = ampIdx > 0 ? displayName.slice(ampIdx).trim()  : "";
const initials = (nameMain.split(/\s+/).map(w => w.charAt(0)).join("").slice(0, 2).toUpperCase() || "★");

const qrDark =
  template === "dark"    ? "#0a0a0f" :
  template === "noir"    ? "#d4af37" :
  template === "aegean"  ? "#0e4d8b" :
  template === "minimal" ? "#14213d" :
                           "#2a3f54"; // elegant
const pngBg =
  template === "dark"    ? "#0f0f18" :
  template === "noir"    ? "#0a0a0a" :
  template === "aegean"  ? "#f7f4ea" :
  template === "minimal" ? "#ffffff" :
                           "#f5ecd3"; // elegant

const TEMPLATE_OPTIONS: Array<{ value: Template; labelEn: string; labelEl: string }> = [
  { value: "elegant", labelEn: "🌿 Elegant (cream)",      labelEl: "🌿 Κομψό (κρεμ)" },
  { value: "noir",    labelEn: "🖤 Noir (black & gold)",  labelEl: "🖤 Noir (μαύρο & χρυσό)" },
  { value: "aegean",  labelEn: "🇬🇷 Aegean (Greek isle)",  labelEl: "🇬🇷 Αιγαίο" },
  { value: "minimal", labelEn: "⬜ Minimal (white)",       labelEl: "⬜ Minimal (λευκό)" },
  { value: "dark",    labelEn: "🌙 Dark (navy)",           labelEl: "🌙 Σκοτεινό (μπλε)" },
];
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{displayName ? `${displayName} — WiFi` : "WiFi"}</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root { color-scheme: light; }
      body { margin: 0; background: #1a1a20; font-family: "Inter", system-ui, sans-serif; }

      .toolbar { position: sticky; top: 0; z-index: 10; display: flex; gap: 10px; align-items: center; justify-content: space-between;
        padding: 14px 20px; background: #111118; border-bottom: 1px solid rgba(255,255,255,0.1); color: #fff; }
      .toolbar a, .toolbar button, .toolbar select {
        font: inherit; cursor: pointer; border-radius: 10px; padding: 8px 14px; font-weight: 600; font-size: 13px;
        background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.18);
      }
      .back { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.2); text-decoration: none; }
      .print-btn { background: #fbbf24 !important; color: #000 !important; border: 0 !important; }
      .stage { padding: 30px 20px; display: flex; justify-content: center; }

      .poster {
        width: 210mm; height: 297mm; position: relative; overflow: hidden;
        padding: 18mm 16mm; box-sizing: border-box;
        display: flex; flex-direction: column; align-items: center; text-align: center;
      }

      /* ─────────────────────── ELEGANT ─────────────────────── */
      .poster.elegant {
        background: linear-gradient(180deg, #f5ecd3 0%, #efe3c2 100%); color: #2a3f54;
      }
      /* Luxury double gold border inset — kept behind content */
      .poster.elegant::before {
        content: ""; position: absolute; inset: 8mm;
        border: 0.3mm solid #c9a227; pointer-events: none; z-index: 0;
      }
      .poster.elegant::after {
        content: ""; position: absolute; inset: 9.5mm;
        border: 0.15mm solid rgba(201,162,39,0.35); pointer-events: none; z-index: 0;
      }
      /* Ornamental flourish around headline */
      .poster.elegant .flourish {
        display: flex; align-items: center; justify-content: center; gap: 4mm;
        margin: 0 0 2mm; width: 100%;
      }
      .poster.elegant .flourish svg { width: 18mm; height: 5mm; opacity: 0.9; }
      .poster.elegant .flourish svg.right { transform: scaleX(-1); }
      /* Est. micro-line */
      .poster.elegant .est-line {
        font-family: "Cormorant Garamond", serif; font-size: 10pt; font-style: italic;
        letter-spacing: 0.24em; text-transform: uppercase; color: #8a7a4a;
        margin: 4mm 0 0;
      }
      .poster.elegant .est-line::before, .poster.elegant .est-line::after { content: "· "; color: #c9a227; }
      .poster.elegant .est-line::after { content: " ·"; }
      .poster.elegant .leaf { position: absolute; pointer-events: none; }
      /* Corner bamboos (prominent) */
      .poster.elegant .leaf.tl { width: 68mm; height: 68mm; opacity: 0.75; top: -6mm; left: -10mm; }
      .poster.elegant .leaf.tr { width: 68mm; height: 68mm; opacity: 0.75; top: -6mm; right: -10mm; transform: scaleX(-1); }
      .poster.elegant .leaf.bl { width: 68mm; height: 68mm; opacity: 0.75; bottom: -6mm; left: -10mm; transform: scaleY(-1); }
      .poster.elegant .leaf.br { width: 68mm; height: 68mm; opacity: 0.75; bottom: -6mm; right: -10mm; transform: scale(-1, -1); }
      /* Mid-edge bamboos — peeking in from the sides */
      .poster.elegant .leaf.ml  { width: 52mm; height: 52mm; opacity: 0.3; top: 108mm; left: -20mm; transform: rotate(12deg); }
      .poster.elegant .leaf.mr  { width: 52mm; height: 52mm; opacity: 0.3; top: 138mm; right: -20mm; transform: scaleX(-1) rotate(12deg); }
      /* Small background accents — watermark-style */
      .poster.elegant .leaf.ul2 { width: 40mm; height: 40mm; opacity: 0.22; top: 62mm; left: -14mm; transform: rotate(-8deg); }
      .poster.elegant .leaf.ur2 { width: 40mm; height: 40mm; opacity: 0.22; top: 82mm; right: -14mm; transform: scaleX(-1) rotate(-8deg); }
      .poster.elegant .leaf.ll2 { width: 42mm; height: 42mm; opacity: 0.22; bottom: 90mm; left: -16mm; transform: scaleY(-1) rotate(8deg); }
      .poster.elegant .leaf.lr2 { width: 42mm; height: 42mm; opacity: 0.22; bottom: 60mm; right: -16mm; transform: scale(-1,-1) rotate(8deg); }
      .poster.elegant > *:not(.leaf) { position: relative; z-index: 2; }
      .poster.elegant .logo-wrap {
        position: relative; z-index: 5;
        flex: 0 0 auto;
        width: 36mm; min-width: 36mm; max-width: 36mm;
        height: 36mm; min-height: 36mm; max-height: 36mm;
        aspect-ratio: 1 / 1;
        border-radius: 50%; overflow: hidden;
        background: #fff; border: 0.8mm solid #2a3f54; box-sizing: border-box;
        margin-top: 4mm;
        box-shadow: 0 1mm 3mm rgba(42,63,84,0.08);
      }
      .poster.elegant .logo-wrap img {
        position: absolute; inset: 0;
        width: 100%; height: 100%; object-fit: cover; display: block;
      }
      .poster.elegant .logo-wrap .initials {
        position: absolute; inset: 0;
        display: flex; align-items: center; justify-content: center;
        font-family: "Cormorant Garamond", serif; font-size: 28pt; font-weight: 700; color: #2a3f54;
      }
      .poster.elegant .partner-name { font-family: "Cormorant Garamond", serif; font-size: 32pt; font-weight: 600; color: #2a3f54; margin: 5mm 0 0; line-height: 1.05; font-style: italic; }
      .poster.elegant .partner-sub { font-family: "Cormorant Garamond", serif; font-size: 18pt; font-style: italic; color: #6b7a8a; margin: 1mm 0 0; }
      .poster.elegant .divider { display: flex; align-items: center; justify-content: center; gap: 3mm; margin: 7mm 0 5mm; width: 90mm; }
      .poster.elegant .divider::before, .poster.elegant .divider::after { content: ""; flex: 1; height: 0.3mm; background: #c9a227; }
      .poster.elegant .divider .dot { width: 2mm; height: 2mm; background: #c9a227; transform: rotate(45deg); }
      .poster.elegant .headline { font-family: "Cormorant Garamond", serif; font-size: 26pt; font-weight: 700; font-style: italic; color: #2a3f54; margin: 0 0 2mm; line-height: 1.1; }
      .poster.elegant .subhead { font-family: "Inter", sans-serif; font-size: 9pt; letter-spacing: 0.28em; text-transform: uppercase; color: #8a7a4a; margin: 0 0 4mm; }
      .poster.elegant .qr-frame { background: #d9d4c7; padding: 4mm; border-radius: 1mm; }
      .poster.elegant .qr-inner { background: #fff; border: 0.3mm solid #c9a227; padding: 3mm; border-radius: 1mm; }
      .poster.elegant canvas { display: block; width: 54mm !important; height: 54mm !important; }
      .poster.elegant .creds { margin-top: 6mm; background: #faf4e1; border-top: 0.4mm solid #c9a227; border-bottom: 0.4mm solid #c9a227; padding: 5mm 10mm; min-width: 150mm; }
      .poster.elegant .creds-row { display: flex; align-items: baseline; justify-content: center; gap: 6mm; padding: 1.5mm 0; }
      .poster.elegant .creds-label { font-family: "Inter", sans-serif; font-size: 10pt; letter-spacing: 0.22em; text-transform: uppercase; color: #8a7a4a; font-weight: 500; min-width: 26mm; text-align: right; }
      .poster.elegant .creds-value { font-family: "Cormorant Garamond", serif; font-size: 20pt; font-weight: 700; color: #2a3f54; text-align: left; word-break: break-word; }
      .poster.elegant .welcome { margin-top: auto; font-family: "Cormorant Garamond", serif; }
      .poster.elegant .welcome-main { font-size: 18pt; font-style: italic; color: #2a3f54; margin: 0; }
      .poster.elegant .welcome-sub  { font-size: 12pt; font-style: italic; color: #6b7a8a; margin: 1mm 0 0; }
      .poster.elegant .sally-credit { margin-top: 4mm; font-family: "Inter", sans-serif; font-size: 10.5pt; color: #2a3f54; font-weight: 600; letter-spacing: 0.02em; background: rgba(201,162,39,0.14); border-top: 0.3mm solid #c9a227; border-bottom: 0.3mm solid #c9a227; padding: 2.5mm 6mm; }

      /* ─────────────────────── NOIR ─────────────────────── */
      .poster.noir { background: radial-gradient(ellipse at top, #1a1611 0%, #0a0a0a 70%); color: #e8d9a8; }
      .poster.noir::before {
        content: ""; position: absolute; inset: 10mm;
        border: 0.3mm solid rgba(212,175,55,0.45); pointer-events: none;
      }
      .poster.noir::after {
        content: ""; position: absolute; inset: 11mm;
        border: 0.15mm solid rgba(212,175,55,0.25); pointer-events: none;
      }
      .poster.noir > * { position: relative; z-index: 1; }
      .poster.noir .monogram {
        width: 26mm; height: 26mm; border-radius: 50%;
        background: transparent; border: 0.6mm solid #d4af37;
        display: grid; place-items: center; margin-top: 6mm;
      }
      .poster.noir .monogram img { width: 80%; height: 80%; border-radius: 50%; object-fit: cover;
        filter: sepia(0.2) saturate(1.1) brightness(0.95); }
      .poster.noir .monogram .initials { font-family: "Playfair Display", serif; font-size: 24pt; font-weight: 900; color: #d4af37; letter-spacing: 0.02em; }
      .poster.noir .brand-rule { display: flex; align-items: center; gap: 3mm; margin: 5mm 0 3mm; }
      .poster.noir .brand-rule::before, .poster.noir .brand-rule::after { content: ""; width: 18mm; height: 0.3mm; background: #d4af37; }
      .poster.noir .brand { font-family: "Inter", sans-serif; font-size: 8pt; letter-spacing: 0.45em; text-transform: uppercase; color: #d4af37; font-weight: 600; }
      .poster.noir .partner-name {
        font-family: "Playfair Display", serif; font-size: 34pt; font-weight: 700; font-style: italic;
        background: linear-gradient(180deg, #f5d577 0%, #d4af37 50%, #a67c0a 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
        margin: 3mm 0 0; line-height: 1.02;
      }
      .poster.noir .partner-sub { font-family: "Playfair Display", serif; font-size: 16pt; font-style: italic; color: #c9a855; margin: 1mm 0 0; }
      .poster.noir .headline { font-family: "Playfair Display", serif; font-size: 22pt; font-weight: 400; font-style: italic; color: #f1e4b8; margin: 12mm 0 2mm; letter-spacing: 0.02em; }
      .poster.noir .subhead { font-family: "Inter", sans-serif; font-size: 8.5pt; letter-spacing: 0.4em; text-transform: uppercase; color: #a69466; margin: 0 0 6mm; }
      .poster.noir .qr-frame { padding: 3mm; border: 0.4mm solid #d4af37; border-radius: 0; }
      .poster.noir .qr-inner { background: #f5efd8; padding: 5mm; }
      .poster.noir canvas { display: block; width: 78mm !important; height: 78mm !important; }
      .poster.noir .creds { margin-top: 7mm; padding: 4mm 0; min-width: 150mm;
        border-top: 0.4mm solid #d4af37; border-bottom: 0.4mm solid #d4af37; }
      .poster.noir .creds-row { display: flex; justify-content: center; align-items: baseline; gap: 6mm; padding: 1.5mm 0; }
      .poster.noir .creds-label { font-family: "Inter", sans-serif; font-size: 9pt; letter-spacing: 0.3em; text-transform: uppercase; color: #a69466; min-width: 26mm; text-align: right; font-weight: 500; }
      .poster.noir .creds-value { font-family: "Playfair Display", serif; font-size: 18pt; font-weight: 700; color: #f1e4b8; text-align: left; word-break: break-word; }
      .poster.noir .welcome { margin-top: auto; font-family: "Playfair Display", serif; }
      .poster.noir .welcome-main { font-size: 16pt; font-style: italic; color: #d4af37; margin: 0; letter-spacing: 0.05em; }
      .poster.noir .welcome-sub  { font-size: 10pt; font-style: italic; color: #a69466; margin: 1mm 0 0; }
      .poster.noir .sally-credit { margin-top: 4mm; font-family: "Inter", sans-serif; font-size: 10pt; color: #f1e4b8; font-weight: 600; letter-spacing: 0.08em; background: rgba(212,175,55,0.1); border-top: 0.3mm solid #d4af37; border-bottom: 0.3mm solid #d4af37; padding: 2.5mm 6mm; }

      /* ─────────────────────── AEGEAN ─────────────────────── */
      .poster.aegean { background: #f7f4ea; color: #0e4d8b; }
      .poster.aegean .meander { position: absolute; left: 0; right: 0; height: 14mm; background-repeat: repeat-x;
        background-size: 28mm 14mm; background-position: center; opacity: 0.9; }
      .poster.aegean .meander.top { top: 0; }
      .poster.aegean .meander.bot { bottom: 0; transform: scaleY(-1); }
      .poster.aegean > *:not(.meander) { position: relative; z-index: 1; }
      .poster.aegean .logo-wrap {
        width: 36mm; height: 36mm; border-radius: 50%; background: #fff;
        border: 0.6mm solid #0e4d8b; display: grid; place-items: center;
        margin-top: 14mm; box-shadow: 0 2mm 6mm rgba(14,77,139,0.10);
      }
      .poster.aegean .logo-wrap img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
      .poster.aegean .logo-wrap .initials { font-family: "Playfair Display", serif; font-size: 26pt; font-weight: 700; color: #0e4d8b; }
      .poster.aegean .brand { font-family: "Inter", sans-serif; font-size: 9pt; letter-spacing: 0.32em; text-transform: uppercase; color: #cd5d42; margin: 5mm 0 2mm; font-weight: 600; }
      .poster.aegean .partner-name { font-family: "Playfair Display", serif; font-size: 32pt; font-weight: 700; color: #0e4d8b; margin: 0; line-height: 1.05; }
      .poster.aegean .partner-sub  { font-family: "Playfair Display", serif; font-size: 16pt; font-style: italic; color: #4a7bab; margin: 1mm 0 0; }
      .poster.aegean .divider { display: flex; align-items: center; justify-content: center; gap: 3mm; margin: 6mm 0 4mm; width: 100mm; }
      .poster.aegean .divider::before, .poster.aegean .divider::after { content: ""; flex: 1; height: 0.3mm; background: #cd5d42; }
      .poster.aegean .divider .dot { width: 2.5mm; height: 2.5mm; border: 0.3mm solid #cd5d42; background: transparent; border-radius: 50%; }
      .poster.aegean .headline { font-family: "Playfair Display", serif; font-size: 24pt; font-weight: 700; color: #0e4d8b; margin: 0 0 2mm; line-height: 1.1; }
      .poster.aegean .subhead { font-family: "Inter", sans-serif; font-size: 9pt; letter-spacing: 0.28em; text-transform: uppercase; color: #4a7bab; margin: 0 0 6mm; }
      .poster.aegean .qr-frame { background: #fff; padding: 4mm; border: 0.4mm solid #0e4d8b; }
      .poster.aegean .qr-inner { padding: 3mm; border: 0.2mm solid rgba(14,77,139,0.25); }
      .poster.aegean canvas { display: block; width: 80mm !important; height: 80mm !important; }
      .poster.aegean .creds { margin-top: 6mm; padding: 4mm 8mm; min-width: 150mm;
        background: #fff; border: 0.4mm solid rgba(14,77,139,0.25); }
      .poster.aegean .creds-row { display: flex; align-items: baseline; justify-content: space-between; gap: 6mm; padding: 1.5mm 0; }
      .poster.aegean .creds-row + .creds-row { border-top: 0.2mm dashed rgba(14,77,139,0.2); }
      .poster.aegean .creds-label { font-family: "Inter", sans-serif; font-size: 10pt; letter-spacing: 0.2em; text-transform: uppercase; color: #cd5d42; font-weight: 600; }
      .poster.aegean .creds-value { font-family: "Playfair Display", serif; font-size: 19pt; font-weight: 700; color: #0e4d8b; word-break: break-word; text-align: right; }
      .poster.aegean .welcome { margin-top: auto; font-family: "Playfair Display", serif; }
      .poster.aegean .welcome-main { font-size: 17pt; font-style: italic; color: #0e4d8b; margin: 0; }
      .poster.aegean .welcome-sub  { font-size: 11pt; font-style: italic; color: #4a7bab; margin: 1mm 0 0; }
      .poster.aegean .sally-credit { margin-top: 4mm; font-family: "Inter", sans-serif; font-size: 10.5pt; color: #fff; font-weight: 600; letter-spacing: 0.04em; background: #cd5d42; padding: 3mm 6mm; border-radius: 1mm; }

      /* ─────────────────────── MINIMAL ─────────────────────── */
      .poster.minimal { background: #ffffff; color: #14213d; padding: 24mm 20mm; }
      .poster.minimal .top-rule { width: 24mm; height: 0.5mm; background: #14213d; margin-bottom: 6mm; }
      .poster.minimal .logo-wrap {
        width: 30mm; height: 30mm; border-radius: 50%;
        background: #f7f6f2; border: 0.4mm solid #14213d;
        display: grid; place-items: center; margin-bottom: 5mm;
      }
      .poster.minimal .logo-wrap img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
      .poster.minimal .logo-wrap .initials { font-family: "Inter", sans-serif; font-size: 20pt; font-weight: 700; color: #14213d; letter-spacing: 0.02em; }
      .poster.minimal .partner-name { font-family: "Inter", sans-serif; font-size: 14pt; font-weight: 600; letter-spacing: 0.32em; text-transform: uppercase; color: #14213d; margin: 0; }
      .poster.minimal .partner-sub  { font-family: "Inter", sans-serif; font-size: 10pt; font-weight: 400; letter-spacing: 0.2em; text-transform: uppercase; color: #6b7280; margin: 2mm 0 0; }
      .poster.minimal .headline {
        font-family: "Inter", sans-serif; font-size: 52pt; font-weight: 200; color: #14213d;
        margin: 14mm 0 2mm; line-height: 0.95; letter-spacing: -0.02em;
      }
      .poster.minimal .subhead { font-family: "Inter", sans-serif; font-size: 10pt; letter-spacing: 0.32em; text-transform: uppercase; color: #6b7280; margin: 0 0 8mm; font-weight: 400; }
      .poster.minimal .qr-frame { padding: 0; border: 0.4mm solid #14213d; }
      .poster.minimal .qr-inner { padding: 4mm; background: #fff; }
      .poster.minimal canvas { display: block; width: 78mm !important; height: 78mm !important; }
      .poster.minimal .creds { margin-top: 8mm; min-width: 150mm; padding: 0; }
      .poster.minimal .creds-row { display: grid; grid-template-columns: 26mm 1fr; align-items: baseline;
        gap: 6mm; padding: 3mm 0; border-top: 0.25mm solid #14213d; }
      .poster.minimal .creds-row:last-child { border-bottom: 0.25mm solid #14213d; }
      .poster.minimal .creds-label { font-family: "Inter", sans-serif; font-size: 9pt; letter-spacing: 0.28em; text-transform: uppercase; color: #6b7280; font-weight: 500; text-align: left; }
      .poster.minimal .creds-value { font-family: "Inter", sans-serif; font-size: 15pt; font-weight: 500; color: #14213d; text-align: left; word-break: break-word; }
      .poster.minimal .welcome { margin-top: auto; font-family: "Inter", sans-serif; }
      .poster.minimal .welcome-main { font-size: 10pt; letter-spacing: 0.32em; text-transform: uppercase; color: #14213d; margin: 0; font-weight: 600; }
      .poster.minimal .welcome-sub  { font-size: 9pt; letter-spacing: 0.18em; text-transform: uppercase; color: #6b7280; margin: 2mm 0 0; font-weight: 400; }
      .poster.minimal .sally-credit { margin-top: 5mm; font-size: 10pt; color: #14213d; font-weight: 600; letter-spacing: 0.08em; border-top: 0.3mm solid #14213d; border-bottom: 0.3mm solid #14213d; padding: 2.5mm 6mm; }

      /* ─────────────────────── DARK ─────────────────────── */
      .poster.dark { background: linear-gradient(135deg, #0f0f18 0%, #18122a 50%, #0f0f18 100%); color: #fff; padding: 22mm 18mm; }
      .poster.dark::before {
        content: ""; position: absolute; inset: 0;
        background: radial-gradient(circle at 20% 10%, rgba(125,211,252,0.25), transparent 42%), radial-gradient(circle at 80% 92%, rgba(251,191,36,0.22), transparent 45%);
        pointer-events: none;
      }
      .poster.dark > * { position: relative; z-index: 1; }
      .poster.dark .brand { font-size: 10pt; letter-spacing: 0.3em; text-transform: uppercase; color: #fcd34d; margin-bottom: 4mm; }
      .poster.dark .partner-logo { height: 22mm; width: 22mm; border-radius: 4mm; object-fit: cover; margin-bottom: 3mm; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); }
      .poster.dark .partner-name { font-size: 14pt; font-weight: 700; color: rgba(255,255,255,0.85); margin: 0 0 3mm; }
      .poster.dark .kicker { font-size: 11pt; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.7); margin-bottom: 3mm; }
      .poster.dark .title { font-size: 36pt; font-weight: 800; line-height: 0.95; margin: 0 0 4mm;
        background: linear-gradient(135deg, #e0f2fe 0%, #7dd3fc 60%, #38bdf8 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent; }
      .poster.dark .subtitle { font-size: 12pt; color: rgba(255,255,255,0.78); max-width: 160mm; margin: 0 0 6mm; line-height: 1.35; }
      .poster.dark .qr-wrap { background: #fff; border-radius: 6mm; padding: 5mm; box-shadow: 0 8mm 24mm rgba(0,0,0,0.5); }
      .poster.dark canvas { display: block; width: 80mm !important; height: 80mm !important; }
      .poster.dark .scan-cta { font-size: 12pt; font-weight: 700; color: #7dd3fc; margin-top: 5mm; letter-spacing: 0.05em; }
      .poster.dark .creds { margin-top: 6mm; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 5mm; padding: 4mm 6mm; min-width: 130mm; }
      .poster.dark .creds-row { display: flex; justify-content: space-between; align-items: baseline; gap: 6mm; padding: 2mm 0; }
      .poster.dark .creds-row + .creds-row { border-top: 1px dashed rgba(255,255,255,0.12); }
      .poster.dark .creds-label { font-size: 11pt; letter-spacing: 0.08em; text-transform: lowercase; color: rgba(255,255,255,0.6); }
      .poster.dark .creds-value { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 16pt; font-weight: 700; color: #fcd34d; word-break: break-all; text-align: right; }
      .poster.dark .footer { margin-top: auto; font-size: 11pt; font-weight: 600; color: #fcd34d; line-height: 1.4; letter-spacing: 0.04em; background: rgba(252,211,77,0.08); border-top: 1px solid rgba(252,211,77,0.35); border-bottom: 1px solid rgba(252,211,77,0.35); padding: 3mm 6mm; }
      .poster.dark .partner-credit { margin-top: 2mm; font-size: 10pt; font-weight: 500; color: rgba(255,255,255,0.75); letter-spacing: 0.04em; }

      @media print {
        @page { size: A4; margin: 0; }
        .toolbar { display: none; }
        .stage { padding: 0; }
        body { background: white; }
        .poster, .poster *, .poster::before, .poster::after {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
        .poster.dark .title, .poster.noir .partner-name {
          background: none !important;
          -webkit-background-clip: initial !important;
          background-clip: initial !important;
        }
        .poster.dark .title { color: #38bdf8 !important; -webkit-text-fill-color: #38bdf8 !important; }
        .poster.noir .partner-name { color: #d4af37 !important; -webkit-text-fill-color: #d4af37 !important; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <a class="back" href="/admin/marketing">← {isEl ? "Πίσω" : "Back"}</a>
      <div style="display:flex;gap:8px;">
        <select id="tplSelect" aria-label="Template">
          {TEMPLATE_OPTIONS.map(o => (
            <option value={o.value} selected={template === o.value}>{isEl ? o.labelEl : o.labelEn}</option>
          ))}
        </select>
        <button id="pngBtn" class="print-btn" style="background:#fff;color:#000;">⬇ {isEl ? "PNG" : "Download PNG"}</button>
        <button class="print-btn" onclick="window.print()">🖨 {isEl ? "Εκτύπωση A4" : "Print A4"}</button>
      </div>
    </div>

    <div class="stage">
      {template === "elegant" && (
        <div id="posterEl" class="poster elegant">
          {["tl","tr","bl","br","ml","mr","ul2","ur2","ll2","lr2"].map(pos => (
            <svg class={`leaf ${pos}`} viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
              <g stroke="#5a7046" stroke-linejoin="round" stroke-linecap="round">
                <rect x="26" y="-5" width="16" height="210" fill="#c5d3a8" stroke="none" />
                <line x1="26" y1="-5" x2="26" y2="205" stroke-width="1.5" />
                <line x1="42" y1="-5" x2="42" y2="205" stroke-width="1.5" />
                <line x1="22" y1="30" x2="46" y2="30" stroke-width="2.5" />
                <line x1="22" y1="72" x2="46" y2="72" stroke-width="2.5" />
                <line x1="22" y1="114" x2="46" y2="114" stroke-width="2.5" />
                <line x1="22" y1="156" x2="46" y2="156" stroke-width="2.5" />
                <ellipse cx="72" cy="50" rx="30" ry="5.5" fill="#a8c085" stroke-width="1" transform="rotate(-28 72 50)" />
                <ellipse cx="100" cy="28" rx="34" ry="6" fill="#c5d3a8" stroke-width="1" transform="rotate(-18 100 28)" />
                <ellipse cx="118" cy="55" rx="30" ry="5.5" fill="#a8c085" stroke-width="1" transform="rotate(-10 118 55)" />
                <ellipse cx="84" cy="92" rx="28" ry="5.5" fill="#c5d3a8" stroke-width="1" transform="rotate(-30 84 92)" />
                <ellipse cx="112" cy="88" rx="30" ry="5.5" fill="#a8c085" stroke-width="1" transform="rotate(-14 112 88)" />
                <ellipse cx="90" cy="132" rx="26" ry="5" fill="#c5d3a8" stroke-width="1" transform="rotate(-26 90 132)" />
              </g>
            </svg>
          ))}
          <div class="logo-wrap">
            {logoUrl ? <img src={logoUrl} alt={`${displayName} logo`} /> : <span class="initials">{initials}</span>}
          </div>
          {nameMain && <h1 class="partner-name">{nameMain}</h1>}
          {nameSub && <p class="partner-sub">{nameSub}</p>}
          <p class="est-line">{isEl ? "Ιδιωτική Φιλοξενία" : "Private Hospitality"}</p>
          <div class="divider"><span class="dot"></span></div>
          <div class="flourish">
            <svg viewBox="0 0 90 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 10 Q 20 2, 40 10 T 78 10" stroke="#c9a227" stroke-width="0.8" fill="none" stroke-linecap="round"/>
              <circle cx="82" cy="10" r="1.8" fill="#c9a227"/>
              <circle cx="86" cy="10" r="0.9" fill="#c9a227"/>
            </svg>
            <svg class="right" viewBox="0 0 90 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 10 Q 20 2, 40 10 T 78 10" stroke="#c9a227" stroke-width="0.8" fill="none" stroke-linecap="round"/>
              <circle cx="82" cy="10" r="1.8" fill="#c9a227"/>
              <circle cx="86" cy="10" r="0.9" fill="#c9a227"/>
            </svg>
          </div>
          <h2 class="headline">{isEl ? "Σκανάρετε για Σύνδεση στο Wi-Fi" : "Scan to Connect to Wi-Fi"}</h2>
          <p class="subhead">{isEl ? "Στρέψτε την κάμερα στον κωδικό" : "Point your camera at the code"}</p>
          <div class="qr-frame"><div class="qr-inner"><canvas class="wifi-qr" data-payload={wifiPayload} data-dark={qrDark}></canvas></div></div>
          <div class="creds">
            <div class="creds-row"><span class="creds-label">Wi-Fi</span><span class="creds-value">{ssid}</span></div>
            {security !== "nopass" && <div class="creds-row"><span class="creds-label">Password</span><span class="creds-value">{password}</span></div>}
          </div>
          <div class="welcome">
            <p class="welcome-main">{isEl ? "Καλώς ήρθατε" : "Welcome"}</p>
            <p class="welcome-sub">{welcomeSub}</p>
            <p class="sally-credit">
              {footerLead}
              &nbsp;🍹&nbsp; sallysbar.gr &nbsp;·&nbsp;
              {footerTail}
            </p>
          </div>
        </div>
      )}

      {template === "noir" && (
        <div id="posterEl" class="poster noir">
          <div class="monogram">
            {logoUrl ? <img src={logoUrl} alt={`${displayName} logo`} /> : <span class="initials">{initials}</span>}
          </div>
          <div class="brand-rule"><span class="brand">{isEl ? "Ιδιωτική Διαμονή" : "Private Residence"}</span></div>
          {nameMain && <h1 class="partner-name">{nameMain}</h1>}
          {nameSub && <p class="partner-sub">{nameSub}</p>}
          <h2 class="headline">{isEl ? "Σύνδεση στο Wi-Fi" : "Complimentary Wi-Fi"}</h2>
          <p class="subhead">{isEl ? "Σκανάρετε τον κωδικό" : "Scan the code to connect"}</p>
          <div class="qr-frame"><div class="qr-inner"><canvas class="wifi-qr" data-payload={wifiPayload} data-dark={qrDark}></canvas></div></div>
          <div class="creds">
            <div class="creds-row"><span class="creds-label">Network</span><span class="creds-value">{ssid}</span></div>
            {security !== "nopass" && <div class="creds-row"><span class="creds-label">Password</span><span class="creds-value">{password}</span></div>}
          </div>
          <div class="welcome">
            <p class="welcome-main">{isEl ? "Καλώς ορίσατε" : "Bienvenue"}</p>
            <p class="welcome-sub">{isEl ? "Η διαμονή σας μόλις ξεκίνησε" : "Your stay begins here"}</p>
            <p class="sally-credit">
              {footerLead}
              &nbsp;·&nbsp; sallysbar.gr
            </p>
          </div>
        </div>
      )}

      {template === "aegean" && (
        <div id="posterEl" class="poster aegean">
          <div class="meander top" style={`background-image: url("data:image/svg+xml;utf8,${encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 50\"><path d=\"M0 40 L0 20 L20 20 L20 40 L10 40 L10 30 L15 30 L15 35 L12 35 L12 32 L40 32 L40 20 L60 20 L60 40 L50 40 L50 30 L55 30 L55 35 L52 35 L52 32 L80 32 L80 20 L100 20 L100 40 L90 40 L90 30 L95 30 L95 35 L92 35 L92 32 L100 32\" stroke=\"%230e4d8b\" stroke-width=\"2\" fill=\"none\"/></svg>')}")`}></div>
          <div class="meander bot" style={`background-image: url("data:image/svg+xml;utf8,${encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 50\"><path d=\"M0 40 L0 20 L20 20 L20 40 L10 40 L10 30 L15 30 L15 35 L12 35 L12 32 L40 32 L40 20 L60 20 L60 40 L50 40 L50 30 L55 30 L55 35 L52 35 L52 32 L80 32 L80 20 L100 20 L100 40 L90 40 L90 30 L95 30 L95 35 L92 35 L92 32 L100 32\" stroke=\"%230e4d8b\" stroke-width=\"2\" fill=\"none\"/></svg>')}")`}></div>
          <div class="logo-wrap">
            {logoUrl ? <img src={logoUrl} alt={`${displayName} logo`} /> : <span class="initials">{initials}</span>}
          </div>
          <p class="brand">{isEl ? "Καλώς Ορίσατε" : "Kalós Orísate"}</p>
          {nameMain && <h1 class="partner-name">{nameMain}</h1>}
          {nameSub && <p class="partner-sub">{nameSub}</p>}
          <div class="divider"><span class="dot"></span></div>
          <h2 class="headline">{isEl ? "Σύνδεση στο Wi-Fi" : "Guest Wi-Fi"}</h2>
          <p class="subhead">{isEl ? "Σκανάρετε με την κάμερα" : "Scan with your camera"}</p>
          <div class="qr-frame"><div class="qr-inner"><canvas class="wifi-qr" data-payload={wifiPayload} data-dark={qrDark}></canvas></div></div>
          <div class="creds">
            <div class="creds-row"><span class="creds-label">Wi-Fi</span><span class="creds-value">{ssid}</span></div>
            {security !== "nopass" && <div class="creds-row"><span class="creds-label">Password</span><span class="creds-value">{password}</span></div>}
          </div>
          <div class="welcome">
            <p class="welcome-main">{isEl ? "Καλή σας διαμονή" : "Enjoy your stay"}</p>
            <p class="welcome-sub">{isEl ? "Κεφαλονιά · Σκάλα" : "Kefalonia · Skala"}</p>
            <p class="sally-credit">
              {footerLead}
              &nbsp;🍹&nbsp; sallysbar.gr &nbsp;·&nbsp;
              {footerTail}
            </p>
          </div>
        </div>
      )}

      {template === "minimal" && (
        <div id="posterEl" class="poster minimal">
          <div class="top-rule"></div>
          <div class="logo-wrap">
            {logoUrl ? <img src={logoUrl} alt={`${displayName} logo`} /> : <span class="initials">{initials}</span>}
          </div>
          {nameMain && <h1 class="partner-name">{nameMain}</h1>}
          {nameSub && <p class="partner-sub">{nameSub.replace(/^&\s*/, "")}</p>}
          <h2 class="headline">Wi-Fi</h2>
          <p class="subhead">{isEl ? "Σκανάρετε για σύνδεση" : "Scan to connect"}</p>
          <div class="qr-frame"><div class="qr-inner"><canvas class="wifi-qr" data-payload={wifiPayload} data-dark={qrDark}></canvas></div></div>
          <div class="creds">
            <div class="creds-row"><span class="creds-label">Network</span><span class="creds-value">{ssid}</span></div>
            {security !== "nopass" && <div class="creds-row"><span class="creds-label">Password</span><span class="creds-value">{password}</span></div>}
          </div>
          <div class="welcome">
            <p class="welcome-main">{isEl ? "Καλώς ήρθατε" : "Welcome"}</p>
            <p class="welcome-sub">{isEl ? "Κεφαλονιά" : "Kefalonia"}</p>
            <p class="sally-credit">
              {isEl ? "Απολαύστε ποτό — sallysbar.gr — πλατεία Σκάλας 200μ" : "Enjoy a drink — sallysbar.gr — Skala square 200m"}
            </p>
          </div>
        </div>
      )}

      {template === "dark" && (
        <div id="posterEl" class="poster dark">
          <div class="brand">{displayName ? `${displayName} · ` : ""}{isEl ? "WiFi για επισκέπτες" : "Guest WiFi"}</div>
          {logoUrl && <img class="partner-logo" src={logoUrl} alt={`${displayName} logo`} />}
          {displayName && <div class="partner-name">{displayName}</div>}
          <div class="kicker">{isEl ? "Συνδεθείτε στο WiFi" : "Connect to WiFi"}</div>
          <h1 class="title">{isEl ? "Σκανάρετε & Συνδεθείτε" : "Scan & Connect"}</h1>
          <p class="subtitle">
            {isEl
              ? "Ανοίξτε την κάμερα στο κινητό σας και σκανάρετε τον κωδικό — θα συνδεθείτε αυτόματα στο WiFi."
              : "Open your phone camera and point it at the code — you'll connect to WiFi automatically."}
          </p>
          <div class="qr-wrap"><canvas class="wifi-qr" data-payload={wifiPayload} data-dark={qrDark}></canvas></div>
          <p class="scan-cta">{isEl ? "Ή εισάγετε χειροκίνητα:" : "Or enter manually:"}</p>
          <div class="creds">
            <div class="creds-row"><span class="creds-label">wifi</span><span class="creds-value">{ssid}</span></div>
            {security !== "nopass" && <div class="creds-row"><span class="creds-label">password</span><span class="creds-value">{password}</span></div>}
          </div>
          <div class="footer">
            {footerLead}
            &nbsp;🍹&nbsp; sallysbar.gr &nbsp;·&nbsp;
            {footerTail}
            {displayName && <div class="partner-credit">{isEl ? `WiFi από ${displayName}` : `WiFi courtesy of ${displayName}`}</div>}
          </div>
        </div>
      )}
    </div>

    <script>
      import QRCode from "qrcode";
      const canvas = document.querySelector<HTMLCanvasElement>(".wifi-qr");
      const payload = canvas?.dataset.payload ?? "";
      const dark = canvas?.dataset.dark ?? "#0a0a0f";
      if (canvas && payload) {
        QRCode.toCanvas(canvas, payload, {
          width: 600, margin: 1, color: { dark, light: "#ffffff" }, errorCorrectionLevel: "H",
        }).catch((e: unknown) => console.error("WiFi QR render failed", e));
      }
    </script>

    <script is:inline define:vars={{ pngBg }}>
      (function () {
        const sel = document.getElementById("tplSelect");
        if (sel) {
          sel.addEventListener("change", () => {
            const u = new URL(location.href);
            u.searchParams.set("template", sel.value);
            location.href = u.toString();
          });
        }

        const btn = document.getElementById("pngBtn");
        const poster = document.getElementById("posterEl");
        if (!btn || !poster) return;
        btn.addEventListener("click", async () => {
          const origLabel = btn.textContent;
          btn.disabled = true;
          btn.textContent = "…";
          try {
            if (!window.html2canvas) {
              await new Promise(function (resolve, reject) {
                var s = document.createElement("script");
                s.src = "https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js";
                s.onload = resolve; s.onerror = reject;
                document.head.appendChild(s);
              });
            }
            var canvas = await window.html2canvas(poster, {
              backgroundColor: pngBg, scale: 2, useCORS: true, logging: false,
              windowWidth: poster.scrollWidth, windowHeight: poster.scrollHeight,
              onclone: function (doc) {
                // html2canvas doesn't render `background-clip: text`.
                // Flatten gradient titles to solid before capture.
                var dk = doc.querySelectorAll(".poster.dark .title");
                for (var i = 0; i < dk.length; i++) {
                  var el = dk[i];
                  el.style.background = "none"; el.style.backgroundClip = "initial"; el.style.webkitBackgroundClip = "initial";
                  el.style.color = "#38bdf8"; el.style.webkitTextFillColor = "#38bdf8";
                }
                var no = doc.querySelectorAll(".poster.noir .partner-name");
                for (var j = 0; j < no.length; j++) {
                  var elj = no[j];
                  elj.style.background = "none"; elj.style.backgroundClip = "initial"; elj.style.webkitBackgroundClip = "initial";
                  elj.style.color = "#d4af37"; elj.style.webkitTextFillColor = "#d4af37";
                }
              },
            });
            var url = canvas.toDataURL("image/png");
            var a = document.createElement("a");
            a.href = url;
            a.download = "wifi-poster.png";
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
          } catch (e) {
            alert("Couldn't export PNG: " + (e?.message || e));
          } finally {
            btn.disabled = false;
            btn.textContent = origLabel;
          }
        });
      })();
    </script>
  </body>
</html>
