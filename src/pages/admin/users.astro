---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import AdminNav from "../../components/AdminNav.astro";
import { supabaseAdmin } from "../../lib/supabase";
import { dict, withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const t = dict[lang];
const user = Astro.locals.user;
const displayName = user?.user_metadata?.full_name?.split(" ")[0] ?? user?.email?.split("@")[0] ?? "Admin";

// Handle invite form submission
let inviteSuccess = "";
let inviteError = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = (form.get("email") as string)?.trim();
  const name  = (form.get("name")  as string)?.trim();
  const role  = (form.get("role")  as string)?.trim();

  if (!email || !["customer", "employee", "admin", "super_admin"].includes(role)) {
    inviteError = lang === "el" ? "Μη έγκυρο email ή ρόλος." : "Invalid email or role.";
  } else {
    const origin = new URL(Astro.request.url).origin;
    const { error } = await supabaseAdmin.auth.admin.inviteUserByEmail(email, {
      data: { full_name: name ?? "", role },
      redirectTo: `${origin}/auth/set-password`,
    });
    if (error) inviteError = error.message;
    else inviteSuccess = lang === "el" ? `Πρόσκληση στάλθηκε στο ${email} ως ${role}.` : `Invite sent to ${email} as ${role}.`;
  }
}

// Load all users
const { data: { users: authUsers } } = await supabaseAdmin.auth.admin.listUsers({ perPage: 200 });
const { data: profiles } = await supabaseAdmin.from("profiles").select("id,role,full_name,created_at");

const profileMap = Object.fromEntries((profiles ?? []).map(p => [p.id, p]));

const users = (authUsers ?? []).map(u => {
  const wasInvited  = !!u.invited_at;
  const isConfirmed = !!(u.email_confirmed_at ?? u.confirmed_at);
  const status = wasInvited && !isConfirmed ? "invite_pending"
               : isConfirmed               ? "active"
               :                             "unconfirmed";
  return {
    id:       u.id,
    email:    u.email ?? "—",
    name:     profileMap[u.id]?.full_name ?? u.user_metadata?.full_name ?? "",
    role:     profileMap[u.id]?.role ?? "customer",
    joined:   profileMap[u.id]?.created_at ?? u.created_at,
    provider: u.app_metadata?.provider ?? "email",
    status,
  };
}).sort((a, b) => new Date(b.joined).getTime() - new Date(a.joined).getTime());

function roleBadge(role: string) {
  const map: Record<string, string> = {
    super_admin: "bg-gradient-to-br from-rose-400/20 to-fuchsia-400/20 text-rose-200 border border-rose-400/40",
    admin:       "bg-amber-400/10 text-amber-400 border border-amber-400/20",
    employee:    "bg-sky-400/10 text-sky-400 border border-sky-400/20",
    staff:       "bg-sky-400/10 text-sky-400 border border-sky-400/20",
    waiter:      "bg-orange-400/10 text-orange-300 border border-orange-400/25",
    barman:      "bg-fuchsia-400/10 text-fuchsia-300 border border-fuchsia-400/25",
    customer:    "bg-white/5 text-white/40 border border-white/10",
  };
  return map[role] ?? "bg-white/5 text-white/40 border border-white/10";
}
function roleLabel(role: string, isEl: boolean) {
  if (role === "super_admin") return isEl ? "🔐 Super" : "🔐 Super";
  return role;
}

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString(lang === "el" ? "el-GR" : "en-GB", { day: "numeric", month: "short", year: "numeric" });
}
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.admin.nav.users} — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      dialog { background: #16161f; border: 1px solid rgba(255,255,255,.12); border-radius: 1rem; padding: 1.5rem; width: min(28rem, 95vw); color: #fff; }
      dialog::backdrop { background: rgba(0,0,0,.6); }
      .field { display: flex; flex-direction: column; gap: .375rem; margin-bottom: 1rem; }
      .field label { font-size: .75rem; color: rgba(255,255,255,.4); }
      .field input, .field select { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: .625rem; padding: .625rem .875rem; font-size: .875rem; color: #fff; outline: none; width: 100%; }
      .field input:focus, .field select:focus { border-color: rgba(255,255,255,.3); }
      .field select option { background: #16161f; }
      .modal-title { font-size: 1rem; font-weight: 600; margin-bottom: 1.25rem; }
      .modal-actions { display: flex; justify-content: flex-end; gap: .5rem; margin-top: 1.25rem; }
      .btn { border-radius: .625rem; padding: .5rem 1rem; font-size: .875rem; font-weight: 500; cursor: pointer; border: none; transition: opacity .15s; }
      .btn-primary { background: #fff; color: #000; }
      .btn-primary:hover { opacity: .9; }
      .btn-primary:disabled { opacity: .4; cursor: not-allowed; }
      .btn-ghost { background: rgba(255,255,255,.08); color: rgba(255,255,255,.7); }
      .btn-ghost:hover { background: rgba(255,255,255,.13); }
      .btn-danger { background: rgba(239,68,68,.15); color: #f87171; border: 1px solid rgba(239,68,68,.2); }
      .btn-danger:hover { background: rgba(239,68,68,.25); }
      .btn-danger:disabled { opacity: .4; cursor: not-allowed; }
      #toast { position: fixed; bottom: 1.5rem; right: 1.5rem; padding: .75rem 1.25rem; border-radius: .75rem; font-size: .875rem; z-index: 9999; opacity: 0; transition: opacity .2s; pointer-events: none; }
      #toast.show { opacity: 1; }
      #toast.ok  { background: rgba(34,197,94,.15); border: 1px solid rgba(34,197,94,.25); color: #4ade80; }
      #toast.err { background: rgba(239,68,68,.15); border: 1px solid rgba(239,68,68,.25); color: #f87171; }
    </style>
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <Header />
    <div class="h-20"></div>

    <AdminNav active="users" />

    <main class="mx-auto max-w-7xl px-4 py-8 space-y-8">

      <!-- Invite -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">{t.admin.inviteStaff}</h2>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          {inviteSuccess && (
            <div class="mb-4 rounded-xl bg-green-400/10 border border-green-400/20 text-green-400 text-sm px-4 py-3">{inviteSuccess}</div>
          )}
          {inviteError && (
            <div class="mb-4 rounded-xl bg-red-400/10 border border-red-400/20 text-red-400 text-sm px-4 py-3">{inviteError}</div>
          )}
          <form method="POST" class="flex flex-wrap gap-3 items-end">
            <div class="flex flex-col gap-1 flex-1 min-w-[180px]">
              <label class="text-xs text-white/40">{t.admin.name}</label>
              <input name="name" type="text" placeholder="Maria Papadopoulou"
                class="rounded-xl bg-white/5 border border-white/10 px-4 py-2.5 text-sm text-white placeholder-white/20 outline-none focus:border-white/30 transition" />
            </div>
            <div class="flex flex-col gap-1 flex-1 min-w-[200px]">
              <label class="text-xs text-white/40">{t.admin.email} <span class="text-red-400">*</span></label>
              <input name="email" type="email" required placeholder="staff@sallysbar.gr"
                class="rounded-xl bg-white/5 border border-white/10 px-4 py-2.5 text-sm text-white placeholder-white/20 outline-none focus:border-white/30 transition" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs text-white/40">{t.admin.role} <span class="text-red-400">*</span></label>
              <select name="role" required
                class="rounded-xl bg-white/5 border border-white/10 px-4 py-2.5 text-sm text-white outline-none focus:border-white/30 transition">
                <option value="employee">Employee</option>
                <option value="admin">Admin</option>
                {Astro.locals.role === "super_admin" && <option value="super_admin">🔐 Super Admin</option>}
                <option value="customer">Customer</option>
              </select>
            </div>
            <button type="submit"
              class="rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-black hover:bg-white/90 transition whitespace-nowrap">
              {t.admin.sendInvite}
            </button>
          </form>
          <p class="mt-3 text-xs text-white/30">{t.admin.inviteMagicNote}</p>
        </div>
      </div>

      <!-- User sections -->
      {(["super_admin", "admin", "waiter", "barman", "employee", "staff", "customer", "other"] as const).map(roleGroup => {
        const KNOWN = ["super_admin","admin","waiter","barman","employee","staff","customer"];
        const group = roleGroup === "other"
          ? users.filter(u => !KNOWN.includes(u.role))
          : users.filter(u => u.role === roleGroup);
        if (!group.length) return null;
        const sectionColors = {
          super_admin: "text-rose-300 border-rose-400/30",
          admin:       "text-amber-400 border-amber-400/20",
          waiter:      "text-orange-300 border-orange-400/25",
          barman:      "text-fuchsia-300 border-fuchsia-400/25",
          employee:    "text-sky-400 border-sky-400/20",
          staff:       "text-sky-400 border-sky-400/20",
          customer:    "text-white/40 border-white/10",
          other:       "text-white/50 border-white/10",
        } as any;
        const sectionLabel = {
          super_admin: lang === "el" ? "🔐 Super Admins" : "🔐 Super Admins",
          admin:       lang === "el" ? "Διαχειριστές" : "Admins",
          waiter:      lang === "el" ? "🧑‍🍳 Σερβιτόροι" : "🧑‍🍳 Waiters",
          barman:      lang === "el" ? "🍸 Μπάρμαν" : "🍸 Barmen",
          employee:    lang === "el" ? "Προσωπικό (όλα)" : "Employees (all)",
          staff:       lang === "el" ? "Staff" : "Staff",
          customer:    lang === "el" ? "Πελάτες" : "Customers",
          other:       lang === "el" ? "Άλλοι ρόλοι" : "Other roles",
        } as any;
        return (
          <div>
            <div class="flex items-center gap-3 mb-3">
              <h2 class={`text-xs font-semibold uppercase tracking-widest ${sectionColors[roleGroup].split(" ")[0]}`}>
                {sectionLabel[roleGroup]}
              </h2>
              <span class={`text-xs px-2 py-0.5 rounded-full border ${sectionColors[roleGroup]} opacity-60`}>
                {group.length}
              </span>
            </div>
            <div class="rounded-2xl border border-white/10 overflow-hidden mb-6">
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-white/10 bg-white/5">
                      <th class="text-left px-4 py-3 text-white/40 font-medium">{t.admin.name}</th>
                      <th class="text-left px-4 py-3 text-white/40 font-medium">{t.admin.email}</th>
                      <th class="text-left px-4 py-3 text-white/40 font-medium">{t.admin.provider}</th>
                      <th class="text-left px-4 py-3 text-white/40 font-medium">Status</th>
                      <th class="text-left px-4 py-3 text-white/40 font-medium">{t.admin.joined}</th>
                      <th class="text-left px-4 py-3 text-white/40 font-medium">{t.admin.actions}</th>
                    </tr>
                  </thead>
                  <tbody class="user-table-body">
                    {group.map((u) => (
                      <tr class="border-b border-white/5 last:border-0 hover:bg-white/[0.02] transition"
                        data-id={u.id}
                        data-name={u.name}
                        data-email={u.email}
                        data-role={u.role}>
                        <td class="px-4 py-3 font-medium text-white" data-col="name">
                          <a href={`/admin/users/${u.id}`} class="text-white hover:text-amber-300 hover:underline underline-offset-2 transition">
                            {u.name || "—"}
                          </a>
                        </td>
                        <td class="px-4 py-3 text-white/60" data-col="email">
                          <a href={`/admin/users/${u.id}`} class="hover:text-amber-300 transition">{u.email}</a>
                        </td>
                        <td class="px-4 py-3 text-white/40 text-xs">{u.provider}</td>
                        <td class="px-4 py-3">
                          {u.status === "invite_pending" ? (
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-400/10 text-amber-400 border border-amber-400/20">
                              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                              Invite Pending
                            </span>
                          ) : u.status === "active" ? (
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-400/10 text-green-400 border border-green-400/20">
                              <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
                              Active
                            </span>
                          ) : (
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white/5 text-white/30 border border-white/10">
                              <span class="w-1.5 h-1.5 rounded-full bg-white/30"></span>
                              Unconfirmed
                            </span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-white/40 whitespace-nowrap">{fmtDate(u.joined)}</td>
                        <td class="px-4 py-3">
                          <div class="flex items-center gap-2">
                            <button class="edit-btn rounded-lg bg-white/8 hover:bg-white/15 border border-white/10 px-3 py-1 text-xs text-white/70 transition">
                              {t.admin.editUser}
                            </button>
                            <button class="delete-btn rounded-lg bg-red-400/10 hover:bg-red-400/20 border border-red-400/20 px-3 py-1 text-xs text-red-400 transition">
                              {t.admin.delete}
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        );
      })}
    </main>

    <!-- Edit modal -->
    <dialog id="editModal">
      <p class="modal-title">{t.admin.editUser}</p>
      <div class="field">
        <label>{t.admin.name}</label>
        <input id="editName" type="text" placeholder="Full name" />
      </div>
      <div class="field">
        <label>{t.admin.email}</label>
        <input id="editEmail" type="email" placeholder="email@example.com" />
      </div>
      <div class="field">
        <label>{t.admin.role}</label>
        <select id="editRole">
          <option value="customer">customer</option>
          <option value="waiter">waiter 🧑‍🍳</option>
          <option value="barman">barman 🍸</option>
          <option value="employee">employee (all staff)</option>
          <option value="admin">admin</option>
          <option value="super_admin">super_admin</option>
        </select>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="editCancel">{t.admin.cancel}</button>
        <button class="btn btn-primary" id="editSave">{t.admin.saveChanges}</button>
      </div>
    </dialog>

    <!-- Delete confirmation modal -->
    <dialog id="deleteModal">
      <p class="modal-title">{t.admin.deleteUser}</p>
      <p style="font-size:.875rem;color:rgba(255,255,255,.6);margin-bottom:1.25rem;">
        {t.admin.deleteConfirm} <strong id="deleteUserLabel" style="color:#fff"></strong>?
        {t.admin.cannotUndo}
      </p>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="deleteCancel">{t.admin.cancel}</button>
        <button class="btn btn-danger" id="deleteConfirm">{t.admin.delete}</button>
      </div>
    </dialog>

    <div id="toast"></div>

    <script define:vars={{ tSave: t.admin.saveChanges, tSaving: t.admin.saving, tDelete: t.admin.delete, tDeleting: t.admin.deleting }}>

      const editModal   = document.getElementById("editModal");
      const deleteModal = document.getElementById("deleteModal");
      const toast       = document.getElementById("toast");

      let activeRow = null;
      let deleteId = "";

      function showToast(msg, type) {
        toast.textContent = msg;
        toast.className = `show ${type}`;
        setTimeout(() => toast.classList.remove("show"), 3000);
      }

      // Wire edit/delete buttons across all role sections
      document.addEventListener("click", (e) => {
        if (!e.target.closest(".user-table-body")) return;
        const btn = e.target.closest("button");
        if (!btn) return;
        const row = btn.closest("tr");

        if (btn.classList.contains("edit-btn")) {
          activeRow = row;
          document.getElementById("editName").value  = row.dataset.name  ?? "";
          document.getElementById("editEmail").value = row.dataset.email ?? "";
          document.getElementById("editRole").value  = row.dataset.role  ?? "customer";
          editModal.showModal();
        }

        if (btn.classList.contains("delete-btn")) {
          deleteId = row.dataset.id;
          const label = row.dataset.email ?? row.dataset.name ?? deleteId;
          document.getElementById("deleteUserLabel").textContent = label;
          deleteModal.showModal();
        }
      });

      document.getElementById("editCancel").addEventListener("click", () => editModal.close());
      document.getElementById("deleteCancel").addEventListener("click", () => deleteModal.close());

      // Save edit
      document.getElementById("editSave").addEventListener("click", async () => {
        if (!activeRow) return;
        const saveBtn = document.getElementById("editSave");
        saveBtn.disabled = true;
        saveBtn.textContent = tSaving;

        const id    = activeRow.dataset.id;
        const name  = document.getElementById("editName").value.trim();
        const email = document.getElementById("editEmail").value.trim();
        const role  = document.getElementById("editRole").value;

        const res = await fetch("/api/admin/users", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, name, email, role }),
        });

        if (res.ok) {
          editModal.close();
          showToast("User updated.", "ok");
          setTimeout(() => location.reload(), 800);
        } else {
          const err = await res.json().catch(() => ({}));
          showToast(err.error ?? "Failed to update user.", "err");
        }

        saveBtn.disabled = false;
        saveBtn.textContent = tSave;
      });

      // Confirm delete
      document.getElementById("deleteConfirm").addEventListener("click", async () => {
        const confirmBtn = document.getElementById("deleteConfirm");
        confirmBtn.disabled = true;
        confirmBtn.textContent = tDeleting;

        const res = await fetch("/api/admin/users", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: deleteId }),
        });

        if (res.ok) {
          const deletedRow = document.querySelector(`tr[data-id="${deleteId}"]`);
          deletedRow?.remove();
          deleteModal.close();
          showToast("User deleted.", "ok");
        } else {
          const err = await res.json().catch(() => ({}));
          showToast(err.error ?? "Failed to delete user.", "err");
          deleteModal.close();
        }

        confirmBtn.disabled = false;
        confirmBtn.textContent = tDelete;
      });
    </script>
  </body>
</html>
