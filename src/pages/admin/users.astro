---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import { supabaseAdmin } from "../../lib/supabase";

const user = Astro.locals.user;
const displayName = user?.user_metadata?.full_name?.split(" ")[0] ?? user?.email?.split("@")[0] ?? "Admin";

// Handle invite form submission
let inviteSuccess = "";
let inviteError = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email  = (form.get("email")  as string)?.trim();
  const name   = (form.get("name")   as string)?.trim();
  const role   = (form.get("role")   as string)?.trim();

  if (!email || !["customer", "employee", "admin"].includes(role)) {
    inviteError = "Invalid email or role.";
  } else {
    const { error } = await supabaseAdmin.auth.admin.inviteUserByEmail(email, {
      data: { full_name: name ?? "", role },
    });
    if (error) {
      inviteError = error.message;
    } else {
      inviteSuccess = `Invite sent to ${email} as ${role}.`;
    }
  }
}

// Load all users
const { data: { users: authUsers } } = await supabaseAdmin.auth.admin.listUsers({ perPage: 200 });
const { data: profiles } = await supabaseAdmin.from("profiles").select("id,role,full_name,created_at");

const profileMap = Object.fromEntries((profiles ?? []).map(p => [p.id, p]));

const users = (authUsers ?? []).map(u => ({
  id: u.id,
  email: u.email ?? "—",
  name: profileMap[u.id]?.full_name ?? u.user_metadata?.full_name ?? "—",
  role: profileMap[u.id]?.role ?? "customer",
  joined: profileMap[u.id]?.created_at ?? u.created_at,
  provider: u.app_metadata?.provider ?? "email",
})).sort((a, b) => new Date(b.joined).getTime() - new Date(a.joined).getTime());

function roleBadge(role: string) {
  const map: Record<string, string> = {
    admin:    "bg-amber-400/10 text-amber-400 border border-amber-400/20",
    employee: "bg-sky-400/10 text-sky-400 border border-sky-400/20",
    customer: "bg-white/5 text-white/40 border border-white/10",
  };
  return map[role] ?? "bg-white/5 text-white/40";
}

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Users — Admin — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <Header />

    <!-- Spacer for fixed header -->
    <div class="h-20"></div>

    <!-- Admin sub-nav -->
    <div class="sticky top-20 z-40 border-b border-amber-400/20 bg-[#0b0b10]/95 backdrop-blur">
      <div class="mx-auto max-w-7xl px-4">
        <nav class="flex items-center gap-1 py-2 overflow-x-auto text-sm">
          <a href="/admin" class="px-3 py-1.5 rounded-lg text-white/50 hover:text-amber-400 hover:bg-amber-400/5 transition whitespace-nowrap">Overview</a>
          <span class="px-3 py-1.5 rounded-lg bg-amber-400/15 border border-amber-400/20 text-amber-400 font-medium whitespace-nowrap">Users</span>
          <a href="/admin/menu" class="px-3 py-1.5 rounded-lg text-white/50 hover:text-amber-400 hover:bg-amber-400/5 transition whitespace-nowrap">Edit Menu</a>
          <a href="/staff/order" class="px-3 py-1.5 rounded-lg text-white/50 hover:text-amber-400 hover:bg-amber-400/5 transition whitespace-nowrap">New Order</a>
        </nav>
      </div>
    </div>

    <main class="mx-auto max-w-7xl px-4 py-8 space-y-8">

      <!-- Invite staff -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">Invite staff</h2>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">

          {inviteSuccess && (
            <div class="mb-4 rounded-xl bg-green-400/10 border border-green-400/20 text-green-400 text-sm px-4 py-3">
              {inviteSuccess}
            </div>
          )}
          {inviteError && (
            <div class="mb-4 rounded-xl bg-red-400/10 border border-red-400/20 text-red-400 text-sm px-4 py-3">
              {inviteError}
            </div>
          )}

          <form method="POST" class="flex flex-wrap gap-3 items-end">
            <div class="flex flex-col gap-1 flex-1 min-w-[180px]">
              <label class="text-xs text-white/40">Name</label>
              <input name="name" type="text" placeholder="Maria Papadopoulou"
                class="rounded-xl bg-white/5 border border-white/10 px-4 py-2.5 text-sm text-white placeholder-white/20 outline-none focus:border-white/30 transition" />
            </div>
            <div class="flex flex-col gap-1 flex-1 min-w-[200px]">
              <label class="text-xs text-white/40">Email <span class="text-red-400">*</span></label>
              <input name="email" type="email" required placeholder="staff@sallysbar.gr"
                class="rounded-xl bg-white/5 border border-white/10 px-4 py-2.5 text-sm text-white placeholder-white/20 outline-none focus:border-white/30 transition" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs text-white/40">Role <span class="text-red-400">*</span></label>
              <select name="role" required
                class="rounded-xl bg-white/5 border border-white/10 px-4 py-2.5 text-sm text-white outline-none focus:border-white/30 transition appearance-none pr-8">
                <option value="employee">Employee (waiter / barman)</option>
                <option value="admin">Admin</option>
                <option value="customer">Customer</option>
              </select>
            </div>
            <button type="submit"
              class="rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-black hover:bg-white/90 transition whitespace-nowrap">
              Send invite
            </button>
          </form>
          <p class="mt-3 text-xs text-white/30">Supabase sends a magic-link email. The user sets their password on first sign-in.</p>
        </div>
      </div>

      <!-- User list -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30">
            All users
            <span class="ml-2 text-white/20">({users.length})</span>
          </h2>
        </div>
        <div class="rounded-2xl border border-white/10 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-white/10 bg-white/5">
                  <th class="text-left px-4 py-3 text-white/40 font-medium">Name</th>
                  <th class="text-left px-4 py-3 text-white/40 font-medium">Email</th>
                  <th class="text-left px-4 py-3 text-white/40 font-medium">Role</th>
                  <th class="text-left px-4 py-3 text-white/40 font-medium">Provider</th>
                  <th class="text-left px-4 py-3 text-white/40 font-medium">Joined</th>
                  <th class="text-left px-4 py-3 text-white/40 font-medium">Action</th>
                </tr>
              </thead>
              <tbody>
                {users.map((u) => (
                  <tr class="border-b border-white/5 last:border-0 hover:bg-white/[0.02] transition" data-user-id={u.id}>
                    <td class="px-4 py-3 font-medium text-white">{u.name}</td>
                    <td class="px-4 py-3 text-white/60">{u.email}</td>
                    <td class="px-4 py-3">
                      <span class={`role-badge inline-flex px-2.5 py-0.5 rounded-full text-xs font-semibold ${roleBadge(u.role)}`}>
                        {u.role}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-white/40 text-xs">{u.provider}</td>
                    <td class="px-4 py-3 text-white/40 whitespace-nowrap">{fmtDate(u.joined)}</td>
                    <td class="px-4 py-3">
                      <div class="flex items-center gap-2">
                        <select class="role-select rounded-lg bg-white/5 border border-white/10 px-2 py-1 text-xs text-white outline-none focus:border-white/30 transition"
                          data-current={u.role}>
                          <option value="customer"  selected={u.role === "customer"}>customer</option>
                          <option value="employee"  selected={u.role === "employee"}>employee</option>
                          <option value="admin"     selected={u.role === "admin"}>admin</option>
                        </select>
                        <button class="save-role-btn rounded-lg bg-white/10 hover:bg-white/20 px-3 py-1 text-xs text-white/70 transition hidden">
                          Save
                        </button>
                        <span class="save-status text-xs text-green-400 hidden">Saved</span>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>

    <script>
      // Inline role update
      document.querySelectorAll<HTMLTableRowElement>("tr[data-user-id]").forEach(row => {
        const userId  = row.dataset.userId!;
        const select  = row.querySelector<HTMLSelectElement>(".role-select")!;
        const saveBtn = row.querySelector<HTMLButtonElement>(".save-role-btn")!;
        const status  = row.querySelector<HTMLElement>(".save-status")!;
        const badge   = row.querySelector<HTMLElement>(".role-badge")!;

        select.addEventListener("change", () => {
          saveBtn.classList.toggle("hidden", select.value === select.dataset.current);
          status.classList.add("hidden");
        });

        saveBtn.addEventListener("click", async () => {
          saveBtn.textContent = "Saving…";
          saveBtn.disabled = true;

          const res = await fetch("/api/admin/set-role", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ userId, role: select.value }),
          });

          if (res.ok) {
            const roleColors: Record<string, string> = {
              admin:    "bg-amber-400/10 text-amber-400 border border-amber-400/20",
              employee: "bg-sky-400/10 text-sky-400 border border-sky-400/20",
              customer: "bg-white/5 text-white/40 border border-white/10",
            };
            badge.className = `role-badge inline-flex px-2.5 py-0.5 rounded-full text-xs font-semibold ${roleColors[select.value] ?? ""}`;
            badge.textContent = select.value;
            (select as any).dataset.current = select.value;
            saveBtn.classList.add("hidden");
            status.classList.remove("hidden");
            setTimeout(() => status.classList.add("hidden"), 2000);
          } else {
            const err = await res.json().catch(() => ({}));
            alert(err.error ?? "Failed to update role.");
          }

          saveBtn.textContent = "Save";
          saveBtn.disabled = false;
        });
      });
    </script>
  </body>
</html>
