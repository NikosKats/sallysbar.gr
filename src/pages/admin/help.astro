---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import AdminNav from "../../components/AdminNav.astro";
import { dict, withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const t = dict[lang];
const isEl = lang === "el";

const L = {
  title: isEl ? "Οδηγός & Βοήθεια — Sally's Bar Admin" : "Help & Guide — Sally's Bar Admin",
  kicker: isEl ? "Εγχειρίδιο Χρήσης" : "Operator Manual",
  heroTitle: isEl ? "Πώς να χρησιμοποιήσεις το Sally's Bar" : "How to use Sally's Bar",
  heroSub: isEl
    ? "Όλα όσα χρειάζεσαι για να τρέξεις το μαγαζί μέσα από την εφαρμογή — εγκατάσταση στο κινητό, παραγγελίες, προετοιμασία ποτών, κλείσιμο τραπεζιών και διαχείριση."
    : "Everything you need to run the venue through this app — installing it on your phone, taking orders, preparing drinks, closing tables, and managing the business.",
  contents: isEl ? "Περιεχόμενα" : "Contents",
  navHelp: isEl ? "Οδηγός & Βοήθεια" : "Help & Guide",

  toc: isEl ? [
    "Εγκατάσταση εφαρμογής (PWA)",
    "Ενεργοποίηση ειδοποιήσεων",
    "Ροή πελάτη (QR + /table/n)",
    "Σερβιτόρος — λήψη παραγγελίας",
    "Μπάρμαν — προετοιμασία παραγγελιών",
    "Παράδοση & κλείσιμο τραπεζιού",
    "Admin — επισκόπηση & analytics",
    "Επεξεργασία μενού",
    "Δημιουργία QR για τραπέζια",
    "Events & κρατήσεις",
    "Χρήστες, ρόλοι & loyalty",
    "Παρακολούθηση φιλοδωρημάτων",
    "Σύνδεση με Telegram",
    "Ομάδα — Team chat (με edit/delete/uploads)",
    "Ρυθμίσεις & Προφίλ χρήστη",
    "Social Card (ψηφιακή κάρτα /u/handle)",
    "Ρυθμίσεις σελίδας τραπεζιού",
    "Staff sidebar & κοινό Footer",
    "Referral points — αποκλειστικά για μέλη",
    "Tonight's Quests με AI + επιβεβαίωση staff",
    "Διαχείριση Tasks",
    "Ρυθμίσεις Wheel / geofence",
    "Ρυθμίσεις σελίδας τραπεζιού",
    "Address autocomplete (Photon)",
    "Sitemap & SEO",
    "Role: super_admin",
    "SaaS: Venues, Onboarding, Business",
    "Games ON/OFF toggles",
    "Wheel: Testing mode & redemption",
    "Scratch rewards + earn list",
    "Tasks: kill & CRUD",
    "Games hub & dedicated pages",
    "Επίλυση προβλημάτων",
  ] : [
    "Install the app (PWA)",
    "Enable push notifications",
    "Customer flow (QR + /table/n)",
    "Waiter — take an order",
    "Barman — prepare orders",
    "Deliver & close table",
    "Admin overview & analytics",
    "Edit the menu",
    "Generate table QR codes",
    "Events & reservations",
    "Users, roles & loyalty",
    "Tips tracking",
    "Telegram integration",
    "Team chat (edit/delete/uploads)",
    "User settings & profile",
    "Social Card (/u/handle)",
    "Table page feature toggles",
    "Staff sidebar & shared Footer",
    "Referral points — members only",
    "Tonight's Quests (AI + staff confirm)",
    "Task management panel",
    "Wheel / geofence settings",
    "Table page toggles",
    "Address autocomplete (Photon)",
    "Sitemap & SEO",
    "super_admin role",
    "SaaS: Venues, Onboarding, Business",
    "Games ON/OFF toggles",
    "Wheel: Testing mode & redemption",
    "Scratch rewards + earn list",
    "Tasks: kill & CRUD",
    "Games hub & dedicated pages",
    "Troubleshooting",
  ],

  s1: {
    head: isEl ? "1. Εγκατάσταση στο κινητό (PWA)" : "1. Install the app on your phone (PWA)",
    body: isEl ? `
      <p>Το Sally's Bar τρέχει ως <strong>Progressive Web App</strong> — χωρίς App Store. Εγκαθιστάς μία φορά και συμπεριφέρεται σαν native app (εικονίδιο, πλήρης οθόνη, push ειδοποιήσεις).</p>
      <p><strong>iPhone / iPad (Safari):</strong></p>
      <ol>
        <li>Άνοιξε το <code>sallysbar.gr/staff</code> στο <strong>Safari</strong> (όχι Chrome).</li>
        <li>Πάτα το εικονίδιο <strong>Κοινοποίηση</strong> (τετράγωνο με βέλος ↑) στο κάτω μέρος.</li>
        <li>Κύλισε και πάτα <strong>"Προσθήκη στην οθόνη Home"</strong>.</li>
        <li>Πάτα <strong>Προσθήκη</strong>. Άνοιξε το νέο εικονίδιο "Sally's Staff" από την αρχική.</li>
      </ol>
      <p class="text-sm text-amber-200/80">⚠️ Στο iOS, οι push ειδοποιήσεις δουλεύουν μόνο όταν η εφαρμογή ανοίγει από το εικονίδιο της αρχικής (iOS 16.4+).</p>
      <p><strong>Android (Chrome):</strong></p>
      <ol>
        <li>Άνοιξε το <code>sallysbar.gr/staff</code> στο Chrome.</li>
        <li>Πάτα το μενού <strong>⋮</strong> → <strong>"Εγκατάσταση εφαρμογής"</strong> ή <strong>"Προσθήκη στην οθόνη Home"</strong>.</li>
        <li>Επιβεβαίωσε και άνοιξε από την αρχική οθόνη.</li>
      </ol>
      <p><strong>Desktop (Chrome/Edge):</strong> κάνε κλικ στο εικονίδιο εγκατάστασης (⊕) στη γραμμή διεύθυνσης όταν βρίσκεσαι στο <code>/staff</code>.</p>
    ` : `
      <p>Sally's Bar runs as a <strong>Progressive Web App</strong> — no App Store needed. Install it once on your phone and it behaves like a native app (home-screen icon, full screen, push notifications).</p>
      <p><strong>iPhone / iPad (Safari):</strong></p>
      <ol>
        <li>Open <code>sallysbar.gr/staff</code> in <strong>Safari</strong> (not Chrome).</li>
        <li>Tap the <strong>Share</strong> icon (square with ↑ arrow) at the bottom.</li>
        <li>Scroll and tap <strong>"Add to Home Screen"</strong>.</li>
        <li>Tap <strong>Add</strong> in the top-right. Open the new "Sally's Staff" icon from your home screen.</li>
      </ol>
      <p class="text-sm text-amber-200/80">⚠️ On iOS, push notifications only work when launched from the home-screen icon (iOS 16.4+).</p>
      <p><strong>Android (Chrome):</strong></p>
      <ol>
        <li>Open <code>sallysbar.gr/staff</code> in Chrome.</li>
        <li>Tap the <strong>⋮</strong> menu → <strong>"Install app"</strong> or <strong>"Add to Home screen"</strong>.</li>
        <li>Confirm and open from the home screen.</li>
      </ol>
      <p><strong>Desktop (Chrome/Edge):</strong> click the install icon (⊕ / computer icon) in the address bar when visiting <code>/staff</code>.</p>
    `,
  },
  s2: {
    head: isEl ? "2. Ενεργοποίηση push ειδοποιήσεων" : "2. Enable push notifications",
    body: isEl ? `
      <p>Μετά την εγκατάσταση του PWA, άνοιξέ το και πάτα το banner <strong>"🔔 Ενεργοποίηση ειδοποιήσεων"</strong> στο κάτω μέρος. Αποδέξου το pop-up του συστήματος.</p>
      <p>Θα παίρνεις push σε κάθε γεγονός παραγγελίας:</p>
      <ul>
        <li><strong>🍹 Νέα παραγγελία</strong> — όταν ο σερβιτόρος στείλει νέο γύρο.</li>
        <li><strong>🔄 Ετοιμάζεται</strong> — ο μπάρμαν δέχτηκε την παραγγελία.</li>
        <li><strong>✅ Έτοιμη</strong> — τα ποτά είναι έτοιμα, ο σερβιτόρος πρέπει να τα πάει.</li>
        <li><strong>📦 Παραδόθηκε</strong> — η παραγγελία έφτασε στον πελάτη.</li>
        <li><strong>💶 Πληρώθηκε</strong> — το τραπέζι πλήρωσε και έκλεισε.</li>
        <li><strong>❌ Ακυρώθηκε</strong> — η παραγγελία ακυρώθηκε.</li>
      </ul>
      <p>Οι ειδοποιήσεις πάνε σε <strong>όλες τις συσκευές</strong> κάθε συνδεδεμένου χρήστη staff/admin.</p>
    ` : `
      <p>After installing the PWA, open it and tap the <strong>"🔔 Enable notifications"</strong> banner at the bottom. Accept the system prompt.</p>
      <p>You'll get a push on every order event:</p>
      <ul>
        <li><strong>🍹 New order</strong> — when a waiter submits a new round.</li>
        <li><strong>🔄 Preparing</strong> — barman accepted the order.</li>
        <li><strong>✅ Ready to serve</strong> — drinks are done, a waiter needs to deliver.</li>
        <li><strong>📦 Delivered</strong> — order was handed to the guest.</li>
        <li><strong>💶 Paid</strong> — table paid up and session closed.</li>
        <li><strong>❌ Cancelled</strong> — order was cancelled.</li>
      </ul>
      <p>Notifications are sent to <strong>every installed device</strong> of every logged-in staff/admin user. Re-enabling on a new phone is automatic once you log in.</p>
    `,
  },
  s3: {
    head: isEl ? "3. Τι βλέπει ο πελάτης (QR → /table/n)" : "3. What the customer sees (QR → /table/n)",
    body: isEl ? `
      <p>Κάθε τραπέζι έχει τυπωμένο QR που οδηγεί στο <code>sallysbar.gr/table/&lt;αριθμός&gt;</code>. Ο πελάτης μπορεί:</p>
      <ul>
        <li><strong>Να δει όλο το μενού</strong> στα Αγγλικά ή Ελληνικά.</li>
        <li>Να πατήσει <strong>"Κάλεσε σερβιτόρο για παραγγελία"</strong> — ο σερβιτόρος λαμβάνει ειδοποίηση με τον αριθμό τραπεζιού.</li>
        <li>Να πατήσει <strong>"Κάλεσε σερβιτόρο για πληρωμή"</strong> και να επιλέξει Κάρτα ή Μετρητά.</li>
        <li>Μετά την πληρωμή, βλέπει prompt για <strong>Google review</strong>.</li>
      </ul>
      <p>Οι πελάτες δεν στέλνουν ποτέ δικές τους παραγγελίες — <em>καλούν</em> τον σερβιτόρο που γράφει την παραγγελία στο κινητό του.</p>
    ` : `
      <p>Every table has a printed QR that opens <code>sallysbar.gr/table/&lt;number&gt;</code>. The customer can:</p>
      <ul>
        <li><strong>Browse the full menu</strong> in English or Greek.</li>
        <li>Tap <strong>"Call Waiter to Order"</strong> — a waiter gets a live notification with the table number.</li>
        <li>Tap <strong>"Call Waiter to Pay"</strong> and choose Card or Cash — waiter is alerted with the payment method.</li>
        <li>After paying, they see a <strong>Google review</strong> prompt.</li>
      </ul>
      <p>Customers never place orders themselves — they <em>call</em> a waiter who writes up the order on their own phone.</p>
    `,
  },
  s4: {
    head: isEl ? "4. Σερβιτόρος — λήψη παραγγελίας" : "4. Waiter — take an order",
    body: isEl ? `
      <ol>
        <li>Άνοιξε το PWA — βρίσκεσαι στο <code>/staff</code>, που δείχνει τα <strong>ανοιχτά τραπέζια</strong>, γύρους και σύνολα.</li>
        <li>Πάτα <strong>"+ Νέα Παραγγελία"</strong> (ή <strong>"Προσθήκη Γύρου"</strong> σε υπάρχον τραπέζι) για να ανοίξει το <code>/staff/order</code>.</li>
        <li>Διάλεξε τον αριθμό τραπεζιού (ή κράτα το προεπιλεγμένο session).</li>
        <li>Πάτα + / − δίπλα σε κάθε είδος για να ρυθμίσεις ποσότητες. Τα σύνολα ενημερώνονται ζωντανά.</li>
        <li>Προαιρετικά πρόσθεσε <strong>σημείωση</strong> (π.χ. "χωρίς πάγο", "extra λάιμ").</li>
        <li>Πάτα <strong>Αποστολή στον μπάρμαν</strong>. Βλέπεις ✓ και push φτάνει στον μπάρμαν.</li>
      </ol>
      <p><strong>Προσθήκη γύρου σε ανοιχτό τραπέζι:</strong> από το <code>/staff</code>, πάτα την κάρτα του τραπεζιού → <strong>Προσθήκη Γύρου</strong>. Όλοι οι γύροι μοιράζονται ένα <em>session</em> και το σύνολο αυξάνεται με κάθε γύρο.</p>
    ` : `
      <ol>
        <li>Open the PWA — you land on <code>/staff</code>, which lists <strong>open tables</strong>, their rounds and totals.</li>
        <li>Tap <strong>"+ New Order"</strong> (or <strong>"Add Round"</strong> on an existing table) to open <code>/staff/order</code>.</li>
        <li>Pick the table number (or keep the preselected session).</li>
        <li>Tap + / − next to each menu item to set quantities. Totals update live.</li>
        <li>Optionally add a <strong>note</strong> (e.g. "no ice", "extra lime").</li>
        <li>Tap <strong>Send to Barman</strong>. You'll see a ✓ confirmation and a push fires to the barman.</li>
      </ol>
      <p><strong>Adding a round to an existing table:</strong> from <code>/staff</code>, tap the table card → <strong>Add Round</strong>. All rounds share a <em>session</em>, and the total grows with each round. This is how you bill multiple orders under one final payment.</p>
    `,
  },
  s5: {
    head: isEl ? "5. Μπάρμαν — λήψη & προετοιμασία" : "5. Barman — receive & prepare orders",
    body: isEl ? `
      <p>Λαμβάνεις παραγγελίες με δύο τρόπους — μέσω <strong>push ειδοποίησης PWA</strong> και μέσω του <strong>Telegram group</strong> (εφόσον είναι ρυθμισμένο).</p>
      <p><strong>Από το Telegram (πιο εύκολο στη ζέστη):</strong></p>
      <ol>
        <li>Έρχεται μήνυμα στο chat του μπάρμαν με αριθμό τραπεζιού, είδη, σύνολο και δύο κουμπιά.</li>
        <li>Πάτα <strong>🔄 Ετοιμάζεται</strong> μόλις ξεκινήσεις — οι σερβιτόροι βλέπουν την ενημέρωση.</li>
        <li>Όταν τα ποτά είναι έτοιμα, πάτα <strong>✅ Έτοιμη</strong>. Νέο μήνυμα φτάνει στο chat των σερβιτόρων.</li>
        <li>Αν χρειαστεί να ακυρώσεις παραγγελία, πάτα <strong>❌ Ακύρωση</strong> (μόνο όσο είναι ακόμα pending).</li>
      </ol>
      <p><strong>Από το PWA:</strong> άνοιξε το <code>/staff</code> — κάθε γύρος εμφανίζεται με τρέχον status.</p>
    ` : `
      <p>You receive orders two ways — via the <strong>PWA push notification</strong> and via the <strong>Telegram group</strong> (if configured). Both work; pick whichever is in front of you.</p>
      <p><strong>From Telegram (easiest during a rush):</strong></p>
      <ol>
        <li>A message arrives in the Barman chat with table number, items, total, and two buttons.</li>
        <li>Tap <strong>🔄 Preparing</strong> once you start making it — waiters see the update.</li>
        <li>When drinks are ready, tap <strong>✅ Ready</strong>. A new message lands in the Waiter chat: <em>"Deliver to table N"</em>.</li>
        <li>If you need to kill an order, tap <strong>❌ Cancel</strong> (only works while it's still pending).</li>
      </ol>
      <p><strong>From the PWA:</strong> open <code>/staff</code> → every round is listed with its current status. Tapping status chips isn't wired on staff yet — use Telegram buttons to move through <em>pending → preparing → ready</em>.</p>
    `,
  },
  s6: {
    head: isEl ? "6. Παράδοση & κλείσιμο τραπεζιού" : "6. Deliver the drinks & close the table",
    body: isEl ? `
      <ol>
        <li>Όταν τα ποτά είναι έτοιμα, ο σερβιτόρος βλέπει push <strong>✅ Έτοιμη</strong>. Πήγαινέ τα στο τραπέζι.</li>
        <li>Στο chat σερβιτόρων στο Telegram, πάτα <strong>📦 Παραδόθηκε</strong>. Ο γύρος μετράει ως <em>delivered</em> και περιμένει πληρωμή.</li>
        <li>Όταν ο πελάτης ζητήσει τον λογαριασμό, άνοιξε το <code>/staff</code>. Πάτα το τραπέζι — βλέπεις το σύνολο και κάθε γύρο.</li>
        <li>Διάλεξε:
          <ul>
            <li><strong>Pay session</strong> — κλείνει όλους τους παραδομένους γύρους ως πληρωμένους και κλείνει το τραπέζι. Πρόσθεσε φιλοδώρημα + τύπο (μετρητά/κάρτα).</li>
            <li><strong>Partial pay</strong> — διάλεξε συγκεκριμένα είδη που πληρώνει τώρα ένας πελάτης. Το τραπέζι μένει ανοιχτό για τα υπόλοιπα.</li>
          </ul>
        </li>
        <li>Επιβεβαίωσε. Push <strong>💶 Πληρώθηκε</strong> φτάνει σε όλους.</li>
      </ol>
      <p><strong>Ακύρωση γύρου:</strong> γίνεται μόνο όσο είναι <em>pending</em>. Χρησιμοποίησε το κουμπί <strong>❌ Ακύρωση</strong> στο Telegram ή /staff.</p>
    ` : `
      <ol>
        <li>When drinks are ready, the waiter sees a <strong>✅ Ready</strong> push. Bring them to the table.</li>
        <li>In the Waiter Telegram chat, tap <strong>📦 Delivered</strong>. The round is now counted as <em>delivered</em> and awaiting payment.</li>
        <li>When the guest asks for the bill, open <code>/staff</code>. Tap the table → you'll see the running total and each delivered round.</li>
        <li>Choose one of:
          <ul>
            <li><strong>Pay session</strong> — closes every delivered round as paid and closes the table. Add the tip amount + type (cash/card) if any.</li>
            <li><strong>Partial pay</strong> — pick specific items a guest is paying for now. Tables stay open for the rest.</li>
          </ul>
        </li>
        <li>Confirm. A <strong>💶 Paid</strong> push fires to everyone.</li>
      </ol>
      <p><strong>Cancelling a round:</strong> only possible while still in <em>pending</em>. Use the <strong>❌ Cancel</strong> button in Telegram or /staff.</p>
    `,
  },
  s7: {
    head: isEl ? "7. Admin — επισκόπηση & analytics" : "7. Admin — overview & analytics",
    body: isEl ? `
      <p><a href="${withLangPrefix(lang, "/admin")}"><code>/admin</code></a> είναι το καθημερινό dashboard:</p>
      <ul>
        <li><strong>Σήμερα</strong> — σύνολα, pending/preparing/ready/delivered, έσοδα.</li>
        <li><strong>Έσοδα</strong> — σήμερα, βδομάδα, μήνας, έτος.</li>
        <li><strong>Μηνιαίο γράφημα</strong> — έσοδα ανά μήνα.</li>
        <li><strong>Ημερολόγιο 30 ημερών</strong> — έσοδα + πλήθος παραγγελιών ανά ημέρα.</li>
        <li><strong>Best sellers</strong> — κορυφαία είδη (YTD).</li>
        <li><strong>Πρόσφατες παραγγελίες</strong> — τελευταίες 20, οποιασδήποτε κατάστασης.</li>
      </ul>
      <p>Στο <a href="${withLangPrefix(lang, "/admin/analytics")}"><code>/admin/analytics</code></a> βλέπεις πιο μακροχρόνιες τάσεις.</p>
    ` : `
      <p><a href="${withLangPrefix(lang, "/admin")}"><code>/admin</code></a> is your daily dashboard:</p>
      <ul>
        <li><strong>Today's status</strong> — totals, pending/preparing/ready/delivered counts, revenue.</li>
        <li><strong>Revenue</strong> — today, this week, this month, this year.</li>
        <li><strong>Monthly bar chart</strong> — revenue per month for the current year.</li>
        <li><strong>Last 30 days calendar</strong> — revenue + order count per day.</li>
        <li><strong>Best sellers</strong> — top items by units sold (YTD).</li>
        <li><strong>Recent orders</strong> — last 20 orders, any status.</li>
      </ul>
      <p><a href="${withLangPrefix(lang, "/admin/analytics")}"><code>/admin/analytics</code></a> drills deeper into long-term trends.</p>
    `,
  },
  s8: {
    head: isEl ? "8. Επεξεργασία μενού" : "8. Edit the menu",
    body: isEl ? `
      <p>Πήγαινε στο <a href="${withLangPrefix(lang, "/admin/menu")}"><code>/admin/menu</code></a>:</p>
      <ul>
        <li>Δημιούργησε/μετονόμασε/αναδιάταξε <strong>κατηγορίες</strong> (Cocktails, Beer, Wine…).</li>
        <li>Πρόσθεσε/επεξεργάσου είδη — <strong>όνομα (EN + EL)</strong>, περιγραφή, τιμή (€), tags.</li>
        <li>Απόκρυψη ειδών με το toggle (χάνονται από /menu και /table/n αλλά μένουν στο ιστορικό).</li>
      </ul>
      <p>Οι αλλαγές είναι άμεσες — οι πελάτες που θα σκανάρουν βλέπουν αμέσως το νέο μενού.</p>
    ` : `
      <p>Go to <a href="${withLangPrefix(lang, "/admin/menu")}"><code>/admin/menu</code></a>:</p>
      <ul>
        <li>Create/rename/reorder <strong>categories</strong> (Cocktails, Beer, Wine…).</li>
        <li>Add/edit items — <strong>name (EN + EL)</strong>, description, price (€), tags.</li>
        <li>Hide items with the visibility toggle (they disappear from /menu and /table/n but stay in history).</li>
      </ul>
      <p>Changes are live immediately — customers scanning a QR will see the new menu.</p>
    `,
  },
  s9: {
    head: isEl ? "9. Δημιουργία QR για τραπέζια" : "9. Generate table QR codes",
    body: isEl ? `
      <ol>
        <li>Άνοιξε το <a href="${withLangPrefix(lang, "/admin/qrcodes")}"><code>/admin/qrcodes</code></a>.</li>
        <li>Δώσε εύρος (π.χ. <strong>Από 1 Έως 20</strong>) — ένα QR ανά αριθμό τραπεζιού.</li>
        <li>Προαιρετικά: ανάγκασε γλώσσα μενού (Auto = η γλώσσα της συσκευής του πελάτη).</li>
        <li>Πάτα <strong>Generate</strong> — κάθε QR εμφανίζεται ως εκτυπώσιμη κάρτα.</li>
