        <li><strong>Δεν εμφανίζεται το banner "🔔 Ενεργοποίηση ειδοποιήσεων"</strong> — είτε είναι ήδη ενεργές (δες ρυθμίσεις συσκευής) είτε χρησιμοποιείς browser που μπλοκάρει ειδοποιήσεις σε incognito.</li>
        <li><strong>Ξέχασα να πατήσω Ready / Delivered</strong> — ο admin διορθώνει status από το <code>/admin/orders</code>.</li>
        <li><strong>Λάθος είδος σε παραγγελία</strong> — ακύρωσε τον γύρο (όσο είναι pending) και ξανακαταχώρησε. Μόλις γίνει <em>preparing</em>, κλειδώνει· πες το στον μπάρμαν προφορικά.</li>
        <li><strong>Ο πελάτης δεν σκανάρει το QR</strong> — δώσε του τηλέφωνο με ανοιχτό το <code>/menu</code>, ή πλήκτρο <code>sallysbar.gr/table/&lt;αριθμός&gt;</code>.</li>
        <li><strong>Αποσυνδέθηκα ξαφνικά</strong> — το session έληξε· κάνε login στο <code>/login</code>. Οι push συνδρομές επιβιώνουν.</li>
      </ul>
      <p>Κολλημένος; Στείλε μήνυμα στον admin.</p>
    ` : `
      <ul>
        <li><strong>No push notifications on iPhone</strong> — make sure you opened the app from the home-screen icon, not from Safari. iOS 16.4 or newer required.</li>
        <li><strong>"🔔 Enable notifications" banner doesn't appear</strong> — either already enabled (check device settings) or you're using a browser that blocks notifications in incognito/private mode.</li>
        <li><strong>Forgot to tap Ready / Delivered</strong> — admin can fix order status from <code>/admin/orders</code>.</li>
        <li><strong>Wrong item in an order</strong> — cancel the round (while pending) and re-enter. Once <em>preparing</em>, it's locked; ask the barman to adjust verbally.</li>
        <li><strong>Customer can't scan QR</strong> — hand them a phone with <code>/menu</code> open, or type <code>sallysbar.gr/table/&lt;their-table&gt;</code>.</li>
        <li><strong>Logged-out suddenly</strong> — session expired; sign back in at <code>/login</code>. Push subscriptions survive.</li>
      </ul>
      <p>Still stuck? Message the admin.</p>
    `,
  },
};

const sections = [
  { id: "install",        icon: "📲", tint: "bg-amber-300/15",   ...L.s1,  open: true },
  { id: "push",           icon: "🔔", tint: "bg-amber-300/15",   ...L.s2 },
  { id: "customer",       icon: "👤", tint: "bg-sky-300/15",     ...L.s3 },
  { id: "waiter",         icon: "🧑‍🍳", tint: "bg-fuchsia-300/15", ...L.s4 },
  { id: "barman",         icon: "🍸", tint: "bg-amber-300/15",   ...L.s5 },
  { id: "deliver",        icon: "📦", tint: "bg-green-300/15",   ...L.s6 },
  { id: "admin-overview", icon: "📊", tint: "bg-amber-300/15",   ...L.s7 },
  { id: "admin-menu",     icon: "📝", tint: "bg-sky-300/15",     ...L.s8 },
  { id: "admin-qr",       icon: "🔳", tint: "bg-amber-300/15",   ...L.s9 },
  { id: "admin-events",   icon: "🎉", tint: "bg-fuchsia-300/15", ...L.s10 },
  { id: "admin-users",    icon: "👥", tint: "bg-sky-300/15",     ...L.s11 },
  { id: "admin-tips",     icon: "💸", tint: "bg-green-300/15",   ...L.s12 },
  { id: "telegram",       icon: "✈️", tint: "bg-sky-300/15",     ...L.s13 },
  { id: "marketing",      icon: "📣", tint: "bg-amber-300/15",   ...L.s15 },
  { id: "mkt-analytics",  icon: "📊", tint: "bg-amber-300/15",   ...L.s16 },
  { id: "gamification",   icon: "🎫", tint: "bg-fuchsia-300/15", ...L.s17 },
  { id: "customer-pwa",   icon: "📲", tint: "bg-sky-300/15",     ...L.s18 },
  { id: "legal",          icon: "⚖️", tint: "bg-white/10",       ...L.s19 },
  { id: "wheel",          icon: "🎡", tint: "bg-amber-300/15",   ...L.s20 },
  { id: "customer-dash",  icon: "🎛️", tint: "bg-fuchsia-300/15", ...L.s21 },
  { id: "wallet-share",   icon: "👛", tint: "bg-sky-300/15",     ...L.s22 },
  { id: "user-dossier",   icon: "🗂️", tint: "bg-white/10",       ...L.s23 },
  { id: "notif-scope",    icon: "🔔", tint: "bg-fuchsia-300/15", ...L.s24 },
  { id: "play-crosspromo",icon: "🎁", tint: "bg-amber-300/15",   ...L.s25 },
  { id: "team-chat",      icon: "💬", tint: "bg-sky-300/15",     ...L.s26 },
  { id: "troubleshoot",   icon: "🩹", tint: "bg-red-300/15",     ...L.s14 },
];

const tocIds = ["install","push","customer","waiter","barman","deliver","admin-overview","admin-menu","admin-qr","admin-events","admin-users","admin-tips","telegram","marketing","mkt-analytics","gamification","customer-pwa","legal","wheel","customer-dash","wallet-share","user-dossier","notif-scope","play-crosspromo","team-chat","troubleshoot"];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{L.title}</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      .help-prose h3 { font-family: "Playfair Display", serif; font-weight: 700; }
      .help-prose ol, .help-prose ul { padding-left: 1.25rem; }
      .help-prose ol { list-style: decimal; }
      .help-prose ul { list-style: disc; }
      .help-prose li { margin-bottom: .4rem; color: rgba(255,255,255,.72); line-height: 1.65; }
      .help-prose li::marker { color: rgba(252,211,77,.5); }
      .help-prose p { color: rgba(255,255,255,.72); line-height: 1.7; margin-bottom: .8rem; }
      .help-prose code { background: rgba(252,211,77,.08); color: #fcd34d; padding: 2px 6px; border-radius: 4px; font-size: .85em; border: 1px solid rgba(252,211,77,.15); }
      .help-prose strong { color: #fff; font-weight: 600; }
      .help-prose a { color: #fcd34d; text-decoration: underline; text-underline-offset: 3px; }
      .help-prose a:hover { color: #fde68a; }
      details { transition: border-color .2s; }
      details[open] { border-color: rgba(252,211,77,.35) !important; }
      details summary::-webkit-details-marker { display: none; }
      @media print {
        @page { size: A4; margin: 15mm; }
        html, body { background: white !important; color: black !important; }
        .no-print { display: none !important; }
        main { max-width: none !important; padding: 0 !important; }
        h1, h2, h3, h4, p, li, a, span, div, summary { color: black !important; background: transparent !important; -webkit-text-fill-color: black !important; }
        .help-prose details { break-inside: avoid; page-break-inside: avoid; border: 1px solid #ddd !important; background: white !important; margin-bottom: 8mm; }
        .help-prose details[open] > div { display: block !important; }
        .help-prose details > summary { list-style: none; cursor: default; }
        .help-prose details > summary > span:last-child { display: none !important; }
        a { text-decoration: underline; color: #1a56db !important; -webkit-text-fill-color: #1a56db !important; }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased">
    <div class="no-print pointer-events-none fixed inset-0 -z-10 opacity-60">
      <div class="absolute -top-40 left-1/3 h-[520px] w-[520px] rounded-full bg-amber-400/10 blur-[140px]"></div>
      <div class="absolute bottom-0 right-0 h-[420px] w-[420px] rounded-full bg-fuchsia-500/10 blur-[140px]"></div>
    </div>

    <div class="no-print">
      <Header />
      <div class="h-20"></div>
      <AdminNav active="help" />
    </div>

    <main class="mx-auto max-w-4xl px-5 py-10">
      <!-- Hero -->
      <div class="mb-10">
        <div class="text-xs uppercase tracking-[0.28em] text-amber-200/80 mb-3">{L.kicker}</div>
        <h1 class="font-heading text-5xl md:text-6xl font-bold leading-[0.95] bg-gradient-to-br from-white via-amber-50 to-amber-200/80 bg-clip-text text-transparent">
          {L.heroTitle}
        </h1>
        <p class="mt-5 text-lg text-white/65 max-w-2xl leading-relaxed">{L.heroSub}</p>
        <button type="button" onclick="document.querySelectorAll('details').forEach(d=>d.open=true);window.print();"
          class="no-print mt-5 inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 hover:border-white/40 transition">
          🖨 {isEl ? "Εκτύπωση / PDF" : "Print / Save PDF"}
        </button>
      </div>

      <!-- TOC -->
      <div class="mb-10 rounded-3xl border border-white/10 bg-white/[0.03] backdrop-blur p-6">
        <div class="text-xs uppercase tracking-[0.24em] text-amber-200/70 mb-4">{L.contents}</div>
        <ol class="grid gap-2 sm:grid-cols-2 text-sm text-white/75 list-decimal pl-5">
          {L.toc.map((label, i) => (
            <li><a href={`#${tocIds[i]}`} class="hover:text-amber-200 transition">{label}</a></li>
          ))}
        </ol>
      </div>

      <div class="help-prose space-y-4">
        {sections.map((s) => (
          <details id={s.id} class="group rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur" open={s.open}>
            <summary class="cursor-pointer px-6 py-5 flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class={`grid place-items-center h-9 w-9 rounded-xl ${s.tint} text-lg`}>{s.icon}</span>
                <h3 class="text-xl">{s.head}</h3>
              </div>
              <span class="text-white/40 group-open:rotate-180 transition-transform text-xl">▾</span>
            </summary>
            <div class="px-6 pb-6 space-y-4" set:html={s.body}></div>
          </details>
        ))}
      </div>
    </main>
  </body>
</html>
