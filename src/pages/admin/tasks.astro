---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import AdminNav from "../../components/AdminNav.astro";
import { TODOS } from "../../lib/todos";
import { supabaseAdmin } from "../../lib/supabase";

if (!["admin","super_admin"].includes(Astro.locals.role ?? "")) {
  return new Response("Forbidden", { status: 403 });
}

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

const { data: settingsRows } = await supabaseAdmin.from("task_settings")
  .select("task_key, enabled, custom_title_en, custom_title_el, custom_desc_en, custom_desc_el, custom_points");
const off = new Set((settingsRows ?? []).filter((r: any) => r.enabled === false).map((r: any) => r.task_key));
const overrides = new Map((settingsRows ?? []).map((r: any) => [r.task_key, r]));

const cats = [
  { key: "onboarding",  label: isEl ? "Onboarding"   : "Onboarding",  tint: "amber" },
  { key: "social",      label: isEl ? "Social"       : "Social",      tint: "fuchsia" },
  { key: "achievement", label: isEl ? "Επιτεύγματα"  : "Achievements", tint: "emerald" },
];
const tintClass: Record<string, string> = {
  amber:   "border-amber-400/30 bg-amber-400/[0.05]",
  fuchsia: "border-fuchsia-400/30 bg-fuchsia-400/[0.05]",
  emerald: "border-emerald-400/30 bg-emerald-400/[0.05]",
};

const totalEnabled = TODOS.filter(t => !off.has(t.key)).length;
const totalPoints  = TODOS.filter(t => !off.has(t.key)).reduce((s, t) => s + t.points, 0);
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{isEl ? "Διαχείριση Tasks" : "Tasks (loyalty)"} — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased">
    <Header />
    <div class="h-20"></div>
    <AdminNav active="tasks" />

    <main class="mx-auto max-w-4xl px-5 py-10">
      <div class="mb-8 flex items-start justify-between gap-4 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-amber-200/80 mb-2">Loyalty</p>
          <h1 class="font-heading text-4xl font-bold">✅ {isEl ? "Tasks του /account" : "Tasks on /account"}</h1>
          <p class="mt-2 text-sm text-white/60 max-w-2xl">{isEl
            ? "Ενεργοποίησε ή απενεργοποίησε κάθε task. Disabled tasks δεν φαίνονται στους πελάτες και δεν δίνουν πόντους."
            : "Enable or disable each task. Disabled tasks are hidden from customers and award no points."}</p>
        </div>
        <div class="shrink-0 flex flex-wrap gap-2">
          <a href="/account" target="_blank" class="rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-4 py-2 text-xs font-semibold">🔗 Preview /account</a>
        </div>
      </div>

      <!-- Master kill switch -->
      <section class={`mb-6 rounded-2xl border p-5 ${totalEnabled === 0 ? "border-red-400/40 bg-red-400/[0.07]" : "border-white/10 bg-white/[0.03]"}`}>
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <p class="text-[10px] uppercase tracking-[0.24em] text-red-300 font-bold">☠️ {isEl ? "Master διακόπτης" : "Master kill switch"}</p>
            <h2 class="font-heading text-xl font-bold mt-1">{isEl ? "Απενεργοποίηση ΟΛΩΝ των tasks" : "Disable ALL tasks"}</h2>
            <p class="text-xs text-white/60 mt-1 max-w-xl">{isEl
              ? "Ένα κουμπί → κλείνουν όλα τα tasks. Η ενότητα «🎯 My Tasks» στο /account κρύβεται αυτόματα."
              : "One click → turns off every task. The \"🎯 My Tasks\" section on /account hides automatically."}</p>
          </div>
          <div class="flex gap-2 shrink-0">
            <button id="killAllTasks" class="rounded-xl bg-gradient-to-br from-red-400 to-red-600 text-white px-5 py-2.5 text-sm font-bold shadow-lg shadow-red-500/25 hover:scale-[1.02] active:scale-[0.98] transition">⛔ {isEl ? "ΚΛΕΙΣΕ ΟΛΑ" : "TURN ALL OFF"}</button>
            <button id="enableAllTasks" class="rounded-xl border border-emerald-400/40 bg-emerald-400/10 hover:bg-emerald-400/20 text-emerald-200 px-5 py-2.5 text-sm font-bold transition">✓ {isEl ? "Άνοιξε όλα" : "Turn all ON"}</button>
          </div>
        </div>
      </section>

      <section class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-8">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <p class="text-[10px] uppercase tracking-wider text-white/50 font-bold">Total tasks</p>
          <p class="font-heading text-3xl font-bold mt-1">{TODOS.length}</p>
        </div>
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.06] p-4">
          <p class="text-[10px] uppercase tracking-wider text-emerald-300 font-bold">Enabled</p>
          <p class="font-heading text-3xl font-bold mt-1">{totalEnabled}</p>
        </div>
        <div class="rounded-2xl border border-amber-400/20 bg-amber-400/[0.06] p-4">
          <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold">Points pool</p>
          <p class="font-heading text-3xl font-bold mt-1">{totalPoints}</p>
        </div>
      </section>

      <div id="banner" class="hidden mb-4 rounded-xl border border-emerald-400/30 bg-emerald-400/10 px-4 py-2 text-sm text-emerald-200"></div>

      {cats.map(c => {
        const items = TODOS.filter(t => t.category === c.key);
        if (!items.length) return null;
        return (
          <section class={`mb-5 rounded-2xl border ${tintClass[c.tint]} p-1`}>
            <p class="px-4 pt-3 pb-2 text-[10px] uppercase tracking-wider text-white/65 font-bold">{c.label} ({items.length})</p>
            <ul class="bg-[#0a0a0f]/40 rounded-xl">
              {items.map(t => {
                const enabled = !off.has(t.key);
                const o = overrides.get(t.key) as any;
                const title = (isEl ? (o?.custom_title_el ?? t.title_el) : (o?.custom_title_en ?? t.title_en));
                const desc  = (isEl ? (o?.custom_desc_el  ?? t.desc_el)  : (o?.custom_desc_en  ?? t.desc_en));
                const points = (o?.custom_points != null) ? o.custom_points : t.points;
                const edited = !!o && (o.custom_title_en || o.custom_title_el || o.custom_desc_en || o.custom_desc_el || o.custom_points != null);
                return (
                  <li class="flex items-center gap-3 px-4 py-3 border-t border-white/5 first:border-0">
                    <span class="text-2xl shrink-0">{t.emoji}</span>
                    <div class="flex-1 min-w-0">
                      <p class="font-semibold text-white flex items-center gap-2">
                        {title}
                        {edited && <span class="text-[9px] px-1.5 py-0.5 rounded bg-sky-400/15 text-sky-300 font-bold uppercase tracking-wider">edited</span>}
                      </p>
                      <p class="text-[11px] text-white/45 mt-0.5 truncate">{desc}</p>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                      <span class="text-[10px] font-bold uppercase tracking-wider text-amber-200/80 px-2 py-0.5 rounded-full bg-amber-400/10">+{points}</span>
                      <span class="text-[10px] font-mono text-white/30">{t.type}</span>
                      <button type="button" class="edit-task text-sm text-white/50 hover:text-amber-300 transition" title={isEl ? "Επεξεργασία" : "Edit"}
                        data-task={JSON.stringify({ key: t.key, default_title_en: t.title_en, default_title_el: t.title_el, default_desc_en: t.desc_en, default_desc_el: t.desc_el, default_points: t.points, emoji: t.emoji, o: o ?? null })}>✎</button>
                      <label class="relative inline-block w-11 h-6 cursor-pointer">
                        <input type="checkbox" data-key={t.key} checked={enabled} class="task-toggle sr-only peer" />
                        <span class="absolute inset-0 rounded-full bg-white/15 peer-checked:bg-emerald-500 transition"></span>
                        <span class="absolute top-0.5 left-0.5 h-5 w-5 rounded-full bg-white transition-transform peer-checked:translate-x-5"></span>
                      </label>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })}
    </main>

    <dialog id="editTaskModal" class="rounded-2xl bg-[#16161f] border border-white/15 p-0 backdrop:bg-black/70" style="max-width:560px;width:95vw;">
      <form id="editTaskForm" method="dialog" class="p-5 space-y-3 text-sm text-white">
        <div class="flex items-center justify-between">
          <h3 class="font-heading text-xl font-bold">{isEl ? "Επεξεργασία task" : "Edit task"} <span id="editTaskEmoji" class="text-2xl"></span></h3>
          <button type="button" id="closeEditTask" class="text-white/50 hover:text-white text-2xl leading-none">×</button>
        </div>
        <p class="text-[11px] text-white/40">{isEl ? "Κενά πεδία = χρήση του default. Δεν μπορείς να αλλάξεις τον τύπο/κατηγορία." : "Empty field = use the default. Type/category cannot be changed."}</p>
        <input type="hidden" name="key" />
        <div class="grid sm:grid-cols-2 gap-3">
          <label class="block"><span class="text-xs text-white/55">Title (EN)</span>
            <input name="title_en" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2" />
            <span class="text-[10px] text-white/30 block mt-0.5" data-default="title_en"></span>
          </label>
          <label class="block"><span class="text-xs text-white/55">Title (EL)</span>
            <input name="title_el" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2" />
            <span class="text-[10px] text-white/30 block mt-0.5" data-default="title_el"></span>
          </label>
          <label class="block sm:col-span-2"><span class="text-xs text-white/55">Description (EN)</span>
            <textarea name="desc_en" rows="2" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2"></textarea>
            <span class="text-[10px] text-white/30 block mt-0.5" data-default="desc_en"></span>
          </label>
          <label class="block sm:col-span-2"><span class="text-xs text-white/55">Description (EL)</span>
            <textarea name="desc_el" rows="2" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2"></textarea>
            <span class="text-[10px] text-white/30 block mt-0.5" data-default="desc_el"></span>
          </label>
          <label class="block"><span class="text-xs text-white/55">Points</span>
            <input name="points" type="number" min="0" max="10000" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" />
            <span class="text-[10px] text-white/30 block mt-0.5" data-default="points"></span>
          </label>
        </div>
        <div class="flex justify-between gap-2 pt-2">
          <button type="button" id="resetTaskBtn" class="rounded-lg border border-white/15 bg-white/5 hover:bg-white/10 px-3 py-2 text-xs text-white/70">{isEl ? "Reset σε default" : "Reset to defaults"}</button>
          <div class="flex gap-2">
            <button type="button" id="cancelEditTask" class="rounded-lg bg-white/10 hover:bg-white/15 px-4 py-2 text-sm">{isEl ? "Άκυρο" : "Cancel"}</button>
            <button type="button" id="saveEditTask" class="rounded-lg bg-gradient-to-br from-amber-300 to-amber-500 text-black px-4 py-2 text-sm font-bold">💾 {isEl ? "Αποθήκευση" : "Save"}</button>
          </div>
        </div>
      </form>
    </dialog>

    <script is:inline>
      const banner = document.getElementById("banner");
      function flash(text, ok = true) {
        banner.textContent = text;
        banner.classList.remove("hidden");
        banner.className = `mb-4 rounded-xl px-4 py-2 text-sm ${ok ? "border border-emerald-400/30 bg-emerald-400/10 text-emerald-200" : "border border-red-400/30 bg-red-400/10 text-red-200"}`;
        setTimeout(() => banner.classList.add("hidden"), 2000);
      }
      // Bulk enable/disable
      async function bulk(enabled) {
        const r = await fetch("/api/admin/task-bulk", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ enabled }),
        });
        if (r.ok) { flash(enabled ? "✓ All tasks enabled" : "⛔ All tasks disabled"); setTimeout(() => location.reload(), 500); }
        else flash("⚠️ Save failed", false);
      }
      document.getElementById("killAllTasks")?.addEventListener("click", () => {
        if (confirm("Disable ALL tasks site-wide? The \"My Tasks\" section will hide from /account.")) bulk(false);
      });
      document.getElementById("enableAllTasks")?.addEventListener("click", () => bulk(true));

      // Edit task
      const modal = document.getElementById("editTaskModal");
      const form  = document.getElementById("editTaskForm");
      function openEdit(data) {
        const o = data.o || {};
        form.elements["key"].value       = data.key;
        form.elements["title_en"].value  = o.custom_title_en ?? "";
        form.elements["title_el"].value  = o.custom_title_el ?? "";
        form.elements["desc_en"].value   = o.custom_desc_en  ?? "";
        form.elements["desc_el"].value   = o.custom_desc_el  ?? "";
        form.elements["points"].value    = (o.custom_points != null) ? o.custom_points : "";
        document.getElementById("editTaskEmoji").textContent = data.emoji;
        form.querySelector('[data-default="title_en"]').textContent = "default: " + data.default_title_en;
        form.querySelector('[data-default="title_el"]').textContent = "default: " + data.default_title_el;
        form.querySelector('[data-default="desc_en"]').textContent  = "default: " + data.default_desc_en;
        form.querySelector('[data-default="desc_el"]').textContent  = "default: " + data.default_desc_el;
        form.querySelector('[data-default="points"]').textContent   = "default: " + data.default_points;
        modal.showModal();
      }
      document.querySelectorAll(".edit-task").forEach(b => {
        b.addEventListener("click", () => { try { openEdit(JSON.parse(b.getAttribute("data-task"))); } catch {} });
      });
      document.getElementById("closeEditTask")?.addEventListener("click", () => modal.close());
      document.getElementById("cancelEditTask")?.addEventListener("click", () => modal.close());
      document.getElementById("resetTaskBtn")?.addEventListener("click", () => {
        ["title_en","title_el","desc_en","desc_el","points"].forEach(n => form.elements[n].value = "");
      });
      document.getElementById("saveEditTask")?.addEventListener("click", async () => {
        const fd = new FormData(form);
        const payload = {};
        for (const [k, v] of fd.entries()) payload[k] = v;
        const r = await fetch("/api/admin/task-edit", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (r.ok) { flash("✓ Saved"); modal.close(); setTimeout(() => location.reload(), 500); }
        else { const j = await r.json().catch(() => ({})); flash("⚠️ " + (j.error || "save failed"), false); }
      });

      document.querySelectorAll(".task-toggle").forEach(input => {
        input.addEventListener("change", async () => {
          const key = input.getAttribute("data-key");
          const enabled = input.checked;
          try {
            const r = await fetch("/api/admin/task-toggle", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ key, enabled }),
            });
            if (!r.ok) throw new Error("save failed");
            flash(`✓ ${key} ${enabled ? "enabled" : "disabled"}`);
          } catch {
            input.checked = !enabled;
            flash("⚠️ Save failed", false);
          }
        });
      });
    </script>
  </body>
</html>
