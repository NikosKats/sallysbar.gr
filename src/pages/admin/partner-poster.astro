---
import "../../styles/global.css";
import { withLangPrefix } from "../../i18n";
import { supabaseAdmin } from "../../lib/supabase";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!["admin","super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}

const slug = String(Astro.url.searchParams.get("slug") ?? "").trim().toLowerCase();
if (!slug) return Astro.redirect(withLangPrefix(lang, "/admin/partners"));

const { data: p } = await supabaseAdmin
  .from("partners")
  .select("slug, name, gift_label, city, logo_url")
  .eq("slug", slug)
  .maybeSingle();

if (!p) return Astro.redirect(withLangPrefix(lang, "/admin/partners"));

const landingUrl = `https://www.sallysbar.gr/welcome/${p.slug}`;
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{p.name} — Poster</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      :root { color-scheme: dark; }
      body { margin: 0; background: #0b0b10; color: white; font-family: system-ui, -apple-system, sans-serif; }
      .toolbar { position: sticky; top: 0; z-index: 10; display: flex; gap: 10px; align-items: center; justify-content: space-between;
        padding: 14px 20px; background: #111118; border-bottom: 1px solid rgba(255,255,255,0.1); }
      .toolbar a, .toolbar button { font: inherit; cursor: pointer; border-radius: 10px; padding: 8px 14px; font-weight: 600; font-size: 13px; }
      .back { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.2); text-decoration: none; }
      .print-btn { background: #fbbf24; color: #000; border: 0; }
      .stage { padding: 30px 20px; display: flex; justify-content: center; }

      .poster {
        width: 210mm; height: 297mm; background: linear-gradient(135deg, #0f0f18 0%, #1a1220 50%, #0f0f18 100%);
        color: white; position: relative; overflow: hidden; padding: 22mm 18mm; box-sizing: border-box;
        display: flex; flex-direction: column; align-items: center; text-align: center;
      }
      .poster::before {
        content: ""; position: absolute; inset: 0;
        background:
          radial-gradient(circle at 20% 10%, rgba(251,191,36,0.25), transparent 40%),
          radial-gradient(circle at 80% 90%, rgba(217,70,239,0.22), transparent 45%);
        pointer-events: none;
      }
      .poster > * { position: relative; }
      .brand { font-size: 10pt; letter-spacing: 0.3em; text-transform: uppercase; color: #fcd34d; margin-bottom: 6mm; }
      .kicker { font-size: 12pt; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.7); margin-bottom: 4mm; }
      .title { font-size: 42pt; font-weight: 800; line-height: 0.95; margin: 0 0 6mm;
        background: linear-gradient(135deg, #fef3c7 0%, #fbbf24 60%, #f59e0b 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent; }
      .subtitle { font-size: 14pt; color: rgba(255,255,255,0.78); max-width: 160mm; margin: 0 0 10mm; line-height: 1.4; }
      .partner-logo { height: 22mm; width: 22mm; border-radius: 4mm; object-fit: cover; margin-bottom: 4mm;
        border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); }

      .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6mm; max-width: 160mm; width: 100%; margin: 0 0 10mm; }
      .step { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4mm; padding: 4mm 3mm; }
      .step-num { font-size: 18pt; font-weight: 800; color: #fcd34d; line-height: 1; margin-bottom: 2mm; }
      .step-txt { font-size: 10pt; color: rgba(255,255,255,0.85); line-height: 1.2; }

      .qr-wrap { background: white; border-radius: 8mm; padding: 8mm; box-shadow: 0 10mm 30mm rgba(0,0,0,0.5); }
      canvas { display: block; }

      .scan-cta { font-size: 18pt; font-weight: 700; color: #fcd34d; margin-top: 8mm; letter-spacing: 0.05em; }
      .url-line { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11pt; color: rgba(255,255,255,0.6); margin-top: 3mm; }
      .footer { margin-top: auto; font-size: 9.5pt; color: rgba(255,255,255,0.5); line-height: 1.4; }

      @media print {
        @page { size: A4; margin: 0; }
        .toolbar { display: none; }
        .stage { padding: 0; }
        body { background: white; }
        html, body, .poster, .poster::before, .title, .scan-cta, .brand, .kicker {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
        /* Print-safe title: solid gold, no gradient clip. Browsers drop
           backgrounds on print unless explicitly forced — fallback avoids
           invisible text if color-adjust is disabled by the user. */
        .title {
          background: none !important;
          -webkit-background-clip: initial !important;
          background-clip: initial !important;
          color: #d97706 !important;
          -webkit-text-fill-color: #d97706 !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <a class="back" href={`/admin/partners/${p.slug}`}>← {isEl ? "Πίσω" : "Back"}</a>
      <div style="display:flex;gap:8px;">
        <button id="pngBtn" class="print-btn" style="background:#fff;color:#000;">⬇ {isEl ? "PNG" : "Download PNG"}</button>
        <button class="print-btn" onclick="window.print()">🖨 {isEl ? "Εκτύπωση A4" : "Print A4"}</button>
      </div>
    </div>
    <div class="stage">
      <div id="posterEl" class="poster">
        <div class="brand">{p.name} · Sally's Bar · {p.city ?? "Skala"}</div>
        {p.logo_url && <img class="partner-logo" src={p.logo_url} alt={p.name + " logo"} />}
        <div class="kicker">{isEl ? "Καλωσήρθατε" : "Welcome"}</div>
        <h1 class="title">{isEl ? `Ένα ${p.gift_label}` : `A ${p.gift_label}`}</h1>
        <p class="subtitle">
          {isEl
            ? `Από τους οικοδεσπότες σας στο ${p.name}. Γίνετε μέλος στο Sally's και απολαύστε το ${p.gift_label} στην πλατεία της Σκάλας — μόλις 200μ κάτω.`
            : `From your hosts at ${p.name}. Join Sally's loyalty card and enjoy your ${p.gift_label} on Skala's main square — just 200 metres down the road.`}
        </p>

        <div class="steps">
          <div class="step"><div class="step-num">1</div><div class="step-txt">{isEl ? "Σκανάρετε" : "Scan the code"}</div></div>
          <div class="step"><div class="step-num">2</div><div class="step-txt">{isEl ? "Εγγραφή σε 1 λεπτό" : "Sign up in 1 minute"}</div></div>
          <div class="step"><div class="step-num">3</div><div class="step-txt">{isEl ? "Δείξτε τον κωδικό" : "Show the code at the bar"}</div></div>
        </div>

        <div class="qr-wrap"><canvas id="qr" data-url={landingUrl}></canvas></div>
        <p class="scan-cta">{isEl ? "Σκανάρετε τώρα" : "Scan to claim"}</p>
        <p class="url-line">{landingUrl.replace(/^https?:\/\//, "")}</p>
        <div class="footer">🍹 &nbsp; sallysbar.gr &nbsp;·&nbsp; {isEl ? "Ένα ανά επισκέπτη — ισχύει κατά τη διαμονή σας" : "One per guest — valid during your stay"}</div>
      </div>
    </div>

    <script>
      import QRCode from "qrcode";
      const canvas = document.getElementById("qr") as HTMLCanvasElement;
      const url = canvas?.dataset.url ?? "";
      if (canvas && url) {
        QRCode.toCanvas(canvas, url, {
          width: 460, margin: 1, color: { dark: "#0a0a0f", light: "#ffffff" }, errorCorrectionLevel: "H",
        }).catch((e: unknown) => console.error("QR render failed", e));
      }
    </script>

    <script is:inline>
      (function () {
        const btn = document.getElementById("pngBtn");
        const poster = document.getElementById("posterEl");
        if (!btn || !poster) return;
        btn.addEventListener("click", async () => {
          const origLabel = btn.textContent;
          btn.disabled = true;
          btn.textContent = "…";
          try {
            if (!window.html2canvas) {
              await new Promise(function (resolve, reject) {
                var s = document.createElement("script");
                s.src = "https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js";
                s.onload = resolve; s.onerror = reject;
                document.head.appendChild(s);
              });
            }
            var canvas = await window.html2canvas(poster, {
              backgroundColor: "#0f0f18", scale: 2, useCORS: true, logging: false,
              windowWidth: poster.scrollWidth, windowHeight: poster.scrollHeight,
              // html2canvas doesn't render `background-clip: text` — the
              // gradient title would come out as an empty gold rectangle.
              // Swap to solid gold only in the cloned DOM used for capture.
              onclone: function (doc) {
                var titles = doc.querySelectorAll(".title");
                for (var i = 0; i < titles.length; i++) {
                  var el = titles[i];
                  el.style.background = "none";
                  el.style.backgroundClip = "initial";
                  el.style.webkitBackgroundClip = "initial";
                  el.style.color = "#fbbf24";
                  el.style.webkitTextFillColor = "#fbbf24";
                }
              },
            });
            var url = canvas.toDataURL("image/png");
            var a = document.createElement("a");
            a.href = url;
            a.download = "sallys-partner-poster.png";
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
          } catch (e) {
            alert("Couldn't export PNG: " + (e?.message || e));
          } finally {
            btn.disabled = false;
            btn.textContent = origLabel;
          }
        });
      })();
    </script>
  </body>
</html>
