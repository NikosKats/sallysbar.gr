---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import { supabaseAdmin } from "../../lib/supabase";

const user = Astro.locals.user;
const displayName = user?.user_metadata?.full_name?.split(" ")[0] ?? user?.email?.split("@")[0] ?? "Admin";

const today = new Date();
today.setHours(0, 0, 0, 0);
const todayStr = today.toISOString();

const [
  { data: todayOrders },
  { data: recentOrders },
  { count: totalCustomers },
  { count: totalEmployees },
] = await Promise.all([
  supabaseAdmin.from("orders").select("id,status,table_number,items").gte("created_at", todayStr),
  supabaseAdmin.from("orders").select("id,table_number,items,status,note,created_at").order("created_at", { ascending: false }).limit(15),
  supabaseAdmin.from("profiles").select("*", { count: "exact", head: true }).eq("role", "customer"),
  supabaseAdmin.from("profiles").select("*", { count: "exact", head: true }).in("role", ["employee", "admin"]),
]);

const pending   = todayOrders?.filter(o => o.status === "pending").length   ?? 0;
const preparing = todayOrders?.filter(o => o.status === "preparing").length ?? 0;
const ready     = todayOrders?.filter(o => o.status === "ready").length     ?? 0;
const delivered = todayOrders?.filter(o => o.status === "delivered").length ?? 0;
const totalToday = todayOrders?.length ?? 0;

function statusBadge(status: string) {
  const map: Record<string, string> = {
    pending:   "bg-yellow-400/10 text-yellow-400 border border-yellow-400/20",
    preparing: "bg-blue-400/10 text-blue-400 border border-blue-400/20",
    ready:     "bg-green-400/10 text-green-400 border border-green-400/20",
    delivered: "bg-white/5 text-white/40 border border-white/10",
    cancelled: "bg-red-400/10 text-red-400 border border-red-400/20",
  };
  return map[status] ?? "bg-white/5 text-white/40";
}

function timeAgo(dateStr: string) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  return `${Math.floor(m / 60)}h ago`;
}

function itemSummary(items: any[]) {
  if (!items?.length) return "—";
  return items.map((i: any) => `${i.quantity ?? 1}× ${i.name}`).join(", ");
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <Header />

    <!-- Spacer for fixed header -->
    <div class="h-20"></div>

    <!-- Admin sub-nav -->
    <div class="sticky top-20 z-40 border-b border-amber-400/20 bg-[#0b0b10]/95 backdrop-blur">
      <div class="mx-auto max-w-7xl px-4">
        <nav class="flex items-center gap-1 py-2 overflow-x-auto text-sm">
          <span class="px-3 py-1.5 rounded-lg bg-amber-400/15 border border-amber-400/20 text-amber-400 font-medium whitespace-nowrap">Overview</span>
          <a href="/admin/users" class="px-3 py-1.5 rounded-lg text-white/50 hover:text-amber-400 hover:bg-amber-400/5 transition whitespace-nowrap">Users</a>
          <a href="/admin/menu" class="px-3 py-1.5 rounded-lg text-white/50 hover:text-amber-400 hover:bg-amber-400/5 transition whitespace-nowrap">Edit Menu</a>
          <a href="/staff/order" class="px-3 py-1.5 rounded-lg text-white/50 hover:text-amber-400 hover:bg-amber-400/5 transition whitespace-nowrap">New Order</a>
        </nav>
      </div>
    </div>

    <main class="mx-auto max-w-7xl px-4 py-8 space-y-8">

      <!-- Stats grid -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">Today</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <p class="text-3xl font-bold text-white">{totalToday}</p>
            <p class="mt-1 text-sm text-white/50">Total orders</p>
          </div>
          <div class="rounded-2xl border border-yellow-400/20 bg-yellow-400/5 p-5">
            <p class="text-3xl font-bold text-yellow-400">{pending}</p>
            <p class="mt-1 text-sm text-yellow-400/60">Pending</p>
          </div>
          <div class="rounded-2xl border border-blue-400/20 bg-blue-400/5 p-5">
            <p class="text-3xl font-bold text-blue-400">{preparing}</p>
            <p class="mt-1 text-sm text-blue-400/60">Preparing</p>
          </div>
          <div class="rounded-2xl border border-green-400/20 bg-green-400/5 p-5">
            <p class="text-3xl font-bold text-green-400">{ready + delivered}</p>
            <p class="mt-1 text-sm text-green-400/60">Done today</p>
          </div>
        </div>
      </div>

      <!-- Business stats -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">Business</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <p class="text-3xl font-bold text-white">{totalCustomers ?? 0}</p>
            <p class="mt-1 text-sm text-white/50">Registered customers</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <p class="text-3xl font-bold text-white">{totalEmployees ?? 0}</p>
            <p class="mt-1 text-sm text-white/50">Staff members</p>
          </div>
          <div class="rounded-2xl border border-amber-400/20 bg-amber-400/5 p-5 col-span-2 sm:col-span-1">
            <p class="text-sm font-semibold text-amber-400 mb-3">Quick actions</p>
            <div class="flex flex-col gap-2">
              <a href="/admin/menu" class="text-sm text-white/70 hover:text-white transition">Edit menu →</a>
              <a href="/staff/order" class="text-sm text-white/70 hover:text-white transition">Take an order →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent orders -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">Recent orders</h2>
        <div class="rounded-2xl border border-white/10 overflow-hidden">
          {!recentOrders?.length ? (
            <div class="p-8 text-center text-sm text-white/40">No orders yet</div>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-white/10 bg-white/5">
                    <th class="text-left px-4 py-3 text-white/40 font-medium">Table</th>
                    <th class="text-left px-4 py-3 text-white/40 font-medium">Items</th>
                    <th class="text-left px-4 py-3 text-white/40 font-medium">Status</th>
                    <th class="text-left px-4 py-3 text-white/40 font-medium">Time</th>
                  </tr>
                </thead>
                <tbody>
                  {recentOrders.map((order) => (
                    <tr class="border-b border-white/5 hover:bg-white/[0.02] transition">
                      <td class="px-4 py-3 font-medium text-white">#{order.table_number}</td>
                      <td class="px-4 py-3 text-white/60 max-w-xs truncate">{itemSummary(order.items)}</td>
                      <td class="px-4 py-3">
                        <span class={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${statusBadge(order.status)}`}>
                          {order.status}
                        </span>
                      </td>
                      <td class="px-4 py-3 text-white/40 whitespace-nowrap">{timeAgo(order.created_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>

    </main>
  </body>
</html>
