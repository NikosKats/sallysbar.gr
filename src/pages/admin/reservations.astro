---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import AdminNav from "../../components/AdminNav.astro";
import { supabaseAdmin } from "../../lib/supabase";
import { dict, withLangPrefix } from "../../i18n";
import { site } from "../../data/site";

const DAILY_CAPACITY = site.dailyTableCapacity ?? 20;

const lang = Astro.locals.lang ?? "en";
const t    = dict[lang];
const isEl = lang === "el";

// Filters from query string
const url      = new URL(Astro.request.url);
const statusF  = url.searchParams.get("status") ?? "all";   // all | pending_ai | pending | confirmed | cancelled
const dateF    = url.searchParams.get("date") ?? "";         // YYYY-MM-DD

let query = supabaseAdmin
  .from("reservations")
  .select("id, user_id, name, email, phone, date, time, party_size, notes, status, source, ai_call_uuid, created_at")
  .order("date", { ascending: true })
  .order("time", { ascending: true });

if (statusF !== "all") query = query.eq("status", statusF);
if (dateF)             query = query.eq("date", dateF);

const { data: rawRes } = await query.limit(500);
const reservations = rawRes ?? [];

function fmtDate(d: string) {
  return new Date(d + "T00:00:00").toLocaleDateString(isEl ? "el-GR" : "en-GB", {
    weekday: "short", day: "numeric", month: "short", year: "numeric",
  });
}

function statusColor(s: string) {
  if (s === "confirmed") return "#4ade80";
  if (s === "cancelled") return "#f87171";
  if (s === "pending_ai") return "#a78bfa";   // violet for AI-pending
  return "#fbbf24";                            // amber for regular pending
}

function statusLabel(s: string) {
  if (s === "pending_ai") return isEl ? "🤖 Εκκρεμεί AI" : "🤖 AI pending";
  if (!isEl) return s.charAt(0).toUpperCase() + s.slice(1);
  return { pending: "Εκκρεμής", confirmed: "Επιβεβαιωμένη", cancelled: "Ακυρωμένη" }[s] ?? s;
}

const counts = {
  all:        reservations.length,
  pending_ai: reservations.filter(r => r.status === "pending_ai").length,
  pending:    reservations.filter(r => r.status === "pending").length,
  confirmed:  reservations.filter(r => r.status === "confirmed").length,
  cancelled:  reservations.filter(r => r.status === "cancelled").length,
};
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isEl ? "Κρατήσεις" : "Reservations"} — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <Header />
    <div class="h-20"></div>

    <!-- Subnav -->
    <AdminNav active="reservations" />

    <main class="mx-auto max-w-7xl px-4 py-6 space-y-6">

      <!-- Header + filters -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <h1 class="text-xl font-bold">{isEl ? "Κρατήσεις" : "Reservations"}</h1>
          <button id="newResBtn" type="button" class="rounded-xl bg-amber-500 hover:bg-amber-400 text-black text-sm font-bold px-3 py-1.5 transition">
            + {isEl ? "Νέα κράτηση" : "New reservation"}
          </button>
          <span class="text-xs text-white/40">
            {isEl ? "Καπάκι: " : "Cap: "}{DAILY_CAPACITY}{isEl ? " τραπέζια/βράδυ" : " tables/night"}
          </span>
        </div>
        <form method="get" class="flex items-center gap-2 flex-wrap">
          <input
            type="date"
            name="date"
            value={dateF}
            class="rounded-xl border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-white focus:outline-none focus:border-amber-400/50"
          />
          <input type="hidden" name="status" value={statusF} />
          <button type="submit" class="rounded-xl border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-white/70 hover:text-white transition">
            {isEl ? "Φίλτρο" : "Filter"}
          </button>
          {dateF && (
            <a href={`?status=${statusF}`} class="rounded-xl border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-white/50 hover:text-white transition">
              {isEl ? "Καθαρισμός" : "Clear date"}
            </a>
          )}
        </form>
      </div>

      <!-- Test SMS panel — lets staff verify Vonage delivery without creating a booking -->
      <details class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3">
        <summary class="cursor-pointer text-sm text-white/70 flex items-center gap-2 list-none">
          <span class="text-amber-300">📱</span>
          <span class="font-medium">{isEl ? "Δοκιμαστικό SMS" : "Test SMS"}</span>
          <span class="text-xs text-white/40 ml-auto">{isEl ? "Έλεγχος Vonage" : "Check Vonage delivery"}</span>
        </summary>
        <form id="testSmsForm" class="mt-3 flex flex-wrap items-end gap-2 text-sm">
          <label class="flex-1 min-w-[200px]">
            <span class="block text-xs text-white/50 mb-1">{isEl ? "Αριθμός (E.164)" : "Number (E.164)"}</span>
            <input required type="tel" name="to" placeholder="+306943649190" class="w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2 font-mono text-sm" />
          </label>
          <label class="flex-[2] min-w-[260px]">
            <span class="block text-xs text-white/50 mb-1">{isEl ? "Μήνυμα" : "Message"}</span>
            <input required type="text" name="text" value={isEl ? "Δοκιμή SMS από Sally's Bar." : "Test SMS from Sally's Bar."} class="w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2 text-sm" />
          </label>
          <button type="submit" id="testSmsBtn" class="rounded-lg bg-amber-500 hover:bg-amber-400 text-black text-sm font-bold px-4 py-2 transition">
            {isEl ? "Αποστολή" : "Send"}
          </button>
        </form>
        <p id="testSmsMsg" class="text-xs text-white/60 mt-2 min-h-[1em] font-mono break-all"></p>
      </details>

      <!-- Status tabs -->
      <div class="flex items-center gap-2 flex-wrap text-sm">
        {(["all","pending_ai","pending","confirmed","cancelled"] as const).map(s => (
          <a
            href={`?status=${s}${dateF ? "&date=" + dateF : ""}`}
            class={`px-3 py-1.5 rounded-lg border transition whitespace-nowrap ${
              statusF === s
                ? "bg-amber-400/15 border-amber-400/30 text-amber-400 font-medium"
                : "border-white/10 bg-white/5 text-white/50 hover:text-white"
            }`}
          >
            {s === "all" ? (isEl ? "Όλες" : "All") : statusLabel(s)}
            <span class="ml-1 opacity-60">({counts[s]})</span>
          </a>
        ))}
      </div>

      <!-- Table -->
      {reservations.length === 0 ? (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-10 text-center text-white/40 text-sm">
          {isEl ? "Δεν υπάρχουν κρατήσεις." : "No reservations found."}
        </div>
      ) : (
        <div class="rounded-2xl border border-white/10 bg-white/5 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm" id="resTable">
              <thead>
                <tr class="border-b border-white/10 text-white/40 text-xs uppercase tracking-wider">
                  <th class="text-left px-4 py-3">{isEl ? "Ημερομηνία" : "Date"}</th>
                  <th class="text-left px-4 py-3">{isEl ? "Ώρα" : "Time"}</th>
                  <th class="text-left px-4 py-3">{isEl ? "Όνομα" : "Name"}</th>
                  <th class="text-left px-4 py-3">{isEl ? "Άτομα" : "Guests"}</th>
                  <th class="text-left px-4 py-3">{isEl ? "Επαφή" : "Contact"}</th>
                  <th class="text-left px-4 py-3">{isEl ? "Σημειώσεις" : "Notes"}</th>
                  <th class="text-left px-4 py-3">{isEl ? "Κατάσταση" : "Status"}</th>
                  <th class="text-right px-4 py-3">{isEl ? "Ενέργειες" : "Actions"}</th>
                </tr>
              </thead>
              <tbody id="resBody">
                {reservations.map((r) => (
                  <tr id={r.id.slice(0, 8)} class={`border-b border-white/5 hover:bg-white/[0.02] transition ${r.status === "pending_ai" ? "bg-violet-500/[0.04]" : ""}`} data-id={r.id} data-status={r.status}>
                    <td class="px-4 py-3 text-white/80 whitespace-nowrap">{fmtDate(r.date)}</td>
                    <td class="px-4 py-3 text-white/80 whitespace-nowrap">{r.time}</td>
                    <td class="px-4 py-3">
                      <div class="font-medium text-white flex items-center gap-2">
                        {r.name}
                        {(r as any).source === "ai_voice" && (
                          <span class="text-[10px] font-semibold rounded-full bg-violet-400/20 border border-violet-400/40 text-violet-300 px-1.5 py-0.5" title="Booked by AI agent">🤖 AI</span>
                        )}
                      </div>
                    </td>
                    <td class="px-4 py-3 text-white/70">{r.party_size}</td>
                    <td class="px-4 py-3">
                      {r.email && <div class="text-white/60 text-xs">{r.email}</div>}
                      {r.phone && <div class="text-white/40 text-xs">{r.phone}</div>}
                      {!r.email && !r.phone && <div class="text-white/30 text-xs">—</div>}
                    </td>
                    <td class="px-4 py-3 text-white/40 text-xs max-w-[180px]">
                      <span class="line-clamp-2">{r.notes || "—"}</span>
                    </td>
                    <td class="px-4 py-3">
                      <span class="status-badge text-xs font-semibold px-2 py-0.5 rounded-full"
                        style={`background:${statusColor(r.status)}22;color:${statusColor(r.status)}`}>
                        {statusLabel(r.status)}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                      <button
                        class="action-btn edit-btn text-xs px-2.5 py-1 rounded-lg border border-sky-400/30 text-sky-300 hover:bg-sky-400/10 transition mr-1"
                        data-id={r.id}
                        data-action="edit"
                        data-name={r.name}
                        data-email={r.email ?? ""}
                        data-phone={r.phone ?? ""}
                        data-date={r.date}
                        data-time={r.time}
                        data-party={r.party_size}
                        data-notes={r.notes ?? ""}
                      >
                        {isEl ? "Επεξ." : "Edit"}
                      </button>
                      {r.status !== "confirmed" && (
                        <button
                          class="action-btn confirm-btn text-xs px-2.5 py-1 rounded-lg border border-green-400/30 text-green-400 hover:bg-green-400/10 transition mr-1"
                          data-id={r.id}
                          data-action="confirmed"
                        >
                          {isEl ? "Επιβεβαίωση" : "Confirm"}
                        </button>
                      )}
                      {r.status !== "cancelled" && (
                        <button
                          class="action-btn cancel-btn text-xs px-2.5 py-1 rounded-lg border border-red-400/30 text-red-400 hover:bg-red-400/10 transition mr-1"
                          data-id={r.id}
                          data-action="cancelled"
                        >
                          {isEl ? "Ακύρωση" : "Cancel"}
                        </button>
                      )}
                      <button
                        class="action-btn delete-btn text-xs px-2.5 py-1 rounded-lg border border-white/10 text-white/30 hover:text-red-400 hover:border-red-400/30 transition"
                        data-id={r.id}
                        data-action="delete"
                      >
                        {isEl ? "Διαγρ." : "Del"}
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </main>

    <!-- Toast -->
    <div id="toastHost" class="fixed bottom-6 right-6 z-[90] flex flex-col gap-2 max-w-sm pointer-events-none"></div>

    <!-- New reservation modal -->
    <div id="newOverlay" class="fixed inset-0 z-[80] hidden bg-black/70 backdrop-blur-sm items-center justify-center p-4">
      <div class="w-full max-w-md rounded-2xl border border-white/10 bg-[#16161f] shadow-xl">
        <div class="flex items-center justify-between px-5 py-4 border-b border-white/10">
          <h3 class="font-semibold text-amber-200">{isEl ? "Νέα κράτηση" : "New reservation"}</h3>
          <button id="newClose" class="text-white/50 hover:text-white text-2xl leading-none">×</button>
        </div>
        <form id="newForm" class="p-5 space-y-3 text-sm">
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="text-xs text-white/60">{isEl ? "Ημερομηνία" : "Date"}</span>
              <input required type="date" name="date" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
            </label>
            <label class="block">
              <span class="text-xs text-white/60">{isEl ? "Ώρα" : "Time"}</span>
              <input required type="time" name="time" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
            </label>
          </div>
          <label class="block">
            <span class="text-xs text-white/60">{isEl ? "Όνομα" : "Name"}</span>
            <input required type="text" name="name" placeholder={isEl ? "π.χ. Γιώργος Παπαδόπουλος" : "e.g. George Smith"} class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="text-xs text-white/60">{isEl ? "Άτομα" : "Party size"}</span>
              <input required type="number" name="party_size" min="1" max="50" value="2" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
            </label>
            <label class="block">
              <span class="text-xs text-white/60">{isEl ? "Τηλέφωνο" : "Phone"}</span>
              <input required type="tel" name="phone" placeholder="+306943649190" pattern="\+\d{8,15}" title={isEl ? "E.164, π.χ. +306943649190" : "E.164, e.g. +306943649190"} class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2 font-mono" />
            </label>
          </div>
          <label class="block">
            <span class="text-xs text-white/60">Email {isEl ? "(προαιρετικό)" : "(optional)"}</span>
            <input type="email" name="email" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
          </label>
          <label class="block">
            <span class="text-xs text-white/60">{isEl ? "Σημειώσεις" : "Notes"}</span>
            <textarea name="notes" rows="2" placeholder={isEl ? "θέση παράθυρο, αλλεργίες, …" : "window seat, allergies, …"} class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2"></textarea>
          </label>
          <label class="block">
            <span class="text-xs text-white/60">{isEl ? "Κατάσταση" : "Status"}</span>
            <select name="status" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2">
              <option value="confirmed" selected>{isEl ? "Επιβεβαιωμένη" : "Confirmed"}</option>
              <option value="pending">{isEl ? "Εκκρεμής" : "Pending"}</option>
            </select>
          </label>
          <p id="newMsg" class="text-xs text-rose-300 min-h-[1em]"></p>
          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="newSave" class="flex-1 rounded-lg bg-amber-500 hover:bg-amber-400 text-black text-sm font-bold px-4 py-2 transition">
              {isEl ? "Δημιουργία" : "Create"}
            </button>
            <button type="button" id="newCancel" class="rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 text-sm text-white/70 px-4 py-2 transition">
              {isEl ? "Άκυρο" : "Cancel"}
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Edit modal -->
    <div id="editOverlay" class="fixed inset-0 z-[80] hidden bg-black/70 backdrop-blur-sm items-center justify-center p-4">
      <div class="w-full max-w-md rounded-2xl border border-white/10 bg-[#16161f] shadow-xl">
        <div class="flex items-center justify-between px-5 py-4 border-b border-white/10">
          <h3 class="font-semibold text-amber-200">{isEl ? "Επεξεργασία κράτησης" : "Edit reservation"}</h3>
          <button id="editClose" class="text-white/50 hover:text-white text-2xl leading-none">×</button>
        </div>
        <form id="editForm" class="p-5 space-y-3 text-sm">
          <input type="hidden" name="id" />
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="text-xs text-white/60">{isEl ? "Ημερομηνία" : "Date"}</span>
              <input required type="date" name="date" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
            </label>
            <label class="block">
              <span class="text-xs text-white/60">{isEl ? "Ώρα" : "Time"}</span>
              <input required type="time" name="time" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
            </label>
          </div>
          <label class="block">
            <span class="text-xs text-white/60">{isEl ? "Όνομα" : "Name"}</span>
            <input required type="text" name="name" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="text-xs text-white/60">{isEl ? "Άτομα" : "Party size"}</span>
              <input required type="number" name="party_size" min="1" max="50" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
            </label>
            <label class="block">
              <span class="text-xs text-white/60">{isEl ? "Τηλέφωνο" : "Phone"}</span>
              <input type="tel" name="phone" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2 font-mono" />
            </label>
          </div>
          <label class="block">
            <span class="text-xs text-white/60">Email</span>
            <input type="email" name="email" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2" />
          </label>
          <label class="block">
            <span class="text-xs text-white/60">{isEl ? "Σημειώσεις" : "Notes"}</span>
            <textarea name="notes" rows="2" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2"></textarea>
          </label>
          <p id="editMsg" class="text-xs text-rose-300 min-h-[1em]"></p>
          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="editSave" class="flex-1 rounded-lg bg-amber-500 hover:bg-amber-400 text-black text-sm font-bold px-4 py-2 transition">
              {isEl ? "Αποθήκευση" : "Save"}
            </button>
            <button type="button" id="editCancel" class="rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 text-sm text-white/70 px-4 py-2 transition">
              {isEl ? "Άκυρο" : "Cancel"}
            </button>
          </div>
        </form>
      </div>
    </div>

    <script define:vars={{ isEl }}>
      const statusColors = { confirmed: "#4ade80", cancelled: "#f87171", pending: "#fbbf24", pending_ai: "#a78bfa" };

      function slabel(s) {
        if (s === "pending_ai") return isEl ? "🤖 Εκκρεμεί AI" : "🤖 AI pending";
        if (!isEl) return s.charAt(0).toUpperCase() + s.slice(1);
        return { pending: "Εκκρεμής", confirmed: "Επιβεβαιωμένη", cancelled: "Ακυρωμένη" }[s] ?? s;
      }

      // Scroll to the highlighted row if ?#<prefix> is present in the URL
      if (location.hash) {
        const row = document.getElementById(location.hash.slice(1));
        if (row) {
          row.scrollIntoView({ behavior: "smooth", block: "center" });
          row.classList.add("ring-2", "ring-amber-400/60");
          setTimeout(() => row.classList.remove("ring-2", "ring-amber-400/60"), 3000);
        }
      }

      function makeBtn(id, action) {
        const cfg = {
          confirmed: { cls: "border-green-400/30 text-green-400 hover:bg-green-400/10 mr-1", label: isEl ? "Επιβεβαίωση" : "Confirm" },
          cancelled: { cls: "border-red-400/30 text-red-400 hover:bg-red-400/10 mr-1",       label: isEl ? "Ακύρωση" : "Cancel" },
          delete:    { cls: "border-white/10 text-white/30 hover:text-red-400 hover:border-red-400/30", label: isEl ? "Διαγρ." : "Del" },
        }[action];
        const b = document.createElement("button");
        b.className = `action-btn text-xs px-2.5 py-1 rounded-lg border transition ${cfg.cls}`;
        b.dataset.id = id; b.dataset.action = action;
        b.textContent = cfg.label;
        return b;
      }

      function rebuildActions(cell, id, newStatus) {
        cell.innerHTML = "";
        if (newStatus !== "confirmed") cell.appendChild(makeBtn(id, "confirmed"));
        if (newStatus !== "cancelled") cell.appendChild(makeBtn(id, "cancelled"));
        cell.appendChild(makeBtn(id, "delete"));
      }

      // Edit modal wiring
      const overlay = document.getElementById("editOverlay");
      const form    = document.getElementById("editForm");
      const msgEl   = document.getElementById("editMsg");
      function openEdit(b) {
        form.id.value         = b.dataset.id;
        form.name.value       = b.dataset.name  ?? "";
        form.email.value      = b.dataset.email ?? "";
        form.phone.value      = b.dataset.phone ?? "";
        form.date.value       = b.dataset.date  ?? "";
        form.time.value       = (b.dataset.time ?? "").slice(0, 5);
        form.party_size.value = b.dataset.party ?? "";
        form.notes.value      = b.dataset.notes ?? "";
        msgEl.textContent = "";
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
      }
      function closeEdit() {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
      }
      document.getElementById("editClose")?.addEventListener("click", closeEdit);
      document.getElementById("editCancel")?.addEventListener("click", closeEdit);
      overlay?.addEventListener("click", (e) => { if (e.target === overlay) closeEdit(); });

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const payload = Object.fromEntries(fd.entries());
        payload.party_size = Number(payload.party_size);
        const saveBtn = document.getElementById("editSave");
        saveBtn.disabled = true; saveBtn.textContent = "…";
        try {
          const res = await fetch("/api/admin/reservations", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const j = await res.json().catch(() => ({}));
          if (!res.ok || j.error) throw new Error(j?.error || ("HTTP " + res.status));
          // Refresh to show updated row (simplest, also re-sorts by date/time)
          location.reload();
        } catch (err) {
          msgEl.textContent = (isEl ? "Σφάλμα: " : "Error: ") + (err?.message || "");
          saveBtn.disabled = false;
          saveBtn.textContent = isEl ? "Αποθήκευση" : "Save";
        }
      });

      // Toast
      const toastHost = document.getElementById("toastHost");
      function toast(text, tone = "info", ms = 4000) {
        const tones = {
          ok:    "border-emerald-400/40 bg-emerald-500/15 text-emerald-100",
          warn:  "border-amber-400/40 bg-amber-500/15 text-amber-100",
          error: "border-rose-400/40 bg-rose-500/15 text-rose-100",
          info:  "border-white/20 bg-white/[0.08] text-white",
        };
        const el = document.createElement("div");
        el.className = `pointer-events-auto rounded-xl border px-4 py-3 text-sm shadow-xl backdrop-blur-sm transition-all duration-300 translate-x-0 ${tones[tone] ?? tones.info}`;
        el.textContent = text;
        toastHost.appendChild(el);
        // fade out
        setTimeout(() => {
          el.style.opacity = "0";
          el.style.transform = "translateX(20px)";
          setTimeout(() => el.remove(), 300);
        }, ms);
      }

      function smsReason(reason) {
        return ({
          no_phone:         isEl ? "χωρίς τηλέφωνο" : "no phone on file",
          already_decided:  isEl ? "είχε ήδη αποφασιστεί" : "already decided",
          not_a_decision:   isEl ? "δεν στέλνει SMS σε αυτή την κατάσταση" : "no SMS for this status",
        })[reason] ?? reason;
      }

      // New reservation modal
      const newOverlay = document.getElementById("newOverlay");
      const newForm    = document.getElementById("newForm");
      const newMsg     = document.getElementById("newMsg");
      function openNew() {
        newForm.reset();
        // Default date to today, time to next half-hour
        const now = new Date();
        const iso = now.getFullYear() + "-" + String(now.getMonth()+1).padStart(2,"0") + "-" + String(now.getDate()).padStart(2,"0");
        const h = now.getHours(), m = now.getMinutes();
        const nh = m < 30 ? h : (h + 1) % 24;
        const nm = m < 30 ? 30 : 0;
        newForm.date.value = iso;
        newForm.time.value = String(nh).padStart(2,"0") + ":" + String(nm).padStart(2,"0");
        newMsg.textContent = "";
        newOverlay.classList.remove("hidden");
        newOverlay.classList.add("flex");
      }
      function closeNew() {
        newOverlay.classList.add("hidden");
        newOverlay.classList.remove("flex");
      }
      document.getElementById("newResBtn")?.addEventListener("click", openNew);
      document.getElementById("newClose")?.addEventListener("click", closeNew);
      document.getElementById("newCancel")?.addEventListener("click", closeNew);
      newOverlay?.addEventListener("click", (e) => { if (e.target === newOverlay) closeNew(); });

      newForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(newForm);
        const payload = Object.fromEntries(fd.entries());
        payload.party_size = Number(payload.party_size);
        const btn = document.getElementById("newSave");
        btn.disabled = true; btn.textContent = "…";
        try {
          const res = await fetch("/api/admin/reservations", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const j = await res.json().catch(() => ({}));
          if (res.status === 409 && j?.full) {
            const cap = j.capacity || {};
            const want = isEl ? "Παράκαμψη και δημιουργία;" : "Override capacity and create anyway?";
            const msg = (isEl ? "Γεμάτο: " : "Fully booked: ") + (cap.used ?? "?") + "/" + (cap.capacity ?? "?") + ". " + want;
            if (confirm(msg)) {
              payload.force = true;
              const r2 = await fetch("/api/admin/reservations", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
              });
              const j2 = await r2.json().catch(() => ({}));
              if (!r2.ok || j2.error) throw new Error(j2?.error || ("HTTP " + r2.status));
              toast(isEl ? "Δημιουργήθηκε (παράκαμψη ορίου)" : "Created (capacity override)", "warn");
              location.reload();
              return;
            }
            newMsg.textContent = isEl ? "Δεν δημιουργήθηκε." : "Not created.";
            btn.disabled = false;
            btn.textContent = isEl ? "Δημιουργία" : "Create";
            return;
          }
          if (!res.ok || j.error) throw new Error(j?.error || ("HTTP " + res.status));
          toast(isEl ? "Η κράτηση δημιουργήθηκε" : "Reservation created", "ok");
          location.reload();
        } catch (err) {
          newMsg.textContent = (isEl ? "Σφάλμα: " : "Error: ") + (err?.message || "");
          btn.disabled = false;
          btn.textContent = isEl ? "Δημιουργία" : "Create";
        }
      });

      // Test SMS form
      const testForm = document.getElementById("testSmsForm");
      const testMsg  = document.getElementById("testSmsMsg");
      const testBtn  = document.getElementById("testSmsBtn");
      testForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(testForm);
        testMsg.textContent = isEl ? "Αποστολή…" : "Sending…";
        testBtn.disabled = true;
        try {
          const res = await fetch("/api/admin/test-sms", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ to: fd.get("to"), text: fd.get("text") }),
          });
          const j = await res.json().catch(() => ({}));
          if (j?.result?.ok) {
            testMsg.style.color = "#6ee7b7";
            testMsg.textContent = "✓ " + (isEl ? "Αποστάλθηκε. UUID: " : "Sent. UUID: ") + j.result.message_uuid;
          } else {
            testMsg.style.color = "#fca5a5";
            testMsg.textContent = "✕ " + (j?.result?.error || j?.error || ("HTTP " + res.status));
          }
        } catch (err) {
          testMsg.style.color = "#fca5a5";
          testMsg.textContent = "✕ " + (err?.message || "error");
        } finally {
          testBtn.disabled = false;
        }
      });

      // Event delegation on table body
      document.getElementById("resBody")?.addEventListener("click", async (e) => {
        const btn = e.target.closest(".action-btn");
        if (!btn) return;

        const id     = btn.dataset.id;
        const action = btn.dataset.action;
        const row    = btn.closest("tr");

        if (action === "edit") {
          openEdit(btn);
          return;
        }

        if (action === "delete") {
          if (!confirm(isEl ? "Διαγραφή κράτησης;" : "Delete this reservation?")) return;
          const res = await fetch("/api/admin/reservations", {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id }),
          });
          if (res.ok) { row?.remove(); toast(isEl ? "Η κράτηση διαγράφηκε" : "Reservation deleted", "ok"); }
          else toast(isEl ? "Σφάλμα διαγραφής" : "Delete failed", "error");
          return;
        }

        // Confirm / Cancel
        btn.disabled = true;
        const res = await fetch("/api/admin/reservations", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, status: action }),
        });
        let j = {};
        try { j = await res.json(); } catch {}
        if (!res.ok) {
          btn.disabled = false;
          toast((isEl ? "Σφάλμα: " : "Error: ") + (j?.error || ("HTTP " + res.status)), "error");
          return;
        }

        // Update badge
        const badge = row?.querySelector(".status-badge");
        const color = statusColors[action] ?? "#fff";
        if (badge) {
          badge.textContent      = slabel(action);
          badge.style.background = color + "22";
          badge.style.color      = color;
        }

        // Rebuild action buttons
        const actionsCell = row?.querySelector("td:last-child");
        if (actionsCell) rebuildActions(actionsCell, id, action);

        // SMS status toast
        const sms = j?.sms;
        const verb = action === "confirmed"
          ? (isEl ? "Επιβεβαιώθηκε" : "Confirmed")
          : (isEl ? "Ακυρώθηκε" : "Cancelled");
        if (sms?.attempted && sms?.ok) {
          toast(`✓ ${verb}. ${isEl ? "SMS στάλθηκε στον πελάτη" : "SMS sent to customer"}`, "ok");
        } else if (sms?.attempted && !sms?.ok) {
          toast(`✓ ${verb}, ${isEl ? "αλλά το SMS απέτυχε" : "but SMS failed"}: ${sms.error ?? ""}`, "warn", 7000);
        } else if (sms?.reason) {
          toast(`✓ ${verb} (${isEl ? "δεν στάλθηκε SMS" : "no SMS sent"} — ${smsReason(sms.reason)})`, "info");
        } else {
          toast(`✓ ${verb}`, "ok");
        }
      });
    </script>
  </body>
</html>
