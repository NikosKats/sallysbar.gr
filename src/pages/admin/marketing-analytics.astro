---
import "../../styles/global.css";
import AdminNav from "../../components/AdminNav.astro";
import { supabaseAdmin } from "../../lib/supabase";
import { withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!["admin","super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}

const daysParam = Number(Astro.url.searchParams.get("days") ?? "30");
const days = [7, 30, 90, 365].includes(daysParam) ? daysParam : 30;
const since = new Date(Date.now() - days * 24 * 3600 * 1000).toISOString();
const campaignFilter = Astro.url.searchParams.get("c") || null;

const { data: campaigns } = await supabaseAdmin
  .from("campaigns")
  .select("id, name, slug, scan_count, active")
  .order("scan_count", { ascending: false });

let scansQ = supabaseAdmin
  .from("campaign_scans")
  .select("scanned_at, campaign_id, country, region, city, device, browser, os, referer, accept_language, timezone")
  .gte("scanned_at", since)
  .order("scanned_at", { ascending: false })
  .limit(5000);
if (campaignFilter) scansQ = scansQ.eq("campaign_id", campaignFilter);
const { data: scans } = await scansQ;

const rows = scans ?? [];
const totalScans = rows.length;
const uniqueCountries = new Set(rows.map(r => r.country).filter(Boolean)).size;

// Aggregations
function top(values: (string | null | undefined)[], limit = 10) {
  const map = new Map<string, number>();
  for (const v of values) {
    const k = (v ?? "(unknown)").toString();
    map.set(k, (map.get(k) ?? 0) + 1);
  }
  return [...map.entries()].sort((a, b) => b[1] - a[1]).slice(0, limit);
}

const byCountry = top(rows.map(r => r.country));
const byDevice  = top(rows.map(r => r.device));
const byBrowser = top(rows.map(r => r.browser));
const byOS      = top(rows.map(r => r.os));
const byLang    = top(rows.map(r => (r.accept_language ?? "").split(",")[0]?.split(";")[0]?.trim() || null));
const byCity    = top(rows.map(r => r.city));
const byReferer = top(rows.map(r => {
  if (!r.referer) return "(direct)";
  try { return new URL(r.referer).hostname; } catch { return r.referer; }
}));

const campaignById = new Map((campaigns ?? []).map(c => [c.id, c]));
const byCampaign: Array<[string, number]> = top(rows.map(r => r.campaign_id)).map(([id, n]) => {
  const c = campaignById.get(id);
  return [c ? `${c.name} (/${c.slug})` : "(deleted)", n];
});

// Daily timeseries
const dayBuckets = new Map<string, number>();
for (let i = days - 1; i >= 0; i--) {
  const d = new Date(Date.now() - i * 24 * 3600 * 1000);
  dayBuckets.set(d.toISOString().slice(0, 10), 0);
}
for (const r of rows) {
  const k = r.scanned_at?.slice(0, 10);
  if (k && dayBuckets.has(k)) dayBuckets.set(k, (dayBuckets.get(k) ?? 0) + 1);
}
const series = [...dayBuckets.entries()];
const maxDay = Math.max(1, ...series.map(s => s[1]));

// Recent list
const recent = rows.slice(0, 50);

const totalCampaigns = (campaigns ?? []).length;
const activeCampaigns = (campaigns ?? []).filter(c => c.active).length;

function flag(cc: string | null | undefined) {
  if (!cc || cc.length !== 2) return "🏳️";
  return String.fromCodePoint(...[...cc.toUpperCase()].map(c => 0x1F1E6 - 65 + c.charCodeAt(0)));
}
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isEl ? "Marketing Analytics" : "Marketing Analytics"} — Admin</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <AdminNav active="marketing-analytics" />

    <main class="mx-auto max-w-6xl px-4 py-6 space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 class="text-2xl font-bold">{isEl ? "Marketing Analytics" : "Marketing Analytics"}</h1>
          <p class="text-sm text-white/50 mt-1">
            {isEl ? `Δεδομένα σκαναρίσματος για τις τελευταίες ${days} ημέρες.` : `QR scan data for the last ${days} days.`}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <form method="get" class="flex items-center gap-2">
            <select name="days" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50">
              <option value="7"   selected={days === 7}>{isEl ? "7 ημέρες" : "Last 7 days"}</option>
              <option value="30"  selected={days === 30}>{isEl ? "30 ημέρες" : "Last 30 days"}</option>
              <option value="90"  selected={days === 90}>{isEl ? "90 ημέρες" : "Last 90 days"}</option>
              <option value="365" selected={days === 365}>{isEl ? "1 έτος" : "Last year"}</option>
            </select>
            <select name="c" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50">
              <option value="">{isEl ? "Όλες οι καμπάνιες" : "All campaigns"}</option>
              {(campaigns ?? []).map(c => (
                <option value={c.id} selected={campaignFilter === c.id}>{c.name}</option>
              ))}
            </select>
            <button type="submit" class="rounded-lg bg-amber-400 text-black px-3 py-2 text-sm font-semibold hover:bg-amber-300 transition">
              {isEl ? "Εφαρμογή" : "Apply"}
            </button>
          </form>
        </div>
      </div>

      <!-- KPI cards -->
      <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-xs uppercase tracking-wider text-white/40">{isEl ? "Σύνολο σκαναρισμάτων" : "Total scans"}</p>
          <p class="text-3xl font-bold text-white mt-1">{totalScans}</p>
        </div>
        <div class="rounded-2xl border border-amber-400/20 bg-amber-400/5 p-4">
          <p class="text-xs uppercase tracking-wider text-amber-300/70">{isEl ? "Χώρες" : "Countries"}</p>
          <p class="text-3xl font-bold text-amber-300 mt-1">{uniqueCountries}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-xs uppercase tracking-wider text-white/40">{isEl ? "Ενεργές καμπάνιες" : "Active campaigns"}</p>
          <p class="text-3xl font-bold text-white mt-1">{activeCampaigns} <span class="text-sm text-white/40 font-normal">/ {totalCampaigns}</span></p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-xs uppercase tracking-wider text-white/40">{isEl ? "Μ.Ο. / ημέρα" : "Avg / day"}</p>
          <p class="text-3xl font-bold text-white mt-1">{(totalScans / days).toFixed(1)}</p>
        </div>
      </section>

      <!-- Daily chart -->
      <section class="rounded-2xl border border-white/10 bg-white/5 p-5">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-4">{isEl ? "Σκαναρίσματα ανά ημέρα" : "Scans per day"}</h2>
        <div class="flex items-end gap-1 h-32">
          {series.map(([d, n]) => {
            const h = (n / maxDay) * 100;
            return (
              <div class="flex-1 min-w-[4px] group relative flex flex-col items-center">
                <div class="w-full bg-amber-400/80 hover:bg-amber-300 transition rounded-t" style={`height: ${h}%`}></div>
                <span class="absolute -top-5 text-[10px] text-white/50 opacity-0 group-hover:opacity-100 transition whitespace-nowrap">{d}: {n}</span>
              </div>
            );
          })}
        </div>
        <div class="mt-2 flex justify-between text-[10px] text-white/30">
          <span>{series[0]?.[0]}</span>
          <span>{series[series.length - 1]?.[0]}</span>
        </div>
      </section>

      <!-- Breakdown grid -->
      <section class="grid md:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-3">{isEl ? "Κορυφαίες Χώρες" : "Top Countries"}</h2>
          {byCountry.length === 0
            ? <p class="text-sm text-white/40">—</p>
            : <ul class="space-y-1.5">
                {byCountry.map(([k, n]) => (
                  <li class="flex items-center justify-between gap-3 text-sm">
                    <span class="flex items-center gap-2 min-w-0"><span class="text-lg">{flag(k)}</span><span class="truncate text-white/80">{k}</span></span>
                    <span class="font-mono text-amber-300 text-xs shrink-0">{n}</span>
                  </li>
                ))}
              </ul>
          }
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-3">{isEl ? "Ανά Καμπάνια" : "By Campaign"}</h2>
          {byCampaign.length === 0
            ? <p class="text-sm text-white/40">—</p>
            : <ul class="space-y-1.5">
                {byCampaign.map(([k, n]) => (
                  <li class="flex items-center justify-between gap-3 text-sm">
                    <span class="truncate text-white/80">{k}</span>
                    <span class="font-mono text-amber-300 text-xs shrink-0">{n}</span>
                  </li>
                ))}
              </ul>
          }
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-3">{isEl ? "Συσκευές" : "Devices"}</h2>
          <ul class="space-y-1.5">
            {byDevice.map(([k, n]) => (
              <li class="flex items-center justify-between gap-3 text-sm">
                <span class="text-white/80 capitalize">{k}</span>
                <span class="font-mono text-amber-300 text-xs">{n}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-3">Browsers</h2>
          <ul class="space-y-1.5">
            {byBrowser.map(([k, n]) => (
              <li class="flex items-center justify-between gap-3 text-sm">
                <span class="text-white/80">{k}</span>
                <span class="font-mono text-amber-300 text-xs">{n}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-3">{isEl ? "Λειτουργικό" : "OS"}</h2>
          <ul class="space-y-1.5">
            {byOS.map(([k, n]) => (
              <li class="flex items-center justify-between gap-3 text-sm">
                <span class="text-white/80">{k}</span>
                <span class="font-mono text-amber-300 text-xs">{n}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-3">{isEl ? "Κορυφαίες Πόλεις" : "Top Cities"}</h2>
          {byCity.length === 0
            ? <p class="text-sm text-white/40">—</p>
            : <ul class="space-y-1.5">
                {byCity.map(([k, n]) => (
                  <li class="flex items-center justify-between gap-3 text-sm">
                    <span class="text-white/80 truncate">{k}</span>
                    <span class="font-mono text-amber-300 text-xs shrink-0">{n}</span>
                  </li>
                ))}
              </ul>
          }
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-3">{isEl ? "Γλώσσα" : "Language"}</h2>
          <ul class="space-y-1.5">
            {byLang.map(([k, n]) => (
              <li class="flex items-center justify-between gap-3 text-sm">
                <span class="text-white/80">{k}</span>
                <span class="font-mono text-amber-300 text-xs">{n}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-3">{isEl ? "Πηγή παραπομπής" : "Referrer"}</h2>
          <ul class="space-y-1.5">
            {byReferer.map(([k, n]) => (
              <li class="flex items-center justify-between gap-3 text-sm">
                <span class="text-white/80 truncate">{k}</span>
                <span class="font-mono text-amber-300 text-xs shrink-0">{n}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Recent scans -->
      <section class="rounded-2xl border border-white/10 bg-white/5 overflow-hidden">
        <div class="px-5 py-3 border-b border-white/10 flex items-center justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50">{isEl ? "Πρόσφατα σκαναρίσματα" : "Recent scans"}</h2>
          <span class="text-xs text-white/40">{isEl ? `Προβολή τελευταίων ${recent.length}` : `Showing latest ${recent.length}`}</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead class="bg-white/5">
              <tr class="text-white/40 text-[10px] uppercase tracking-wider">
                <th class="text-left px-3 py-2">{isEl ? "Ώρα" : "Time"}</th>
                <th class="text-left px-3 py-2">{isEl ? "Καμπάνια" : "Campaign"}</th>
                <th class="text-left px-3 py-2">{isEl ? "Χώρα" : "Country"}</th>
                <th class="text-left px-3 py-2">{isEl ? "Πόλη" : "City"}</th>
                <th class="text-left px-3 py-2">{isEl ? "Συσκευή" : "Device"}</th>
                <th class="text-left px-3 py-2">Browser</th>
                <th class="text-left px-3 py-2">OS</th>
                <th class="text-left px-3 py-2">{isEl ? "Πηγή" : "Referrer"}</th>
              </tr>
            </thead>
            <tbody>
              {recent.map(r => {
                const c = campaignById.get(r.campaign_id);
                const refHost = (() => { if (!r.referer) return "(direct)"; try { return new URL(r.referer).hostname; } catch { return r.referer; } })();
                return (
                  <tr class="border-t border-white/5 hover:bg-white/[0.03]">
                    <td class="px-3 py-2 text-white/70 whitespace-nowrap">{new Date(r.scanned_at).toLocaleString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })}</td>
                    <td class="px-3 py-2 text-white/80 truncate max-w-[180px]">{c?.name ?? "—"}</td>
                    <td class="px-3 py-2 text-white/70 whitespace-nowrap">{flag(r.country)} {r.country ?? "—"}</td>
                    <td class="px-3 py-2 text-white/70 truncate max-w-[140px]">{r.city ?? "—"}</td>
                    <td class="px-3 py-2 text-white/70 capitalize">{r.device ?? "—"}</td>
                    <td class="px-3 py-2 text-white/70">{r.browser ?? "—"}</td>
                    <td class="px-3 py-2 text-white/70">{r.os ?? "—"}</td>
                    <td class="px-3 py-2 text-white/50 truncate max-w-[140px]">{refHost}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <div class="pt-2">
        <a href="/admin/marketing" class="text-xs text-white/50 hover:text-amber-300 transition">← {isEl ? "Πίσω στις καμπάνιες" : "Back to campaigns"}</a>
      </div>
    </main>
  </body>
</html>
