---
import "../../../styles/global.css";
import { withLangPrefix } from "../../../i18n";
import { site } from "../../../data/site";

export const prerender = false;

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!["admin", "super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}

const url = new URL(Astro.request.url);
const n = (k: string, fb = 0) => {
  const v = Number(url.searchParams.get(k));
  return Number.isFinite(v) ? v : fb;
};
const channel   = url.searchParams.get("channel") ?? "sms";
const count     = n("count");
const unit      = n("unit");
const wholesale = n("wholesale");
const commPct   = n("commission_pct");
const commission = n("commission");
const billable  = n("billable");
const vat       = n("vat");
const gross     = n("gross");

// Invoice number: date-based, editable client-side
const now = new Date();
const pad = (x: number) => String(x).padStart(2, "0");
const invoiceNumber = `PIST-${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}`;
const invoiceDate = now.toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "long", year: "numeric" });
const dueDate = new Date(Date.now() + 14 * 86400_000).toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "long", year: "numeric" });

const eur = (x: number) => "€" + x.toFixed(2);

const channelLabel = channel === "sms" ? "SMS" : channel === "whatsapp" ? "WhatsApp" : channel === "push" ? "Push" : "Email";
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isEl ? "Τιμολόγιο" : "Invoice"} {invoiceNumber} — PistotitaOS</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      @media print {
        @page { size: A4; margin: 15mm; }
        body { background: white !important; color: black !important; }
        .no-print { display: none !important; }
        .inv-card, .inv-section { border-color: #d0d0d0 !important; background: white !important; }
        [contenteditable="true"] { outline: none !important; border: none !important; }
        * { color: black !important; }
      }
      [contenteditable="true"] { outline: 1px dashed rgba(251, 191, 36, 0.4); outline-offset: 2px; border-radius: 4px; padding: 0 4px; }
      [contenteditable="true"]:focus { outline: 2px solid rgba(251, 191, 36, 0.7); background: rgba(251, 191, 36, 0.06); }
    </style>
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white p-4 md:p-8">
    <!-- Toolbar -->
    <div class="no-print max-w-3xl mx-auto mb-4 flex items-center justify-between gap-3 flex-wrap">
      <a href={withLangPrefix(lang, "/admin/campaigns")} class="text-sm text-sky-300 hover:text-sky-200">← {isEl ? "Πίσω στις καμπάνιες" : "Back to campaigns"}</a>
      <div class="flex gap-2">
        <button onclick="window.print()" class="rounded-lg bg-amber-500 hover:bg-amber-400 text-black font-bold px-4 py-2 text-sm">🖨 {isEl ? "Εκτύπωση / PDF" : "Print / Save PDF"}</button>
      </div>
    </div>

    <p class="no-print max-w-3xl mx-auto mb-3 text-[11px] text-white/50">
      💡 {isEl ? "Πάτησε πάνω σε οποιοδήποτε κείμενο για επεξεργασία πριν την εκτύπωση (όνομα πελάτη, ΑΦΜ, διεύθυνση, σημειώσεις)." : "Click any text to edit before printing (customer name, VAT ID, address, notes)."}
    </p>

    <!-- Invoice body -->
    <main class="max-w-3xl mx-auto bg-white text-black rounded-2xl p-8 md:p-12 shadow-2xl inv-card">
      <!-- Header: brand + number -->
      <div class="flex items-start justify-between gap-6 pb-6 border-b border-gray-300">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-amber-600 font-bold">PistotitaOS</p>
          <h1 class="font-heading text-3xl font-bold mt-1">{isEl ? "Τιμολόγιο Υπηρεσιών" : "Services Invoice"}</h1>
          <p class="mt-2 text-sm text-gray-600">{isEl ? "Καμπάνια ανακοινώσεων" : "Broadcast campaign"} · {channelLabel}</p>
        </div>
        <div class="text-right text-sm">
          <p class="text-gray-500">{isEl ? "Αρ. Τιμολογίου" : "Invoice №"}</p>
          <p class="font-mono font-bold text-lg" contenteditable="true">{invoiceNumber}</p>
          <p class="text-gray-500 mt-2">{isEl ? "Ημερομηνία" : "Date"}</p>
          <p class="font-semibold" contenteditable="true">{invoiceDate}</p>
          <p class="text-gray-500 mt-2">{isEl ? "Πληρωτέο έως" : "Due by"}</p>
          <p contenteditable="true">{dueDate}</p>
        </div>
      </div>

      <!-- Parties -->
      <div class="grid grid-cols-2 gap-8 py-6 border-b border-gray-300 text-sm">
        <div>
          <p class="text-xs uppercase tracking-wider text-gray-500 font-bold mb-2">{isEl ? "Από" : "From"}</p>
          <p class="font-bold">PistotitaOS</p>
          <p contenteditable="true">{site.name}</p>
          <p contenteditable="true">Skala, 28086, Kefalonia, Greece</p>
          <p contenteditable="true">VAT: EL_____________</p>
          <p contenteditable="true">bookings@sallysbar.gr</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-gray-500 font-bold mb-2">{isEl ? "Προς" : "Bill to"}</p>
          <p class="font-bold" contenteditable="true">{isEl ? "Όνομα πελάτη" : "Customer name"}</p>
          <p contenteditable="true">{isEl ? "Διεύθυνση" : "Address"}</p>
          <p contenteditable="true">{isEl ? "Πόλη, Τ.Κ." : "City, Postal code"}</p>
          <p contenteditable="true">VAT: EL_____________</p>
          <p contenteditable="true">email@customer.tld</p>
        </div>
      </div>

      <!-- Line items -->
      <div class="py-6">
        <table class="w-full text-sm">
          <thead class="text-xs uppercase tracking-wider text-gray-500 border-b border-gray-300">
            <tr>
              <th class="text-left py-2">{isEl ? "Περιγραφή" : "Description"}</th>
              <th class="text-right py-2 w-20">{isEl ? "Ποσ." : "Qty"}</th>
              <th class="text-right py-2 w-24">{isEl ? "Τιμή" : "Unit"}</th>
              <th class="text-right py-2 w-24">{isEl ? "Ποσό" : "Amount"}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="py-3">
                <p class="font-semibold">{channelLabel} {isEl ? "καμπάνια — κόστος API" : "campaign — API delivery cost"}</p>
                <p class="text-xs text-gray-500 mt-0.5" contenteditable="true">{isEl ? "Χονδρική χρέωση API μηνυμάτων" : "Wholesale messaging cost"}</p>
              </td>
              <td class="py-3 text-right font-mono">{count}</td>
              <td class="py-3 text-right font-mono">{eur(unit)}</td>
              <td class="py-3 text-right font-mono">{eur(wholesale)}</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-3">
                <p class="font-semibold">{isEl ? "Υπηρεσίες PistotitaOS" : "PistotitaOS services"}</p>
                <p class="text-xs text-gray-500 mt-0.5" contenteditable="true">
                  {isEl
                    ? `Προετοιμασία καμπάνιας, targeting, πλατφόρμα delivery (+${commPct}%)`
                    : `Campaign setup, targeting, delivery platform (+${commPct}%)`}
                </p>
              </td>
              <td class="py-3 text-right font-mono">1</td>
              <td class="py-3 text-right font-mono">{eur(commission)}</td>
              <td class="py-3 text-right font-mono">{eur(commission)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Totals -->
      <div class="pt-4 border-t border-gray-300">
        <div class="ml-auto max-w-xs space-y-1.5 text-sm">
          <div class="flex justify-between"><span class="text-gray-600">{isEl ? "Καθαρή αξία" : "Subtotal (net)"}</span><span class="font-mono">{eur(billable)}</span></div>
          <div class="flex justify-between"><span class="text-gray-600">{isEl ? "ΦΠΑ 24%" : "VAT 24%"}</span><span class="font-mono">{eur(vat)}</span></div>
          <div class="flex justify-between pt-2 mt-1 border-t border-gray-400 text-lg font-bold"><span>{isEl ? "Σύνολο" : "Total"}</span><span class="font-mono">{eur(gross)}</span></div>
        </div>
      </div>

      <!-- Payment + footer -->
      <div class="mt-8 pt-6 border-t border-gray-300 text-sm">
        <p class="text-xs uppercase tracking-wider text-gray-500 font-bold mb-2">{isEl ? "Στοιχεία πληρωμής" : "Payment details"}</p>
        <p class="text-gray-700" contenteditable="true">
          {isEl
            ? "Τράπεζα: ____________  ·  IBAN: GR__ ____ ____ ____ ____ ____ ____  ·  Κωδ. Πληρωμής: [αρ. τιμολογίου]"
            : "Bank: ____________  ·  IBAN: GR__ ____ ____ ____ ____ ____ ____  ·  Payment reference: [invoice number]"}
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-gray-200 text-[11px] text-gray-500 leading-relaxed">
        <p contenteditable="true">
          {isEl
            ? "Οι τιμές SMS/WhatsApp αντικατοπτρίζουν την τιμολόγηση του παρόχου προς Ελλάδα. Οι προμήθειες PistotitaOS περιλαμβάνουν setup της καμπάνιας, targeting, dispatch και logging. Όλες οι τιμές σε EUR. ΦΠΑ 24% εφαρμόζεται."
            : "SMS/WhatsApp rates reflect carrier pricing to Greece. PistotitaOS service fees cover campaign setup, targeting, dispatch and logging. All prices in EUR. 24% VAT applies."}
        </p>
      </div>
    </main>
  </body>
</html>
