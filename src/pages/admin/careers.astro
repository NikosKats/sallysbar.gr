---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import AdminNav from "../../components/AdminNav.astro";
import { supabaseAdmin } from "../../lib/supabase";
import { withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!["admin","super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}

const { data: jobs } = await supabaseAdmin
  .from("job_listings")
  .select("*")
  .order("sort_order", { ascending: true })
  .order("created_at", { ascending: false });

const { data: applications } = await supabaseAdmin
  .from("job_applications")
  .select("id, job_id, full_name, email, phone, message, cv_url, cv_filename, status, created_at")
  .order("created_at", { ascending: false })
  .limit(200);

const { data: careersSettings } = await supabaseAdmin
  .from("careers_settings")
  .select("notify_email, notify_enabled")
  .eq("id", 1)
  .single();

const jobTitleMap = new Map<string, string>();
for (const j of jobs ?? []) jobTitleMap.set(j.id, isEl ? j.title_el : j.title_en);
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isEl ? "Καριέρα" : "Careers"} — Admin</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <Header />
    <div class="h-20"></div>
    <AdminNav active="careers" />

    <main class="mx-auto max-w-5xl px-4 py-6 space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <h1 class="text-xl font-bold">{isEl ? "Αγγελίες Εργασίας" : "Job Listings"}</h1>
        <button id="newJobBtn" class="rounded-xl bg-amber-400 text-black px-4 py-2 text-sm font-semibold hover:bg-amber-300 transition">
          + {isEl ? "Νέα αγγελία" : "New job"}
        </button>
      </div>

      <p class="text-xs text-white/50">
        {isEl
          ? "Οι ενεργές αγγελίες εμφανίζονται δημόσια στο /careers με κουμπιά κοινοποίησης."
          : "Active listings are shown publicly on /careers with share buttons."}
      </p>

      <!-- Notification settings -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-5 space-y-3">
        <h2 class="text-sm font-semibold text-white/50 uppercase tracking-widest">
          {isEl ? "Ειδοποιήσεις Αιτήσεων" : "Application Notifications"}
        </h2>
        <form id="settingsForm" class="grid sm:grid-cols-[1fr_auto_auto] gap-3 items-end">
          <label class="block">
            <span class="text-xs text-white/40 uppercase tracking-wider">{isEl ? "Email για ειδοποιήσεις" : "Notify email"}</span>
            <input name="notify_email" type="email" value={careersSettings?.notify_email ?? ""} placeholder="jobs@sallysbar.gr"
              class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" />
          </label>
          <label class="flex items-center gap-2 text-sm text-white/80 rounded-xl border border-white/10 bg-white/5 px-3 py-2">
            <input type="checkbox" name="notify_enabled" checked={careersSettings?.notify_enabled !== false} class="h-4 w-4" />
            {isEl ? "Ενεργό" : "Enabled"}
          </label>
          <button type="submit" class="rounded-xl bg-amber-400 text-black px-4 py-2 text-sm font-semibold hover:bg-amber-300 transition">
            {isEl ? "Αποθήκευση" : "Save"}
          </button>
        </form>
        <p id="settingsMsg" class="text-xs hidden"></p>
        <p class="text-xs text-white/40">
          {isEl
            ? "Κάθε νέα αίτηση στέλνει email με στοιχεία + σύνδεσμο CV. Απαιτεί RESEND_API_KEY."
            : "Each new application sends an email with applicant details + CV link. Requires RESEND_API_KEY."}
        </p>
      </div>

      <div id="jobsList" class="space-y-3">
        {(jobs ?? []).length === 0 && (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-white/50 text-sm">
            {isEl ? "Δεν υπάρχουν αγγελίες ακόμα." : "No jobs yet."}
          </div>
        )}
        {(jobs ?? []).map(j => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4" data-job-id={j.id}>
            <div class="flex items-start justify-between gap-3 flex-wrap">
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="text-base font-semibold text-white">{isEl ? j.title_el : j.title_en}</h3>
                  {!j.active && <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/10 text-white/50">{isEl ? "Ανενεργή" : "Inactive"}</span>}
                  {j.employment_type && <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-400/15 text-amber-300">{j.employment_type}</span>}
                </div>
                <p class="text-xs text-white/40 mt-1">
                  {j.department && <span>{j.department} · </span>}
                  <span>{j.location ?? "—"}</span>
                  {j.salary_range && <span> · {j.salary_range}</span>}
                </p>
              </div>
              <div class="flex items-center gap-2">
                <button class="edit-btn text-xs px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 transition">{isEl ? "Επεξεργασία" : "Edit"}</button>
                <button class="del-btn text-xs px-3 py-1.5 rounded-lg bg-red-500/15 text-red-300 hover:bg-red-500/25 transition">{isEl ? "Διαγραφή" : "Delete"}</button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Applications -->
      <div class="pt-6 mt-6 border-t border-white/10">
        <h2 class="text-lg font-bold mb-3">{isEl ? "Αιτήσεις" : "Applications"} <span class="text-white/40 text-sm font-normal">({(applications ?? []).length})</span></h2>
        {(applications ?? []).length === 0 ? (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6 text-center text-white/50 text-sm">
            {isEl ? "Δεν υπάρχουν αιτήσεις ακόμα." : "No applications yet."}
          </div>
        ) : (
          <div class="space-y-2">
            {(applications ?? []).map(a => (
              <details class="rounded-2xl border border-white/10 bg-white/5 p-4" data-app-id={a.id} data-app-status={a.status}>
                <summary class="cursor-pointer list-none flex items-center justify-between gap-3 flex-wrap">
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-white">{a.full_name}</p>
                    <p class="text-xs text-white/40">
                      {a.email}
                      {a.phone && <span> · {a.phone}</span>}
                      {a.job_id && <span> · {jobTitleMap.get(a.job_id) ?? "—"}</span>}
                    </p>
                  </div>
                  <div class="flex items-center gap-2 text-xs">
                    <span class="status-pill px-2 py-0.5 rounded-full bg-amber-400/15 text-amber-300 uppercase tracking-wider">{a.status}</span>
                    <span class="text-white/40">{new Date(a.created_at).toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "short", year: "numeric" })}</span>
                  </div>
                </summary>
                <div class="mt-3 pt-3 border-t border-white/10 flex flex-wrap items-center gap-2 text-xs">
                  <span class="text-white/50 mr-1">{isEl ? "Κατάσταση:" : "Status:"}</span>
                  <select class="status-select rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-white text-xs focus:outline-none focus:border-amber-400/50">
                    <option value="new" selected={a.status === "new"}>{isEl ? "Νέα" : "New"}</option>
                    <option value="reviewed" selected={a.status === "reviewed"}>{isEl ? "Εξετάστηκε" : "Reviewed"}</option>
                    <option value="interviewed" selected={a.status === "interviewed"}>{isEl ? "Συνέντευξη" : "Interviewed"}</option>
                    <option value="accepted" selected={a.status === "accepted"}>{isEl ? "Αποδοχή" : "Accepted"}</option>
                    <option value="hired" selected={a.status === "hired"}>{isEl ? "Προσλήφθηκε" : "Hired"}</option>
                    <option value="rejected" selected={a.status === "rejected"}>{isEl ? "Απόρριψη" : "Rejected"}</option>
                    <option value="archived" selected={a.status === "archived"}>{isEl ? "Αρχειοθετήθηκε" : "Archived"}</option>
                  </select>
                  <span class="status-msg text-white/40 hidden"></span>
                  <button type="button" class="app-edit-btn ml-auto px-3 py-1 rounded-lg bg-white/10 hover:bg-white/15 transition"
                    data-app={JSON.stringify({ id: a.id, full_name: a.full_name, email: a.email, phone: a.phone ?? "", message: a.message ?? "", cv_url: a.cv_url ?? "", cv_filename: a.cv_filename ?? "" })}>
                    {isEl ? "Επεξεργασία" : "Edit"}
                  </button>
                  <button type="button" class="app-del-btn px-3 py-1 rounded-lg bg-red-500/15 text-red-300 hover:bg-red-500/25 transition">
                    {isEl ? "Διαγραφή" : "Delete"}
                  </button>
                </div>
                {a.message && (
                  <p class="mt-3 text-sm text-white/70 whitespace-pre-line border-t border-white/10 pt-3">{a.message}</p>
                )}
                <div class="mt-3 flex flex-wrap gap-2 text-xs">
                  <a href={`mailto:${a.email}`} class="px-3 py-1 rounded-lg bg-white/10 hover:bg-white/15 transition">✉️ {isEl ? "Email" : "Email"}</a>
                  {a.phone && <a href={`tel:${a.phone}`} class="px-3 py-1 rounded-lg bg-white/10 hover:bg-white/15 transition">📞 {a.phone}</a>}
                  {a.cv_url && <a href={a.cv_url} target="_blank" rel="noopener" class="px-3 py-1 rounded-lg bg-amber-400/15 text-amber-300 hover:bg-amber-400/25 transition">📄 {a.cv_filename ?? (isEl ? "Βιογραφικό" : "CV")}</a>}
                </div>
              </details>
            ))}
          </div>
        )}
      </div>
    </main>

    <!-- Application editor modal -->
    <div id="appModal" class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm p-0 sm:p-4">
      <div class="relative mx-auto w-full max-w-lg h-full sm:h-auto sm:max-h-[calc(100vh-2rem)] sm:my-4 rounded-none sm:rounded-2xl border border-white/10 bg-[#141420] flex flex-col">
        <div class="flex items-start justify-between p-5 border-b border-white/10 shrink-0">
          <h3 class="text-lg font-bold text-amber-200">{isEl ? "Επεξεργασία Αίτησης" : "Edit Application"}</h3>
          <button id="appCloseBtn" type="button" class="text-white/40 hover:text-white text-3xl leading-none px-2 -mt-1">×</button>
        </div>
        <form id="appForm" class="flex-1 overflow-y-auto p-5 space-y-3">
          <input type="hidden" name="id" />
          <label class="block"><span class="text-xs text-white/50">{isEl ? "Ονοματεπώνυμο" : "Full name"}</span>
            <input name="full_name" required minlength="2" maxlength="120" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
          <label class="block"><span class="text-xs text-white/50">Email</span>
            <input name="email" type="email" required class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
          <label class="block"><span class="text-xs text-white/50">{isEl ? "Τηλέφωνο" : "Phone"}</span>
            <input name="phone" type="tel" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
          <label class="block"><span class="text-xs text-white/50">{isEl ? "CV URL" : "CV URL"}</span>
            <input name="cv_url" type="url" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
          <label class="block"><span class="text-xs text-white/50">{isEl ? "Όνομα αρχείου CV" : "CV filename"}</span>
            <input name="cv_filename" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
          <label class="block"><span class="text-xs text-white/50">{isEl ? "Μήνυμα / Βιογραφικό" : "Message / Bio"}</span>
            <textarea name="message" rows="6" maxlength="5000" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"></textarea></label>
          <p id="appFormMsg" class="text-xs hidden"></p>
        </form>
        <div class="shrink-0 border-t border-white/10 p-4 bg-[#141420] flex gap-3">
          <button id="appCancelBtn" type="button" class="flex-1 rounded-xl border border-white/15 text-white/70 px-4 py-3 text-sm font-semibold hover:bg-white/5 transition">
            {isEl ? "Άκυρο" : "Cancel"}
          </button>
          <button id="appSaveBtn" type="button" class="flex-[2] rounded-xl bg-amber-400 text-black px-4 py-3 text-sm font-semibold hover:bg-amber-300 transition">
            {isEl ? "Αποθήκευση" : "Save"}
          </button>
        </div>
      </div>
    </div>

    <!-- Editor modal -->
    <div id="jobModal" class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm p-0 sm:p-4">
      <div class="relative mx-auto w-full max-w-2xl h-full sm:h-auto sm:max-h-[calc(100vh-2rem)] sm:my-4 rounded-none sm:rounded-2xl border border-white/10 bg-[#141420] flex flex-col">
        <div class="flex items-start justify-between p-5 border-b border-white/10 shrink-0 gap-3">
          <h3 id="modalTitle" class="text-lg font-bold text-amber-200">{isEl ? "Αγγελία" : "Job"}</h3>
          <div class="flex items-center gap-2">
            <button id="aiGenBtn" type="button" class="text-xs px-3 py-1.5 rounded-lg bg-gradient-to-br from-fuchsia-500/30 to-amber-400/30 border border-white/15 text-white hover:from-fuchsia-500/50 hover:to-amber-400/50 transition">
              ✨ {isEl ? "AI δημιουργία" : "AI Generate"}
            </button>
            <button id="closeJobBtn" class="text-white/40 hover:text-white text-3xl leading-none px-2 -mt-1">×</button>
          </div>
        </div>
        <form id="jobForm" class="flex-1 overflow-y-auto p-5 space-y-3">
          <input type="hidden" name="id" />
          <div class="grid sm:grid-cols-2 gap-3">
            <label class="block"><span class="text-xs text-white/50">Title EN</span>
              <input name="title_en" required class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
            <label class="block"><span class="text-xs text-white/50">Title EL</span>
              <input name="title_el" required class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
            <label class="block"><span class="text-xs text-white/50">{isEl ? "Τμήμα" : "Department"}</span>
              <input name="department" placeholder="Bar / Kitchen / Floor" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
            <label class="block"><span class="text-xs text-white/50">{isEl ? "Τύπος απασχόλησης" : "Employment type"}</span>
              <select name="employment_type" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white">
                <option value="">—</option>
                <option value="full_time">{isEl ? "Πλήρης" : "Full-time"}</option>
                <option value="part_time">{isEl ? "Μερική" : "Part-time"}</option>
                <option value="seasonal">{isEl ? "Εποχική" : "Seasonal"}</option>
                <option value="contract">{isEl ? "Συμβόλαιο" : "Contract"}</option>
              </select></label>
            <label class="block"><span class="text-xs text-white/50">{isEl ? "Τοποθεσία" : "Location"}</span>
              <input name="location" value="Skala, Kefalonia" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
            <label class="block"><span class="text-xs text-white/50">{isEl ? "Αμοιβή (προαιρ.)" : "Salary range (optional)"}</span>
              <input name="salary_range" placeholder="€900–1200 / month" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
            <label class="block sm:col-span-2"><span class="text-xs text-white/50">{isEl ? "Email αίτησης (προαιρ.)" : "Apply email (optional)"}</span>
              <input name="apply_email" type="email" placeholder="jobs@sallysbar.gr" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
            <label class="block sm:col-span-2"><span class="text-xs text-white/50">{isEl ? "Περιγραφή (EN)" : "Description (EN)"}</span>
              <textarea name="description_en" rows="3" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"></textarea></label>
            <label class="block sm:col-span-2"><span class="text-xs text-white/50">{isEl ? "Περιγραφή (EL)" : "Description (EL)"}</span>
              <textarea name="description_el" rows="3" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"></textarea></label>
            <label class="block sm:col-span-2"><span class="text-xs text-white/50">{isEl ? "Απαιτήσεις (EN, μία ανά γραμμή)" : "Requirements (EN, one per line)"}</span>
              <textarea name="requirements_en" rows="3" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"></textarea></label>
            <label class="block sm:col-span-2"><span class="text-xs text-white/50">{isEl ? "Απαιτήσεις (EL, μία ανά γραμμή)" : "Requirements (EL, one per line)"}</span>
              <textarea name="requirements_el" rows="3" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white"></textarea></label>
            <label class="block"><span class="text-xs text-white/50">{isEl ? "Σειρά" : "Sort order"}</span>
              <input name="sort_order" type="number" value="0" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" /></label>
            <label class="flex items-center gap-2 text-sm text-white/80 rounded-xl border border-white/10 bg-white/5 px-3 py-2 self-end">
              <input type="checkbox" name="active" checked class="h-4 w-4" /> {isEl ? "Ενεργή αγγελία" : "Active listing"}
            </label>
          </div>
          <p id="jobFormMsg" class="text-xs hidden"></p>
        </form>
        <div class="shrink-0 border-t border-white/10 p-4 bg-[#141420]">
          <div class="flex items-center gap-3">
            <button type="button" id="cancelJobBtn" class="flex-1 rounded-xl border border-white/15 text-white/70 px-4 py-3 text-sm font-semibold hover:bg-white/5 transition">
              {isEl ? "Άκυρο" : "Cancel"}
            </button>
            <button type="button" id="saveJobBtn" class="flex-[2] rounded-xl bg-amber-400 text-black px-4 py-3 text-sm font-semibold hover:bg-amber-300 transition">
              {isEl ? "Αποθήκευση" : "Save"}
            </button>
          </div>
        </div>
      </div>
    </div>

    <script define:vars={{ isEl, jobs: jobs ?? [] }}>
      const modal = document.getElementById("jobModal");
      const form  = document.getElementById("jobForm");
      const titleEl = document.getElementById("modalTitle");

      function openModal(job) {
        form.reset();
        form.elements.id.value = job?.id ?? "";
        titleEl.textContent = job
          ? (isEl ? "Επεξεργασία αγγελίας" : "Edit job")
          : (isEl ? "Νέα αγγελία" : "New job");
        if (job) {
          for (const k of ["title_en","title_el","department","employment_type","location","description_en","description_el","requirements_en","requirements_el","salary_range","apply_email","sort_order"]) {
            if (form.elements[k]) form.elements[k].value = job[k] ?? "";
          }
          form.elements.active.checked = !!job.active;
        } else {
          form.elements.location.value = "Skala, Kefalonia";
        }
        modal.classList.remove("hidden"); modal.classList.add("flex");
      }
      function closeModal() { modal.classList.add("hidden"); modal.classList.remove("flex"); }

      document.getElementById("newJobBtn").addEventListener("click", () => openModal(null));
      document.getElementById("closeJobBtn").addEventListener("click", closeModal);
      document.getElementById("cancelJobBtn").addEventListener("click", closeModal);
      document.getElementById("saveJobBtn").addEventListener("click", () => form.requestSubmit());

      const aiBtn = document.getElementById("aiGenBtn");
      aiBtn.addEventListener("click", async () => {
        const seed = form.elements.title_en.value.trim() || form.elements.title_el.value.trim();
        const role = prompt(
          isEl
            ? "Περιγράψτε τη θέση (π.χ. 'Barman', 'Σερβιτόρος για σεζόν', 'Βοηθός κουζίνας')"
            : "Describe the role (e.g. 'Head bartender', 'Seasonal waiter', 'Kitchen helper')",
          seed
        );
        if (!role || role.trim().length < 2) return;
        const prevLabel = aiBtn.textContent;
        aiBtn.disabled = true;
        aiBtn.textContent = isEl ? "⏳ Δημιουργία…" : "⏳ Generating…";
        try {
          const res = await fetch("/api/admin/careers-ai-generate", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ role }),
          });
          const j = await res.json();
          if (!res.ok || !j.job) {
            alert((isEl ? "Σφάλμα AI: " : "AI error: ") + (j.error ?? "unknown"));
            return;
          }
          const g = j.job;
          for (const k of ["title_en","title_el","department","description_en","description_el","requirements_en","requirements_el"]) {
            if (g[k] && form.elements[k] && !form.elements[k].value) form.elements[k].value = g[k];
            else if (g[k] && form.elements[k]) form.elements[k].value = g[k];
          }
          if (g.employment_type && form.elements.employment_type) {
            const valid = ["full_time","part_time","seasonal","contract"];
            if (valid.includes(g.employment_type)) form.elements.employment_type.value = g.employment_type;
          }
        } catch (e) {
          alert(isEl ? "Σφάλμα δικτύου" : "Network error");
        } finally {
          aiBtn.disabled = false;
          aiBtn.textContent = prevLabel;
        }
      });
      modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });

      document.querySelectorAll(".edit-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.closest("[data-job-id]").dataset.jobId;
          openModal(jobs.find(j => j.id === id));
        });
      });

      document.querySelectorAll(".del-btn").forEach(btn => {
        btn.addEventListener("click", async () => {
          if (!confirm(isEl ? "Διαγραφή αγγελίας;" : "Delete this job?")) return;
          const id = btn.closest("[data-job-id]").dataset.jobId;
          const res = await fetch(`/api/admin/careers?id=${id}`, { method: "DELETE" });
          if (res.ok) window.location.reload();
          else alert("Error");
        });
      });

      document.querySelectorAll(".status-select").forEach((sel) => {
        sel.addEventListener("change", async () => {
          const root = sel.closest("[data-app-id]");
          const id = root.dataset.appId;
          const status = sel.value;
          const msgEl = root.querySelector(".status-msg");
          const pill = root.querySelector(".status-pill");
          sel.disabled = true;
          msgEl.className = "status-msg text-white/40";
          msgEl.textContent = isEl ? "⏳" : "⏳";
          const res = await fetch("/api/admin/careers-application-status", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, status }),
          });
          sel.disabled = false;
          if (res.ok) {
            pill.textContent = status;
            msgEl.textContent = isEl ? "✓ Αποθηκεύτηκε" : "✓ Saved";
            msgEl.className = "status-msg text-emerald-400";
            setTimeout(() => { msgEl.className = "status-msg hidden"; }, 1500);
          } else {
            msgEl.textContent = isEl ? "Σφάλμα" : "Error";
            msgEl.className = "status-msg text-red-400";
          }
        });
      });

      const appModal = document.getElementById("appModal");
      const appForm  = document.getElementById("appForm");
      const appMsg   = document.getElementById("appFormMsg");
      function openAppModal(data) {
        appForm.reset();
        for (const k of ["id","full_name","email","phone","cv_url","cv_filename","message"]) {
          if (appForm.elements[k]) appForm.elements[k].value = data[k] ?? "";
        }
        appMsg.className = "text-xs hidden";
        appModal.classList.remove("hidden"); appModal.classList.add("flex");
      }
      function closeAppModal() { appModal.classList.add("hidden"); appModal.classList.remove("flex"); }
      document.getElementById("appCloseBtn").addEventListener("click", closeAppModal);
      document.getElementById("appCancelBtn").addEventListener("click", closeAppModal);
      appModal.addEventListener("click", (e) => { if (e.target === appModal) closeAppModal(); });

      document.querySelectorAll(".app-edit-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault(); e.stopPropagation();
          try { openAppModal(JSON.parse(btn.dataset.app)); } catch {}
        });
      });

      document.getElementById("appSaveBtn").addEventListener("click", async () => {
        if (!appForm.reportValidity()) return;
        const fd = new FormData(appForm);
        const payload = Object.fromEntries(fd.entries());
        appMsg.className = "text-xs hidden";
        const res = await fetch("/api/admin/careers-application-status", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) { window.location.reload(); }
        else {
          const j = await res.json().catch(() => ({}));
          appMsg.textContent = j.error ?? "Error";
          appMsg.className = "text-xs text-red-400 block";
        }
      });

      document.querySelectorAll(".app-del-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (!confirm(isEl ? "Διαγραφή αίτησης;" : "Delete this application?")) return;
          const root = btn.closest("[data-app-id]");
          const id = root.dataset.appId;
          const res = await fetch(`/api/admin/careers-application-status?id=${id}`, { method: "DELETE" });
          if (res.ok) root.remove();
          else alert("Error");
        });
      });

      const settingsForm = document.getElementById("settingsForm");
      settingsForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(settingsForm);
        const payload = {
          notify_email: String(fd.get("notify_email") ?? "").trim() || null,
          notify_enabled: fd.get("notify_enabled") === "on",
        };
        const msg = document.getElementById("settingsMsg");
        msg.className = "text-xs hidden";
        const res = await fetch("/api/admin/careers-settings", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          msg.textContent = isEl ? "Αποθηκεύτηκε." : "Saved.";
          msg.className = "text-xs text-emerald-400 block";
        } else {
          const j = await res.json().catch(() => ({}));
          msg.textContent = j.error ?? "Error";
          msg.className = "text-xs text-red-400 block";
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const payload = Object.fromEntries(fd.entries());
        payload.active = fd.get("active") === "on";
        payload.sort_order = Number(payload.sort_order) || 0;
        if (!payload.id) delete payload.id;
        const msg = document.getElementById("jobFormMsg");
        msg.className = "text-xs hidden";
        const res = await fetch("/api/admin/careers", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) { window.location.reload(); }
        else {
          const j = await res.json().catch(() => ({}));
          msg.textContent = j.error ?? "Error";
          msg.className = "text-xs text-red-400 block";
        }
      });
    </script>
  </body>
</html>
