---
import "../../styles/global.css";
import AdminNav from "../../components/AdminNav.astro";
import { supabaseAdmin } from "../../lib/supabase";
import { withLangPrefix } from "../../i18n";

export const prerender = false;

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!["admin", "super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}

const { data: cards } = await supabaseAdmin
  .from("profiles")
  .select("id, full_name, handle, avatar_url, bio, socials, card_public, created_at, city, country")
  .not("handle", "is", null)
  .order("created_at", { ascending: false });

const list = cards ?? [];
const total    = list.length;
const publicCt = list.filter(c => c.card_public).length;
const hidden   = total - publicCt;
const withAvatar = list.filter(c => !!c.avatar_url).length;
const withBio    = list.filter(c => !!c.bio && c.bio.trim().length).length;
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{isEl ? "Social Cards" : "Social Cards"} — Admin</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <AdminNav active="social-cards" />
    <main class="mx-auto max-w-6xl px-5 py-10">
      <h1 class="font-heading text-3xl md:text-4xl font-bold">🪪 {isEl ? "Ψηφιακές Social Cards" : "Social Cards"}</h1>
      <p class="mt-2 text-sm text-white/60 max-w-2xl">
        {isEl
          ? "Κάθε χρήστης με δημόσια κάρτα /u/handle. Δες χρήστες, ορατότητα και στατιστικά."
          : "Every user with a /u/handle social card. See users, visibility, and stats."}
      </p>

      <!-- KPIs -->
      <section class="mt-6 grid sm:grid-cols-4 gap-3">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <p class="text-[10px] uppercase tracking-wider text-white/50">{isEl ? "Σύνολο" : "Total cards"}</p>
          <p class="font-heading text-3xl font-bold mt-1">{total}</p>
        </div>
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.06] p-4">
          <p class="text-[10px] uppercase tracking-wider text-emerald-300">{isEl ? "Δημόσιες" : "Public"}</p>
          <p class="font-heading text-3xl font-bold mt-1">{publicCt}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
          <p class="text-[10px] uppercase tracking-wider text-white/50">{isEl ? "Κρυφές" : "Hidden"}</p>
          <p class="font-heading text-3xl font-bold mt-1">{hidden}</p>
        </div>
        <div class="rounded-2xl border border-fuchsia-400/20 bg-fuchsia-400/[0.06] p-4">
          <p class="text-[10px] uppercase tracking-wider text-fuchsia-300">{isEl ? "Με avatar / bio" : "With avatar / bio"}</p>
          <p class="font-heading text-3xl font-bold mt-1">{withAvatar} / {withBio}</p>
        </div>
      </section>

      <!-- Search -->
      <div class="mt-6">
        <input id="search" type="text" placeholder={isEl ? "Αναζήτηση ονόματος ή handle…" : "Search name or handle…"} class="w-full rounded-lg bg-black/40 border border-white/10 px-3 py-2 text-sm" />
      </div>

      <!-- Cards grid -->
      <section class="mt-6 grid md:grid-cols-2 gap-3">
        {list.length === 0 ? (
          <p class="text-white/40 text-sm py-8 text-center col-span-2">{isEl ? "Κανείς δεν έχει δημιουργήσει social card ακόμη." : "No social cards created yet."}</p>
        ) : list.map((c: any) => (
          <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-4" data-card={c.id} data-search={(c.full_name ?? "") + " " + (c.handle ?? "")}>
            <div class="flex items-start gap-3">
              {c.avatar_url ? (
                <img src={c.avatar_url} alt="" class="h-14 w-14 rounded-full object-cover border border-white/10" />
              ) : (
                <div class="h-14 w-14 rounded-full bg-gradient-to-br from-fuchsia-500 to-amber-500 flex items-center justify-center text-xl font-bold">
                  {(c.full_name ?? "?").slice(0, 1).toUpperCase()}
                </div>
              )}
              <div class="min-w-0 flex-1">
                <p class="font-semibold truncate">{c.full_name ?? <span class="text-white/40">—</span>}</p>
                <a href={`/u/${c.handle}`} target="_blank" class="text-sm text-sky-300 hover:text-sky-200 truncate block">@{c.handle} ↗</a>
                {c.bio && <p class="text-xs text-white/60 mt-1 line-clamp-2">{c.bio}</p>}
                {(c.city || c.country) && <p class="text-[11px] text-white/40 mt-1">{[c.city, c.country].filter(Boolean).join(", ")}</p>}
              </div>
              <span class={`shrink-0 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full border ${c.card_public ? "bg-emerald-400/15 text-emerald-300 border-emerald-400/30" : "bg-white/5 text-white/50 border-white/15"}`}>
                {c.card_public ? (isEl ? "ΔΗΜΟΣΙΑ" : "PUBLIC") : (isEl ? "ΚΡΥΦΗ" : "HIDDEN")}
              </span>
            </div>

            {c.socials && Object.keys(c.socials).length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2 text-xs">
                {Object.entries(c.socials).filter(([_, v]) => !!v).map(([k, v]: any) => (
                  <a href={String(v)} target="_blank" class="rounded-full border border-white/10 bg-white/[0.04] px-2 py-0.5 text-white/70 hover:text-sky-300">{k}</a>
                ))}
              </div>
            )}

            <div class="mt-3 flex items-center justify-between gap-2 text-xs">
              <span class="text-white/40">{isEl ? "Δημιουργήθηκε:" : "Created:"} {new Date(c.created_at).toLocaleDateString(isEl ? "el-GR" : "en-GB")}</span>
              <button class="js-toggle rounded-lg bg-white/10 hover:bg-white/20 px-3 py-1 font-semibold">
                {c.card_public ? (isEl ? "🙈 Απόκρυψη" : "🙈 Hide") : (isEl ? "👁 Εμφάνιση" : "👁 Show")}
              </button>
            </div>
          </article>
        ))}
      </section>
    </main>

    <script is:inline>
      // Search
      document.getElementById("search")?.addEventListener("input", (e) => {
        const q = e.target.value.toLowerCase().trim();
        document.querySelectorAll("[data-card]").forEach((el) => {
          const hay = (el.getAttribute("data-search") || "").toLowerCase();
          el.style.display = q === "" || hay.includes(q) ? "" : "none";
        });
      });

      // Toggle card_public
      document.addEventListener("click", async (e) => {
        const btn = e.target.closest(".js-toggle");
        if (!btn) return;
        const card = btn.closest("[data-card]");
        const id = card.getAttribute("data-card");
        btn.disabled = true;
        const r = await fetch("/api/admin/card-visibility-toggle", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user_id: id, kind: "social" }),
        });
        const j = await r.json().catch(() => ({}));
        btn.disabled = false;
        if (j.ok) location.reload();
        else alert(j.error ?? "error");
      });
    </script>
  </body>
</html>
