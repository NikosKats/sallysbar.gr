---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import AdminNav from "../../components/AdminNav.astro";
import { withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

// Super-admin only
if (Astro.locals.role !== "super_admin") {
  return new Response("Forbidden", { status: 403 });
}

const clusters = [
  { n: 1, icon: "💻", title: isEl ? "Ο Κώδικας (software ως προϊόν)" : "The Code (software as product)",
    margin: "85–95%", status: "primary",
    items: [
      ["SaaS — Seasonal (6mo)", "€1,890 total (~€315/mo) · May–Oct", "Tourist venues · billed April upfront"],
      ["SaaS — Year-round (12mo)", "€2,988 total (€249/mo) · 12-mo commit", "City bars · compounding MRR"],
      ["One-time platform setup fee", "€1,000 per venue", "~4h install work · ~68% margin"],
      ["🤖 AI Assistant installation fee", "€2,000 per venue (optional)", "~7h work · ~72% margin · agencies charge €5–15k"],
      ["🤖 AI Receptionist add-on — Starter", "€89/mo · 150 min", "~82% margin · upsell on every plan"],
      ["🤖 AI Receptionist add-on — Pro", "€199/mo · 500 min", "~74% margin · typical venue fit"],
      ["🤖 AI Receptionist add-on — Unlimited", "€399/mo · 1,500 min", "~60% margin · high-volume city bars"],
      ["🤖 AI Voice overage", "€0.35–€0.45/min above cap", "Wholesale ≈ €0.105/min → 233–328% markup"],
      ["📣 CRM & Automation add-on — Starter", "€19/mo · 100 msgs included", "~63% margin · risk-averse venues"],
      ["📣 CRM & Automation add-on — Pro", "€49/mo · 400 msgs + AI generator + shortener + inbox", "~43% margin · typical bar default"],
      ["📣 CRM & Automation add-on — Unlimited", "€99/mo · 1,000 msgs + custom triggers + SLA", "~29% margin · high-volume city bars"],
      ["📣 CRM message overage", "€0.10/msg above cap", "Wholesale ≈ €0.07/msg → 43% markup"],
      ["🤝 Partner Engagement Platform", "Bundled with base plan", "In-room QR → 2-step OTP signup → loyalty + welcome drink. No competitor ships this. Moat feature when pitching venues that own or partner with hotels."],
      ["🏨 Partner onboarding (agency service)", "€200–€500 one-time per partner", "Print A4 posters + owner training + gift-label config. Optional service the venue can resell to their own partner hotels."],
      ["📅 Reservations v2 (capacity + self-manage)", "Bundled with base plan", "Nightly cap enforced across AI + admin + un-cancel. Customer self-manage via HMAC-signed SMS link. Cuts 'did they get the SMS?' support burden."],
      ["✈️ Travel-hub QR (/visit landing)", "Bundled with base plan", "Airport / port / taxi QR → branded landing with directions. Venue owner prints laminated A4 and hands to airport/port contacts — zero ongoing cost."],
      ["One-off licenses", "€3k–€8k perpetual", "No MRR"],
      ["White-label", "Agency rebrand", "Slow sales cycle"],
      ["Open-source + paid hosting", "€49–€99/mo managed", "Scales long-tail"],
      ["Exit / acquisition", "€50k–€200k once", "18+ mo to liquidity"],
    ],
  },
  { n: 2, icon: "📊", title: isEl ? "Τα Δεδομένα (συγκεντρωτικά insights)" : "The Data (aggregated insights)",
    margin: "70–95%", status: "unlock-later",
    items: [
      ["Venue benchmarks", "€50/mo add-on per customer", "Needs 15+ venues"],
      ["Tourism reports", "€200–€800 quarterly", "Kefalonia tourism board, Hotel assoc."],
      ["Supplier analytics", "€500–€2k/quarter", "Distilleries, beer distributors"],
      ["Foot-traffic heatmaps", "€1k+ per report", "Real-estate buyers"],
      ["Loyalty data licensing", "€5k+ one-time", "POS partners"],
      ["Paid API access", "€0.01–€0.05/call", "Booking aggregators"],
    ],
  },
  { n: 3, icon: "🎯", title: isEl ? "Η Προσοχή (ad real-estate)" : "The Attention (ad real-estate)",
    margin: "90%+", status: "side-revenue",
    items: [
      ["Featured tiles on /play, /card, /u/...", "€30–€80/mo per partner", "Surf school, boats, restaurants"],
      ["Sponsored slot on /visit travel landing", "€50–€150/mo per advertiser", "First thing an arriving traveller sees — car-rentals, tour boats, taxi firms."],
      ["Sponsored wheel prizes", "€150–€400/mo per sponsor", "Prize slot on daily wheel"],
      ["Menu promo slots", "€200+/mo per brand", "Distillery pairing shout-outs"],
      ["Geo-triggered offers", "€0.10–€0.30 CPM", "Tourist-language triggered"],
      ["Event hosting on /events", "€20–€50 per listing", "Third-party venues"],
    ],
  },
  { n: 4, icon: "🤝", title: isEl ? "Οι Παραπομπές (affiliate)" : "The Referrals (affiliate)",
    margin: "100%", status: "quick-win",
    items: [
      ["Kefalonia BnB bookings", "5–10% per booking", "Already half-built"],
      ["🤝 Partner hotel welcome-drink commission", "€1–€2 per redeemed code, or €30–€50/mo flat credit", "Every partner in the Partner Platform. Auditable via /admin/partners/[slug] redemption stats."],
      ["🏨 Direct-stay rebookings (OTA bypass)", "~€45/stay saved (15% Booking.com commission)", "Sally's SMS confirmation includes 'Stay at Helen's direct, save 15%' → 1-in-20 conversion = €6k/yr for the venue."],
      ["Restaurant bookings", "€1–€3 per reservation", "Partner with Skala restaurants"],
      ["Boat/tour sales", "10–15% commission", "Tile on /play"],
      ["Taxi/transfer services", "€0.50–€2 per ride", "'Call a cab' button"],
      ["Cross-bar swaps", "Cash or points", "Off-night traffic sharing"],
    ],
  },
  { n: 5, icon: "🛠️", title: isEl ? "Οι Υπηρεσίες (η ώρα σου)" : "The Services (your hourly)",
    margin: "100% of rate", status: "bridge-income",
    items: [
      ["Freelance dev work", "$80–$150/hr", "Portfolio-driven, immediate"],
      ["Onboarding / installation", "€890 per venue (setup fee)", "Baked into both seasonal + year-round plans"],
      ["Custom integrations", "€80–€150/hr", "POS, printers, Telegram, quirks"],
      ["Consulting on gamification", "€150–€300/hr", "Strategy calls"],
      ["Priority support packages", "€200–€500/mo", "Optional tier add-on"],
      ["Custom data reports", "€500–€3k each", "For chains wanting analysis"],
    ],
  },
  { n: 6, icon: "🎁", title: isEl ? "Το Hardware (φυσικά προϊόντα)" : "The Hardware (physical goods)",
    margin: "40–90%", status: "high-margin-upsell",
    items: [
      ["NFC loyalty cards (preprinted)", "Buy €0.50–€2, sell €10–€15", "80% margin · recurring"],
      ["Table QR codes laminated", "€0.20 cost, €3–€5 each", "90% margin"],
      ["Campaign QR coasters", "€0.05 cost, €0.50 each (box)", "Wear out = reorders"],
      ["NFC tap points for bar counter", "€3 → €30–€50", "90% margin"],
      ["Branded staff phones (used Android)", "€150 → €250–€350", "40% margin"],
      ["Receipt printers & thermal tickets", "Resale margin", "20–40% margin"],
    ],
  },
  { n: 7, icon: "🎓", title: isEl ? "Η Γνώση (τι έμαθες)" : "The Knowledge (what you learned)",
    margin: "95%+", status: "passive",
    items: [
      ["Course on Astro + Cloudflare + Supabase", "€29–€99 × 100–500 sales", "Gumroad/Udemy"],
      ["YouTube channel (solo-dev + SaaS)", "€500–€5k/mo at 10k+ subs", "Sponsorships"],
      ["Blog / newsletter case study", "€100–€2k/mo sponsors", "sallysbar.gr story"],
      ["Speaking at meetups", "Free → lead gen", "Astro/Cloudflare users"],
      ["Templates on ThemeForest/Pipet", "€49–€129 passive", "Strip down to starter"],
    ],
  },
  { n: 8, icon: "🏗️", title: isEl ? "Οι Κάθετες Αγορές (ίδιος κώδικας, νέα αγορά)" : "The Verticals (same code, new market)",
    margin: "Same SaaS × N", status: "year-2",
    items: [
      ["Cocktail bars / lounges", "Current ✅", "Sally's"],
      ["Restaurants", "2 wks adapt", "10× bigger market"],
      ["Cafés", "1 wk", "Low ARPU, huge volume"],
      ["Hair salons", "3 wks (booking swap)", "Underserved"],
      ["Small hotels / guesthouses", "4 wks", "Perfect for Ionian islands"],
      ["Gyms / yoga studios", "3 wks", "Loyalty-first"],
      ["Food trucks", "1 wk", "Viral potential"],
    ],
  },
  { n: 9, icon: "🔐", title: isEl ? "Το Δίκτυο (later-stage moat)" : "The Network (later-stage moat)",
    margin: "Exponential", status: "year-3",
    items: [
      ["Inter-venue loyalty", "Higher ARPU per venue", "Points across network"],
      ["Marketplace fees", "2–5% take", "Tourist books any 'Sally' venue"],
      ["Universal guest card", "Upsell opportunity", "One card, all bars"],
      ["Cross-venue analytics", "Chain-level pricing", "Benchmarking"],
      ["Acquire competitors", "Roll-up play", "Fold into platform"],
    ],
  },
];

const statusColor: Record<string, string> = {
  "primary":            "bg-amber-400/20 text-amber-200 border-amber-400/40",
  "quick-win":          "bg-emerald-400/20 text-emerald-200 border-emerald-400/40",
  "side-revenue":       "bg-sky-400/20 text-sky-200 border-sky-400/40",
  "bridge-income":      "bg-fuchsia-400/20 text-fuchsia-200 border-fuchsia-400/40",
  "high-margin-upsell": "bg-rose-400/20 text-rose-200 border-rose-400/40",
  "unlock-later":       "bg-white/10 text-white/60 border-white/20",
  "passive":            "bg-white/10 text-white/60 border-white/20",
  "year-2":             "bg-white/10 text-white/50 border-white/15",
  "year-3":             "bg-white/10 text-white/40 border-white/10",
};
const statusLabel: Record<string, string> = isEl ? {
  "primary":            "ΚΥΡΙΟ",
  "quick-win":          "QUICK WIN",
  "side-revenue":       "ΠΛΑΪΝΟ",
  "bridge-income":      "ΓΕΦΥΡΑ",
  "high-margin-upsell": "UPSELL",
  "unlock-later":       "ΑΡΓΟΤΕΡΑ",
  "passive":            "ΠΑΘΗΤΙΚΟ",
  "year-2":             "ΕΤΟΣ 2+",
  "year-3":             "ΕΤΟΣ 3+",
} : {
  "primary":            "PRIMARY",
  "quick-win":          "QUICK WIN",
  "side-revenue":       "SIDE",
  "bridge-income":      "BRIDGE",
  "high-margin-upsell": "UPSELL",
  "unlock-later":       "UNLOCK LATER",
  "passive":            "PASSIVE",
  "year-2":             "YEAR 2+",
  "year-3":             "YEAR 3+",
};
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{isEl ? "Business Playbook" : "Business Playbook"} — Super Admin</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      @media print {
        body { background: white !important; color: black !important; }
        .no-print { display: none !important; }
        details { break-inside: avoid; page-break-inside: avoid; }
        details[open] summary { page-break-after: avoid; }
        * { color: black !important; background-image: none !important; }
        a { color: black !important; text-decoration: none !important; }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased">
    <div class="no-print"><Header /></div>
    <div class="h-20 no-print"></div>
    <div class="no-print"><AdminNav active="business" /></div>

    <main class="mx-auto max-w-5xl px-5 py-10">
      <div class="mb-8 flex items-start justify-between gap-4 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-rose-300 mb-2 flex items-center gap-2">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-rose-400 animate-pulse"></span>
            {isEl ? "ΜΟΝΟ SUPER ADMIN" : "SUPER ADMIN ONLY"}
          </p>
          <h1 class="font-heading text-4xl font-bold">{isEl ? "💼 Business Playbook" : "💼 Business Playbook"}</h1>
          <p class="mt-2 text-sm text-white/60 max-w-2xl">
            {isEl ? "9 clusters μονετοποίησης. Κάθε ένα = διαφορετικό asset που μπορείς να πουλήσεις. Επικέντρωση σε 2–3 ταυτόχρονα." : "9 monetization clusters. Each = a different asset you can sell. Focus on 2–3 clusters at a time."}
          </p>
        </div>
        <div class="text-right text-xs text-white/40">
          <button onclick="window.print()" class="no-print mb-2 rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-4 py-2 text-xs font-semibold text-white">🖨 {isEl ? "Εκτύπωση / PDF" : "Print / Save PDF"}</button>
          <p>{isEl ? "Εσωτερικό έγγραφο" : "Internal document"}</p>
          <p class="mt-1">{isEl ? "Μη κοινοποιείται" : "Do not share"}</p>
        </div>
      </div>

      <!-- Focus reminder -->
      <section class="mb-8 rounded-2xl border border-amber-400/30 bg-gradient-to-br from-amber-500/10 via-fuchsia-500/5 to-sky-500/5 p-5">
        <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-2">⭐ Year-1 focus</p>
        <div class="grid sm:grid-cols-3 gap-3 text-sm">
          <div><span class="font-bold text-amber-200">#1 Code (SaaS + AI add-on)</span> — main engine</div>
          <div><span class="font-bold text-fuchsia-200">#5 Services</span> — bridge income while SaaS ramps</div>
          <div><span class="font-bold text-emerald-200">#4 Referrals (Kefalonia BnB)</span> — free money once signed</div>
        </div>
      </section>

      <!-- AI Receptionist callout — new primary revenue driver -->
      <section class="mb-8 rounded-2xl border border-violet-400/30 bg-gradient-to-br from-violet-500/[0.10] via-fuchsia-500/[0.05] to-transparent p-5">
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-violet-400 animate-pulse"></span>
          <p class="text-[10px] uppercase tracking-wider text-violet-300 font-bold">🆕 {isEl ? "ΝΕΟΣ ΠΟΡΟΣ ΕΣΟΔΩΝ" : "NEW REVENUE DRIVER"}</p>
        </div>
        <h3 class="font-heading text-xl font-bold">🤖 AI Voice + 📣 CRM — {isEl ? "δύο add-ons υψηλού margin" : "two high-margin add-ons"}</h3>
        <p class="mt-2 text-sm text-white/70 max-w-3xl">
          {isEl
            ? "AI Voice: €2.000 setup + €89/€199/€399/μήνα. CRM: €19/€49/€99/μήνα. Μαζί, στα 100 venues με 40% attach → ~€9,900/μήνα MRR + €80k/χρόνο σε AI install fees. ~€6,400/μήνα καθαρό."
            : "AI Voice: €2,000 setup + €89/€199/€399/mo. CRM: €19/€49/€99/mo. Combined, at 100 venues with 40% attach → ~€9,900/mo MRR + €80k/year in AI install fees. ~€6,400/mo net."}
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <a href={withLangPrefix(lang, "/admin/external-apis")} class="inline-flex items-center gap-1 rounded-lg border border-violet-400/30 bg-violet-400/10 text-violet-200 px-3 py-1.5 text-xs font-semibold hover:bg-violet-400/20">
            🔌 External APIs — {isEl ? "Κόστη & Monetize" : "Cost & Monetize"}
          </a>
          <a href={withLangPrefix(lang, "/admin/ai-calls")} class="inline-flex items-center gap-1 rounded-lg border border-white/10 bg-white/[0.03] text-white/75 px-3 py-1.5 text-xs hover:bg-white/10">
            📞 {isEl ? "Συνομιλίες AI" : "AI Conversations"}
          </a>
          <a href={withLangPrefix(lang, "/admin/saas-playbook")} class="inline-flex items-center gap-1 rounded-lg border border-white/10 bg-white/[0.03] text-white/75 px-3 py-1.5 text-xs hover:bg-white/10">
            🚀 SaaS Playbook
          </a>
        </div>
      </section>

      <!-- Clusters -->
      <section class="space-y-4">
        {clusters.map(c => (
          <details class="group rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur" open={c.n <= 3}>
            <summary class="cursor-pointer px-5 py-4 flex items-center justify-between gap-4">
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-2xl shrink-0">{c.icon}</span>
                <div class="min-w-0">
                  <h3 class="font-heading text-lg font-bold">Cluster {c.n} — {c.title}</h3>
                  <p class="text-xs text-white/50 mt-0.5">Margin: <span class="text-white/75 font-semibold">{c.margin}</span></p>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full border ${statusColor[c.status]}`}>{statusLabel[c.status]}</span>
                <span class="text-white/40 group-open:rotate-180 transition-transform">▾</span>
              </div>
            </summary>
            <div class="px-5 pb-5">
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead class="text-[10px] uppercase tracking-wider text-white/40 text-left">
                    <tr>
                      <th class="py-2 pr-3 font-semibold">Model</th>
                      <th class="py-2 pr-3 font-semibold">Pricing / example</th>
                      <th class="py-2 font-semibold">Notes</th>
                    </tr>
                  </thead>
                  <tbody>
                    {c.items.map(([m, p, n]) => (
                      <tr class="border-t border-white/5">
                        <td class="py-2 pr-3 font-medium text-white/90">{m}</td>
                        <td class="py-2 pr-3 text-white/75">{p}</td>
                        <td class="py-2 text-white/55">{n}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </details>
        ))}
      </section>

      <!-- Two-track rollout plan (mirrors SaaS playbook pricing) -->
      <section class="mt-8">
        <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">📆 {isEl ? "Πλάνο rollout — αντικατοπτρίζει τα δύο SaaS plans" : "Rollout plan — mirrors the two SaaS plans"}</p>
        <div class="grid md:grid-cols-2 gap-4">

          <!-- 6-month seasonal sprint -->
          <div class="rounded-2xl border border-sky-400/30 bg-sky-400/[0.05] p-5">
            <p class="text-[11px] uppercase tracking-wider text-sky-200/80 font-bold">🏝️ {isEl ? "Seasonal sprint (6 μήνες)" : "Seasonal sprint (6 months)"}</p>
            <p class="text-xs text-white/55 mt-0.5">For the tourist-driven plan · May → October</p>

            <div class="mt-4 space-y-4 text-sm text-white/75 leading-relaxed">
              <div>
                <h4 class="font-heading font-bold text-white">Pre-season (Feb–Apr)</h4>
                <ul class="mt-1.5 space-y-1 list-disc pl-5">
                  <li>Multi-tenant refactor (<code class="text-[12px]">venue_id</code> on every query)</li>
                  <li>Stripe Checkout + upfront seasonal invoice (€1,890 + €890 setup)</li>
                  <li>Sally's 2025 case study with real KPIs</li>
                  <li>Sign 3 Kefalonia bars on seasonal plan (early-bird 20% off)</li>
                </ul>
              </div>
              <div>
                <h4 class="font-heading font-bold text-white">In-season (May–Aug)</h4>
                <ul class="mt-1.5 space-y-1 list-disc pl-5">
                  <li>Onboard each venue in &lt; 4h (use <code>/admin/onboarding</code>)</li>
                  <li>Weekly WhatsApp check-ins via marketing automation</li>
                  <li>Capture 60-day results → convert to testimonials</li>
                  <li>Kefalonia BnB affiliate live by June</li>
                </ul>
              </div>
              <div>
                <h4 class="font-heading font-bold text-white">Wind-down (Sep–Oct)</h4>
                <ul class="mt-1.5 space-y-1 list-disc pl-5">
                  <li>Renewal pitch for next season (lock in by Oct 15)</li>
                  <li>Upsell NFC loyalty cards + custom coasters</li>
                  <li><strong>Goal: 5 seasonal venues = €9,450 cash banked upfront</strong></li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 12-month year-round plan -->
          <div class="rounded-2xl border border-amber-400/30 bg-amber-400/[0.05] p-5 relative">
            <span class="absolute -top-3 right-6 text-[10px] font-bold uppercase tracking-wider bg-gradient-to-br from-amber-300 to-amber-500 text-black px-3 py-1 rounded-full shadow-lg shadow-amber-500/30">Compounding MRR</span>
            <p class="text-[11px] uppercase tracking-wider text-amber-200/80 font-bold">🏙️ {isEl ? "Year-round plan (12 μήνες)" : "Year-round plan (12 months)"}</p>
            <p class="text-xs text-white/55 mt-0.5">For the €249/mo plan · city bars + cafés open all year</p>

            <div class="mt-4 space-y-4 text-sm text-white/75 leading-relaxed">
              <div>
                <h4 class="font-heading font-bold text-white">Q1 · Month 1–3 · Foundation</h4>
                <ul class="mt-1.5 space-y-1 list-disc pl-5">
                  <li>Subdomain routing + tenant isolation hardening</li>
                  <li>Product landing page on separate domain</li>
                  <li>Freelance 10 hrs/wk for bridge cash</li>
                  <li>Sign 2 city bars on year-round plan @ €149/mo yr-1 discount</li>
                </ul>
              </div>
              <div>
                <h4 class="font-heading font-bold text-white">Q2 · Month 4–6 · First MRR</h4>
                <ul class="mt-1.5 space-y-1 list-disc pl-5">
                  <li>Testimonials from Q1 customers → pitch at full €249/mo</li>
                  <li>Add 4 more venues (Athens / Thessaloniki cocktail bars)</li>
                  <li><strong>Target: 6 venues · ~€1.5k MRR</strong></li>
                </ul>
              </div>
              <div>
                <h4 class="font-heading font-bold text-white">Q3 · Month 7–9 · Scale</h4>
                <ul class="mt-1.5 space-y-1 list-disc pl-5">
                  <li>Partner with one hospitality consultant (rev-share)</li>
                  <li>NFC card resale kicks in (high-margin upsell)</li>
                  <li><strong>Target: 12 venues · ~€3k MRR</strong></li>
                </ul>
              </div>
              <div>
                <h4 class="font-heading font-bold text-white">Q4 · Month 10–12 · Lock-in</h4>
                <ul class="mt-1.5 space-y-1 list-disc pl-5">
                  <li>Unlock venue-benchmark data add-on (€50/mo) once 15+ venues</li>
                  <li>Annual-upfront discount pitch (€2,690) to reduce churn</li>
                  <li><strong>Target: 20–25 venues · €5–€6k MRR · decide scale/hire/exit</strong></li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <p class="mt-3 text-xs text-white/45">💡 Tourist venues → seasonal (cash upfront in April). City venues → year-round (compounding monthly). Don't try to fit a city bar into the seasonal plan — they'll churn the moment you quote €1,890 for "only 6 months."</p>
      </section>

      <!-- Reality check -->
      <section class="mt-6 rounded-2xl border border-red-400/20 bg-red-400/[0.04] p-5">
        <p class="text-[10px] uppercase tracking-wider text-red-300 font-bold mb-2">⚠️ {isEl ? "Έλεγχος πραγματικότητας" : "Reality check"}</p>
        <ul class="text-sm text-white/70 space-y-1.5 leading-relaxed list-disc pl-5">
