---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import AdminNav from "../../components/AdminNav.astro";

if (Astro.locals.role !== "super_admin") {
  return new Response("Forbidden", { status: 403 });
}

// Two-plan strategy: seasonal (6mo) for tourist-driven venues, year-round (12mo) for city bars.
// Same feature set — only commitment + price differ.
const bullets = [
  "Menu + QR table ordering",
  "Loyalty card, tiers, rewards",
  "Daily Wheel, Scratch cards, Quests",
  "Team chat + push notifications",
  "Telegram order flow",
  "Google / Apple Wallet cards",
  "Social card (viral virality)",
  "Analytics + reporting",
  "Staff enrollment",
  "Bilingual EN/EL",
  "Marketing automation (10 triggers)",
  "CRM bulk campaigns — 7 channels (WA/SMS/Viber/Messenger/IG/Push/Email)",
  "Audience sources: DB filters or pasted list (CSV-friendly)",
  "URL shortener sallysbar.gr/s/xxxxx (click tracking)",
  "Inbox: inbound replies, delivery receipts, voice calls",
  "Voice recording playback (JWT-signed admin proxy)",
  "Messenger / Instagram linking (+20 point booster)",
  "Profile completion bar (0–100% with CTA chips)",
  "Auto-STOP unsubscribe honoring",
  "Priority support",
];

const plans = [
  {
    key: "seasonal",
    name: "Seasonal — 6 months",
    tagline: "For tourist / island / beach venues",
    window: "May → October",
    setup: 850,
    total: 1380,
    discount_total: 690,
    discount_pct: 50,
    monthlyEquiv: 230,
    effective_mo: "€230/mo list · €115/mo early-bird",
    billing: "Billed once in April — money arrives before the season opens. All figures net; +24% VAT added.",
    featured: false,
    color: "from-sky-400 to-sky-600",
  },
  {
    key: "yearround",
    name: "Year-round — 12 months",
    tagline: "For city bars / cafés open all year",
    window: "12-month commitment",
    setup: 850,
    total: 2400,
    discount_total: 1104,
    discount_pct: 54,
    monthlyEquiv: 200,
    effective_mo: "€200/mo list · €92/mo early-bird",
    billing: "12-month commitment · 20% cheaper than 2× seasonal · paid upfront (€2,400 list / €1,104 early-bird). All figures net; +24% VAT added.",
    featured: true,
    color: "from-amber-400 to-amber-600",
  },
];

const models = [
  { t: "Per-venue isolated installs", note: "What you're doing today", pros: ["Zero refactor needed", "Customer owns data", "Zero blast radius", "Sold as 'your private platform'"], cons: ["2-4h install each", "N places to fix a bug", "Fragmented billing"] },
  { t: "Shared multi-tenant",         note: "2-3 weeks to build", pros: ["One deploy → all venues", "Consolidated billing", "SQL-insert onboarding", "Cross-venue analytics"], cons: ["Refactor required", "Noisy-neighbor risk", "Shared blast radius"] },
];

const checklist = [
  { stage: "1. Code & infra (~1h scripted)", items: [
    "Clone repo into venue's GitHub / new Cloudflare Pages project",
    "Create Supabase project (free tier to start)",
    "Run all SQL migrations in /scripts in order (incl. add-marketing-automation, add-vonage-webhooks, add-social-linking, add-short-links)",
    "Set env vars: Supabase URL/keys, VAPID pair, Telegram tokens",
    "Point domain DNS to Cloudflare (www + apex)",
  ]},
  { stage: "2. Branding (~30min)", items: [
    "Edit src/data/site.ts (name, address, socials, maps URL)",
    "Replace icon-*.png + apple-touch-icon",
    "Tweak Tailwind palette if custom accent color requested",
  ]},
  { stage: "3. Content (~1h with customer)", items: [
    "Import menu from CSV or photo-to-text",
    "Configure loyalty tiers + rewards catalog",
    "Create Telegram channels for barman + waiter",
    "Generate table QR codes via /admin/qrcodes",
    "Print table cards + starter loyalty cards",
  ]},
  { stage: "4. Messaging & CRM setup (~1h)", items: [
    "Vonage account → Messages Application → add number (voice + SMS + WhatsApp capabilities)",
    "Set webhook URLs (MUST be www. — non-www 301s kill POST bodies): Inbound /api/vonage/inbound, Status /api/vonage/status",
    "Voice: Answer /api/vonage/voice-answer, Event /api/vonage/voice-events, Fallback /api/vonage/voice-fallback",
    "Upload VONAGE_APP_PRIVATE_KEY via `cat private.key | wrangler pages secret put` (never paste key into chat)",
    "Register alphanumeric sender ID for SMS (e.g. 'Sallys Bar' — max 11 chars, no apostrophes, Greek MNOs require pre-registration)",
    "Flip VONAGE_MESSAGES_BASE to https://api.nexmo.com (production, not sandbox)",
    "Meta webhook for Messenger/IG linking: https://<venue>/api/social/meta-webhook + HMAC secret + verify token",
    "Resend account + bookings@<venue> sender + SPF/DKIM/DMARC records",
  ]},
  { stage: "5. Staff onboarding (~30min call)", items: [
    "Invite first admin via /admin/users",
    "Walk through /admin/overview, /staff, /admin/help",
    "Walk through /admin/campaigns (filters, paste-list, AI generate, URL shortener)",
    "Walk through /admin/inbox (replies, delivery receipts, voice recordings)",
    "Record Loom they can replay later",
    "Enable push notifications on their staff phone",
  ]},
  { stage: "6. Go live (~30min)", items: [
    "End-to-end test of /table/1 flow",
    "Run one test order through the full lifecycle",
    "Send test SMS + WhatsApp to verify sender name shows correctly",
    "Send welcome email with URLs + credentials",
    "Add to your /admin/venues tracker",
  ]},
];

const costPerVenue = [
  ["Cloudflare Pages + Workers",       "€0 (free tier ~10k req/day)"],
  ["Supabase free tier",                "€0 (500MB DB, 1GB storage)"],
  ["Supabase Pro (when needed)",        "€25/mo per project"],
  ["Domain",                            "~€1/mo amortized"],
  ["Resend email (100/day free)",       "€0–€20/mo"],
  ["Push VAPID / Telegram",             "€0"],
  ["Total run cost",                    "€0–€45/mo per venue"],
];

// All numbers below calculated from the EARLY-BIRD (actual) prices, not the list anchor.
const margins = [
  { tier: "Seasonal €690 · 6 mo (early-bird)",      cost: "~€42/mo infra + support (6 mo)",  profit: "~€438 profit / season / venue" },
  { tier: "Year-round €1,104 · 12 mo (early-bird)", cost: "~€42/mo infra + support",          profit: "~€600 profit / yr / venue" },
  { tier: "Setup fee (fixed, every plan)",          cost: "~4h work",                         profit: "€850 one-time / venue" },
];

// Blended 50/50 seasonal (€690) + year-round (€1,104) = avg €897/venue/yr rev at early-bird.
// Setup is a fixed €850 on every plan, paid once per new venue.
const scale = [
  { venues: 10,  mrr: "€8.9k/yr · +€8.5k setup",  label: "Covers your phone bill" },
  { venues: 25,  mrr: "€22.4k/yr · +€21k setup", label: "Covers the fixed burn" },
  { venues: 50,  mrr: "€44.9k/yr · +€42k setup", label: "Side income (both)" },
  { venues: 100, mrr: "€89.7k/yr · +€85k setup", label: "Half-salary both partners" },
  { venues: 200, mrr: "€179.4k/yr · +€170k setup", label: "Quit-your-job number" },
  { venues: 400, mrr: "€358.8k/yr · +€340k setup", label: "Consider hiring / selling" },
];

const legal = [
  ["Service Agreement (1-page)",       "What you deliver · uptime · support hours · termination · liability cap (1× annual)"],
  ["GDPR Data Processing Agreement",   "Template from EDPB or Iubenda (~€30). Reused across venues."],
  ["Privacy Policy (per install)",     "Auto-generated from site.ts + template. Already half-built at /privacy."],
  ["Terms of Service",                 "Already at /terms — update once per product name."],
];

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>SaaS Playbook — Super Admin</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      @media print {
        body { background: white !important; color: black !important; }
        .no-print { display: none !important; }
        details { break-inside: avoid; page-break-inside: avoid; }
        details[open] summary { page-break-after: avoid; }
        * { color: black !important; background-image: none !important; }
        a { color: black !important; text-decoration: none !important; }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased">
    <div class="no-print"><Header /></div>
    <div class="h-20 no-print"></div>
    <div class="no-print"><AdminNav active="saas-playbook" /></div>

    <main class="mx-auto max-w-5xl px-5 py-10">
      <div class="mb-8 flex items-start justify-between gap-4 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-rose-300 mb-2 flex items-center gap-2">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-rose-400 animate-pulse"></span>
            {isEl ? "ΜΟΝΟ SUPER ADMIN" : "SUPER ADMIN ONLY"}
          </p>
          <h1 class="font-heading text-4xl font-bold">{isEl ? "🚀 SaaS Playbook" : "🚀 SaaS Playbook"}</h1>
          <p class="mt-2 text-sm text-white/60 max-w-2xl">{isEl ? "Πώς μετατρέπεις την πλατφόρμα του Sally σε πραγματικό SaaS: μοντέλο deployment, τιμολόγηση, checklist εγκατάστασης, unit economics, νομικά." : "How you turn Sally's platform into a real SaaS: deployment model, pricing, install checklist, unit economics, legal."}</p>
        </div>
        <button onclick="window.print()" class="no-print shrink-0 rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-4 py-2 text-xs font-semibold text-white">🖨 {isEl ? "Εκτύπωση / PDF" : "Print / Save PDF"}</button>
      </div>

      <!-- What's new — recently shipped -->
      <section class="mb-10 rounded-2xl border border-emerald-400/30 bg-gradient-to-br from-emerald-500/[0.08] via-fuchsia-500/[0.04] to-sky-500/[0.04] p-5">
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <h2 class="text-[10px] uppercase tracking-[0.22em] text-emerald-300 font-bold">{isEl ? "🆕 Πρόσφατα shipped — διαφοροποίηση από ανταγωνιστές" : "🆕 Recently shipped — differentiators vs. competitors"}</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-3 text-sm">
          <div class="rounded-xl border border-white/10 bg-black/30 p-3">
            <p class="font-heading font-bold text-emerald-200 mb-1">📣 CRM Campaigns 2.0</p>
            <p class="text-white/70 text-xs leading-relaxed">{isEl
              ? "7 κανάλια (WA/SMS/Viber/Messenger/IG/Push/Email) · φιλτράρισμα κοινού ή paste list · AI generate · live cost breakdown με ΦΠΑ · A4 invoice για τον πελάτη. Paste list = ad-hoc blast χωρίς να βάλεις πρώτα στη βάση."
              : "7 channels (WA/SMS/Viber/Messenger/IG/Push/Email) · audience filters OR pasted list (CSV-friendly) · AI generate · live cost breakdown with VAT · A4 client invoice. Pasted list = ad-hoc blast without importing to DB first."}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-black/30 p-3">
            <p class="font-heading font-bold text-sky-200 mb-1">🔗 URL Shortener (owned)</p>
            <p class="text-white/70 text-xs leading-relaxed">{isEl
              ? "sallysbar.gr/s/xxxxx — 5-χαρ base36, idempotent, click tracking. Κρατάει SMS σε 1 segment, αντί για 2+. Auto-shorten on paste + ↶ Restore original για 3rd-party UTM."
              : "sallysbar.gr/s/xxxxx — 5-char base36, idempotent, click tracking. Keeps SMS in 1 segment instead of 2+. Auto-shorten on paste + ↶ Restore original for 3rd-party UTM preservation."}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-black/30 p-3">
            <p class="font-heading font-bold text-fuchsia-200 mb-1">📬 Unified Inbox</p>
            <p class="text-white/70 text-xs leading-relaxed">{isEl
              ? "/admin/inbox — inbound replies (όλα τα κανάλια), delivery receipts, φωνητικές κλήσεις με inline recording playback. Inline reply, αυτόματο STOP unsubscribe, filters, delete-all. Τα μαγαζιά τα έψαχναν σε 5 διαφορετικές εφαρμογές."
              : "/admin/inbox — inbound replies (every channel), delivery receipts, voice calls with inline recording playback. Inline reply, auto-STOP unsubscribe, filters, delete-all. Replaces 5 separate tools venues used to juggle."}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-black/30 p-3">
            <p class="font-heading font-bold text-amber-200 mb-1">🔗 Messenger + Instagram Linking</p>
            <p class="text-white/70 text-xs leading-relaxed">{isEl
              ? "Κάθε χρήστης συνδέει Messenger/IG μέσω m.me/ig.me ref-links — webhook μας πιάνει PSID/IG-ID + χαρίζει +20 πόντοι. Unlock για 1-click DM campaigns χωρίς να σπάει το Meta 24h rule."
              : "Users link Messenger/IG via per-user m.me/ig.me ref-links — our webhook captures PSID/IG-ID + awards +20 points. Unlocks 1-click DM campaigns without breaking Meta's 24h reply window."}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-black/30 p-3">
            <p class="font-heading font-bold text-white mb-1">🎯 Profile Completion Bar</p>
            <p class="text-white/70 text-xs leading-relaxed">{isEl
              ? "0–100% progress στο /account με CTA chips για κάθε ελλιπές πεδίο. +20 badge σε Messenger/IG. 100% → celebratory state. Αλλάζει drastically το completion rate (που τροφοδοτεί όλη την CRM)."
              : "0–100% progress on /account with CTA chips per missing slot. +20 badge on Messenger/IG slots. 100% → celebratory state. Dramatically improves completion rate (the signal that feeds every CRM trigger downstream)."}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-black/30 p-3">
            <p class="font-heading font-bold text-rose-200 mb-1">📞 Voice + Recording Playback</p>
            <p class="text-white/70 text-xs leading-relaxed">{isEl
              ? "Εισερχόμενες κλήσεις στο Vonage number με NCCO greeting + record. Recording playback inline στο /admin/inbox μέσω JWT-signed proxy (RS256 via Web Crypto — άμεση πρόσβαση στο Vonage file υποστηρίζει μόνο JWT auth)."
              : "Inbound calls to your Vonage number with NCCO greeting + record. Recording plays inline at /admin/inbox via a JWT-signed proxy (RS256 via Web Crypto — direct Vonage file URLs only accept JWT auth)."}</p>
          </div>
        </div>
        <p class="mt-4 text-[11px] text-white/50">{isEl
          ? "💡 Αυτά είναι τα features που οι περισσότεροι ανταγωνιστές (Toast, Loyverse, Fivestars) ΔΕΝ έχουν σε ένα πακέτο στα €92/μήνα. Στο pitch δώσε έμφαση εδώ."
          : "💡 These are the features most competitors (Toast, Loyverse, Fivestars) don't bundle at €92/mo. Lead with these in the pitch."}</p>
      </section>

      <!-- AI Receptionist add-on (new in v2.1) -->
      <section class="mb-10 rounded-2xl border border-violet-400/30 bg-gradient-to-br from-violet-500/[0.10] via-fuchsia-500/[0.05] to-transparent p-5">
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-violet-400 animate-pulse"></span>
          <h2 class="text-[10px] uppercase tracking-wider text-violet-300 font-bold">{isEl ? "🆕 ΝΕΟ — Ο κύριος νέος πόρος εσόδων" : "🆕 NEW — Main new revenue driver"}</h2>
        </div>
        <h3 class="font-heading text-2xl font-bold">🤖 AI Voice Receptionist — add-on tiers</h3>
        <p class="mt-2 text-sm text-white/65 max-w-2xl">
          Powered by Vapi + GPT-4o-mini + ElevenLabs + Deepgram + Vonage. All-in wholesale ≈ <strong>€0.105/min</strong>. Sold as a monthly add-on on top of the base PistotitaOS plan.
        </p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[10px] uppercase tracking-wider text-white/50 text-left">
              <tr>
                <th class="py-2 pr-3">Tier</th>
                <th class="py-2 pr-3 text-right">Price/mo</th>
                <th class="py-2 pr-3 text-right">Included min</th>
                <th class="py-2 pr-3 text-right">At-cost</th>
                <th class="py-2 pr-3 text-right">Margin €</th>
                <th class="py-2 pr-3 text-right">Margin %</th>
                <th class="py-2 pr-3 text-right">Overage</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-white/10 bg-violet-400/[0.05]"><td class="py-2 pr-3 font-bold">Starter</td><td class="py-2 pr-3 text-right font-mono font-bold text-emerald-300">€39</td><td class="py-2 pr-3 text-right font-mono">130</td><td class="py-2 pr-3 text-right font-mono text-white/60">€13.65</td><td class="py-2 pr-3 text-right font-mono text-emerald-300">€25.35</td><td class="py-2 pr-3 text-right font-mono text-emerald-300 font-bold">65%</td><td class="py-2 pr-3 text-right font-mono">€0.30</td></tr>
              <tr class="border-t border-white/5"><td class="py-2 pr-3 font-bold">Pro</td><td class="py-2 pr-3 text-right font-mono font-bold text-emerald-300">€79</td><td class="py-2 pr-3 text-right font-mono">400</td><td class="py-2 pr-3 text-right font-mono text-white/60">€42.00</td><td class="py-2 pr-3 text-right font-mono text-emerald-300">€37.00</td><td class="py-2 pr-3 text-right font-mono text-amber-300 font-bold">47%</td><td class="py-2 pr-3 text-right font-mono">€0.30</td></tr>
              <tr class="border-t border-white/5"><td class="py-2 pr-3 font-bold">Unlimited</td><td class="py-2 pr-3 text-right font-mono font-bold text-emerald-300">€149</td><td class="py-2 pr-3 text-right font-mono">1,000</td><td class="py-2 pr-3 text-right font-mono text-white/60">€105.00</td><td class="py-2 pr-3 text-right font-mono text-emerald-300">€44.00</td><td class="py-2 pr-3 text-right font-mono text-amber-300 font-bold">30%</td><td class="py-2 pr-3 text-right font-mono">€0.30</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-white/55">💡 <strong>Scale math:</strong> 100 venues × 60% Starter / 30% Pro / 10% Unlimited = <strong class="text-emerald-300">~€5,300/mo revenue · ~€2,100/mo net</strong>. Full API cost breakdown: <a href="/admin/external-apis" class="text-amber-300 underline">/admin/external-apis</a></p>
      </section>

      <!-- Pricing: two plans -->
      <section class="mb-10">
        <h2 class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-4">{isEl ? "💰 Δύο plans, ίδια πλατφόρμα" : "💰 Two plans, same platform"}</h2>

        <div class="mb-4 rounded-2xl border border-emerald-400/30 bg-emerald-400/[0.06] p-4 text-sm text-white/80">
          <p class="font-bold text-emerald-200 mb-1">🎯 Dual pricing — list + early-bird discount</p>
          <p>
            <strong>List price</strong> (marketing anchor): Seasonal <strong>€1,380</strong> · Year-round <strong>€2,400</strong>.
            <strong>Early-bird (what customers actually pay):</strong> Seasonal <strong>€690</strong> (−50%) · Year-round <strong>€1,104</strong> (−54% · 20% cheaper than 2× seasonal).
            Setup €850 is a <strong>fixed one-time fee</strong> on every plan — no discounts, no waivers.
            All margins, scale milestones and break-even numbers below are computed from the <strong>early-bird prices</strong>.
            <br/><span class="text-white/70">All prices are net (ex. VAT). <strong>+24% VAT</strong> is added at checkout.</span>
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          {plans.map(p => (
            <div class={`rounded-2xl border p-6 relative ${p.featured ? "border-amber-400/60 bg-gradient-to-br from-amber-500/15 via-fuchsia-500/5 to-sky-500/5" : "border-white/10 bg-white/[0.03]"}`}>
              {p.featured && (
                <span class="absolute -top-3 right-6 text-[10px] font-bold uppercase tracking-wider bg-gradient-to-br from-amber-300 to-amber-500 text-black px-3 py-1 rounded-full shadow-lg shadow-amber-500/30">{isEl ? "Καλύτερη αξία" : "Best value"}</span>
              )}
              <p class="text-[11px] uppercase tracking-wider text-amber-200/80 font-bold">{p.name}</p>
              <p class="text-xs text-white/55 mt-0.5">{p.tagline} · {p.window}</p>
              <div class="mt-4 flex items-end gap-3 flex-wrap">
                <p class="font-heading text-5xl font-bold bg-gradient-to-br from-white to-amber-100 bg-clip-text text-transparent leading-none"><s class="text-white/30 text-3xl font-normal">€{p.total.toLocaleString("en-GB")}</s></p>
                <p class="font-heading text-5xl font-bold text-emerald-300 leading-none">€{p.discount_total.toLocaleString("en-GB")}</p>
              </div>
              <p class="mt-1 text-[11px] text-white/55">net price · + 24% VAT</p>
              <p class="mt-2 text-xs"><span class="rounded-full bg-emerald-400/20 border border-emerald-400/40 text-emerald-300 px-2 py-0.5 font-bold">−{p.discount_pct}% EARLY-BIRD</span> <span class="text-white/50 ml-2">{isEl ? "λίστα τιμή €" : "list price €"}{p.total.toLocaleString("en-GB")}</span></p>
              <p class="text-sm text-white/55 mt-2">{p.effective_mo}</p>

              {/* First-payment breakdown with VAT */}
              <div class="mt-4 rounded-xl border border-white/10 bg-black/30 p-3 text-xs">
                <div class="flex items-center justify-between py-1 border-b border-white/5">
                  <span class="text-white/75">🔧 Installation (one-time)</span>
                  <span class="font-mono text-white">€{p.setup} <span class="text-white/45">net</span></span>
                </div>
                <div class="flex items-center justify-between py-1 border-b border-white/5">
                  <span class="text-white/75">🔁 Subscription ({p.key === "seasonal" ? "6 mo" : "12 mo"})</span>
                  <span class="font-mono text-emerald-300">€{p.discount_total.toLocaleString("en-GB")} <span class="text-white/45">net</span></span>
                </div>
                <div class="flex items-center justify-between py-1 text-white/70">
                  <span>Subtotal net</span>
                  <span class="font-mono">€{(p.discount_total + p.setup).toLocaleString("en-GB")}</span>
                </div>
                <div class="flex items-center justify-between py-1 text-white/70">
                  <span>+ 24% VAT</span>
                  <span class="font-mono">€{Math.round((p.discount_total + p.setup) * 0.24).toLocaleString("en-GB")}</span>
                </div>
                <div class="flex items-center justify-between pt-2 mt-1 border-t border-white/10 text-amber-200 font-bold">
                  <span>Total 1st payment (incl. VAT)</span>
                  <span class="font-mono">€{Math.round((p.discount_total + p.setup) * 1.24).toLocaleString("en-GB")}</span>
                </div>
                <div class="flex items-center justify-between pt-2 mt-2 border-t border-white/10 text-sky-200">
                  <span>Renewal ({p.key === "seasonal" ? "next season" : "year 2+"}) · no install</span>
                  <span class="font-mono">€{Math.round(p.discount_total * 1.24).toLocaleString("en-GB")} <span class="text-white/45 font-normal">incl. VAT</span></span>
                </div>
              </div>

              <p class="mt-4 text-[11px] text-white/50 leading-relaxed">{p.billing}</p>
            </div>
          ))}
        </div>

        <div class="mt-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
          <p class="text-[11px] uppercase tracking-wider text-amber-200/80 font-bold mb-2">{isEl ? "Όλα περιλαμβάνονται και στα δύο plans" : "Everything included in both plans"}</p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-1 text-sm text-white/85">
            {bullets.map(b => <li>✓ {b}</li>)}
          </ul>
        </div>

        <p class="mt-3 text-xs text-white/45">💡 Same feature set on both plans — only commitment length differs. Seasonal customers churn at Oct 31; year-round gives compounding MRR and is a better sale for city venues.</p>
      </section>

      <!-- Deployment models -->
      <section class="mb-10">
        <h2 class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-4">{isEl ? "🏗️ Μοντέλα Deployment" : "🏗️ Deployment models"}</h2>
        <div class="grid md:grid-cols-2 gap-3">
          {models.map(m => (
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
              <p class="font-heading text-lg font-bold">{m.t}</p>
              <p class="text-xs text-amber-200/70 mt-0.5">{m.note}</p>
              <div class="mt-3 grid grid-cols-2 gap-3 text-sm">
                <div>
                  <p class="text-[10px] uppercase tracking-wider text-emerald-300 font-bold mb-1">Pros</p>
                  <ul class="text-white/75 space-y-0.5 text-xs">{m.pros.map(p => <li>+ {p}</li>)}</ul>
                </div>
                <div>
                  <p class="text-[10px] uppercase tracking-wider text-red-300 font-bold mb-1">Cons</p>
                  <ul class="text-white/75 space-y-0.5 text-xs">{m.cons.map(p => <li>− {p}</li>)}</ul>
                </div>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-3 text-xs text-white/50">💡 <strong class="text-amber-200">Hybrid recommendation:</strong> Start with per-venue installs (5 venues). Build multi-tenant after. Keep isolated as the Signature/Enterprise tier.</p>
      </section>

      <!-- Install checklist -->
      <section class="mb-10">
        <h2 class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-4">{isEl ? "📋 Checklist Εγκατάστασης (~4 ώρες ανά venue)" : "📋 Install checklist (~4 hours per venue)"}</h2>
        <div class="space-y-3">
          {checklist.map(c => (
            <details class="rounded-2xl border border-white/10 bg-white/[0.03] overflow-hidden" open>
              <summary class="cursor-pointer px-5 py-3 font-semibold text-white/90 hover:bg-white/[0.02]">{c.stage}</summary>
              <ul class="px-5 pb-4 space-y-1.5 text-sm text-white/75">
                {c.items.map(i => <li class="flex items-start gap-2"><span class="text-white/30 shrink-0">□</span><span>{i}</span></li>)}
              </ul>
            </details>
          ))}
        </div>
        <p class="mt-3 text-xs text-white/45">→ Use <a href="/admin/onboarding" class="text-amber-200 underline">/admin/onboarding</a> to auto-generate the install script for each new venue.</p>
      </section>

      <!-- Unit economics -->
      <section class="mb-10 grid md:grid-cols-2 gap-3">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
          <h3 class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">{isEl ? "💸 Κόστος ανά venue" : "💸 Cost per venue"}</h3>
          <table class="w-full text-sm">
            <tbody>
              {costPerVenue.map(([k, v]) => (
                <tr class="border-t border-white/5 first:border-0">
                  <td class="py-1.5 text-white/70">{k}</td>
                  <td class="py-1.5 text-right font-mono text-white/90">{v}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.05] p-5">
          <h3 class="text-[10px] uppercase tracking-wider text-emerald-300 font-bold mb-3">📈 Margins</h3>
          <table class="w-full text-sm">
            <tbody>
              {margins.map(m => (
                <tr class="border-t border-white/5 first:border-0">
                  <td class="py-1.5 text-white/80">{m.tier}</td>
                  <td class="py-1.5 text-right text-white/60 font-mono text-xs">{m.cost}</td>
                  <td class="py-1.5 text-right text-emerald-200 font-mono font-semibold">{m.profit}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Scale table -->
      <section class="mb-10 rounded-2xl border border-amber-400/30 bg-gradient-to-br from-amber-500/10 via-fuchsia-500/5 to-sky-500/5 p-5">
        <h3 class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">{isEl ? "📊 Πού είναι τα λεφτά" : "📊 Where the money is"}</h3>
        <table class="w-full text-sm">
          <tbody>
            {scale.map(s => (
              <tr class="border-t border-white/10 first:border-0">
                <td class="py-2 font-mono font-semibold">{s.venues} venues</td>
                <td class="py-2 text-right font-mono text-amber-200">{s.mrr}</td>
                <td class="py-2 text-right text-white/55 text-xs">{s.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- Legal essentials -->
      <section class="mb-10 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <h3 class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">{isEl ? "⚖️ Νομικά απαραίτητα πριν τον πελάτη #2" : "⚖️ Legal essentials before customer #2"}</h3>
        <table class="w-full text-sm">
          <tbody>
            {legal.map(([k, v]) => (
              <tr class="border-t border-white/5 first:border-0">
                <td class="py-2 pr-4 font-semibold text-white/90 w-[40%]">{k}</td>
                <td class="py-2 text-white/65">{v}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-3 text-xs text-white/45">Total legal spend to get started: <strong class="text-white/70">€500–€1,500</strong> (Greek lawyer reviews once, reuse templates forever).</p>
      </section>

      <!-- What to build next -->
      <section class="mb-10 rounded-2xl border border-fuchsia-400/25 bg-fuchsia-400/[0.05] p-5">
        <h3 class="text-[10px] uppercase tracking-wider text-fuchsia-300 font-bold mb-3">🔧 What to build next (ranked by ROI)</h3>
        <ol class="space-y-2 text-sm text-white/80 list-decimal pl-5">
          <li><strong>Onboarding CLI / dashboard</strong> — 1-2 days. Without this, you'll never scale past 5 venues. <a href="/admin/onboarding" class="text-amber-200 underline">→ /admin/onboarding</a></li>
          <li><strong>Venues tracker</strong> — 1 day. One page listing every venue you run, SSO into each admin panel. <a href="/admin/venues" class="text-amber-200 underline">→ /admin/venues</a></li>
          <li><strong>Backup & migration tooling</strong> — 1 day. Nightly Supabase backup to cold bucket, "restore from backup" one-click.</li>
          <li><strong>Auto-update pipeline</strong> — 2-3 days. GitHub Action deploys `main` to every venue's Pages project. Frozen-version escape hatch per venue.</li>
          <li><strong>Stripe billing with seasonal logic</strong> — 1-2 days. Subscriptions with venue_id metadata, middleware suspends on payment fail, customer portal.</li>
        </ol>
      </section>
    </main>
  </body>
</html>
