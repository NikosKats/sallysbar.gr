---
import "../../styles/global.css";
import AdminNav from "../../components/AdminNav.astro";

export const prerender = false;

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (Astro.locals.role !== "super_admin") {
  return new Response("Forbidden", { status: 403 });
}

const eur = (n: number) => "€" + Math.round(n).toLocaleString("en-GB");

const startupCosts = [
  ["GEMI registration + IKE incorporation", 70, 70],
  ["e-YMS standard statute (no notary)", 0, 0],
  ["Paid-in capital (recoverable, sits in bank)", 5000, 1000],
  ["Chamber of Commerce registration", 50, 50],
  ["Legal review (SLA, DPA, dunning, ToS)", 1200, 1200],
  ["Accountant onboarding / setup", 250, 150],
  ["Domain + registered trademark (Class 9/42)", 900, 250],
  ["Business bank account opening", 0, 0],
  ["Branding refresh + landing page polish", 800, 300],
  ["Virtual office (12 mo prepaid)", 588, 156],
  ["Initial marketing collateral (print + digital)", 600, 200],
  ["Contingency buffer", 1000, 400],
];
const startupTotalC = startupCosts.reduce((s, r) => s + (r[1] as number), 0);
const startupTotalL = startupCosts.reduce((s, r) => s + (r[2] as number), 0);

const fixedCosts = [
  ["EFKA — two non-salaried founders (Cat 1)", 560, 560, "55%"],
  ["Accountant (monthly retainer)", 150, 150, "15%"],
  ["Virtual office (BCO Porto Center tier)", 49, 49, "5%"],
  ["Cloudflare Pages + Workers + R2", 20, 40, "3%"],
  ["Supabase Pro", 25, 60, "4%"],
  ["Transactional email (Resend)", 20, 40, "3%"],
  ["Vonage Messages credit reserve", 30, 60, "4%"],
  ["Domain + SSL + misc SaaS", 10, 20, "1%"],
  ["Bookkeeping software (λογιστικό πρόγραμμα)", 20, 30, "2%"],
  ["Bank fees (IBAN, transfers)", 10, 20, "1%"],
  ["Legal/GDPR retainer (pro-rated)", 50, 80, "5%"],
  ["Insurance (PI, from 30 venues)", 0, 50, "2%"],
];
const fixedTotalLow = fixedCosts.reduce((s, r) => s + (r[1] as number), 0);
const fixedTotalHigh = fixedCosts.reduce((s, r) => s + (r[2] as number), 0);

const variableCosts = [
  ["Telegram bot + bot hosting", 0, "Shared infra"],
  ["Onboarding call (video conferencing)", 0, "Shared infra"],
  ["Per-venue Supabase storage (media)", 24, "€2/mo × 12"],
  ["Outbound WhatsApp/SMS credits", 180, "~€15/mo via Vonage"],
  ["Transactional email quota (Resend)", 60, "~€5/mo"],
  ["Customer-support time (remote)", 180, "~2h/mo × €75 internal"],
  ["Onboarding labor (time, not cash)", 0, "4h × €75 = labor only"],
  ["Payment processing (bank transfer)", 0, "EFT = €0"],
  ["NFC / print collateral (optional upsell)", 60, "Reorder reserve"],
];
const variableTotal = variableCosts.reduce((s, r) => s + (r[1] as number), 0);

// Recomputed at new pricing — blended €897/venue/yr (50/50 seasonal €690 + year-round €1,104).
const scaleMilestones = [
  { v: 1,   rev:    939, tot: 12_820, gp: -11_881 },
  { v: 10,  rev:  9_390, tot: 17_356, gp:  -7_966 },
  { v: 25,  rev: 23_475, tot: 24_916, gp:  -1_441 },
  { v: 50,  rev: 46_950, tot: 37_516, gp:   9_434 },
  { v: 100, rev: 93_900, tot: 62_716, gp:  31_184 },
  { v: 120, rev:112_680, tot: 72_796, gp:  39_884 },
  { v: 200, rev:187_800, tot:113_116, gp:  74_684 },
  { v: 400, rev:375_600, tot:213_916, gp: 161_684 },
];

// Recomputed: blended €897 sub/venue/yr + €850 fixed setup paid on signing.
// Setup fee gives a huge Y1 cash boost: 40 venues × €850 = €34k extra on top of €38k subscriptions.
const scenarios = [
  { name: "A · Conservative", pace: "2/mo",    y1Venues: 20, y1Rev: 35_780, y1Net: 23_500,  y3Net: 18_000, cashBE: "month 2", halfSal: "month 48" },
  { name: "B · Realistic",    pace: "4/mo",    y1Venues: 40, y1Rev: 71_560, y1Net: 53_440,  y3Net: 38_000, cashBE: "month 1", halfSal: "month 36" },
  { name: "C · Aggressive",   pace: "8/mo+ref", y1Venues: 80, y1Rev:143_120, y1Net:110_000, y3Net: 78_000, cashBE: "month 1", halfSal: "month 24" },
];

// Recomputed at new pricing. Scenario B: 4 venues/mo avg, mix 50% seasonal + 50% year-round.
// Each new seasonal: €850 setup + €690 sub = €1,540 cash on signing.
// Each new year-round: €850 setup + €1,104 sub = €1,954 cash on signing.
// Blended new-venue cash: ~€1,747. All paid upfront. Q4 slows to ~3 venues/mo.
const cashflow = [
  { m: "Jan", v:  4, rev: 7_156, cost: 1_070, net:  6_086, cum:  6_086 },
  { m: "Feb", v:  8, rev: 7_156, cost: 1_158, net:  5_998, cum: 12_084 },
  { m: "Mar", v: 12, rev: 7_156, cost: 1_246, net:  5_910, cum: 17_994 },
  { m: "Apr", v: 16, rev: 7_156, cost: 1_334, net:  5_822, cum: 23_816 },
  { m: "May", v: 20, rev: 7_156, cost: 1_422, net:  5_734, cum: 29_550 },
  { m: "Jun", v: 24, rev: 7_156, cost: 1_510, net:  5_646, cum: 35_196 },
  { m: "Jul", v: 27, rev: 5_367, cost: 1_576, net:  3_791, cum: 38_987 },
  { m: "Aug", v: 30, rev: 5_367, cost: 1_642, net:  3_725, cum: 42_712 },
  { m: "Sep", v: 33, rev: 5_367, cost: 1_708, net:  3_659, cum: 46_371 },
  { m: "Oct", v: 36, rev: 5_367, cost: 1_774, net:  3_593, cum: 49_964 },
  { m: "Nov", v: 38, rev: 3_578, cost: 1_818, net:  1_760, cum: 51_724 },
  { m: "Dec", v: 40, rev: 3_578, cost: 1_862, net:  1_716, cum: 53_440 },
];

// Recomputed at new pricing: blended GP €519/venue/yr vs €1,896 at old pricing.
const breakEvens = [
  { k: "Cover fixed monthly burn",       current: "24 venues",   repriced: "—",           time: "month 12–18" },
  { k: "Recover startup cash",           current: "30–40 venues", repriced: "—",          time: "month 24"    },
  { k: "One partner €1,500/mo take-home", current: "70 venues",  repriced: "—",           time: "month 36–42" },
  { k: "Both partners €1,500/mo each",   current: "120 venues",  repriced: "—",           time: "month 48"    },
  { k: "Both partners full-time €38k/yr", current: "225+ venues", repriced: "—",          time: "month 60+"   },
];

const funding = [
  ["Personal runway — 6 mo living / founder", 10_000, 10_000, "Outside the business"],
  ["Paid-in capital (recoverable)",            5_000,  1_000,  "Sits in company bank"],
  ["Startup costs (net spend)",                4_500,  2_000,  "Incorporation + legal + branding"],
  ["3 months operating buffer",                3_000,  2_500,  "Covers fixed burn before first cash in"],
];
const fundTotalC = funding.reduce((s, r) => s + (r[1] as number), 0);
const fundTotalL = funding.reduce((s, r) => s + (r[2] as number), 0);
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Financial Model & Break-Even — Admin</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      @media print {
        body { background: white !important; color: black !important; }
        .no-print { display: none !important; }
        .fin-card { break-inside: avoid; page-break-inside: avoid; border-color: #ccc !important; background: white !important; }
        table, thead, tbody, tr, th, td { color: black !important; background: white !important; }
        h1, h2, h3, h4 { color: black !important; }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <AdminNav active="financial-model" />

    <main class="mx-auto max-w-5xl px-5 py-10">
      <!-- Header -->
      <div class="mb-8 flex items-start justify-between gap-4 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-rose-300 mb-2 flex items-center gap-2">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-rose-400 animate-pulse"></span>
            SUPER ADMIN ONLY
          </p>
          <h1 class="font-heading text-4xl font-bold">📊 Financial Model & Break-Even Analysis</h1>
          <p class="mt-2 text-sm text-white/60 max-w-3xl">
            Hospitality SaaS Platform · Greece — Thessaloniki — IKE — Two Co-founders.
            Complete cost inventory · Break-even · Cash flow timeline. Companion to the Operating Plan. Prepared April 2026.
          </p>
        </div>
        <div class="text-right text-xs text-white/40">
          <button onclick="window.print()" class="no-print mb-2 rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-4 py-2 text-xs font-semibold text-white">🖨 Print / Save PDF</button>
          <p>{isEl ? "Εσωτερικό έγγραφο" : "Internal document"}</p>
          <p class="mt-1">{isEl ? "Μην το κοινοποιείς" : "Do not share"}</p>
        </div>
      </div>

      <!-- Contents -->
      <section class="fin-card mb-8 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">📑 {isEl ? "Περιεχόμενα" : "Contents"}</p>
        <ol class="grid sm:grid-cols-2 gap-1.5 text-sm text-white/80 list-decimal pl-5">
          <li><a href="#s1" class="hover:text-amber-200">{isEl ? "Βασικά νούμερα & συμπέρασμα" : "Headline numbers & verdict"}</a></li>
          <li><a href="#s2" class="hover:text-amber-200">{isEl ? "Κόστος ανάπτυξης (sunk)" : "Build cost (sunk investment)"}</a></li>
          <li><a href="#s3" class="hover:text-amber-200">{isEl ? "Κόστη έναρξης (άπαξ)" : "Startup costs (one-time)"}</a></li>
          <li><a href="#s4" class="hover:text-amber-200">{isEl ? "Σταθερά λειτουργικά κόστη" : "Fixed operating costs"}</a></li>
          <li><a href="#s5" class="hover:text-amber-200">{isEl ? "Μεταβλητά κόστη (ανά venue)" : "Variable operating costs (per venue)"}</a></li>
          <li><a href="#s6" class="hover:text-amber-200">{isEl ? "Συνολικά κόστη σε κάθε κλίμακα" : "Total cost stack at each scale"}</a></li>
          <li><a href="#s7" class="hover:text-amber-200">{isEl ? "Ανάλυση break-even" : "Break-even analysis"}</a></li>
          <li><a href="#s8" class="hover:text-amber-200">{isEl ? "Τρία ρεαλιστικά σενάρια" : "Three realistic ramp scenarios"}</a></li>
          <li><a href="#s9" class="hover:text-amber-200">{isEl ? "Μηνιαία cash flow (Y1)" : "Month-by-month cash flow (Year 1)"}</a></li>
          <li><a href="#s10" class="hover:text-amber-200">{isEl ? "Πότε γίνεται κερδοφόρα;" : "When does it become profitable?"}</a></li>
          <li><a href="#s11" class="hover:text-amber-200">{isEl ? "Ανάλυση ευαισθησίας" : "Sensitivity analysis"}</a></li>
          <li><a href="#s12" class="hover:text-amber-200">{isEl ? "Πώς γρηγορότερα σε κέρδος" : "How to get to profitability faster"}</a></li>
          <li><a href="#s13" class="hover:text-amber-200">{isEl ? "Απαιτήσεις χρηματοδότησης" : "Funding requirements"}</a></li>
          <li><a href="#s13b" class="hover:text-amber-200">📈 {isEl ? "ROI στο build της πλατφόρμας" : "ROI on the platform build"}</a></li>
          <li><a href="#s14" class="hover:text-amber-200">{isEl ? "Εκτελεστικό συμπέρασμα" : "Executive conclusion"}</a></li>
        </ol>
      </section>

      <!-- 1. Headline -->
      <section id="s1" class="fin-card mb-8 rounded-2xl border border-amber-400/30 bg-amber-400/[0.05] p-5">
        <h2 class="font-heading text-2xl font-bold mb-3">{isEl ? "1. Βασικά Νούμερα & Συμπέρασμα" : "1. Headline Numbers & Verdict"}</h2>
        <p class="text-sm text-white/80 leading-relaxed">
          {isEl
            ? <>Με τη νέα τιμολόγηση (Seasonal €690, Year-round €1,104 — 20% φθηνότερα από 2× seasonal, <strong>Setup €850 σταθερό σε κάθε plan</strong>), η επιχείρηση χρειάζεται <strong>€4,000–€7,500</strong> για να ξεκινήσει συν τα €187,615 της ήδη χτισμένης πλατφόρμας. Σταθερό μηνιαίο burn: <strong>€1,026/μήνα</strong>. Recurring GP ανά venue: <strong>€519/έτος</strong> — αλλά κάθε <em>νέα</em> πώληση δίνει <strong>~€1,747 cash on signing</strong> (€850 setup + upfront συνδρομή). Το setup fee κυριαρχεί στα Y1 οικονομικά → cash break-even τραβιέται μπροστά στον <strong>μήνα 1–2</strong>. Recurring break-even (Y2+): ~24 venues. Half-salary και για τους δύο partners: ~120 venues. Πλήρες εισόδημα: 225+ venues.</>
            : <>Under the new pricing (Seasonal €690, Year-round €1,104 — 20% cheaper than 2× seasonal, <strong>Setup €850 fixed on every plan</strong>), the business needs <strong>€4,000–€7,500</strong> to launch plus the €187,615 already-built platform IP. Fixed monthly burn is <strong>€1,026/mo</strong>. Recurring GP per venue: <strong>€519/yr</strong> — but each <em>new</em> sale delivers <strong>~€1,747 cash on signing</strong> (€850 setup + upfront subscription). Setup fee dominates Y1 economics → cash break-even pulled forward to <strong>month 1–2</strong>. Recurring break-even (Y2+): ~24 venues. Half-salary both partners: ~120 venues. Full income: 225+ venues.</>}
        </p>

        <div class="grid sm:grid-cols-3 gap-3 mt-4">
          <div class="rounded-xl border border-white/10 bg-white/[0.04] p-4 text-center">
            <p class="text-[10px] uppercase tracking-wider text-amber-200/80">{isEl ? "Μετρητά για launch" : "Cash to launch"}</p>
            <p class="font-heading text-3xl font-bold mt-1">€4.5k</p>
            <p class="text-xs text-white/55 mt-1">{isEl ? "+ €5k ανακτήσιμο κεφάλαιο" : "+ €5k recoverable capital"}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.04] p-4 text-center">
            <p class="text-[10px] uppercase tracking-wider text-amber-200/80">{isEl ? "Σταθερό μηνιαίο burn" : "Fixed monthly burn"}</p>
            <p class="font-heading text-3xl font-bold mt-1">~€1,026</p>
            <p class="text-xs text-white/55 mt-1">{isEl ? "ΕΦΚΑ + λογιστής + infra" : "EFKA + accountant + infra"}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.04] p-4 text-center">
            <p class="text-[10px] uppercase tracking-wider text-amber-200/80">{isEl ? "Gross margin / venue" : "Gross margin / venue"}</p>
            <p class="font-heading text-3xl font-bold mt-1">79–83%</p>
            <p class="text-xs text-white/55 mt-1">{isEl ? "Εξαιρετικό για SaaS" : "Exceptional for SaaS"}</p>
          </div>
        </div>

        <div class="mt-4 grid sm:grid-cols-2 gap-3 text-sm">
          {breakEvens.map(b => (
            <div class="rounded-xl border border-white/10 bg-white/[0.03] p-3">
              <p class="font-bold text-white">{b.k}</p>
              <p class="text-xs text-white/60 mt-0.5">Current: <span class="text-amber-200">{b.current}</span> · Repriced: <span class="text-emerald-300">{b.repriced}</span> · {b.time}</p>
            </div>
          ))}
        </div>

        <p class="mt-4 text-sm text-white/75 leading-relaxed">
          {isEl
            ? <><strong>Συμπέρασμα.</strong> Οικονομικά υγιής με χαμηλές απαιτήσεις κεφαλαίου και ξεκάθαρο μαθηματικό μονοπάτι προς κερδοφορία. Η πλατφόρμα €187,615 είναι sunk — ένα one-time δώρο στο μοντέλο που οι ανταγωνιστές πρέπει να αντιγράψουν. Από εδώ, τα μετρητά που χρειάζονται είναι λίγα (€4k–€7.5k) και το σταθερό κόστος κυριαρχείται από λίγες γραμμές (ΕΦΚΑ + λογιστής + virtual office = ~80%). Ο κυρίαρχος κίνδυνος είναι ο ρυθμός, όχι τα οικονομικά.</>
            : <><strong>Verdict.</strong> Financially sound with low capital requirements and a clear mathematical path to profitability. The €187,615 platform is sunk — a one-time gift to the business model competitors must replicate. From here, cash needed is small (€4k–€7.5k) and fixed cost is dominated by a handful of line items (EFKA + accountant + virtual office = ~80%). Every €1,890 seasonal sale produces ~€1,485 in pre-tax profit before fixed-cost allocation. The dominant risk is pace, not finance.</>}
        </p>
      </section>

      <!-- 2. Build cost -->
      <section id="s2" class="fin-card mb-8 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <h2 class="font-heading text-2xl font-bold mb-3">{isEl ? "2. Κόστος Ανάπτυξης (Sunk Investment)" : "2. Build Cost (Sunk Investment)"}</h2>
        <p class="text-sm text-white/80 leading-relaxed">
          The platform is already built. At EU agency rates it represents <strong>2,185 hours</strong> = <strong>€187,615 net / €290,804 gross</strong>.
          <strong>Cash impact: €0.</strong> It is the company's founding IP contribution and the moat against any competitor.
        </p>
        <ul class="mt-3 space-y-1.5 text-sm text-white/75 list-disc pl-5">
          <li><strong>Accounting:</strong> under Greek GAAP internally-developed software is typically expensed as incurred. Discuss capitalisation with your λογιστής — creates depreciation over 3–5 years.</li>
          <li><strong>Tax:</strong> zero unless capitalised (then depreciation is deductible).</li>
          <li><strong>Valuation:</strong> €187,615–€290,804 of demonstrable IP; useful for grants and any future sale.</li>
          <li><strong>Strategic:</strong> estimated 12–18 months head-start in the Greek hospitality vertical.</li>
          <li><strong>All break-even calcs below exclude the build cost</strong> — the cash is already spent.</li>
        </ul>
      </section>

      <!-- 3. Startup costs -->
      <section id="s3" class="fin-card mb-8 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <h2 class="font-heading text-2xl font-bold mb-3">{isEl ? "3. Κόστη Έναρξης (Άπαξ)" : "3. Startup Costs (One-Time)"}</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[11px] uppercase tracking-wider text-white/60">
              <tr class="border-b border-white/10">
                <th class="text-left py-2 px-3">Line item</th>
                <th class="text-right py-2 px-3">Conservative</th>
                <th class="text-right py-2 px-3">Lean</th>
              </tr>
            </thead>
            <tbody>
              {startupCosts.map(([label, c, l]) => (
                <tr class="border-b border-white/5">
                  <td class="py-2 px-3 text-white/80">{label}</td>
                  <td class="py-2 px-3 text-right font-mono text-white/85">{eur(c as number)}</td>
                  <td class="py-2 px-3 text-right font-mono text-emerald-300">{eur(l as number)}</td>
                </tr>
              ))}
              <tr class="border-t-2 border-amber-400/40 bg-amber-400/[0.04]">
                <td class="py-2 px-3 font-bold">TOTAL</td>
                <td class="py-2 px-3 text-right font-mono font-bold text-amber-200">{eur(startupTotalC)}</td>
                <td class="py-2 px-3 text-right font-mono font-bold text-emerald-300">{eur(startupTotalL)}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-sm text-white/70">
          <strong>Recommended path:</strong> lean column except on legal (never cut GDPR corners). Pay €5,000 paid-in capital (signals seriousness on GEMI).
          Pick virtual office @ €49/mo (prestige address) once signed.
          <strong>Target: ~€4,500 net spend + €5,000 recoverable capital = €9,500 cash in founder accounts on day 1.</strong>
        </p>
      </section>

      <!-- 4. Fixed costs -->
      <section id="s4" class="fin-card mb-8 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <h2 class="font-heading text-2xl font-bold mb-3">{isEl ? "4. Σταθερά Λειτουργικά Κόστη (Ανεξάρτητα Venues)" : "4. Fixed Operating Costs (Independent of Venues)"}</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[11px] uppercase tracking-wider text-white/60">
              <tr class="border-b border-white/10">
                <th class="text-left py-2 px-3">Line item</th>
                <th class="text-right py-2 px-3">Low €/mo</th>
                <th class="text-right py-2 px-3">High €/mo</th>
                <th class="text-right py-2 px-3">% of burn</th>
              </tr>
            </thead>
            <tbody>
              {fixedCosts.map(([label, lo, hi, pct]) => (
                <tr class="border-b border-white/5">
                  <td class="py-2 px-3 text-white/80">{label}</td>
                  <td class="py-2 px-3 text-right font-mono">{eur(lo as number)}</td>
                  <td class="py-2 px-3 text-right font-mono">{eur(hi as number)}</td>
                  <td class="py-2 px-3 text-right text-white/60">{pct}</td>
                </tr>
              ))}
              <tr class="border-t-2 border-amber-400/40 bg-amber-400/[0.04]">
                <td class="py-2 px-3 font-bold">TOTAL</td>
                <td class="py-2 px-3 text-right font-mono font-bold text-amber-200">{eur(fixedTotalLow)}</td>
                <td class="py-2 px-3 text-right font-mono font-bold text-amber-200">{eur(fixedTotalHigh)}</td>
                <td class="py-2 px-3"></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="mt-4 rounded-xl border border-rose-400/20 bg-rose-400/[0.04] p-4 text-sm text-white/80">
          <p class="font-bold text-rose-200 mb-1">⚠️ 80% of fixed cost = two line items</p>
          <ul class="space-y-0.5 list-disc pl-5 text-white/75">
            <li>EFKA for two founders: €560/mo → <strong>55%</strong></li>
            <li>Accountant + virtual office: €199/mo → <strong>19%</strong></li>
            <li>Everything else combined: ~€267/mo → 26%</li>
          </ul>
          <p class="mt-2 text-white/70">You cannot meaningfully reduce burn — only grow revenue past it.</p>
        </div>
        <div class="mt-4 text-sm text-white/70">
          <p class="font-bold text-white mb-1">What's NOT in the table (common mistakes)</p>
          <ul class="space-y-0.5 list-disc pl-5">
            <li>Founder salaries (IKE founders take dividends @ 22% CIT + 5% WHT — not salary).</li>
            <li>Home utilities / personal mobile / home office furniture (all personal, not deductible).</li>
