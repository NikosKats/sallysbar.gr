---
import "../../styles/global.css";
import AdminNav from "../../components/AdminNav.astro";
import { supabaseAdmin } from "../../lib/supabase";
import { withLangPrefix } from "../../i18n";
import { getScratchSettings, getScratchPool } from "../../lib/scratch";

const settings = await getScratchSettings();
const rewards = await getScratchPool();
const totalWeight = rewards.reduce((s, r) => s + r.weight, 0);

const { data: earnRows } = await supabaseAdmin
  .from("scratch_earn_items")
  .select("emoji, text_en, text_el, active, sort_order")
  .order("sort_order", { ascending: true });
const earnItems = (earnRows ?? []) as Array<{ emoji: string; text_en: string; text_el: string; active: boolean; sort_order: number }>;

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!["admin","super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/admin"));
}

// Latest 200 cards
const { data: cards } = await supabaseAdmin
  .from("scratch_cards")
  .select("id, user_id, reward_type, reward_value, reward_label, revealed_at, claimed_at, expires_at, trigger, created_at")
  .order("created_at", { ascending: false })
  .limit(200);

// Look up user emails for display
const userIds = Array.from(new Set((cards ?? []).map(c => c.user_id)));
const emailMap = new Map<string, string>();
if (userIds.length > 0) {
  const { data: profiles } = await supabaseAdmin
    .from("profiles").select("id, email, full_name").in("id", userIds);
  for (const p of profiles ?? []) emailMap.set(p.id, p.full_name || p.email || p.id.slice(0, 8));
}

// Eligible members: every registered auth.users entry.
// Using auth.admin.listUsers so we catch users who signed up but never had a
// `profiles` row auto-created (depends on your Supabase auth-to-profile trigger).
const { data: authList } = await supabaseAdmin.auth.admin.listUsers({ perPage: 500 });
const authUsers = authList?.users ?? [];
const { data: profileRows } = await supabaseAdmin.from("profiles").select("id, full_name");
const nameById = new Map((profileRows ?? []).map((p: any) => [p.id, p.full_name]));
const members = authUsers.map(u => ({
  id: u.id,
  email: u.email ?? "",
  full_name: (nameById.get(u.id) as string | undefined) ?? u.user_metadata?.full_name ?? u.email?.split("@")[0] ?? "—",
})).sort((a, b) => (a.full_name ?? "").localeCompare(b.full_name ?? ""));

// Stats
const total = (cards ?? []).length;
const revealed = (cards ?? []).filter(c => c.revealed_at).length;
const claimed = (cards ?? []).filter(c => c.claimed_at).length;
const unrevealedByUser = new Map<string, number>();
for (const c of cards ?? []) {
  if (!c.revealed_at) unrevealedByUser.set(c.user_id, (unrevealedByUser.get(c.user_id) ?? 0) + 1);
}
const revealRate = total > 0 ? Math.round((revealed / total) * 100) : 0;

const memberCount = (members ?? []).length;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isEl ? "Scratch Cards" : "Scratch Cards"} — Admin</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <AdminNav active="scratch" />

    <main class="mx-auto max-w-5xl px-4 py-6 space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 class="text-2xl font-bold">{isEl ? "🎫 Scratch Cards" : "🎫 Scratch Cards"}</h1>
          <p class="text-sm text-white/50 mt-1">
            {isEl ? "Έκδοση, εξαργύρωση και παρακολούθηση scratch cards." : "Issue, redeem, and track scratch cards."}
          </p>
        </div>
      </div>

      <!-- KPI -->
      <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-xs uppercase tracking-wider text-white/40">{isEl ? "Σύνολο" : "Total issued"}</p>
          <p class="text-3xl font-bold text-white mt-1">{total}</p>
        </div>
        <div class="rounded-2xl border border-amber-400/20 bg-amber-400/5 p-4">
          <p class="text-xs uppercase tracking-wider text-amber-300/70">{isEl ? "Αποκαλύφθηκαν" : "Revealed"}</p>
          <p class="text-3xl font-bold text-amber-300 mt-1">{revealed} <span class="text-sm font-normal text-amber-300/60">· {revealRate}%</span></p>
        </div>
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-4">
          <p class="text-xs uppercase tracking-wider text-emerald-300/70">{isEl ? "Εξαργυρώθηκαν" : "Claimed"}</p>
          <p class="text-3xl font-bold text-emerald-300 mt-1">{claimed}</p>
        </div>
        <div class="rounded-2xl border border-fuchsia-400/20 bg-fuchsia-400/5 p-4">
          <p class="text-xs uppercase tracking-wider text-fuchsia-300/70">{isEl ? "Εκκρεμούν" : "Unrevealed"}</p>
          <p class="text-3xl font-bold text-fuchsia-300 mt-1">{total - revealed}</p>
        </div>
      </section>

      <!-- Auto-issue settings -->
      <section class="rounded-2xl border border-white/10 bg-white/5 p-5 space-y-4">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-white/50">{isEl ? "Αυτόματη έκδοση (toggles)" : "Auto-issue hooks"}</h2>
          <button id="saveSettingsBtn" type="button" class="rounded-xl bg-amber-400 text-black px-4 py-2 text-sm font-semibold hover:bg-amber-300 transition">{isEl ? "Αποθήκευση" : "Save"}</button>
        </div>

        <div class="grid md:grid-cols-2 gap-3">
          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4 space-y-3">
            <label class="flex items-start gap-3">
              <input type="checkbox" id="sOrder" checked={settings.auto_on_order} class="mt-1 h-4 w-4" />
              <div>
                <div class="font-semibold text-white">1. {isEl ? "Σε κάθε παραγγελία" : "On every order"}</div>
                <p class="text-xs text-white/55 mt-1">{isEl ? "Κάρτα όταν ο πελάτης πληρώνει μια παραγγελία ≥ ελάχιστου ποσού." : "Card when a customer pays an order ≥ minimum amount."}</p>
              </div>
            </label>
            <div class="grid grid-cols-2 gap-3 pl-7">
              <label class="block"><span class="text-[10px] uppercase tracking-wider text-white/40">{isEl ? "Ελάχιστο €" : "Min €"}</span>
                <input id="sOrderMin" type="number" min="0" step="0.5" value={(settings.order_min_cents / 100).toFixed(2)} class="w-full mt-1 rounded-lg border border-white/10 bg-white/5 px-2 py-1.5 text-sm text-white" /></label>
              <label class="block"><span class="text-[10px] uppercase tracking-wider text-white/40">{isEl ? "Κάρτες/παραγγελία" : "Cards / order"}</span>
                <input id="sOrderCards" type="number" min="1" max="10" value={settings.cards_per_order} class="w-full mt-1 rounded-lg border border-white/10 bg-white/5 px-2 py-1.5 text-sm text-white" /></label>
            </div>
          </div>

          <label class="rounded-xl border border-white/10 bg-white/[0.03] p-4 flex items-start gap-3 cursor-pointer">
            <input type="checkbox" id="sRsvp" checked={settings.auto_on_rsvp} class="mt-1 h-4 w-4" />
            <div>
              <div class="font-semibold text-white">2. {isEl ? "Σε RSVP σε event" : "On event RSVP"}</div>
              <p class="text-xs text-white/55 mt-1">{isEl ? "Κάρτα όταν κάποιος κάνει κράτηση για event." : "Card when someone RSVPs to an event."}</p>
            </div>
          </label>

          <label class="rounded-xl border border-white/10 bg-white/[0.03] p-4 flex items-start gap-3 cursor-pointer">
            <input type="checkbox" id="sCheckin" checked={settings.auto_on_checkin} class="mt-1 h-4 w-4" />
            <div>
              <div class="font-semibold text-white">3. {isEl ? "Check-in (σκανάρισμα τραπεζιού)" : "Table check-in (QR scan)"}</div>
              <p class="text-xs text-white/55 mt-1">{isEl ? "Μία κάρτα/μέρα όταν συνδεδεμένος χρήστης σκανάρει QR τραπεζιού." : "One card/day when a logged-in user scans any table QR."}</p>
            </div>
          </label>

          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4 opacity-60">
            <div class="flex items-start gap-3">
              <input type="checkbox" id="sReferral" checked={false} disabled class="mt-1 h-4 w-4" />
              <div>
                <div class="font-semibold text-white">4. {isEl ? "Σε σύσταση φίλου" : "On referral"} <span class="text-[10px] uppercase tracking-wider text-white/40">({isEl ? "απενεργοποιημένο" : "disabled"})</span></div>
                <p class="text-xs text-white/55 mt-1">{isEl
                  ? "Ο νέος χρήστης παίρνει την κάρτα μέσω του signup bonus. Ο συστήνων παίρνει μόνο πόντους (όχι scratch card)."
                  : "The new user gets the card via the signup bonus. The referrer receives only points (no scratch card)."}</p>
              </div>
            </div>
          </div>

          <label class="rounded-xl border border-fuchsia-400/25 bg-fuchsia-400/5 p-4 flex items-start gap-3 cursor-pointer md:col-span-2">
            <input type="checkbox" id="sSignup" checked={settings.auto_on_signup} class="mt-1 h-4 w-4" />
            <div>
              <div class="font-semibold text-fuchsia-200">⭐ {isEl ? "Bonus εγγραφής (νέος χρήστης)" : "Signup bonus (new user)"}</div>
              <p class="text-xs text-white/55 mt-1">{isEl
                ? "Κάθε νέα εγγραφή παίρνει αυτόματα μία scratch card. Συνδύασε με το preset QR «Signup Bonus» από το /admin/marketing για μαζική προώθηση."
                : "Every new signup auto-receives one scratch card. Pair it with the \"Signup Bonus\" QR preset on /admin/marketing for mass promotion."}</p>
            </div>
          </label>

          <div class="rounded-xl border border-amber-400/25 bg-amber-400/5 p-4 space-y-3">
            <label class="flex items-start gap-3">
              <input type="checkbox" id="sDaily" checked={settings.daily_drop_enabled} class="mt-1 h-4 w-4" />
              <div>
                <div class="font-semibold text-amber-200">5. {isEl ? "Ημερήσιο drop" : "Daily drop"}</div>
                <p class="text-xs text-white/55 mt-1">{isEl ? "Μία κάρτα σε κάθε μέλος, μία φορά τη μέρα. Συνδύασε με push στις HH:00." : "One card to every member, once per day. Combine with a push at HH:00."}</p>
              </div>
            </label>
            <div class="flex items-end gap-2 pl-7">
              <label class="block flex-1"><span class="text-[10px] uppercase tracking-wider text-white/40">{isEl ? "Ώρα" : "Hour"}</span>
                <input id="sDailyHour" type="number" min="0" max="23" value={settings.daily_drop_hour} class="w-full mt-1 rounded-lg border border-white/10 bg-white/5 px-2 py-1.5 text-sm text-white" /></label>
              <button id="runDailyBtn" type="button" class="rounded-lg bg-amber-400/20 hover:bg-amber-400/30 text-amber-200 text-xs font-semibold px-3 py-1.5">▶ {isEl ? "Τρέξε τώρα" : "Run now"}</button>
            </div>
          </div>

          <div class="rounded-xl border border-fuchsia-400/25 bg-fuchsia-400/5 p-4 space-y-2">
            <label class="flex items-start gap-3">
              <input type="checkbox" id="sBirthday" checked={settings.birthday_enabled} class="mt-1 h-4 w-4" />
              <div>
                <div class="font-semibold text-fuchsia-200">6. {isEl ? "Γενέθλια" : "Birthday"}</div>
                <p class="text-xs text-white/55 mt-1">{isEl ? "Μία κάρτα σε κάθε μέλος με γενέθλια σήμερα." : "One card to every member whose birthday is today."}</p>
              </div>
            </label>
            <div class="pl-7">
              <button id="runBirthdayBtn" type="button" class="rounded-lg bg-fuchsia-400/20 hover:bg-fuchsia-400/30 text-fuchsia-200 text-xs font-semibold px-3 py-1.5">▶ {isEl ? "Τρέξε τώρα" : "Run now"}</button>
            </div>
          </div>

          <label class="block rounded-xl border border-white/10 bg-white/[0.03] p-4 md:col-span-2">
            <span class="text-xs text-white/50">{isEl ? "Προκαθορισμένη λήξη για αυτόματες κάρτες (ώρες, κενό = ποτέ)" : "Default expiry for auto-issued cards (hours, blank = never)"}</span>
            <input id="sExpiresHours" type="number" min="0" max="8760" value={settings.default_expires_hours ?? ""} class="w-full mt-1 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" />
          </label>
        </div>

        <p id="settingsMsg" class="text-xs hidden"></p>
      </section>

      <!-- Actions: mass drop + single issue -->
      <section class="grid md:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-amber-400/30 bg-gradient-to-br from-amber-500/10 to-fuchsia-500/10 p-5">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-amber-300">{isEl ? "Μαζική διανομή" : "Mass drop"}</h2>
          <p class="text-sm text-white/70 mt-2 leading-relaxed">
            {isEl
              ? `Στείλε μία scratch card σε κάθε μέλος του προγράμματος (${memberCount} μέλη). Ιδανικό πριν από ένα event ή για να γεμίσεις μια ήρεμη βραδιά.`
              : `Issue one scratch card to every loyalty member (${memberCount} members). Great right before an event or to fill a slow night.`}
          </p>
          <label class="block mt-3">
            <span class="text-xs text-white/50">{isEl ? "Λήξη (προαιρετικά)" : "Expires (optional)"}</span>
            <input id="bulkExpires" type="datetime-local" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" />
          </label>
          <button id="bulkIssueBtn" type="button" class="mt-4 w-full rounded-xl bg-amber-400 text-black px-4 py-3 text-sm font-bold hover:bg-amber-300 transition">
            🎫 {isEl ? `Έκδοση σε όλα τα ${memberCount} μέλη` : `Issue to all ${memberCount} members`}
          </button>
          <p id="bulkMsg" class="mt-2 text-xs hidden"></p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-white/50">{isEl ? "Έκδοση σε συγκεκριμένο χρήστη" : "Issue to one user"}</h2>
          <p class="text-sm text-white/60 mt-2 leading-relaxed">{isEl ? "Διάλεξε μέλος — κάρτα δημιουργείται άμεσα." : "Pick a member — card is created immediately."}</p>
          <label class="block mt-3">
            <span class="text-xs text-white/50">{isEl ? "Μέλος" : "Member"}</span>
            <select id="singleUser" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white">
              <option value="">—</option>
              {(members ?? []).map(m => (
                <option value={m.id}>{m.full_name || m.email}</option>
              ))}
            </select>
          </label>
          <label class="block mt-3">
            <span class="text-xs text-white/50">{isEl ? "Λήξη (προαιρετικά)" : "Expires (optional)"}</span>
            <input id="singleExpires" type="datetime-local" class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white" />
          </label>
          <button id="singleIssueBtn" type="button" class="mt-4 w-full rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 text-white px-4 py-3 text-sm font-semibold transition">
            🎫 {isEl ? "Έκδοση κάρτας" : "Issue card"}
          </button>
          <p id="singleMsg" class="mt-2 text-xs hidden"></p>
        </div>
      </section>

      <!-- Recent cards list -->
      <section class="rounded-2xl border border-white/10 bg-white/5 overflow-hidden">
        <div class="px-5 py-3 border-b border-white/10 flex items-center justify-between flex-wrap gap-2">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/50">{isEl ? "Πρόσφατες κάρτες" : "Recent cards"}</h2>
          <div class="flex items-center gap-2 text-xs">
            <label class="flex items-center gap-1 text-white/60"><input id="filterUnclaimed" type="checkbox" class="h-3.5 w-3.5" /> {isEl ? "Μόνο για εξαργύρωση (σερβιτόρος)" : "Awaiting staff redemption only"}</label>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead class="bg-white/5">
              <tr class="text-white/40 text-[10px] uppercase tracking-wider">
                <th class="text-left px-3 py-2">{isEl ? "Όταν" : "When"}</th>
                <th class="text-left px-3 py-2">{isEl ? "Χρήστης" : "User"}</th>
                <th class="text-left px-3 py-2">{isEl ? "Ανταμοιβή" : "Reward"}</th>
                <th class="text-left px-3 py-2">{isEl ? "Κατάσταση" : "Status"}</th>
                <th class="text-left px-3 py-2">{isEl ? "Λήξη" : "Expires"}</th>
                <th class="text-right px-3 py-2">{isEl ? "Ενέργειες" : "Actions"}</th>
              </tr>
            </thead>
            <tbody id="cardsBody">
              {(cards ?? []).map(c => {
                const isPoints = c.reward_type === "points";
                const status = c.claimed_at ? "claimed" : c.revealed_at ? "revealed" : "unrevealed";
                const statusLabel = status === "claimed"   ? (isEl ? "✓ Εξαργυρώθηκε" : "✓ Claimed")
                                  : status === "revealed"  ? (isEl ? "👁 Αποκαλύφθηκε — εκκρεμεί" : "👁 Revealed — awaiting")
                                  : (isEl ? "🎫 Δεν αποκαλύφθηκε" : "🎫 Unrevealed");
                const statusClr = status === "claimed"   ? "bg-emerald-400/15 text-emerald-300"
                                : status === "revealed"  ? "bg-amber-400/15 text-amber-300"
                                : "bg-white/10 text-white/50";
                return (
                  <tr class="border-t border-white/5 hover:bg-white/[0.03] scratch-row"
                    data-id={c.id} data-status={status} data-type={c.reward_type}>
                    <td class="px-3 py-2 text-white/60 whitespace-nowrap">{new Date(c.created_at).toLocaleString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })}</td>
                    <td class="px-3 py-2 text-white/80 truncate max-w-[180px]">{emailMap.get(c.user_id) ?? c.user_id.slice(0, 8)}</td>
                    <td class="px-3 py-2 text-white"><span class="font-semibold">{c.reward_label}</span>{c.trigger && <span class="text-white/30 ml-1">· {c.trigger}</span>}</td>
                    <td class="px-3 py-2"><span class={`text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full ${statusClr}`}>{statusLabel}</span></td>
                    <td class="px-3 py-2 text-white/50 whitespace-nowrap">{c.expires_at ? new Date(c.expires_at).toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "short" }) : "—"}</td>
                    <td class="px-3 py-2 text-right whitespace-nowrap">
                      {status === "revealed" && !isPoints && (
                        <button class="claim-btn text-[11px] px-2 py-1 rounded-lg bg-emerald-400/15 text-emerald-300 hover:bg-emerald-400/25 transition">
                          {isEl ? "Εξαργύρωση ✓" : "Mark claimed ✓"}
                        </button>
                      )}
                      {status === "claimed" && (
                        <button class="unclaim-btn text-[11px] px-2 py-1 rounded-lg bg-white/10 hover:bg-white/15 transition">
                          {isEl ? "Αναίρεση" : "Undo"}
                        </button>
                      )}
                      <button class="void-btn text-[11px] ml-1 px-2 py-1 rounded-lg bg-red-500/15 text-red-300 hover:bg-red-500/25 transition">
                        {isEl ? "Ακύρωση" : "Void"}
                      </button>
                    </td>
                  </tr>
                );
              })}
              {(cards ?? []).length === 0 && (
                <tr><td colspan="6" class="text-center text-white/40 py-8 text-sm">{isEl ? "Καμία κάρτα ακόμα." : "No cards issued yet."}</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Editable reward pool -->
      <section class="rounded-2xl border border-white/10 bg-white/5 p-5 space-y-3">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-widest text-white/50">🏆 {isEl ? "Έπαθλα (weighted pool)" : "Rewards (weighted pool)"}</h2>
            <p class="text-xs text-white/40 mt-1">{isEl ? "Επεξεργάσιμα. Σύνολο βαρών = 100%. Το τσεκ \"Active\" κρύβει το reward από το pool χωρίς να το διαγράφει." : "Fully editable. Weights sum to 100%. Uncheck \"Active\" to hide a reward without deleting it."}</p>
          </div>
          <div class="flex gap-2">
            <button id="addRewardBtn" type="button" class="rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-3 py-1.5 text-xs font-semibold">+ {isEl ? "Νέα" : "New"}</button>
            <button id="saveRewardsBtn" type="button" class="rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black px-4 py-1.5 text-xs font-bold">💾 {isEl ? "Αποθήκευση" : "Save"}</button>
          </div>
        </div>
        <p id="rewardsMsg" class="text-xs hidden"></p>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[10px] uppercase tracking-wider text-white/40 text-left">
              <tr>
                <th class="py-2 pr-2">{isEl ? "Τύπος" : "Type"}</th>
                <th class="py-2 pr-2 w-20">Value</th>
                <th class="py-2 pr-2">Label EN</th>
                <th class="py-2 pr-2">Label EL</th>
                <th class="py-2 pr-2 w-24 text-right">Weight</th>
                <th class="py-2 pr-2 w-16 text-right">%</th>
                <th class="py-2 pr-2 w-14 text-center">On</th>
                <th class="py-2 w-8"></th>
              </tr>
            </thead>
            <tbody id="rewardsBody">
              {rewards.map((r) => {
                const pct = totalWeight > 0 ? (r.weight / totalWeight) * 100 : 0;
                return (
                  <tr class="reward-row border-t border-white/5">
                    <td class="py-1.5 pr-2">
                      <select data-field="type" class="rounded bg-white/5 border border-white/10 px-2 py-1 text-xs">
                        <option value="points"     selected={r.type === "points"}>points</option>
                        <option value="free_shot"  selected={r.type === "free_shot"}>free_shot</option>
                        <option value="free_drink" selected={r.type === "free_drink"}>free_drink</option>
                        <option value="discount"   selected={r.type === "discount"}>discount</option>
                        <option value="custom"     selected={r.type === "custom"}>custom</option>
                      </select>
                    </td>
                    <td class="py-1.5 pr-2"><input type="number" data-field="value" value={r.value} class="w-20 rounded bg-white/5 border border-white/10 px-2 py-1 text-xs font-mono" /></td>
                    <td class="py-1.5 pr-2"><input type="text" data-field="label_en" value={r.label_en} class="w-full rounded bg-white/5 border border-white/10 px-2 py-1 text-xs" /></td>
                    <td class="py-1.5 pr-2"><input type="text" data-field="label_el" value={r.label_el} class="w-full rounded bg-white/5 border border-white/10 px-2 py-1 text-xs" /></td>
                    <td class="py-1.5 pr-2 text-right"><input type="number" data-field="weight" value={r.weight} min="0" class="w-20 rounded bg-white/5 border border-white/10 px-2 py-1 text-xs font-mono text-right" /></td>
                    <td class="py-1.5 pr-2 text-right"><span class="pct-out font-mono text-white/60">{pct.toFixed(pct < 10 ? 1 : 0)}%</span></td>
                    <td class="py-1.5 pr-2 text-center"><input type="checkbox" data-field="active" checked class="h-4 w-4 accent-emerald-400" /></td>
                    <td class="py-1.5 text-right"><button type="button" class="del-reward text-white/40 hover:text-red-300" title="Delete">🗑</button></td>
                  </tr>
                );
              })}
            </tbody>
            <tfoot>
              <tr class="border-t-2 border-amber-400/40">
                <td class="py-2 pr-2 text-[10px] uppercase text-amber-300 font-bold" colspan="4">Total</td>
                <td class="py-2 pr-2 text-right font-mono font-bold text-amber-200" id="totalWeight">{totalWeight}</td>
                <td class="py-2 pr-2 text-right font-mono font-bold">100%</td>
                <td colspan="2"></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>

      <!-- Editable "How to earn more" list -->
      <section class="rounded-2xl border border-white/10 bg-white/5 p-5 space-y-3">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-widest text-white/50">🎯 {isEl ? "Πώς παίρνουν περισσότερες (πελάτες)" : "How customers earn more"}</h2>
            <p class="text-xs text-white/40 mt-1">{isEl ? "Η λίστα που φαίνεται στο /scratch. Επεξεργάσιμη με σειρά." : "The list shown on /scratch. Fully editable with reordering."}</p>
          </div>
          <div class="flex gap-2">
            <button id="addEarnBtn" type="button" class="rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-3 py-1.5 text-xs font-semibold">+ {isEl ? "Νέα" : "New"}</button>
            <button id="saveEarnBtn" type="button" class="rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black px-4 py-1.5 text-xs font-bold">💾 {isEl ? "Αποθήκευση" : "Save"}</button>
          </div>
        </div>
        <p id="earnMsg" class="text-xs hidden"></p>
        <div id="earnList" class="space-y-2">
          {earnItems.map(it => (
            <div class="earn-row flex items-center gap-2 rounded-xl border border-white/10 bg-black/20 px-3 py-2">
              <button type="button" class="earn-up    text-white/40 hover:text-white text-xs" title="Up">↑</button>
              <button type="button" class="earn-down  text-white/40 hover:text-white text-xs" title="Down">↓</button>
              <input type="text" data-field="emoji"   value={it.emoji}   class="w-12 text-center rounded bg-white/5 border border-white/10 px-1 py-1 text-lg" />
              <input type="text" data-field="text_en" value={it.text_en} placeholder="English" class="flex-1 rounded bg-white/5 border border-white/10 px-2 py-1.5 text-xs" />
              <input type="text" data-field="text_el" value={it.text_el} placeholder="Ελληνικά" class="flex-1 rounded bg-white/5 border border-white/10 px-2 py-1.5 text-xs" />
              <label class="inline-flex items-center gap-1 text-[10px] text-white/60"><input type="checkbox" data-field="active" checked={it.active} class="h-3.5 w-3.5 accent-emerald-400" />on</label>
              <button type="button" class="earn-del text-white/40 hover:text-red-300" title="Delete">🗑</button>
            </div>
          ))}
        </div>
      </section>
    </main>

    <script is:inline>
      // ── Rewards editor ────────────────────────────────────────────────
      (function () {
        const body = document.getElementById("rewardsBody");
        const totalOut = document.getElementById("totalWeight");
        const msgEl = document.getElementById("rewardsMsg");
        if (!body) return;

        function rowTemplate(r) {
          const tr = document.createElement("tr");
          tr.className = "reward-row border-t border-white/5";
          tr.innerHTML = `
            <td class="py-1.5 pr-2">
              <select data-field="type" class="rounded bg-white/5 border border-white/10 px-2 py-1 text-xs">
                <option value="points">points</option>
                <option value="free_shot">free_shot</option>
                <option value="free_drink">free_drink</option>
                <option value="discount">discount</option>
                <option value="custom">custom</option>
              </select>
            </td>
            <td class="py-1.5 pr-2"><input type="number" data-field="value" value="${r.value ?? 0}" class="w-20 rounded bg-white/5 border border-white/10 px-2 py-1 text-xs font-mono" /></td>
            <td class="py-1.5 pr-2"><input type="text" data-field="label_en" value="${(r.label_en ?? "").replace(/"/g, "&quot;")}" class="w-full rounded bg-white/5 border border-white/10 px-2 py-1 text-xs" /></td>
            <td class="py-1.5 pr-2"><input type="text" data-field="label_el" value="${(r.label_el ?? "").replace(/"/g, "&quot;")}" class="w-full rounded bg-white/5 border border-white/10 px-2 py-1 text-xs" /></td>
            <td class="py-1.5 pr-2 text-right"><input type="number" data-field="weight" value="${r.weight ?? 1}" min="0" class="w-20 rounded bg-white/5 border border-white/10 px-2 py-1 text-xs font-mono text-right" /></td>
            <td class="py-1.5 pr-2 text-right"><span class="pct-out font-mono text-white/60">0%</span></td>
            <td class="py-1.5 pr-2 text-center"><input type="checkbox" data-field="active" ${r.active !== false ? "checked" : ""} class="h-4 w-4 accent-emerald-400" /></td>
            <td class="py-1.5 text-right"><button type="button" class="del-reward text-white/40 hover:text-red-300" title="Delete">🗑</button></td>`;
          tr.querySelector('[data-field="type"]').value = r.type || "points";
          return tr;
        }

        function rowsToObjects() {
          return Array.from(body.querySelectorAll(".reward-row")).map(tr => ({
            type:     tr.querySelector('[data-field="type"]').value,
            value:    Number(tr.querySelector('[data-field="value"]').value) || 0,
            label_en: tr.querySelector('[data-field="label_en"]').value,
            label_el: tr.querySelector('[data-field="label_el"]').value,
            weight:   Number(tr.querySelector('[data-field="weight"]').value) || 0,
            active:   tr.querySelector('[data-field="active"]').checked,
          }));
        }

        function recalc() {
          const rows = rowsToObjects();
          const total = rows.reduce((s, r) => s + (r.active ? r.weight : 0), 0);
          totalOut.textContent = total;
          Array.from(body.querySelectorAll(".reward-row")).forEach((tr, i) => {
            const w = rows[i].active ? rows[i].weight : 0;
            const pct = total > 0 ? (w / total) * 100 : 0;
            tr.querySelector(".pct-out").textContent = pct.toFixed(pct < 10 ? 1 : 0) + "%";
          });
        }

        function bindRow(tr) {
          tr.querySelectorAll("input, select").forEach(el => el.addEventListener("input", recalc));
          tr.querySelector(".del-reward").addEventListener("click", () => {
            if (!confirm("Delete this reward?")) return;
            tr.remove(); recalc();
          });
        }
        body.querySelectorAll(".reward-row").forEach(bindRow);

        document.getElementById("addRewardBtn").addEventListener("click", () => {
          const tr = rowTemplate({ type: "points", value: 10, label_en: "New reward", label_el: "Νέα ανταμοιβή", weight: 5, active: true });
          body.appendChild(tr);
          bindRow(tr);
          recalc();
        });

        function flash(text, ok) {
          msgEl.textContent = text;
          msgEl.className = `text-xs ${ok ? "text-emerald-300" : "text-red-300"} block`;
          setTimeout(() => msgEl.classList.add("hidden"), 3000);
        }

        document.getElementById("saveRewardsBtn").addEventListener("click", async (e) => {
          const btn = e.currentTarget;
          btn.disabled = true;
          try {
            const rows = rowsToObjects();
            if (!rows.length) { flash("⚠️ Need at least one reward.", false); return; }
            if (rows.every(r => !r.active)) { flash("⚠️ At least one reward must be active.", false); return; }
            const r = await fetch("/api/admin/scratch-rewards", {
              method: "POST", headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "save", rows }),
            });
            const j = await r.json();
            if (!r.ok) throw new Error(j.error || "save_failed");
            flash("✓ Saved (" + j.count + " rewards)", true);
            setTimeout(() => location.reload(), 700);
          } catch (err) {
            flash("⚠️ " + (err.message || "failed"), false);
          } finally {
            btn.disabled = false;
          }
        });

        recalc();
      })();

      // ── Earn-list editor ──────────────────────────────────────────────
      (function () {
        const list = document.getElementById("earnList");
        const msg  = document.getElementById("earnMsg");
        if (!list) return;

        function flash(t, ok) {
          msg.textContent = t;
          msg.className = `text-xs block ${ok ? "text-emerald-300" : "text-red-300"}`;
          setTimeout(() => msg.classList.add("hidden"), 2500);
        }

        function rowTpl(it) {
          const div = document.createElement("div");
          div.className = "earn-row flex items-center gap-2 rounded-xl border border-white/10 bg-black/20 px-3 py-2";
          div.innerHTML = `
            <button type="button" class="earn-up text-white/40 hover:text-white text-xs">↑</button>
            <button type="button" class="earn-down text-white/40 hover:text-white text-xs">↓</button>
            <input type="text" data-field="emoji"   value="${(it.emoji   ?? "🎁").replace(/"/g,"&quot;")}"   class="w-12 text-center rounded bg-white/5 border border-white/10 px-1 py-1 text-lg" />
            <input type="text" data-field="text_en" value="${(it.text_en ?? "").replace(/"/g,"&quot;")}" placeholder="English" class="flex-1 rounded bg-white/5 border border-white/10 px-2 py-1.5 text-xs" />
            <input type="text" data-field="text_el" value="${(it.text_el ?? "").replace(/"/g,"&quot;")}" placeholder="Ελληνικά" class="flex-1 rounded bg-white/5 border border-white/10 px-2 py-1.5 text-xs" />
            <label class="inline-flex items-center gap-1 text-[10px] text-white/60"><input type="checkbox" data-field="active" ${it.active === false ? "" : "checked"} class="h-3.5 w-3.5 accent-emerald-400" />on</label>
            <button type="button" class="earn-del text-white/40 hover:text-red-300">🗑</button>`;
          bind(div);
          return div;
        }
        function bind(row) {
          row.querySelector(".earn-up").addEventListener("click", () => {
            const prev = row.previousElementSibling;
            if (prev) list.insertBefore(row, prev);
          });
          row.querySelector(".earn-down").addEventListener("click", () => {
            const next = row.nextElementSibling;
            if (next) list.insertBefore(next, row);
          });
          row.querySelector(".earn-del").addEventListener("click", () => {
            if (confirm("Delete this item?")) row.remove();
          });
        }
        list.querySelectorAll(".earn-row").forEach(bind);

        document.getElementById("addEarnBtn").addEventListener("click", () => {
          list.appendChild(rowTpl({ emoji: "🎁", text_en: "New way to earn", text_el: "Νέος τρόπος", active: true }));
        });

        document.getElementById("saveEarnBtn").addEventListener("click", async (e) => {
          const btn = e.currentTarget;
          btn.disabled = true;
          try {
            const rows = Array.from(list.querySelectorAll(".earn-row")).map(row => ({
              emoji:   row.querySelector('[data-field="emoji"]').value.trim(),
              text_en: row.querySelector('[data-field="text_en"]').value,
              text_el: row.querySelector('[data-field="text_el"]').value,
              active:  row.querySelector('[data-field="active"]').checked,
            }));
            const r = await fetch("/api/admin/scratch-earn", {
              method: "POST", headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ rows }),
            });
            const j = await r.json();
            if (!r.ok) throw new Error(j.error || "save failed");
            flash(`✓ Saved (${j.count})`, true);
          } catch (err) {
            flash("⚠️ " + (err.message || "failed"), false);
          } finally {
            btn.disabled = false;
          }
        });
      })();

      (function () {
        const isEl = document.documentElement.lang === "el";

        async function issueCards(payload, btn, msgEl) {
          btn.disabled = true;
          const orig = btn.textContent;
          btn.textContent = "⏳";
          msgEl.className = "text-xs hidden";
          const res = await fetch("/api/admin/scratch-issue", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const j = await res.json();
          btn.disabled = false;
          btn.textContent = orig;
          if (res.ok) {
            msgEl.textContent = (isEl ? "✓ Εκδόθηκαν: " : "✓ Issued: ") + j.issued;
            msgEl.className = "text-xs text-emerald-400 block mt-2";
            setTimeout(() => window.location.reload(), 1000);
          } else {
            msgEl.textContent = (isEl ? "Σφάλμα: " : "Error: ") + (j.error ?? "unknown");
            msgEl.className = "text-xs text-red-400 block mt-2";
          }
        }

        document.getElementById("bulkIssueBtn").addEventListener("click", () => {
          const exp = document.getElementById("bulkExpires").value;
          if (!confirm(isEl ? "Σίγουρα; Θα σταλεί κάρτα σε όλα τα μέλη." : "Are you sure? A card will be sent to every member.")) return;
          issueCards({ mode: "all-members", trigger: "admin-bulk", expires_at: exp || null }, document.getElementById("bulkIssueBtn"), document.getElementById("bulkMsg"));
        });

        document.getElementById("singleIssueBtn").addEventListener("click", () => {
          const user_id = document.getElementById("singleUser").value;
          if (!user_id) { alert(isEl ? "Διάλεξε μέλος" : "Pick a member"); return; }
          const exp = document.getElementById("singleExpires").value;
          issueCards({ mode: "single", user_id, trigger: "admin", expires_at: exp || null }, document.getElementById("singleIssueBtn"), document.getElementById("singleMsg"));
        });

        async function rowAction(row, action) {
          const id = row.dataset.id;
          const res = await fetch("/api/admin/scratch-claim", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, action }),
          });
          if (res.ok) window.location.reload();
          else alert(isEl ? "Σφάλμα" : "Error");
        }
        document.querySelectorAll(".claim-btn").forEach(b => b.addEventListener("click", () => rowAction(b.closest(".scratch-row"), "claim")));
        document.querySelectorAll(".unclaim-btn").forEach(b => b.addEventListener("click", () => rowAction(b.closest(".scratch-row"), "unclaim")));
        document.querySelectorAll(".void-btn").forEach(b => b.addEventListener("click", () => {
          if (!confirm(isEl ? "Διαγραφή κάρτας;" : "Void this card?")) return;
          rowAction(b.closest(".scratch-row"), "void");
        }));

        document.getElementById("saveSettingsBtn").addEventListener("click", async () => {
          const payload = {
            auto_on_order:    document.getElementById("sOrder").checked,
            order_min_cents:  Math.round(Number(document.getElementById("sOrderMin").value) * 100),
            cards_per_order:  Number(document.getElementById("sOrderCards").value) || 1,
            auto_on_rsvp:     document.getElementById("sRsvp").checked,
            auto_on_checkin:  document.getElementById("sCheckin").checked,
            auto_on_referral: document.getElementById("sReferral").checked,
            auto_on_signup:   document.getElementById("sSignup").checked,
            daily_drop_enabled: document.getElementById("sDaily").checked,
            daily_drop_hour:  Number(document.getElementById("sDailyHour").value) || 21,
            birthday_enabled: document.getElementById("sBirthday").checked,
            default_expires_hours: document.getElementById("sExpiresHours").value || null,
          };
          const msg = document.getElementById("settingsMsg");
          msg.className = "text-xs hidden";
          const r = await fetch("/api/admin/scratch-settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
          if (r.ok) { msg.textContent = isEl ? "✓ Αποθηκεύτηκε" : "✓ Saved"; msg.className = "text-xs text-emerald-400 block"; }
          else { const j = await r.json().catch(() => ({})); msg.textContent = (isEl ? "Σφάλμα: " : "Error: ") + (j.error ?? "unknown"); msg.className = "text-xs text-red-400 block"; }
        });

        async function runDrop(path, btn) {
          const orig = btn.textContent; btn.disabled = true; btn.textContent = "⏳";
          const r = await fetch(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
          const j = await r.json();
          btn.disabled = false; btn.textContent = orig;
          if (r.ok) alert((isEl ? "✓ Εκδόθηκαν: " : "✓ Issued: ") + j.issued + (j.reason ? ` (${j.reason})` : ""));
          else alert((isEl ? "Σφάλμα: " : "Error: ") + (j.error ?? "unknown"));
          if (r.ok && j.issued > 0) window.location.reload();
        }
        document.getElementById("runDailyBtn").addEventListener("click", () => runDrop("/api/admin/scratch-daily-drop", document.getElementById("runDailyBtn")));
        document.getElementById("runBirthdayBtn").addEventListener("click", () => runDrop("/api/admin/scratch-birthday", document.getElementById("runBirthdayBtn")));

        document.getElementById("filterUnclaimed").addEventListener("change", (e) => {
          const on = e.target.checked;
          document.querySelectorAll(".scratch-row").forEach(r => {
            const show = !on || (r.dataset.status === "revealed" && r.dataset.type !== "points");
            r.style.display = show ? "" : "none";
          });
        });
      })();
    </script>
  </body>
</html>
