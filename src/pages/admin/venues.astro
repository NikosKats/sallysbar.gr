---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import AdminNav from "../../components/AdminNav.astro";
import { supabaseAdmin } from "../../lib/supabase";

if (Astro.locals.role !== "super_admin") {
  return new Response("Forbidden", { status: 403 });
}

const { data: venues } = await supabaseAdmin
  .from("saas_venues")
  .select("*")
  .order("created_at", { ascending: false });

const list = (venues ?? []) as any[];

const total        = list.length;
const live         = list.filter(v => v.status === "live").length;
const onboarding   = list.filter(v => v.status === "onboarding").length;
const mrr          = list.filter(v => v.status === "live").reduce((s, v) => s + (v.recurring_eur ?? 0), 0);

const statusColors: Record<string, string> = {
  prospect:   "bg-white/10 text-white/70 border-white/15",
  onboarding: "bg-amber-400/15 text-amber-200 border-amber-400/30",
  live:       "bg-emerald-400/15 text-emerald-200 border-emerald-400/30",
  paused:     "bg-sky-400/15 text-sky-200 border-sky-400/30",
  churned:    "bg-red-400/15 text-red-200 border-red-400/30",
};

function healthState(v: any) {
  if (v.last_health_ok === null || v.last_health_ok === undefined) return { color: "bg-white/20", label: "—" };
  if (v.last_health_ok === true) return { color: "bg-emerald-400", label: "live" };
  return { color: "bg-red-400", label: "down" };
}

function timeAgo(iso: string | null) {
  if (!iso) return "—";
  const d = Date.now() - new Date(iso).getTime();
  const m = Math.floor(d / 60_000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.floor(h / 24)}d ago`;
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>My Venues — Super Admin</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased">
    <Header />
    <div class="h-20"></div>
    <AdminNav active="venues" />

    <main class="mx-auto max-w-6xl px-5 py-10">
      <div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-rose-300 mb-2 flex items-center gap-2">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-rose-400 animate-pulse"></span>
            SUPER ADMIN ONLY
          </p>
          <h1 class="font-heading text-4xl font-bold">🏢 My Venues</h1>
          <p class="mt-2 text-sm text-white/60 max-w-2xl">Every SaaS customer you're running, with direct launch links into their admin panels, Supabase, Cloudflare, and Facebook dashboards.</p>
        </div>
        <div class="flex gap-2">
          <button id="healthBtn" class="rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-4 py-2 text-xs font-semibold">🔄 Ping all</button>
          <a href="/admin/onboarding" class="rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black px-4 py-2 text-xs font-bold hover:scale-[1.01] transition">+ Onboard new venue</a>
        </div>
      </div>

      <!-- KPI row -->
      <section class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <p class="text-[10px] uppercase tracking-wider text-white/50 font-bold">Total venues</p>
          <p class="font-heading text-3xl font-bold mt-1">{total}</p>
        </div>
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.06] p-4">
          <p class="text-[10px] uppercase tracking-wider text-emerald-300 font-bold">Live</p>
          <p class="font-heading text-3xl font-bold mt-1">{live}</p>
        </div>
        <div class="rounded-2xl border border-amber-400/20 bg-amber-400/[0.06] p-4">
          <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold">Onboarding</p>
          <p class="font-heading text-3xl font-bold mt-1">{onboarding}</p>
        </div>
        <div class="rounded-2xl border border-fuchsia-400/20 bg-fuchsia-400/[0.06] p-4">
          <p class="text-[10px] uppercase tracking-wider text-fuchsia-300 font-bold">Annual revenue</p>
          <p class="font-heading text-3xl font-bold mt-1">€{mrr.toLocaleString("en-GB")}</p>
        </div>
      </section>

      <!-- Venue cards -->
      {list.length === 0 ? (
        <section class="rounded-2xl border border-white/10 bg-white/[0.03] p-10 text-center">
          <p class="text-white/40 text-sm">No venues yet.</p>
          <a href="/admin/onboarding" class="mt-4 inline-block rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 text-black px-5 py-2.5 text-sm font-bold">🏁 Onboard your first venue →</a>
        </section>
      ) : (
        <section class="grid gap-4">
          {list.map(v => {
            const h = healthState(v);
            const domainUrl = v.domain ? `https://${v.domain}` : (v.cloudflare_pages_url ?? null);
            const adminUrl  = domainUrl ? `${domainUrl}/admin` : null;
            const staffUrl  = domainUrl ? `${domainUrl}/staff` : null;
            const tableUrl  = domainUrl ? `${domainUrl}/table/1` : null;
            return (
              <article class="rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur p-5">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                  <div class="flex items-start gap-3 min-w-0">
                    <div class={`shrink-0 h-3 w-3 rounded-full mt-1.5 ${h.color}`} title={h.label}></div>
                    <div class="min-w-0">
                      <div class="flex items-center gap-2 flex-wrap">
                        <h3 class="font-heading text-xl font-bold">{v.display_name}</h3>
                        <code class="text-xs text-white/40 font-mono">{v.slug}</code>
                        <span class={`inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full border ${statusColors[v.status] ?? statusColors.prospect}`}>{v.status}</span>
                        <span class="text-[10px] text-white/40 font-mono capitalize">{v.tier}</span>
                      </div>
                      {v.domain && <a href={`https://${v.domain}`} target="_blank" class="text-sm text-sky-300/80 hover:text-sky-200">{v.domain} ↗</a>}
                      <p class="text-[11px] text-white/45 mt-1">
                        {v.contact_name && <>{v.contact_name} · </>}
                        {v.contact_email && <a href={`mailto:${v.contact_email}`} class="hover:text-amber-200">{v.contact_email}</a>}
                        {v.season_start && v.season_end && <span> · season {v.season_start.slice(5)} → {v.season_end.slice(5)}</span>}
                        {v.recurring_eur && <span> · €{v.recurring_eur.toLocaleString("en-GB")}/yr</span>}
                      </p>
                    </div>
                  </div>
                  <div class="text-right text-[11px] text-white/40 shrink-0">
                    <p>checked {timeAgo(v.last_health_check)}</p>
                    {v.last_deploy_version && <p class="font-mono">{v.last_deploy_version}</p>}
                  </div>
                </div>

                <!-- Launch strip -->
                <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
                  {adminUrl && (
                    <a href={adminUrl} target="_blank" class="group flex items-center justify-center gap-1.5 rounded-xl bg-amber-400/10 border border-amber-400/20 hover:bg-amber-400/20 px-3 py-2.5 text-xs font-semibold text-amber-200 transition">
                      🛠 Admin
                    </a>
                  )}
                  {staffUrl && (
                    <a href={staffUrl} target="_blank" class="group flex items-center justify-center gap-1.5 rounded-xl bg-sky-400/10 border border-sky-400/20 hover:bg-sky-400/20 px-3 py-2.5 text-xs font-semibold text-sky-200 transition">
                      🧑‍🍳 Staff
                    </a>
                  )}
                  {tableUrl && (
                    <a href={tableUrl} target="_blank" class="group flex items-center justify-center gap-1.5 rounded-xl bg-fuchsia-400/10 border border-fuchsia-400/20 hover:bg-fuchsia-400/20 px-3 py-2.5 text-xs font-semibold text-fuchsia-200 transition">
                      📜 /table/1
                    </a>
                  )}
                  {v.supabase_dashboard && (
                    <a href={v.supabase_dashboard} target="_blank" class="group flex items-center justify-center gap-1.5 rounded-xl bg-emerald-400/10 border border-emerald-400/20 hover:bg-emerald-400/20 px-3 py-2.5 text-xs font-semibold text-emerald-200 transition">
                      ⚡ Supabase
                    </a>
                  )}
                  {v.cloudflare_dashboard && (
                    <a href={v.cloudflare_dashboard} target="_blank" class="group flex items-center justify-center gap-1.5 rounded-xl bg-orange-400/10 border border-orange-400/20 hover:bg-orange-400/20 px-3 py-2.5 text-xs font-semibold text-orange-200 transition">
                      ☁️ Cloudflare
                    </a>
                  )}
                  {v.fb_dashboard && (
                    <a href={v.fb_dashboard} target="_blank" class="group flex items-center justify-center gap-1.5 rounded-xl bg-blue-500/10 border border-blue-400/20 hover:bg-blue-400/20 px-3 py-2.5 text-xs font-semibold text-blue-200 transition">
                      📘 FB App
                    </a>
                  )}
                  {v.github_repo && (
                    <a href={v.github_repo} target="_blank" class="group flex items-center justify-center gap-1.5 rounded-xl bg-white/5 border border-white/15 hover:bg-white/10 px-3 py-2.5 text-xs font-semibold text-white/80 transition">
                      🐙 GitHub
                    </a>
                  )}
                  <button class="edit-venue group flex items-center justify-center gap-1.5 rounded-xl bg-white/5 border border-white/15 hover:bg-white/10 px-3 py-2.5 text-xs font-semibold text-white/80 transition"
                    data-venue={JSON.stringify(v)}>
                    ✎ Edit
                  </button>
                </div>

                {/* Details: IDs + refs */}
                {(v.supabase_url || v.fb_app_id || v.admin_bootstrap_email || v.notes) && (
                  <details class="mt-3 text-xs text-white/55">
                    <summary class="cursor-pointer hover:text-white/80 transition">More details</summary>
                    <div class="mt-2 space-y-1.5 font-mono text-[11px]">
                      {v.supabase_url &&       <div><span class="text-white/35">supabase_url:</span> {v.supabase_url}</div>}
                      {v.supabase_ref &&       <div><span class="text-white/35">supabase_ref:</span> {v.supabase_ref}</div>}
                      {v.pages_project &&      <div><span class="text-white/35">pages_project:</span> {v.pages_project}</div>}
                      {v.cloudflare_pages_url &&<div><span class="text-white/35">pages_url:</span> {v.cloudflare_pages_url}</div>}
                      {v.fb_app_id &&          <div><span class="text-white/35">fb_app_id:</span> {v.fb_app_id}</div>}
                      {v.admin_bootstrap_email && <div><span class="text-white/35">admin_email:</span> {v.admin_bootstrap_email}</div>}
                      {v.billing_model &&      <div><span class="text-white/35">billing:</span> {v.billing_model}</div>}
                    </div>
                    {v.notes && <p class="mt-2 text-white/70 not-italic font-sans whitespace-pre-wrap">{v.notes}</p>}
                  </details>
                )}
              </article>
            );
          })}
        </section>
      )}

      <!-- Security note -->
      <section class="mt-8 rounded-2xl border border-red-400/20 bg-red-400/[0.04] p-5">
        <p class="text-[10px] uppercase tracking-wider text-red-300 font-bold mb-2">🔐 Security note</p>
        <p class="text-xs text-white/70 leading-relaxed">
          This page stores <strong>URLs and IDs only</strong> — never service role keys, VAPID private keys, FB secrets, or Telegram bot tokens. Those live in Cloudflare secrets (<code>wrangler pages secret put</code>) and your password manager. The "SSO" buttons open each venue's own admin panel, which you log into with your own account there (create one when you onboard).
        </p>
      </section>
    </main>

    <!-- Edit modal -->
    <dialog id="editModal" class="rounded-2xl bg-[#16161f] border border-white/15 p-0 backdrop:bg-black/70" style="max-width:700px;width:95vw;">
      <form method="dialog" id="editForm" class="p-6 space-y-3 text-sm text-white">
        <div class="flex items-center justify-between mb-2">
          <h3 class="font-heading text-xl font-bold">Edit venue</h3>
          <button type="button" id="closeEdit" class="text-white/50 hover:text-white text-2xl leading-none">×</button>
        </div>
        <input type="hidden" name="slug" />
        <div class="grid sm:grid-cols-2 gap-3">
          <label class="block"><span class="text-xs text-white/60">Display name</span><input name="display_name" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2" /></label>
          <label class="block"><span class="text-xs text-white/60">Domain</span><input name="domain" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2" /></label>
          <label class="block"><span class="text-xs text-white/60">Status</span>
            <select name="status" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2">
              <option value="prospect">Prospect</option><option value="onboarding">Onboarding</option><option value="live">Live</option><option value="paused">Paused</option><option value="churned">Churned</option>
            </select>
          </label>
          <label class="block"><span class="text-xs text-white/60">Tier</span>
            <select name="tier" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2">
              <option value="starter">Starter</option><option value="pro">Pro</option><option value="signature">Signature</option>
            </select>
          </label>
          <label class="block"><span class="text-xs text-white/60">Contact name</span><input name="contact_name" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2" /></label>
          <label class="block"><span class="text-xs text-white/60">Contact email</span><input name="contact_email" type="email" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2" /></label>
          <label class="block"><span class="text-xs text-white/60">Season start</span><input name="season_start" type="date" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 [color-scheme:dark]" /></label>
          <label class="block"><span class="text-xs text-white/60">Season end</span><input name="season_end" type="date" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 [color-scheme:dark]" /></label>
          <label class="block"><span class="text-xs text-white/60">Supabase ref</span><input name="supabase_ref" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" /></label>
          <label class="block"><span class="text-xs text-white/60">Supabase URL</span><input name="supabase_url" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" placeholder="https://ref.supabase.co" /></label>
          <label class="block"><span class="text-xs text-white/60">Supabase dashboard</span><input name="supabase_dashboard" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" placeholder="https://supabase.com/dashboard/project/ref" /></label>
          <label class="block"><span class="text-xs text-white/60">Cloudflare Pages project</span><input name="pages_project" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" /></label>
          <label class="block"><span class="text-xs text-white/60">Cloudflare Pages URL</span><input name="cloudflare_pages_url" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" placeholder="https://proj.pages.dev" /></label>
          <label class="block"><span class="text-xs text-white/60">Cloudflare dashboard</span><input name="cloudflare_dashboard" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" placeholder="https://dash.cloudflare.com/.../pages/view/proj" /></label>
          <label class="block"><span class="text-xs text-white/60">FB App ID</span><input name="fb_app_id" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" /></label>
          <label class="block"><span class="text-xs text-white/60">FB Dashboard</span><input name="fb_dashboard" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" placeholder="https://developers.facebook.com/apps/ID/" /></label>
          <label class="block"><span class="text-xs text-white/60">GitHub repo</span><input name="github_repo" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2 font-mono" /></label>
          <label class="block"><span class="text-xs text-white/60">Admin bootstrap email</span><input name="admin_bootstrap_email" type="email" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2" /></label>
        </div>
        <label class="block"><span class="text-xs text-white/60">Notes</span><textarea name="notes" rows="3" class="mt-1 w-full rounded-lg bg-white/5 border border-white/15 px-3 py-2"></textarea></label>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" id="cancelEdit" class="rounded-lg bg-white/10 hover:bg-white/15 px-4 py-2 text-sm">Cancel</button>
          <button type="button" id="saveEdit" class="rounded-lg bg-gradient-to-br from-amber-300 to-amber-500 text-black px-4 py-2 text-sm font-bold">💾 Save</button>
        </div>
      </form>
    </dialog>

    <script is:inline>
      const modal = document.getElementById("editModal");
      const form = document.getElementById("editForm");

      function openEdit(v) {
        for (const el of form.elements) {
          if (el.name && v[el.name] !== undefined && v[el.name] !== null) el.value = v[el.name];
          else if (el.name) el.value = "";
        }
        form.elements["slug"].value = v.slug;
        modal.showModal();
      }

      document.querySelectorAll(".edit-venue").forEach(b => {
        b.addEventListener("click", () => {
          try { openEdit(JSON.parse(b.getAttribute("data-venue"))); } catch {}
        });
      });
      document.getElementById("closeEdit").addEventListener("click", () => modal.close());
      document.getElementById("cancelEdit").addEventListener("click", () => modal.close());

      document.getElementById("saveEdit").addEventListener("click", async () => {
        const fd = new FormData(form);
        const payload = {};
        for (const [k, v] of fd.entries()) payload[k] = String(v);
        const r = await fetch("/api/venues/save", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        if (r.ok) location.reload();
        else alert("Save failed");
      });

      document.getElementById("healthBtn").addEventListener("click", async (e) => {
        const btn = e.currentTarget;
        btn.disabled = true; btn.textContent = "⏳ pinging…";
        try {
          const r = await fetch("/api/venues/health", { method: "POST" });
          if (r.ok) location.reload();
          else alert("Health ping failed");
        } catch { alert("Health ping failed"); }
        btn.disabled = false;
      });
    </script>
  </body>
</html>
