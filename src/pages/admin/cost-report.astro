  { icon: "🎯", title: "CRM Campaigns & messaging", items: [
    { name: "Bulk campaign composer", desc: "/admin/campaigns: pick channel, filter audience (7 filters), preview recipients + live cost, AI-generate copy, Test-to-me, SEND NOW with confirm.", aud: "A", hours: 42, rate: 95 },
    { name: "Pasted-list audience source", desc: "Paste phones or emails (newline/comma/tab) for ad-hoc blasts; live valid/invalid/dupe counter; auto-skips opted-out profiles.", aud: "A", hours: 14, rate: 95 },
    { name: "AI message generator", desc: "Channel-aware copy writer with length caps for SMS/WA/email.", aud: "A", hours: 12, rate: 120 },
    { name: "Cost breakdown + printable invoice", desc: "Wholesale × channel × commission × VAT with A4 invoice export for clients.", aud: "A", hours: 22, rate: 75 },
    { name: "URL shortener sallysbar.gr/s/xxxxx", desc: "5-char base36 slugs; idempotent reuse; click tracking; auto-shorten toggle with ↶ Restore original.", aud: "A", hours: 22, rate: 95 },
  ]},
  { icon: "📬", title: "Inbox, delivery & voice", items: [
    { name: "Unified /admin/inbox dashboard", desc: "Inbound messages (all channels), delivery receipts, voice calls — three tables with filters + delete-all.", aud: "A", hours: 20, rate: 75 },
    { name: "Inline reply from dashboard", desc: "Reply to any inbound message without leaving the inbox (routes back through the same channel).", aud: "A", hours: 10, rate: 95 },
    { name: "Auto-STOP unsubscribe handling", desc: "Reply 'stop' / 'παυση' / 'unsubscribe' → flips marketing_consent off automatically.", aud: "A", hours: 4, rate: 95 },
    { name: "Voice call recording + playback", desc: "Inbound calls record to MP3; inline playback via JWT-signed admin proxy (RS256 via Web Crypto).", aud: "A", hours: 30, rate: 120 },
    { name: "Vonage webhooks (inbound/status/voice)", desc: "Bulletproof webhook endpoints: JSON + form + GET; auto-match profile; meta-merge delivery status into marketing_log.", aud: "A", hours: 34, rate: 95 },
  ]},
  { icon: "🔗", title: "Social linking (Messenger / Instagram)", items: [
    { name: "Meta webhook + linking flow", desc: "User taps Connect → messages your Page → webhook captures messenger_id / instagram_id with HMAC verification.", aud: "C", hours: 24, rate: 120 },
    { name: "+20 loyalty points booster", desc: "Idempotent one-time reward per platform, awarded on first link event.", aud: "C", hours: 4, rate: 75 },
    { name: "m.me CTA in reservation reminder", desc: "2h reminder appends a Messenger link if the user hasn't linked yet.", aud: "C", hours: 6, rate: 95 },
    { name: "Profile completion bar", desc: "/account shows 0–100% progress with per-field chips (+20 badge on social slots).", aud: "C", hours: 8, rate: 75 },
    { name: "/admin/social-links diagnostics", desc: "Lists linked users + raw webhook events for debugging.", aud: "A", hours: 8, rate: 75 },
  ]},
  { icon: "🚀", title: "PistotitaOS — SaaS sales kit", items: [
    { name: "Public sales page /pistotita-os", desc: "Hero + 4 modules + features + bilingual pricing (seasonal €690 / year-round €1,104 + €850 setup) + territorial exclusivity + FAQ.", aud: "A", hours: 32, rate: 75 },
    { name: "Competitor comparison matrix", desc: "/pistotita-os/compare: Toast, Loyverse, Fivestars, e-Food, DIY side-by-side.", aud: "A", hours: 8, rate: 75 },
    { name: "Sales dashboard /admin/pistotita-os", desc: "Leads pipeline, WhatsApp/call scripts, territory rules, pricing cheat sheet.", aud: "A", hours: 14, rate: 75 },
    { name: "Pricing-justification PDF", desc: "Printable leave-behind with cost-vs-agency, ROI table, per-day math, closing question.", aud: "A", hours: 12, rate: 75 },
    { name: "Financial model + break-even", desc: "14-section Y1 cash flow, scenarios, sensitivity, levers (super-admin).", aud: "A", hours: 20, rate: 120 },
  ]},
  { icon: "⚙️", title: "Platform, security & SaaS", items: [
    { name: "Astro 5 SSR on Cloudflare Workers", desc: "Edge rendering, low cold-start, R2/KV integration.", aud: "A", hours: 24, rate: 95 },
    { name: "Supabase Postgres + RLS", desc: "Strict row-level security on every table; service role only in backend.", aud: "A", hours: 36, rate: 95 },
    { name: "Auth: email, phone OTP, Google", desc: "Multi-provider via Supabase; middleware role guard.", aud: "C", hours: 28, rate: 95 },
    { name: "super_admin role + 15 API guards", desc: "Dedicated nav group; middleware + per-endpoint checks.", aud: "A", hours: 12, rate: 95 },
    { name: "PWA (install, offline shell, icons)", desc: "Customer + admin + staff manifests; iOS 16.4+ push.", aud: "C", hours: 20, rate: 95 },
    { name: "Sitemap + SEO", desc: "Dynamic sitemap, OG images, JSON-LD, robots.", aud: "A", hours: 14, rate: 75 },
    { name: "Address autocomplete (Photon)", desc: "Free OSM geocoding; no Google Maps bill.", aud: "C", hours: 10, rate: 75 },
    { name: "SaaS tooling: venues, onboarding", desc: "Multi-tenant scripts + venue tracker + health ping.", aud: "A", hours: 22, rate: 95 },
    { name: "Cloudflare cron triggers", desc: "Scheduled jobs: reminders, birthdays, re-engagement.", aud: "A", hours: 8, rate: 95 },
  ]},
];

const audLabel = (a: "C" | "S" | "A") => a === "C" ? "Customer" : a === "S" ? "Staff" : "Admin";
const audColor = (a: "C" | "S" | "A") => a === "C" ? "text-sky-300 border-sky-400/30 bg-sky-400/10"
  : a === "S" ? "text-fuchsia-300 border-fuchsia-400/30 bg-fuchsia-400/10"
  : "text-amber-300 border-amber-400/30 bg-amber-400/10";

const groupCost = (g: FeatureGroup) => g.items.reduce((s, f) => s + f.hours * f.rate, 0);
const groupHours = (g: FeatureGroup) => g.items.reduce((s, f) => s + f.hours, 0);
const featuresTotalCost = features.reduce((s, g) => s + groupCost(g), 0);
const featuresTotalHours = features.reduce((s, g) => s + groupHours(g), 0);

const scenarios = [
  { label: "Mid-tier Athens agency (fixed-price)",          range: "€140k–€170k", note: "net, ex VAT" },
  { label: "Premium Athens agency (4-person squad)",         range: "€200k–€260k", note: "design-heavy" },
  { label: "EU offshore (Poland, Portugal, Romania)",        range: "€85k–€120k",  note: "" },
  { label: "Bulgaria / Serbia / North Macedonia",            range: "€55k–€85k",   note: "" },
  { label: "Solo senior freelancer (6–12 months)",           range: "€55k–€95k",   note: "no PM overhead" },
  { label: "Western Europe (Germany, Netherlands)",           range: "€220k–€380k", note: "" },
];

const T = {
  title:  isEl ? "Αναφορά Κόστους (EU Agency)" : "Cost Report (EU Agency)",
  kicker: "SUPER ADMIN ONLY",
  sub:    isEl
    ? "Αναλυτική εκτίμηση κόστους ανά feature, με ρυθμούς EU/ΕΛ agency. Χρησιμοποίησέ τη για pitch, grants, προτάσεις επενδυτών."
    : "Feature-by-feature cost breakdown at EU/Greek agency rates. Use this for pitches, grants, investor decks.",
  rates: isEl ? "Ρυθμοί χρέωσης" : "Billing rates",
  junior: isEl ? "Junior" : "Junior", mid: "Mid", senior: "Senior", lead: isEl ? "Lead / Architect" : "Lead / Architect",
  hours: isEl ? "Ώρες" : "Hours",
  rate:  isEl ? "Ρυθμός" : "Rate",
  cost:  isEl ? "Κόστος" : "Cost",
  item:  isEl ? "Feature" : "Feature",
  totals: isEl ? "Σύνολο" : "Totals",
  net:   isEl ? "Καθαρό" : "Net",
  overhead: isEl ? "+ 25% overhead" : "+ 25% overhead",
  vat:   isEl ? "+ 24% ΦΠΑ" : "+ 24% VAT",
  scenarios: isEl ? "Εύρος αγοράς" : "Market ranges",
  notIncluded: isEl ? "Δεν περιλαμβάνονται" : "Not included",
  extras: isEl ? [
    "Περιεχόμενο (φωτογραφία, copywriting, branding): +€5k–€15k",
    "Νομικά (GDPR, privacy counsel): +€2k–€5k",
    "Hardware (NFC, thermal printer, staff phones): +€1k–€4k",
    "Λειτουργικά κόστη: ~€75/μήνα",
    "Υποστήριξη μετά το launch: €1.5k–€3.5k/μήνα retainer",
  ] : [
    "Content (photography, copywriting, branding): +€5k–€15k",
    "Legal (GDPR, privacy counsel): +€2k–€5k",
    "Hardware (NFC, thermal printer, staff phones): +€1k–€4k",
    "Recurring run cost: ~€75/month",
    "Post-launch support: €1.5k–€3.5k/mo retainer",
  ],
};
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{T.title} — Super Admin</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      @media print {
        @page { size: A4; margin: 12mm; }
        .no-print { display: none !important; }
        body { background: white !important; color: black !important; }
        details { break-inside: avoid; page-break-inside: avoid; }
        details > summary > span, details h2, details h3 { color: black !important; }
        table, th, td { color: black !important; border-color: #ccc !important; }
        .tier-card { background: white !important; border: 1px solid #ddd !important; }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased">
    <div class="no-print"><Header /></div>
    <div class="h-20 no-print"></div>
    <div class="no-print"><AdminNav active="cost-report" /></div>

    <main class="mx-auto max-w-5xl px-5 py-10">
      <div class="mb-8 flex items-start justify-between gap-4 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-rose-300 mb-2 flex items-center gap-2">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-rose-400 animate-pulse"></span>
            {T.kicker}
          </p>
          <h1 class="font-heading text-4xl font-bold">💶 {T.title}</h1>
          <p class="mt-2 text-sm text-white/60 max-w-2xl">{T.sub}</p>
        </div>
        <button onclick="window.print()" class="no-print shrink-0 rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 px-4 py-2 text-xs font-semibold">🖨 {isEl ? "Εκτύπωση / PDF" : "Print / Save PDF"}</button>
      </div>

      <!-- Billing rates -->
      <section class="mb-8 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">⚙️ {T.rates}</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
          <div><span class="text-white/50">{T.junior}</span> <span class="font-mono font-semibold">€55/h</span></div>
          <div><span class="text-white/50">{T.mid}</span> <span class="font-mono font-semibold">€75/h</span></div>
          <div><span class="text-white/50">{T.senior}</span> <span class="font-mono font-semibold">€95/h</span></div>
          <div><span class="text-white/50">{T.lead}</span> <span class="font-mono font-semibold">€120/h</span></div>
        </div>
      </section>

      <!-- Grand totals (hero) -->
      <section class="grid md:grid-cols-3 gap-3 mb-8">
        <div class="rounded-2xl border border-amber-400/30 bg-amber-400/[0.07] p-5">
          <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold">{T.net}</p>
          <p class="font-heading text-3xl font-bold mt-2">{eur(totalCost)}</p>
          <p class="text-[11px] text-white/50 mt-1">{totalHours.toLocaleString()} {T.hours}</p>
        </div>
        <div class="rounded-2xl border border-fuchsia-400/30 bg-fuchsia-400/[0.07] p-5">
          <p class="text-[10px] uppercase tracking-wider text-fuchsia-300 font-bold">{T.overhead}</p>
          <p class="font-heading text-3xl font-bold mt-2">{eur(withOverhead)}</p>
          <p class="text-[11px] text-white/50 mt-1">× 1.25 office / tooling / risk</p>
        </div>
        <div class="rounded-2xl border border-sky-400/30 bg-sky-400/[0.07] p-5">
          <p class="text-[10px] uppercase tracking-wider text-sky-300 font-bold">{T.vat}</p>
          <p class="font-heading text-3xl font-bold mt-2">{eur(withVAT)}</p>
          <p class="text-[11px] text-white/50 mt-1">{isEl ? "Μικτό (τελική τιμή)" : "Gross (final price)"}</p>
        </div>
      </section>

      <!-- Tier rollup table -->
      <section class="mb-8 rounded-2xl border border-white/10 bg-white/[0.03] overflow-hidden">
        <div class="px-5 py-4 border-b border-white/10">
          <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold">📊 {T.totals} — {isEl ? "Σύνοψη ανά τομέα" : "Rollup by tier"}</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[10px] uppercase tracking-wider text-white/40 text-left bg-black/20">
              <tr>
                <th class="py-2.5 px-4 font-semibold w-10">#</th>
                <th class="py-2.5 px-4 font-semibold">{isEl ? "Τομέας" : "Tier"}</th>
                <th class="py-2.5 px-4 font-semibold text-right">{T.hours}</th>
                <th class="py-2.5 px-4 font-semibold text-right">{T.cost}</th>
                <th class="py-2.5 px-4 font-semibold text-right">{isEl ? "%" : "%"}</th>
              </tr>
            </thead>
            <tbody>
              {tierTotals.map(t => (
                <tr class="border-t border-white/5 hover:bg-white/[0.02]">
                  <td class="py-2.5 px-4 text-white/50">{t.n}</td>
                  <td class="py-2.5 px-4"><a href={`#tier-${t.n}`} class="hover:text-amber-200 transition">{isEl ? t.titleEl : t.title}</a></td>
                  <td class="py-2.5 px-4 text-right font-mono">{t.hours}</td>
                  <td class="py-2.5 px-4 text-right font-mono font-semibold">{eur(t.cost)}</td>
                  <td class="py-2.5 px-4 text-right font-mono text-white/50">{((t.cost / totalCost) * 100).toFixed(1)}%</td>
                </tr>
              ))}
              <tr class="border-t-2 border-amber-400/40 bg-amber-400/[0.06]">
                <td class="py-3 px-4"></td>
                <td class="py-3 px-4 font-bold text-amber-200">{T.totals}</td>
                <td class="py-3 px-4 text-right font-mono font-bold">{totalHours}</td>
                <td class="py-3 px-4 text-right font-mono font-bold text-amber-200">{eur(totalCost)}</td>
                <td class="py-3 px-4 text-right font-mono">100%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Functionality inventory (what the app does + per-feature cost) -->
      <section class="mb-10">
        <div class="flex items-end justify-between gap-4 flex-wrap mb-4">
          <div>
            <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold">🧭 {isEl ? "Τι κάνει η εφαρμογή (ανά λειτουργία)" : "What the app does (per feature)"}</p>
            <h2 class="font-heading text-2xl font-bold mt-1">{isEl ? "Αναλυτική λίστα λειτουργιών & κόστος" : "Full functionality inventory & per-feature cost"}</h2>
            <p class="text-sm text-white/60 mt-1 max-w-2xl">{isEl
              ? "Κάθε γραμμή είναι μια λειτουργία που βλέπουν πελάτες, staff ή admins. Κόστος = ώρες × ρυθμός χρέωσης EU agency."
              : "Each line is a user-facing capability — customer, staff, or admin. Cost = hours × EU-agency rate."}</p>
          </div>
          <div class="text-right">
            <p class="text-xs text-white/50">{isEl ? "Σύνολο λειτουργιών" : "Feature inventory total"}</p>
            <p class="font-heading text-3xl font-bold text-amber-200">{eur(featuresTotalCost)}</p>
            <p class="text-[11px] text-white/45">{featuresTotalHours.toLocaleString()} {T.hours}</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-4 text-xs">
          <span class="rounded-full border border-sky-400/30 bg-sky-400/10 text-sky-300 px-2.5 py-0.5">🙋 Customer</span>
          <span class="rounded-full border border-fuchsia-400/30 bg-fuchsia-400/10 text-fuchsia-300 px-2.5 py-0.5">🧑‍🍳 Staff</span>
          <span class="rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-300 px-2.5 py-0.5">🛠 Admin</span>
        </div>

        <div class="space-y-4">
          {features.map(g => (
            <details class="feature-card group rounded-2xl border border-white/10 bg-white/[0.03]" open>
              <summary class="cursor-pointer px-5 py-3 flex items-center justify-between gap-4 list-none">
                <div class="min-w-0 flex items-center gap-3">
                  <span class="text-2xl">{g.icon}</span>
                  <h3 class="font-heading text-lg font-bold">{g.title}</h3>
                  <span class="text-xs text-white/40">({g.items.length} features)</span>
                </div>
                <div class="flex items-center gap-4 shrink-0 text-sm">
                  <span class="text-white/50 hidden sm:inline">{groupHours(g).toLocaleString()} h</span>
                  <span class="font-mono font-bold text-amber-200">{eur(groupCost(g))}</span>
                  <span class="text-white/40 group-open:rotate-180 transition-transform">▾</span>
                </div>
              </summary>
              <div class="px-5 pb-4 overflow-x-auto">
                <table class="w-full text-sm">
                  <thead class="text-[11px] uppercase tracking-wider text-white/50">
                    <tr class="border-b border-white/10">
                      <th class="text-left py-2 pr-3">Feature</th>
                      <th class="text-left py-2 px-2">Who</th>
                      <th class="text-right py-2 px-2">Hours</th>
                      <th class="text-right py-2 px-2">Rate</th>
                      <th class="text-right py-2 pl-2">Cost</th>
                    </tr>
                  </thead>
                  <tbody>
                    {g.items.map(f => (
                      <tr class="border-b border-white/5 align-top">
                        <td class="py-2 pr-3">
                          <p class="font-semibold text-white">{f.name}</p>
                          <p class="text-xs text-white/55 mt-0.5">{f.desc}</p>
                        </td>
                        <td class="py-2 px-2 whitespace-nowrap"><span class={`rounded-full border px-2 py-0.5 text-[11px] ${audColor(f.aud)}`}>{audLabel(f.aud)}</span></td>
                        <td class="py-2 px-2 text-right font-mono">{f.hours}</td>
                        <td class="py-2 px-2 text-right font-mono text-white/60">€{f.rate}</td>
                        <td class="py-2 pl-2 text-right font-mono font-bold text-amber-200">{eur(f.hours * f.rate)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- Per-tier detail -->
      <section class="space-y-3 mb-8">
        <div class="flex flex-wrap items-center gap-2 mb-1 print:hidden">
          <button id="js-expand-all" type="button" class="rounded-lg bg-amber-500 hover:bg-amber-400 text-black text-sm font-medium px-3 py-1.5">▾ {isEl ? "Ανάπτυξη όλων" : "Expand all"}</button>
          <button id="js-collapse-all" type="button" class="rounded-lg bg-white/10 hover:bg-white/20 text-white text-sm font-medium px-3 py-1.5">▴ {isEl ? "Σύμπτυξη όλων" : "Collapse all"}</button>
        </div>
        {tiers.map(tier => {
          const sub = tierSum(tier);
          return (
            <details id={`tier-${tier.n}`} class="tier-card group rounded-2xl border border-white/10 bg-white/[0.03]" open={tier.n === 1}>
              <summary class="cursor-pointer px-5 py-4 flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-[10px] uppercase tracking-wider text-white/40 font-bold">Tier {tier.n}</p>
                  <h2 class="font-heading text-lg font-bold">{isEl ? tier.titleEl : tier.title}</h2>
                </div>
                <div class="flex items-center gap-4 shrink-0">
                  <div class="text-right">
                    <p class="text-[10px] uppercase tracking-wider text-white/40">{T.hours}</p>
                    <p class="font-mono font-semibold">{sub.hours}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-[10px] uppercase tracking-wider text-amber-300">{T.cost}</p>
                    <p class="font-mono font-bold text-amber-200">{eur(sub.cost)}</p>
                  </div>
                  <span class="text-white/40 group-open:rotate-180 transition-transform">▾</span>
                </div>
              </summary>
              <div class="px-5 pb-5">
                <div class="overflow-x-auto">
                  <table class="w-full text-sm">
                    <thead class="text-[10px] uppercase tracking-wider text-white/40 text-left">
                      <tr>
                        <th class="py-2 pr-3 font-semibold">{T.item}</th>
                        <th class="py-2 pr-3 font-semibold text-right w-20">{T.hours}</th>
                        <th class="py-2 pr-3 font-semibold text-right w-20">{T.rate}</th>
                        <th class="py-2 font-semibold text-right w-28">{T.cost}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {tier.rows.map(([label, h, r]) => (
                        <tr class="border-t border-white/5">
                          <td class="py-2 pr-3 text-white/85">{label}</td>
                          <td class="py-2 pr-3 text-right font-mono text-white/70">{h}</td>
                          <td class="py-2 pr-3 text-right font-mono text-white/50">€{r}</td>
                          <td class="py-2 text-right font-mono font-semibold">{eur(h * r)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </details>
          );
        })}
      </section>

      <script is:inline>
        document.getElementById("js-expand-all")?.addEventListener("click", () => {
          document.querySelectorAll("details.tier-card, details.feature-card").forEach(d => d.setAttribute("open", ""));
        });
        document.getElementById("js-collapse-all")?.addEventListener("click", () => {
          document.querySelectorAll("details.tier-card, details.feature-card").forEach(d => d.removeAttribute("open"));
        });
      </script>

      <!-- Market scenarios -->
      <section class="mb-8 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold mb-3">🌍 {T.scenarios}</p>
        <div class="grid sm:grid-cols-2 gap-2 text-sm">
          {scenarios.map(s => (
            <div class="flex items-center justify-between gap-3 rounded-xl bg-white/[0.03] border border-white/10 px-4 py-2.5">
              <span class="min-w-0 truncate">
                <span class="text-white/85">{s.label}</span>
                {s.note && <span class="text-[11px] text-white/40"> · {s.note}</span>}
              </span>
              <span class="font-mono font-semibold text-amber-200 shrink-0">{s.range}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Extras -->
      <section class="rounded-2xl border border-red-400/20 bg-red-400/[0.04] p-5">
        <p class="text-[10px] uppercase tracking-wider text-red-300 font-bold mb-3">⚠️ {T.notIncluded}</p>
        <ul class="text-sm text-white/75 space-y-1.5 list-disc pl-5">
          {T.extras.map(e => <li>{e}</li>)}
        </ul>
      </section>
    </main>
  </body>
</html>
