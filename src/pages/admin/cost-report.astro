function tierSum(t: Tier) {
  return t.rows.reduce((acc, [, h, r]) => {
    acc.hours += h;
    acc.cost  += h * r;
    return acc;
  }, { hours: 0, cost: 0 });
}

const tierTotals = tiers.map(t => ({ ...tierSum(t), n: t.n, title: t.title, titleEl: t.titleEl }));
const totalHours = tierTotals.reduce((s, t) => s + t.hours, 0);
const totalCost  = tierTotals.reduce((s, t) => s + t.cost,  0);
const withOverhead = Math.round(totalCost * 1.25);
const withVAT      = Math.round(withOverhead * 1.24);

function eur(n: number) {
  return "€" + Math.round(n).toLocaleString("en-GB");
}

