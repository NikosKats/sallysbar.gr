---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import StaffPwa from "../../components/StaffPwa.astro";
import StaffNav from "../../components/StaffNav.astro";
import { supabaseAdmin, createSupabaseServerClient } from "../../lib/supabase";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect(isEl ? "/el/login?next=/staff/chat" : "/login?next=/staff/chat");
}

const { data: me } = await supabaseAdmin
  .from("profiles").select("role, full_name").eq("id", user.id).maybeSingle();
if (!me || !["employee", "admin", "super_admin"].includes(me.role)) {
  return new Response("Forbidden", { status: 403 });
}

const { data: { session } } = await createSupabaseServerClient(Astro.request, Astro.cookies).auth.getSession();
const realtimeToken = session?.access_token ?? "";

// Mark all current messages as read on page open
await supabaseAdmin.from("team_reads").upsert(
  { user_id: user.id, last_read_at: new Date().toISOString() },
  { onConflict: "user_id" },
);

// Initial batch (last 100)
const { data: rawMsgs } = await supabaseAdmin
  .from("team_messages")
  .select("id, user_id, body, created_at, image_url, edited_at, deleted_at, reply_to, pinned_at, pinned_by")
  .order("created_at", { ascending: false })
  .limit(100);

const authorIds = Array.from(new Set((rawMsgs ?? []).map(m => m.user_id)));
const { data: authorProfs } = authorIds.length
  ? await supabaseAdmin.from("profiles").select("id, full_name, role").in("id", authorIds)
  : { data: [] };
const authors = new Map((authorProfs ?? []).map((p: any) => [p.id, p]));

// Fetch parent summaries for any replies in the initial batch
const parentIds = Array.from(new Set((rawMsgs ?? []).map((m: any) => m.reply_to).filter(Boolean))) as string[];
const { data: parents } = parentIds.length
  ? await supabaseAdmin.from("team_messages").select("id, user_id, body, image_url, deleted_at").in("id", parentIds)
  : { data: [] };
const parentMap = new Map((parents ?? []).map((p: any) => [p.id, p]));

const initial = (rawMsgs ?? []).reverse().map((m: any) => {
  const parent = m.reply_to ? parentMap.get(m.reply_to) : null;
  return {
    id: m.id,
    user_id: m.user_id,
    body: m.body,
    image_url: m.image_url,
    edited_at: m.edited_at,
    deleted_at: m.deleted_at,
    pinned_at: m.pinned_at,
    reply_to: m.reply_to,
    reply_parent: parent ? {
      id: parent.id,
      body: parent.deleted_at ? "(deleted)" : parent.body,
      has_image: !!parent.image_url,
      author_name: (authors.get(parent.user_id) as any)?.full_name ?? "Member",
    } : null,
    created_at: m.created_at,
    author_name: (authors.get(m.user_id) as any)?.full_name ?? "Member",
    author_role: (authors.get(m.user_id) as any)?.role ?? "employee",
  };
});

const initialPinned = initial.filter((m: any) => m.pinned_at && !m.deleted_at);

// Avatar helpers — initials + deterministic gradient from user_id hash
function initials(name: string) {
  const parts = (name || "M").trim().split(/\s+/);
  return ((parts[0]?.[0] ?? "") + (parts[1]?.[0] ?? "")).toUpperCase() || "M";
}
const palettes = [
  "from-rose-400 to-pink-600",
  "from-sky-400 to-blue-600",
  "from-emerald-400 to-teal-600",
  "from-amber-400 to-orange-600",
  "from-fuchsia-400 to-purple-600",
  "from-cyan-400 to-sky-600",
  "from-lime-400 to-green-600",
  "from-violet-400 to-indigo-600",
];
function gradientFor(id: string) {
  let h = 0;
  for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;
  return palettes[h % palettes.length];
}

const t = {
  title:   isEl ? "Ομάδα" : "Team chat",
  sub:     isEl ? "Staff + admin · ιδιωτικό κανάλι" : "Staff + admin · private channel",
  placeholder: isEl ? "Γράψε μήνυμα…" : "Write a message…",
  empty:   isEl ? "Ξεκίνα την κουβέντα 👋" : "Start the conversation 👋",
  admin:   "admin",
  staff:   isEl ? "staff" : "staff",
};
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{t.title} — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
    <StaffPwa />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white font-body antialiased">
    <Header />
    <StaffNav active="staff-chat" role={(me.role === "admin" || me.role === "super_admin") ? "admin" : "employee"} />

    <main class="flex flex-col h-screen lg:h-screen max-w-3xl mx-auto w-full">
      <div class="px-4 py-3 border-b border-white/10 flex items-center gap-3 bg-[#0b0b10]/95 backdrop-blur">
        <div class="h-10 w-10 rounded-full bg-gradient-to-br from-sky-400 to-fuchsia-500 flex items-center justify-center text-lg shrink-0">💬</div>
        <div class="flex-1 min-w-0">
          <h1 class="font-heading text-lg font-bold leading-tight">{t.title}</h1>
          <p class="text-[11px] text-white/50 flex items-center gap-1.5">
            <span id="liveDot" class="h-1.5 w-1.5 rounded-full bg-yellow-400 animate-pulse"></span>
            <span>{t.sub}</span>
          </p>
        </div>
      </div>

      <!-- Pinned strip -->
      <div id="pinnedStrip" class={initialPinned.length ? "border-b border-amber-400/25 bg-amber-400/[0.07] px-3 py-2 space-y-1" : "hidden"}>
        {initialPinned.length > 0 && (
          <p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold">📌 {isEl ? "Καρφιτσωμένα" : "Pinned"}</p>
        )}
        <div id="pinnedList" class="space-y-1">
          {initialPinned.map(m => (
            <button data-scroll-to={m.id} class="pinned-item w-full text-left flex items-center gap-2 rounded-lg bg-white/5 hover:bg-white/10 px-2 py-1.5 transition">
              <span class="text-xs font-bold text-amber-200 shrink-0">{m.author_name}:</span>
              <span class="text-xs text-white/75 truncate flex-1">{m.body || (m.image_url ? "📷 photo" : "")}</span>
            </button>
          ))}
        </div>
      </div>

      <div id="messages" class="flex-1 overflow-y-auto px-3 sm:px-4 py-5 space-y-4">
        {initial.length === 0 && (
          <div id="emptyState" class="text-center text-sm text-white/40 py-10">{t.empty}</div>
        )}
      </div>

      <!-- Reply-to preview strip -->
      <div id="replyStrip" class="hidden border-t border-sky-400/30 bg-sky-400/[0.08] px-3 py-2 flex items-center gap-3">
        <div class="w-1 h-8 rounded-full bg-sky-400 shrink-0"></div>
        <div class="flex-1 min-w-0">
          <p class="text-[10px] uppercase tracking-wider text-sky-300 font-bold">{isEl ? "Απάντηση σε" : "Replying to"} <span id="replyAuthor"></span></p>
          <p id="replyPreview" class="text-xs text-white/70 truncate"></p>
        </div>
        <button type="button" id="replyCancel" class="h-7 w-7 rounded-full bg-white/10 hover:bg-white/20 text-white/70 text-sm shrink-0">✕</button>
      </div>

      <!-- Image preview strip -->
      <div id="pendingImage" class="hidden border-t border-white/10 bg-white/5 px-3 py-2 flex items-center gap-3">
        <img id="pendingPreview" class="h-16 w-16 rounded-lg object-cover" alt="" />
        <div class="flex-1 min-w-0 text-xs text-white/60 truncate" id="pendingName"></div>
        <button type="button" id="pendingCancel" class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-white/80 text-sm">✕</button>
      </div>

      <form id="sendForm" class="border-t border-white/10 bg-[#0b0b10]/95 backdrop-blur px-3 py-3 flex gap-2 items-end">
        <label class="shrink-0 h-11 w-11 rounded-full bg-white/10 hover:bg-white/15 flex items-center justify-center cursor-pointer transition" title={isEl ? "Επισύναψη φωτογραφίας" : "Attach image"}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <input id="imgInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
        </label>
        <textarea id="msgInput" rows="1" placeholder={t.placeholder} maxlength="2000"
          class="flex-1 resize-none rounded-2xl bg-white/10 border border-white/15 px-4 py-2.5 text-sm placeholder:text-white/40 focus:outline-none focus:border-sky-400/50 max-h-32"></textarea>
        <button type="submit" id="sendBtn" disabled
          class="h-11 w-11 shrink-0 rounded-full bg-gradient-to-br from-sky-400 to-sky-600 text-white flex items-center justify-center disabled:opacity-40 active:scale-95 transition">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 12l18-9-6 18-3-7-9-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>
    </main>

    <script is:inline define:vars={{ realtimeToken, meId: user.id, meRole: me.role, isEl, adminLabel: t.admin, staffLabel: t.staff, palettes, initial, initialPinned }}>
      window.__teamChatCfg = { realtimeToken, meId, meRole, isEl, adminLabel, staffLabel, palettes, initial, initialPinned };
    </script>
    <script>
      // @ts-nocheck
      import { createClient } from "@supabase/supabase-js";
      const { realtimeToken, meId, meRole, isEl, adminLabel, staffLabel, palettes, initial, initialPinned } = window.__teamChatCfg;

      const box = document.getElementById("messages");
      const form = document.getElementById("sendForm");
      const input = document.getElementById("msgInput");
      const btn = document.getElementById("sendBtn");
      const dot = document.getElementById("liveDot");
      const imgInput = document.getElementById("imgInput");
      const pendingImage = document.getElementById("pendingImage");
      const pendingPreview = document.getElementById("pendingPreview");
      const pendingName = document.getElementById("pendingName");
      const pendingCancel = document.getElementById("pendingCancel");
      const replyStrip = document.getElementById("replyStrip");
      const replyPreview = document.getElementById("replyPreview");
      const replyAuthor = document.getElementById("replyAuthor");
      const replyCancel = document.getElementById("replyCancel");
      const pinnedStrip = document.getElementById("pinnedStrip");
      const pinnedList = document.getElementById("pinnedList");
      const authorCache = new Map();
      const msgCache = new Map(); // id -> full message object (for reply + pin resolution)
      let pendingUrl = null;
      let replyTo = null; // { id, author, snippet }
      const isAdmin = meRole === "admin" || meRole === "super_admin";

      (initial || []).forEach(m => msgCache.set(m.id, m));

      function scrollBottom() { requestAnimationFrame(() => { box.scrollTop = box.scrollHeight; }); }
      scrollBottom();

      function escapeHtml(s) {
        return String(s || "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
      }
      function linkify(safeHtml) {
        return safeHtml.replace(/(https?:\/\/[^\s<]+)/g, (u) => `<a href="${u}" target="_blank" rel="noopener" class="underline underline-offset-2 hover:no-underline break-all">${u}</a>`);
      }
      function initials(name) {
        const parts = (name || "M").trim().split(/\s+/);
        return ((parts[0]?.[0] ?? "") + (parts[1]?.[0] ?? "")).toUpperCase() || "M";
      }
      function gradFor(id) {
        let h = 0;
        for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;
        return palettes[h % palettes.length];
      }

      function renderMsg(m, opts = {}) {
        const existing = box.querySelector(`[data-msg-id="${m.id}"]`);
        if (existing && !opts.replace) return;

        const mine = m.user_id === meId;
        const canDelete = mine || meRole === "admin";
        const canEdit = mine && !m.deleted_at && !m.image_url;
        const deleted = !!m.deleted_at;
        const d = new Date(m.created_at);
        const time = d.toLocaleTimeString(isEl ? "el-GR" : "en-GB", { hour: "2-digit", minute: "2-digit" });
        const date = d.toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "short" });
        const ini = initials(m.author_name);
        const grad = gradFor(m.user_id);
        const wrap = existing ?? document.createElement("div");
        wrap.className = `group flex items-end gap-2 ${mine ? "justify-end" : "justify-start"}`;
        wrap.setAttribute("data-msg-id", m.id);

        const avatar = `<div class="shrink-0 h-9 w-9 rounded-full bg-gradient-to-br ${grad} flex items-center justify-center text-xs font-bold text-white/95 ring-2 ring-white/10">${escapeHtml(ini)}</div>`;
        const roleBadge = m.author_role === "admin"
          ? `<span class="px-1.5 py-0.5 rounded-full bg-fuchsia-400/15 text-fuchsia-300 text-[9px] font-bold uppercase tracking-wider">${adminLabel}</span>`
          : `<span class="px-1.5 py-0.5 rounded-full bg-sky-400/15 text-sky-300 text-[9px] font-bold uppercase tracking-wider">${staffLabel}</span>`;
        const nameLabel = mine ? (isEl ? "Εσύ" : "You") : escapeHtml(m.author_name || "Member");
        const editedMark = m.edited_at && !deleted ? `<span class="text-white/30 italic">· ${isEl ? "επεξεργασμένο" : "edited"}</span>` : "";
        const meta = `
          <div class="flex items-center gap-2 mb-1 px-1 text-[11px] ${mine ? "flex-row-reverse" : ""}">
            <span class="font-semibold text-white/85">${nameLabel}</span>
            ${roleBadge}
            <span class="text-white/40">· ${date} ${time}</span>
            ${editedMark}
          </div>`;

        let content = "";
        if (deleted) {
          content = `<div class="text-sm italic text-white/40">${isEl ? "🗑️ Το μήνυμα διαγράφηκε" : "🗑️ Message deleted"}</div>`;
        } else {
          if (m.image_url) {
            content += `<a href="${escapeHtml(m.image_url)}" target="_blank" rel="noopener"><img src="${escapeHtml(m.image_url)}" alt="" class="max-h-64 rounded-xl mb-1" loading="lazy" /></a>`;
          }
          if (m.body) {
            content += `<div class="text-sm leading-relaxed whitespace-pre-wrap break-words">${linkify(escapeHtml(m.body))}</div>`;
          }
        }

        const canPin = isAdmin && !deleted;
        const actions = !deleted ? `
          <div class="absolute ${mine ? "left-0 -translate-x-full" : "right-0 translate-x-full"} top-0 hidden group-hover:flex items-center gap-1 pr-2 pl-2">
            <button type="button" data-act="reply" class="h-7 w-7 rounded-full bg-white/10 hover:bg-sky-400/40 text-white/80 text-xs" title="${isEl ? "Απάντηση" : "Reply"}">↩</button>
            ${canPin ? `<button type="button" data-act="pin" class="h-7 w-7 rounded-full bg-white/10 hover:bg-amber-400/40 text-white/80 text-xs" title="${m.pinned_at ? (isEl ? "Ξεκαρφίτσωμα" : "Unpin") : (isEl ? "Καρφίτσωμα" : "Pin")}">📌</button>` : ""}
            ${canEdit ? `<button type="button" data-act="edit" class="h-7 w-7 rounded-full bg-white/10 hover:bg-white/20 text-white/80 text-xs" title="${isEl ? "Επεξεργασία" : "Edit"}">✎</button>` : ""}
            ${canDelete ? `<button type="button" data-act="del" class="h-7 w-7 rounded-full bg-white/10 hover:bg-red-400/40 text-white/80 text-xs" title="${isEl ? "Διαγραφή" : "Delete"}">🗑</button>` : ""}
          </div>` : "";

        // Reply-to quote (clickable → scrolls to parent)
        let replyQuote = "";
        if (m.reply_parent) {
          const snippet = m.reply_parent.body ? escapeHtml(m.reply_parent.body.slice(0, 120)) : (m.reply_parent.has_image ? "📷 photo" : "");
          replyQuote = `<button type="button" data-scroll-to="${m.reply_parent.id}" class="w-full text-left block mb-1 rounded-lg border-l-2 ${mine ? "border-white/40 bg-white/10" : "border-sky-400 bg-sky-400/10"} px-2 py-1 hover:brightness-110 transition">
            <p class="text-[10px] font-bold ${mine ? "text-white/75" : "text-sky-200"}">${isEl ? "↩ απάντηση σε " : "↩ reply to "}${escapeHtml(m.reply_parent.author_name || "Member")}</p>
            <p class="text-xs ${mine ? "text-white/85" : "text-white/70"} truncate">${snippet}</p>
          </button>`;
        }

        const pinMark = m.pinned_at && !deleted ? `<span class="text-[10px] text-amber-300 font-bold mr-1">📌</span>` : "";

        const bubble = `<div class="relative rounded-2xl px-3.5 py-2 ${mine ? "rounded-br-sm bg-gradient-to-br from-sky-500 to-sky-600 text-white" : "rounded-bl-sm bg-white/10 text-white/95"} ${m.pinned_at && !deleted ? "ring-1 ring-amber-400/40" : ""}">${pinMark}${replyQuote}${content}${actions}</div>`;
        const inner = `<div class="max-w-[78%] flex flex-col ${mine ? "items-end" : "items-start"}">${meta}${bubble}</div>`;
        wrap.innerHTML = mine ? inner + avatar : avatar + inner;

        msgCache.set(m.id, m);

        // Wire action buttons
        wrap.querySelectorAll("[data-act]").forEach(b => {
          b.addEventListener("click", (e) => {
            e.stopPropagation();
            const act = b.getAttribute("data-act");
            if (act === "edit")  startEdit(m);
            if (act === "del")   tryDelete(m);
            if (act === "reply") startReply(m);
            if (act === "pin")   togglePin(m);
          });
        });
        // Wire reply-quote → scroll to parent
        wrap.querySelectorAll("[data-scroll-to]").forEach(b => {
          b.addEventListener("click", () => scrollTo(b.getAttribute("data-scroll-to")));
        });

        if (!existing) {
          const empty = document.getElementById("emptyState");
          if (empty) empty.remove();
          box.appendChild(wrap);
          scrollBottom();
        }
      }

      async function startEdit(m) {
        const nv = prompt(isEl ? "Νέο κείμενο:" : "Edit message:", m.body || "");
        if (nv === null) return;
        const text = nv.trim();
        if (!text) return;
        try {
          const r = await fetch("/api/team/edit", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: m.id, body: text }) });
          if (r.ok) renderMsg({ ...m, body: text, edited_at: new Date().toISOString() }, { replace: true });
        } catch {}
      }
      async function tryDelete(m) {
        if (!confirm(isEl ? "Διαγραφή μηνύματος;" : "Delete this message?")) return;
        try {
          const r = await fetch("/api/team/delete", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: m.id }) });
          if (r.ok) renderMsg({ ...m, body: "", image_url: null, deleted_at: new Date().toISOString() }, { replace: true });
        } catch {}
      }

      function startReply(m) {
        replyTo = {
          id: m.id,
          author: m.author_name || "Member",
          snippet: m.body ? m.body.slice(0, 160) : (m.image_url ? "📷 photo" : ""),
        };
        replyAuthor.textContent = replyTo.author;
        replyPreview.textContent = replyTo.snippet;
        replyStrip.classList.remove("hidden");
        replyStrip.classList.add("flex");
        input.focus();
      }
      function clearReply() {
        replyTo = null;
        replyStrip.classList.add("hidden");
        replyStrip.classList.remove("flex");
      }
      replyCancel?.addEventListener("click", clearReply);

      async function togglePin(m) {
        const pin = !m.pinned_at;
        try {
          const r = await fetch("/api/team/pin", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: m.id, pin }) });
          if (!r.ok) return;
          const updated = { ...m, pinned_at: pin ? new Date().toISOString() : null };
          renderMsg(updated, { replace: true });
          msgCache.set(m.id, updated);
          renderPinnedStrip();
        } catch {}
      }

      function renderPinnedStrip() {
        const pinned = Array.from(msgCache.values())
          .filter(m => m.pinned_at && !m.deleted_at)
          .sort((a, b) => new Date(b.pinned_at).getTime() - new Date(a.pinned_at).getTime());
        if (!pinned.length) {
          pinnedStrip.classList.add("hidden");
          pinnedList.innerHTML = "";
          return;
        }
        pinnedStrip.classList.remove("hidden");
        pinnedStrip.innerHTML = `<p class="text-[10px] uppercase tracking-wider text-amber-300 font-bold">📌 ${isEl ? "Καρφιτσωμένα" : "Pinned"}</p>
          <div class="space-y-1 mt-1">${pinned.map(m => `
            <button data-scroll-to="${m.id}" class="w-full text-left flex items-center gap-2 rounded-lg bg-white/5 hover:bg-white/10 px-2 py-1.5 transition">
              <span class="text-xs font-bold text-amber-200 shrink-0">${escapeHtml(m.author_name || "Member")}:</span>
              <span class="text-xs text-white/75 truncate flex-1">${escapeHtml(m.body || (m.image_url ? "📷 photo" : ""))}</span>
            </button>`).join("")}</div>`;
        pinnedStrip.querySelectorAll("[data-scroll-to]").forEach(b => {
          b.addEventListener("click", () => scrollTo(b.getAttribute("data-scroll-to")));
        });
      }

      function scrollTo(id) {
        const el = box.querySelector(`[data-msg-id="${id}"]`);
        if (!el) return;
        el.scrollIntoView({ behavior: "smooth", block: "center" });
        el.classList.add("ring-2", "ring-amber-400");
        setTimeout(() => el.classList.remove("ring-2", "ring-amber-400"), 1500);
      }

      // Wire pinned-strip links rendered by the server on initial load
      pinnedStrip.querySelectorAll("[data-scroll-to]").forEach(b => {
        b.addEventListener("click", () => scrollTo(b.getAttribute("data-scroll-to")));
      });

      async function fetchAuthor(userId) {
        if (authorCache.has(userId)) return authorCache.get(userId);
        try {
          const r = await fetch("/api/team/messages?limit=50");
          const j = await r.json();
          for (const m of (j.messages || [])) {
            authorCache.set(m.user_id, { name: m.author_name, role: m.author_role });
          }
        } catch {}
        return authorCache.get(userId) || { name: "Member", role: "employee" };
      }

      // Render initial batch
      (initial || []).forEach(m => renderMsg(m));

      // Image upload flow
      imgInput?.addEventListener("change", async () => {
        const f = imgInput.files && imgInput.files[0];
        if (!f) return;
        if (f.size > 5 * 1024 * 1024) { alert(isEl ? "Μέγιστο 5MB" : "Max 5MB"); imgInput.value = ""; return; }
        pendingImage.classList.remove("hidden");
        pendingImage.classList.add("flex");
        pendingPreview.src = URL.createObjectURL(f);
        pendingName.textContent = isEl ? "Ανεβαίνει…" : "Uploading…";
        const fd = new FormData(); fd.append("file", f);
        try {
          const r = await fetch("/api/team/upload", { method: "POST", body: fd });
          const j = await r.json();
          if (!r.ok) throw new Error(j.error || "upload failed");
          pendingUrl = j.url;
          pendingName.textContent = f.name;
          btn.disabled = false;
        } catch (e) {
          pendingName.textContent = "⚠️ " + (e.message || "upload failed");
        } finally {
          imgInput.value = "";
        }
      });
      pendingCancel?.addEventListener("click", () => {
        pendingUrl = null;
        pendingImage.classList.add("hidden");
        pendingImage.classList.remove("flex");
        pendingPreview.src = "";
        btn.disabled = !input.value.trim();
      });

      input.addEventListener("input", () => {
        btn.disabled = !input.value.trim() && !pendingUrl;
        input.style.height = "auto";
        input.style.height = Math.min(input.scrollHeight, 128) + "px";
      });
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const text = input.value.trim();
        const imgUrl = pendingUrl;
        if (!text && !imgUrl) return;
        btn.disabled = true;
        input.value = "";
        input.style.height = "auto";
        const sentPreview = imgUrl;
        pendingUrl = null;
        pendingImage?.classList.add("hidden");
        pendingImage?.classList.remove("flex");
        try {
          const replyId = replyTo?.id;
          const r = await fetch("/api/team/send", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ body: text, image_url: sentPreview || undefined, reply_to: replyId }),
          });
          const j = await r.json();
          if (r.ok && j.message) {
            // Attach reply parent snippet client-side so the new bubble shows the quote immediately.
            const parent = replyId ? msgCache.get(replyId) : null;
            if (parent) j.message.reply_parent = { id: parent.id, body: parent.body, has_image: !!parent.image_url, author_name: parent.author_name };
            renderMsg(j.message);
            clearReply();
          }
        } catch {
          input.value = text;
        }
        btn.disabled = !input.value.trim();
        input.focus();
      });

      const supa = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
        { realtime: { params: { eventsPerSecond: 10 } } },
      );
      if (realtimeToken) supa.realtime.setAuth(realtimeToken);

      supa.channel("team-chat")
        .on("postgres_changes", { event: "INSERT", schema: "public", table: "team_messages" }, async (payload) => {
          const m = payload.new;
          if (m.user_id === meId) return;
          const a = await fetchAuthor(m.user_id);
          renderMsg({ ...m, author_name: a.name, author_role: a.role });
          fetch("/api/team/read", { method: "POST" }).catch(() => {});
        })
        .on("postgres_changes", { event: "UPDATE", schema: "public", table: "team_messages" }, async (payload) => {
          const m = payload.new;
          const a = await fetchAuthor(m.user_id);
          renderMsg({ ...m, author_name: a.name, author_role: a.role }, { replace: true });
        })
        .subscribe((status) => {
          if (status === "SUBSCRIBED") dot.className = "h-1.5 w-1.5 rounded-full bg-emerald-400";
          else if (status === "CHANNEL_ERROR" || status === "CLOSED") dot.className = "h-1.5 w-1.5 rounded-full bg-red-400";
        });

      window.addEventListener("focus", () => {
        fetch("/api/team/read", { method: "POST" }).catch(() => {});
      });
    </script>
  </body>
</html>
