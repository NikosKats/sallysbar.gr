---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import { getMenu, formatPriceEUR } from "../../lib/menuService";

// Protected by middleware — only employee/admin can access /staff/*
const { categories, items } = await getMenu("en");
const byCategory = new Map<number, typeof items>();
for (const it of items) {
  const list = byCategory.get(it.category_id) ?? [];
  list.push(it);
  byCategory.set(it.category_id, list);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>New Order — Staff</title>
    <meta name="robots" content="noindex" />
  </head>

  <body class="min-h-screen bg-[#0b0b10] text-white font-body pb-32">
    <Header />

    <!-- Spacer for fixed header -->
    <div class="h-20"></div>

    <!-- Staff sub-nav -->
    <div class="sticky top-20 z-40 border-b border-sky-400/20 bg-[#0b0b10]/95 backdrop-blur">
      <div class="mx-auto max-w-2xl px-6 flex items-center gap-2 py-2 text-sm">
        <a href="/staff" class="px-3 py-1.5 rounded-lg text-white/50 hover:text-sky-400 hover:bg-sky-400/5 transition">← Operations</a>
        <span class="px-3 py-1.5 rounded-lg bg-sky-400/15 border border-sky-400/20 text-sky-400 font-medium">New Order</span>
      </div>
    </div>

    <main class="mx-auto max-w-2xl px-6 py-6 space-y-6">
      <!-- Table number -->
      <div>
        <label class="block text-sm text-white/60 mb-2" for="tableInput">Table number</label>
        <input
          id="tableInput"
          type="number"
          min="1"
          max="99"
          placeholder="e.g. 5"
          class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white text-lg font-semibold placeholder:text-white/30 outline-none focus:border-white/30"
        />
      </div>

      <!-- Menu items -->
      <div>
        <div class="text-sm text-white/60 mb-3">Select items</div>
        <div class="space-y-6">
          {categories.map((c) => {
            const list = byCategory.get(c.id) ?? [];
            if (list.length === 0) return null;
            return (
              <div>
                <div class="text-xs uppercase tracking-widest text-white/40 mb-2">{c.name}</div>
                <div class="rounded-2xl border border-white/10 bg-white/5 divide-y divide-white/10">
                  {list.map((item) => (
                    <div class="flex items-center justify-between gap-4 px-4 py-3">
                      <div class="min-w-0 flex-1">
                        <div class="text-sm font-medium">{item.name}</div>
                        <div class="text-xs text-white/50">{formatPriceEUR(item.price_cents)}</div>
                      </div>
                      <div class="flex items-center gap-3 shrink-0">
                        <button
                          type="button"
                          data-action="dec"
                          data-id={item.id}
                          class="qty-btn w-8 h-8 rounded-full border border-white/15 bg-white/5 text-white/80 hover:bg-white/10 flex items-center justify-center text-lg leading-none transition"
                        >
                          −
                        </button>
                        <span
                          id={`qty-${item.id}`}
                          class="w-5 text-center text-sm font-semibold"
                        >
                          0
                        </span>
                        <button
                          type="button"
                          data-action="inc"
                          data-id={item.id}
                          data-name={item.name}
                          data-price={item.price_cents}
                          class="qty-btn w-8 h-8 rounded-full border border-white/15 bg-white/5 text-white/80 hover:bg-white/10 flex items-center justify-center text-lg leading-none transition"
                        >
                          +
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Note -->
      <div>
        <label class="block text-sm text-white/60 mb-2" for="noteInput">Note (optional)</label>
        <input
          id="noteInput"
          type="text"
          placeholder="e.g. no ice on the Mojito"
          class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/30 outline-none focus:border-white/30"
        />
      </div>

      <!-- Order summary -->
      <div id="summaryBlock" class="hidden rounded-2xl border border-white/10 bg-white/5 p-4">
        <div class="text-sm text-white/60 mb-2">Order summary</div>
        <div id="summaryList" class="space-y-1 text-sm"></div>
        <div class="mt-3 pt-3 border-t border-white/10 flex justify-between text-sm font-semibold">
          <span>Total</span>
          <span id="summaryTotal"></span>
        </div>
      </div>

      <!-- Success / error -->
      <div id="successMsg" class="hidden rounded-2xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400">
        Order sent to barman!
      </div>
      <div id="errorMsg" class="hidden rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
        Something went wrong. Please try again.
      </div>
    </main>

    <!-- Submit bar -->
    <div class="fixed bottom-0 inset-x-0 border-t border-white/10 bg-[#0b0b10]/95 backdrop-blur px-6 py-4">
      <button
        id="submitBtn"
        disabled
        class="w-full rounded-2xl bg-white text-black font-semibold py-3.5 text-sm disabled:opacity-30 disabled:cursor-not-allowed hover:bg-white/90 active:scale-95 transition"
      >
        Send to Barman
      </button>
    </div>

    <script>
      const quantities: Record<string, { name: string; qty: number; price_cents: number }> = {};

      const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
      const summaryBlock = document.getElementById("summaryBlock")!;
      const summaryList = document.getElementById("summaryList")!;
      const summaryTotal = document.getElementById("summaryTotal")!;
      const successMsg = document.getElementById("successMsg")!;
      const errorMsg = document.getElementById("errorMsg")!;

      function updateSummary() {
        const items = Object.values(quantities).filter((i) => i.qty > 0);
        const hasItems = items.length > 0;
        const table = (document.getElementById("tableInput") as HTMLInputElement).value;

        submitBtn.disabled = !hasItems || !table;

        if (hasItems) {
          summaryBlock.classList.remove("hidden");
          summaryList.innerHTML = items
            .map((i) => `<div class="flex justify-between"><span>${i.qty}× ${i.name}</span><span class="text-white/60">€${((i.qty * i.price_cents) / 100).toFixed(0)}</span></div>`)
            .join("");
          const total = items.reduce((s, i) => s + i.qty * i.price_cents, 0);
          summaryTotal.textContent = `€${(total / 100).toFixed(0)}`;
        } else {
          summaryBlock.classList.add("hidden");
        }
      }

      document.querySelectorAll<HTMLButtonElement>(".qty-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.id!;
          const action = btn.dataset.action!;
          const name = btn.dataset.name ?? id;
          const price = Number(btn.dataset.price ?? 0);

          if (!quantities[id]) quantities[id] = { name, qty: 0, price_cents: price };

          if (action === "inc") quantities[id].qty++;
          if (action === "dec" && quantities[id].qty > 0) quantities[id].qty--;

          const display = document.getElementById(`qty-${id}`)!;
          display.textContent = String(quantities[id].qty);

          updateSummary();
        });
      });

      document.getElementById("tableInput")?.addEventListener("input", updateSummary);

      submitBtn.addEventListener("click", async () => {
        const table = Number((document.getElementById("tableInput") as HTMLInputElement).value);
        const note = (document.getElementById("noteInput") as HTMLInputElement).value.trim();
        const items = Object.values(quantities).filter((i) => i.qty > 0);

        successMsg.classList.add("hidden");
        errorMsg.classList.add("hidden");
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";

        try {
          const res = await fetch("/api/order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ table, items, note: note || undefined }),
          });

          if (res.ok) {
            successMsg.classList.remove("hidden");
            // Reset form
            Object.keys(quantities).forEach((k) => {
              quantities[k].qty = 0;
              const el = document.getElementById(`qty-${k}`);
              if (el) el.textContent = "0";
            });
            (document.getElementById("tableInput") as HTMLInputElement).value = "";
            (document.getElementById("noteInput") as HTMLInputElement).value = "";
            summaryBlock.classList.add("hidden");
          } else {
            errorMsg.classList.remove("hidden");
          }
        } catch {
          errorMsg.classList.remove("hidden");
        }

        submitBtn.textContent = "Send to Barman";
        updateSummary();
      });
    </script>
  </body>
</html>
