---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import { getMenu, formatPriceEUR } from "../../lib/menuService";
import { dict, withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const t = dict[lang];
// Protected by middleware — only employee/admin can access /staff/*
// Always fetch menu in English so item names + numbers match the customer table page
const { categories, items } = await getMenu("en");
const byCategory = new Map<number, typeof items>();
for (const it of items) {
  const list = byCategory.get(it.category_id) ?? [];
  list.push(it);
  byCategory.set(it.category_id, list);
}

// Global item numbers — must match the numbering on the customer table page
const itemNumbers = new Map<number, number>();
let itemCounter = 1;
for (const c of categories) {
  for (const it of byCategory.get(c.id) ?? []) {
    itemNumbers.set(it.id, itemCounter++);
  }
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{t.staff.newOrder} — Sally's Bar</title>
    <meta name="robots" content="noindex" />
    <!-- Telegram Mini App SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
      /* When running inside Telegram Mini App, hide the site header */
      .tg-app #site-header-wrap { display: none !important; }
      .tg-app .staff-subnav     { top: 0 !important; }
      .tg-app #native-submit-bar { display: none !important; }
      .tg-app body              { padding-bottom: 1rem !important; }
    </style>
  </head>

  <body class="min-h-screen bg-[#0b0b10] text-white font-body pb-32">

    <!-- Detect Telegram Mini App early to avoid layout flash -->
    <script is:inline>
      if (window.Telegram?.WebApp?.initData) {
        document.documentElement.classList.add('tg-app');
        Telegram.WebApp.ready();
        Telegram.WebApp.expand();
        Telegram.WebApp.setBackgroundColor('#0b0b10');
        Telegram.WebApp.setHeaderColor('#0b0b10');
        Telegram.WebApp.BackButton.show();
        Telegram.WebApp.BackButton.onClick(function() { window.history.back(); });
      }
    </script>

    <!-- Site header — hidden in Telegram Mini App -->
    <div id="site-header-wrap">
      <Header />
      <div class="h-20"></div>
    </div>

    <!-- Staff sub-nav -->
    <div class="staff-subnav sticky top-20 z-40 border-b border-sky-400/20 bg-[#0b0b10]/95 backdrop-blur">
      <div class="mx-auto max-w-2xl px-6 flex items-center gap-2 py-2 text-sm">
        <a href={withLangPrefix(lang, "/staff")} class="px-3 py-1.5 rounded-lg text-white/50 hover:text-sky-400 hover:bg-sky-400/5 transition">{t.staff.back}</a>
        <span class="px-3 py-1.5 rounded-lg bg-sky-400/15 border border-sky-400/20 text-sky-400 font-medium">{t.staff.newOrder}</span>
      </div>
    </div>

    <main class="mx-auto max-w-2xl px-6 py-6 space-y-6">
      <!-- Table number -->
      <div>
        <label class="block text-sm text-white/60 mb-2" for="tableInput">{t.staff.tableNumber}</label>
        <input
          id="tableInput"
          type="number"
          min="1"
          max="99"
          placeholder={t.staff.tablePlaceholder}
          class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white text-lg font-semibold placeholder:text-white/30 outline-none focus:border-white/30"
        />
      </div>

      <!-- Menu items -->
      <div>
        <div class="text-sm text-white/60 mb-3">{t.staff.selectItems}</div>
        <div class="space-y-6">
          {categories.map((c) => {
            const list = byCategory.get(c.id) ?? [];
            if (list.length === 0) return null;
            return (
              <div>
                <div class="text-xs uppercase tracking-widest text-white/40 mb-2">{c.name}</div>
                <div class="rounded-2xl border border-white/10 bg-white/5 divide-y divide-white/10">
                  {list.map((item) => (
                    <div class="flex items-center justify-between gap-4 px-4 py-3">
                      <div class="min-w-0 flex-1">
                        <div class="text-sm font-medium">
                          <span class="text-white/30 text-xs font-normal mr-1">#{itemNumbers.get(item.id)}</span>{item.name}
                        </div>
                        <div class="text-xs text-white/50">{formatPriceEUR(item.price_cents)}</div>
                      </div>
                      <div class="flex items-center gap-3 shrink-0">
                        <button
                          type="button"
                          data-action="dec"
                          data-id={item.id}
                          class="qty-btn w-8 h-8 rounded-full border border-white/15 bg-white/5 text-white/80 hover:bg-white/10 flex items-center justify-center text-lg leading-none transition"
                        >−</button>
                        <span id={`qty-${item.id}`} class="w-5 text-center text-sm font-semibold">0</span>
                        <button
                          type="button"
                          data-action="inc"
                          data-id={item.id}
                          data-name={item.name}
                          data-price={item.price_cents}
                          class="qty-btn w-8 h-8 rounded-full border border-white/15 bg-white/5 text-white/80 hover:bg-white/10 flex items-center justify-center text-lg leading-none transition"
                        >+</button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Note -->
      <div>
        <label class="block text-sm text-white/60 mb-2" for="noteInput">{t.staff.note}</label>
        <input
          id="noteInput"
          type="text"
          placeholder={t.staff.notePlaceholder}
          class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/30 outline-none focus:border-white/30"
        />
      </div>

      <!-- Order summary -->
      <div id="summaryBlock" class="hidden rounded-2xl border border-white/10 bg-white/5 p-4">
        <div class="text-sm text-white/60 mb-2">{t.staff.orderSummary}</div>
        <div id="summaryList" class="space-y-1 text-sm"></div>
        <div class="mt-3 pt-3 border-t border-white/10 flex justify-between text-sm font-semibold">
          <span>{t.staff.total}</span>
          <span id="summaryTotal"></span>
        </div>
      </div>

      <!-- Success / error -->
      <div id="successMsg" class="hidden rounded-2xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400">
        {t.staff.orderSent}
      </div>
      <div id="errorMsg" class="hidden rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
        {t.staff.orderError}
      </div>
    </main>

    <!-- Native submit bar (shown in browser, hidden in Telegram) -->
    <div id="native-submit-bar" class="fixed bottom-0 inset-x-0 border-t border-white/10 bg-[#0b0b10]/95 backdrop-blur px-6 py-4">
      <button
        id="submitBtn"
        disabled
        class="w-full rounded-2xl bg-white text-black font-semibold py-3.5 text-sm disabled:opacity-30 disabled:cursor-not-allowed hover:bg-white/90 active:scale-95 transition"
      >
        {t.staff.sendToBarman}
      </button>
    </div>

    <script define:vars={{ tSendToBarman: t.staff.sendToBarman, tSending: t.staff.sending }}>
      const isTg   = !!(window.Telegram?.WebApp?.initData);
      const tgBtn  = isTg ? window.Telegram.WebApp.MainButton : null;

      const submitBtn   = document.getElementById("submitBtn");
      const summaryBlock = document.getElementById("summaryBlock");
      const summaryList  = document.getElementById("summaryList");
      const summaryTotal = document.getElementById("summaryTotal");
      const successMsg   = document.getElementById("successMsg");
      const errorMsg     = document.getElementById("errorMsg");

      const quantities = {};

      if (isTg) {
        tgBtn.setText(tSendToBarman);
        tgBtn.color = '#2481cc';
      }

      function updateSummary() {
        const items    = Object.values(quantities).filter(i => i.qty > 0);
        const hasItems = items.length > 0;
        const table    = document.getElementById("tableInput").value;
        const canSubmit = hasItems && !!table;

        if (!isTg) {
          submitBtn.disabled = !canSubmit;
        } else {
          canSubmit ? tgBtn.show() : tgBtn.hide();
        }

        if (hasItems) {
          summaryBlock.classList.remove("hidden");
          summaryList.innerHTML = items
            .map(i => `<div class="flex justify-between"><span>${i.qty}× ${i.name}</span><span class="text-white/60">€${((i.qty * i.price_cents) / 100).toFixed(0)}</span></div>`)
            .join("");
          const total = items.reduce((s, i) => s + i.qty * i.price_cents, 0);
          summaryTotal.textContent = `€${(total / 100).toFixed(0)}`;
        } else {
          summaryBlock.classList.add("hidden");
        }
      }

      async function doSubmit() {
        const table = Number(document.getElementById("tableInput").value);
        const note  = document.getElementById("noteInput").value.trim();
        const items = Object.values(quantities).filter(i => i.qty > 0);

        successMsg.classList.add("hidden");
        errorMsg.classList.add("hidden");

        if (!isTg) {
          submitBtn.disabled = true;
          submitBtn.textContent = tSending;
        } else {
          tgBtn.showProgress(false);
          tgBtn.disable();
        }

        try {
          const res = await fetch("/api/order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ table, items, note: note || undefined }),
          });

          if (res.ok) {
            if (isTg) {
              // Close mini app — waiter sees the order notification in Telegram
              window.Telegram.WebApp.close();
            } else {
              successMsg.classList.remove("hidden");
              Object.keys(quantities).forEach(k => {
                quantities[k].qty = 0;
                const el = document.getElementById(`qty-${k}`);
                if (el) el.textContent = "0";
              });
              document.getElementById("tableInput").value = "";
              document.getElementById("noteInput").value = "";
              summaryBlock.classList.add("hidden");
            }
          } else {
            errorMsg.classList.remove("hidden");
          }
        } catch {
          errorMsg.classList.remove("hidden");
        }

        if (!isTg) {
          submitBtn.textContent = tSendToBarman;
          updateSummary();
        } else {
          tgBtn.hideProgress();
          tgBtn.enable();
        }
      }

      // Qty buttons
      document.querySelectorAll(".qty-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const id     = btn.dataset.id;
          const action = btn.dataset.action;
          const name   = btn.dataset.name ?? id;
          const price  = Number(btn.dataset.price ?? 0);

          if (!quantities[id]) quantities[id] = { name, qty: 0, price_cents: price };

          if (action === "inc") quantities[id].qty++;
          if (action === "dec" && quantities[id].qty > 0) quantities[id].qty--;

          const display = document.getElementById(`qty-${id}`);
          display.textContent = String(quantities[id].qty);

          updateSummary();
        });
      });

      document.getElementById("tableInput").addEventListener("input", updateSummary);

      // Wire submit to the right surface
      if (isTg) {
        tgBtn.onClick(doSubmit);
      } else {
        submitBtn.addEventListener("click", doSubmit);
      }
    </script>
  </body>
</html>
