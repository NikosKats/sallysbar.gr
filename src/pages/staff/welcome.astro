---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import { withLangPrefix } from "../../i18n";
import { getWelcomeSettings } from "../../lib/welcome-settings";

export const prerender = false;

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";

if (!Astro.locals.user || !["staff", "admin", "super_admin"].includes(Astro.locals.role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/login"));
}

const welcomeSettings = await getWelcomeSettings();
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isEl ? "Κωδικοί καλωσορίσματος" : "Welcome drink codes"} — Staff</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">
    <Header />
    <div class="h-20"></div>

    <main class="mx-auto max-w-md px-5 py-8 space-y-5">
      <div>
        <p class="text-[10px] uppercase tracking-[0.22em] text-amber-200/80 mb-1">Staff · Sally's Bar</p>
        <h1 class="font-heading text-2xl font-bold">
          🍹 {isEl ? "Εξαργύρωση κωδικού" : "Redeem welcome code"}
        </h1>
        <p class="text-sm text-white/60 mt-1">
          {isEl
            ? "Ο πελάτης δείχνει έναν κωδικό όπως HEL-A4K9. Πληκτρολογήστε τον για επιβεβαίωση."
            : "The guest shows a code like HEL-A4K9. Type it to verify and redeem."}
        </p>
        <div class="mt-3 rounded-xl border border-amber-400/40 bg-amber-500/[0.08] px-3 py-2">
          <p class="text-[10px] uppercase tracking-wider text-amber-200/80">{isEl ? "Δώρο προς σερβίρισμα" : "Gift to serve"}</p>
          <p class="text-sm font-semibold text-amber-100">🍹 {welcomeSettings.gift_label}</p>
        </div>
      </div>

      <form id="lookupForm" class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 space-y-3">
        <label class="block">
          <span class="text-xs text-white/60">{isEl ? "Κωδικός" : "Code"}</span>
          <input required type="text" name="code" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text" placeholder="HEL-XXXX" class="mt-1 w-full rounded-lg bg-black/40 border border-white/10 px-3 py-3 text-center font-mono text-xl tracking-widest uppercase focus:outline-none focus:border-amber-400/60" />
        </label>
        <button type="submit" id="lookupBtn" class="w-full rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-bold px-4 py-3 transition">
          {isEl ? "Αναζήτηση" : "Look up"}
        </button>
        <p id="errMsg" class="text-xs text-rose-300 min-h-[1em] text-center"></p>
      </form>

      <div id="detail" class="hidden rounded-2xl border border-white/10 bg-white/[0.04] p-4 space-y-3">
        <div class="flex items-center justify-between">
          <p class="text-xs uppercase tracking-wider text-white/50">{isEl ? "Στοιχεία επισκέπτη" : "Guest details"}</p>
          <span id="statusPill" class="text-[11px] font-semibold rounded-full px-2 py-0.5">—</span>
        </div>
        <div class="text-sm space-y-1">
          <p><span class="text-white/50">{isEl ? "Όνομα" : "Name"}:</span> <span id="dName" class="text-white/90 font-medium">—</span></p>
          <p><span class="text-white/50">Email:</span> <span id="dEmail" class="text-white/80">—</span></p>
          <p><span class="text-white/50">{isEl ? "Τηλέφωνο" : "Phone"}:</span> <span id="dPhone" class="text-white/80 font-mono">—</span></p>
          <p><span class="text-white/50">{isEl ? "Πηγή" : "Source"}:</span> <span id="dSource" class="text-white/80">—</span></p>
          <p><span class="text-white/50">{isEl ? "Έκδοση" : "Issued"}:</span> <span id="dIssued" class="text-white/70 text-xs">—</span></p>
        </div>
        <button id="redeemBtn" class="w-full rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-bold px-4 py-3 transition disabled:opacity-40 disabled:cursor-not-allowed">
          ✓ {isEl ? "Επιβεβαίωση εξαργύρωσης" : "Mark drink as served"}
        </button>
        <p id="redeemMsg" class="text-xs text-center min-h-[1em]"></p>
      </div>
    </main>

    <script is:inline>
      (function() {
        const lookupForm = document.getElementById("lookupForm");
        const lookupBtn  = document.getElementById("lookupBtn");
        const errMsg     = document.getElementById("errMsg");
        const detail     = document.getElementById("detail");
        const dName      = document.getElementById("dName");
        const dEmail     = document.getElementById("dEmail");
        const dPhone     = document.getElementById("dPhone");
        const dSource    = document.getElementById("dSource");
        const dIssued    = document.getElementById("dIssued");
        const statusPill = document.getElementById("statusPill");
        const redeemBtn  = document.getElementById("redeemBtn");
        const redeemMsg  = document.getElementById("redeemMsg");
        let currentCode = "";

        function setStatus(status) {
          const m = {
            issued:    { cls: "bg-amber-500/20 text-amber-200 border border-amber-400/40",   label: "Ready to redeem" },
            redeemed:  { cls: "bg-emerald-500/20 text-emerald-200 border border-emerald-400/40", label: "Already redeemed" },
            expired:   { cls: "bg-rose-500/15 text-rose-200 border border-rose-400/40",      label: "Expired" },
          };
          const v = m[status] || { cls: "bg-white/10 text-white/70", label: status };
          statusPill.className = "text-[11px] font-semibold rounded-full px-2 py-0.5 " + v.cls;
          statusPill.textContent = v.label;
          redeemBtn.disabled = status !== "issued";
          redeemBtn.textContent = status === "redeemed" ? "✓ Already served" : "✓ Mark drink as served";
        }

        lookupForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          errMsg.textContent = "";
          redeemMsg.textContent = "";
          const code = String(new FormData(lookupForm).get("code") || "").trim().toUpperCase();
          if (!code) return;
          currentCode = code;
          lookupBtn.disabled = true;
          const orig = lookupBtn.textContent;
          lookupBtn.textContent = "…";
          try {
            const res = await fetch("/api/staff/welcome-redeem?code=" + encodeURIComponent(code));
            const j = await res.json().catch(() => ({}));
            if (!res.ok || !j.ok) {
              errMsg.textContent = j?.error === "not_found" ? "Code not found." : (j?.error || ("HTTP " + res.status));
              detail.classList.add("hidden");
              return;
            }
            const w = j.welcome;
            dName.textContent = w.full_name || "—";
            dEmail.textContent = w.email || "—";
            dPhone.textContent = w.phone || "—";
            dSource.textContent = (w.source || "").toUpperCase();
            dIssued.textContent = w.issued_at ? new Date(w.issued_at).toLocaleString() : "—";
            setStatus(w.status);
            detail.classList.remove("hidden");
          } catch (err) {
            errMsg.textContent = err?.message || "network error";
          } finally {
            lookupBtn.disabled = false;
            lookupBtn.textContent = orig;
          }
        });

        redeemBtn.addEventListener("click", async () => {
          if (!currentCode) return;
          redeemBtn.disabled = true;
          redeemMsg.textContent = "…";
          try {
            const res = await fetch("/api/staff/welcome-redeem", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ code: currentCode }),
            });
            const j = await res.json().catch(() => ({}));
            if (!res.ok || !j.ok) {
              redeemMsg.className = "text-xs text-center text-rose-300";
              redeemMsg.textContent = j?.error || ("HTTP " + res.status);
              redeemBtn.disabled = false;
              return;
            }
            redeemMsg.className = "text-xs text-center text-emerald-300";
            redeemMsg.textContent = "✓ Served to " + (j.full_name || "guest") + ". Enjoy!";
            setStatus("redeemed");
          } catch (err) {
            redeemMsg.className = "text-xs text-center text-rose-300";
            redeemMsg.textContent = err?.message || "network error";
            redeemBtn.disabled = false;
          }
        });
      })();
    </script>
  </body>
</html>
