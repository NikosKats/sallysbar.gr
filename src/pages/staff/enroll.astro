---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import { supabaseAdmin } from "../../lib/supabase";
import { withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";
const user = Astro.locals.user;
const role = Astro.locals.role;

if (!user || !["employee", "admin"].includes(role ?? "")) {
  return Astro.redirect(withLangPrefix(lang, "/login") + "?next=/staff/enroll");
}

const enrollUrl = `https://sallysbar.gr/register?staff=${user.id}`;

// Stats: signups via this staff member
const startToday = new Date();
startToday.setHours(0, 0, 0, 0);
const startWeek = new Date();
startWeek.setDate(startWeek.getDate() - 7);
const startMonth = new Date();
startMonth.setDate(startMonth.getDate() - 30);

const [{ count: todayCount }, { count: weekCount }, { count: monthCount }, { count: totalCount }] = await Promise.all([
  supabaseAdmin.from("profiles").select("id", { count: "exact", head: true })
    .eq("referred_by_staff", user.id).gte("created_at", startToday.toISOString()),
  supabaseAdmin.from("profiles").select("id", { count: "exact", head: true })
    .eq("referred_by_staff", user.id).gte("created_at", startWeek.toISOString()),
  supabaseAdmin.from("profiles").select("id", { count: "exact", head: true })
    .eq("referred_by_staff", user.id).gte("created_at", startMonth.toISOString()),
  supabaseAdmin.from("profiles").select("id", { count: "exact", head: true })
    .eq("referred_by_staff", user.id),
]);

const { data: recentSignups } = await supabaseAdmin
  .from("profiles")
  .select("id, full_name, created_at")
  .eq("referred_by_staff", user.id)
  .order("created_at", { ascending: false })
  .limit(20);

const TIP_PER_SIGNUP = 0.50; // EUR — admin-tunable later
const todayEarn = (todayCount ?? 0) * TIP_PER_SIGNUP;
const weekEarn  = (weekCount ?? 0)  * TIP_PER_SIGNUP;

const displayName = (user.user_metadata as any)?.full_name ?? user.email?.split("@")[0] ?? "Staff";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{isEl ? "Εγγραφές Πελατών" : "Customer Enrollment"} — Sally's Bar Staff</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white font-body antialiased">
    <Header />

    <main class="mx-auto max-w-md px-4 pt-28 pb-10 space-y-5">
      <div>
        <p class="text-xs uppercase tracking-[0.28em] text-amber-300/80">{isEl ? "Σταφ" : "Staff"}</p>
        <h1 class="font-heading text-2xl font-bold mt-1">{isEl ? "Εγγραφές πελατών" : "Customer enrollment"}</h1>
        <p class="text-xs text-white/50 mt-1">{displayName} · {role}</p>
      </div>

      <!-- Big QR for showing to guests -->
      <section class="rounded-3xl bg-white p-6 shadow-2xl shadow-amber-500/10 flex flex-col items-center gap-3">
        <canvas id="enrollQr" data-url={enrollUrl} width="240" height="240"></canvas>
        <p class="text-[10px] uppercase tracking-[0.3em] text-neutral-500 font-bold">{isEl ? "Πάνω στο τηλέφωνο πελάτη" : "Show on guest's phone"}</p>
        <p class="text-xs text-neutral-700 text-center max-w-[200px]">{isEl ? "Σκάναρε για εγγραφή — δωρεάν scratch card!" : "Scan to sign up — free scratch card!"}</p>
      </section>

      <button id="copyLinkBtn" type="button" data-url={enrollUrl}
        class="w-full rounded-xl border border-amber-400/30 bg-amber-400/10 hover:bg-amber-400/20 text-amber-200 px-4 py-3 text-sm font-semibold transition">
        🔗 {isEl ? "Αντιγραφή link" : "Copy link"}
      </button>

      <!-- Stats -->
      <section class="grid grid-cols-2 gap-3">
        <div class="rounded-2xl border border-amber-400/20 bg-amber-400/5 p-4">
          <p class="text-[10px] uppercase tracking-wider text-amber-300/70">{isEl ? "Σήμερα" : "Today"}</p>
          <p class="text-3xl font-bold text-amber-300 mt-1">{todayCount ?? 0}</p>
          <p class="text-[10px] text-amber-300/60 mt-0.5">~ €{todayEarn.toFixed(2)} {isEl ? "tip" : "tip"}</p>
        </div>
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-4">
          <p class="text-[10px] uppercase tracking-wider text-emerald-300/70">{isEl ? "7 ημέρες" : "Last 7 days"}</p>
          <p class="text-3xl font-bold text-emerald-300 mt-1">{weekCount ?? 0}</p>
          <p class="text-[10px] text-emerald-300/60 mt-0.5">~ €{weekEarn.toFixed(2)}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-[10px] uppercase tracking-wider text-white/40">{isEl ? "30 ημέρες" : "Last 30 days"}</p>
          <p class="text-3xl font-bold text-white mt-1">{monthCount ?? 0}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-[10px] uppercase tracking-wider text-white/40">{isEl ? "Συνολικά" : "All time"}</p>
          <p class="text-3xl font-bold text-white mt-1">{totalCount ?? 0}</p>
        </div>
      </section>

      <p class="text-center text-xs text-white/40 leading-relaxed">
        {isEl
          ? `Tip jar: €${TIP_PER_SIGNUP.toFixed(2)} ανά εγγραφή. Ο admin πληρώνει εβδομαδιαία.`
          : `Tip jar: €${TIP_PER_SIGNUP.toFixed(2)} per signup. Admin pays out weekly.`}
      </p>

      <!-- Recent signups -->
      {(recentSignups ?? []).length > 0 && (
        <section class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <h2 class="text-xs font-semibold text-white/50 uppercase tracking-widest mb-3">{isEl ? "Πρόσφατες εγγραφές" : "Recent signups"}</h2>
          <div class="divide-y divide-white/5">
            {(recentSignups ?? []).map(s => (
              <div class="flex items-center justify-between py-2 text-xs">
                <span class="text-white/80 truncate">{s.full_name ?? "—"}</span>
                <span class="text-white/40 whitespace-nowrap">{new Date(s.created_at).toLocaleDateString(isEl ? "el-GR" : "en-GB", { day: "2-digit", month: "short" })}</span>
              </div>
            ))}
          </div>
        </section>
      )}
    </main>

    <script>
      import QRCode from "qrcode";
      const canvas = document.getElementById("enrollQr") as HTMLCanvasElement | null;
      const url = canvas?.dataset.url ?? "";
      if (canvas && url) {
        QRCode.toCanvas(canvas, url, {
          width: 240, margin: 1,
          color: { dark: "#0a0a0f", light: "#ffffff" },
          errorCorrectionLevel: "H",
        }).catch((e: unknown) => console.error(e));
      }

      const copyBtn = document.getElementById("copyLinkBtn") as HTMLButtonElement | null;
      copyBtn?.addEventListener("click", async () => {
        const u = copyBtn.dataset.url ?? "";
        try {
          await navigator.clipboard.writeText(u);
          const orig = copyBtn.innerHTML;
          copyBtn.textContent = "✓ Copied";
          setTimeout(() => { copyBtn.innerHTML = orig; }, 1500);
        } catch {
          prompt("Copy:", u);
        }
      });
    </script>
  </body>
</html>
