---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import StaffPwa from "../../components/StaffPwa.astro";
import StaffNav from "../../components/StaffNav.astro";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";
const role = (Astro.locals.role === "admin" || Astro.locals.role === "super_admin" ? "admin" : "employee") as "admin" | "employee";
const tokenFromUrl = new URL(Astro.request.url).searchParams.get("token") ?? "";
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{isEl ? "Εξαργύρωση ρόδας" : "Wheel redeem"} — Sally's Staff</title>
    <meta name="robots" content="noindex,nofollow" />
    <StaffPwa />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased">
    <Header />
    <div class="h-20"></div>
    <StaffNav active="staff-wheel-claim" role={role} />

    <main class="mx-auto max-w-2xl px-5 py-8">
      <div class="mb-6 flex items-start justify-between gap-3 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-[0.24em] text-amber-300 mb-1">🎡 {isEl ? "Ρόδα" : "Wheel"}</p>
          <h1 class="font-heading text-3xl font-bold">{isEl ? "Εξαργύρωση επάθλων" : "Prize redemption"}</h1>
          <p class="mt-1 text-sm text-white/55">{isEl ? "Σκάναρε το QR του πελάτη ή πάτα Έγκριση." : "Scan the customer's QR or tap Approve."}</p>
        </div>
        <button id="scanBtn" class="rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 text-black px-4 py-2.5 text-sm font-bold shadow-lg shadow-amber-500/20">{isEl ? "📷 Σάρωση QR" : "📷 Scan QR"}</button>
      </div>

      <div id="banner" class="hidden mb-4 rounded-xl px-4 py-2 text-sm"></div>
      <div id="pendingList" class="space-y-3">
        <p class="text-center text-white/40 text-sm py-10" id="emptyState">⏳ {isEl ? "Φόρτωση…" : "Loading…"}</p>
      </div>
    </main>

    <dialog id="scanModal" class="rounded-3xl bg-[#0e0e16] border border-white/15 p-0 backdrop:bg-black/80" style="max-width:480px;width:95vw;">
      <div class="p-5">
        <div class="flex items-center justify-between mb-3">
          <p class="font-heading text-lg font-bold">📷 {isEl ? "Σάρωση" : "Scan"}</p>
          <button id="closeScan" class="text-white/50 hover:text-white text-2xl leading-none">×</button>
        </div>
        <video id="scanVideo" autoplay playsinline muted class="w-full rounded-xl bg-black aspect-square object-cover"></video>
        <p class="mt-3 text-xs text-white/55 text-center">{isEl ? "Στόχευσε το QR του πελάτη." : "Point at the customer's QR."}</p>
        <p id="scanMsg" class="mt-2 text-xs text-center text-amber-200 hidden"></p>
      </div>
    </dialog>

    <script is:inline define:vars={{ isEl, tokenFromUrl }}>
      const list = document.getElementById("pendingList");
      const banner = document.getElementById("banner");

      function flash(text, ok = true) {
        banner.textContent = text;
        banner.className = `mb-4 rounded-xl px-4 py-2 text-sm ${ok ? "border border-emerald-400/30 bg-emerald-400/10 text-emerald-200" : "border border-red-400/30 bg-red-400/10 text-red-200"}`;
        banner.classList.remove("hidden");
        setTimeout(() => banner.classList.add("hidden"), 2500);
      }

      async function act(action, payload) {
        try {
          const r = await fetch("/api/loyalty/wheel-claim", {
            method: "PATCH", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action, ...payload }),
          });
          const j = await r.json();
          if (!r.ok) { flash("⚠️ " + (j.error || "failed"), false); return false; }
          flash(action === "approve" ? `✓ ${j.reward || "approved"}` : (isEl ? "✗ Απορρίφθηκε" : "✗ Rejected"));
          refresh();
          return true;
        } catch { flash("⚠️ Network error", false); return false; }
      }

      async function refresh() {
        // Pull all pending claim tokens directly — server-side filter.
        try {
          const r = await fetch("/api/loyalty/wheel-claim-list");
          if (!r.ok) { list.innerHTML = `<p class="text-center text-white/40 text-sm py-10">${isEl ? "Δεν έχεις δικαιώματα ή κάτι πήγε στραβά." : "No permission or error."}</p>`; return; }
          const j = await r.json();
          const items = j.spins || [];
          if (!items.length) { list.innerHTML = `<p class="text-center text-white/40 text-sm py-10">${isEl ? "Καμία εξαργύρωση σε αναμονή. 🎉" : "No pending redemptions. 🎉"}</p>`; return; }
          list.innerHTML = items.map(s => {
            const when = new Date(s.spun_at).toLocaleTimeString(isEl ? "el-GR" : "en-GB", { hour: "2-digit", minute: "2-digit" });
            const u = s.user || {};
            const initials = (u.full_name || "M").trim().split(/\s+/).map(x => x[0]).join("").slice(0,2).toUpperCase();
            const avatar = u.avatar_url ? `<img src="${u.avatar_url}" class="h-11 w-11 rounded-full object-cover ring-2 ring-white/10" />`
              : `<div class="h-11 w-11 rounded-full bg-gradient-to-br from-amber-300 to-fuchsia-500 flex items-center justify-center font-bold text-white">${initials}</div>`;
            return `<article class="rounded-2xl border border-white/10 bg-white/[0.03] p-4" data-id="${s.id}">
              <div class="flex items-start gap-3">
                ${avatar}
                <div class="flex-1 min-w-0">
                  <p class="font-bold text-white truncate">${u.full_name || "Member"}</p>
                  <p class="text-sm text-amber-200 mt-0.5 truncate">🎁 ${s.reward_label}</p>
                  <p class="text-[11px] text-white/50 mt-0.5">🎡 ${when}</p>
                </div>
              </div>
              <div class="mt-3 grid grid-cols-2 gap-2">
                <button class="reject-btn rounded-xl border border-red-400/30 bg-red-400/10 hover:bg-red-400/20 text-red-200 px-3 py-2.5 text-sm font-semibold">✗ ${isEl ? "Απόρριψη" : "Reject"}</button>
                <button class="approve-btn rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 text-white px-3 py-2.5 text-sm font-bold shadow-lg shadow-emerald-500/20">✓ ${isEl ? "Έγκριση" : "Approve"}</button>
              </div>
            </article>`;
          }).join("");
          list.querySelectorAll("[data-id]").forEach(card => {
            const id = card.getAttribute("data-id");
            card.querySelector(".approve-btn").addEventListener("click", () => act("approve", { spin_id: id }));
            card.querySelector(".reject-btn") .addEventListener("click", async () => {
              const reason = prompt(isEl ? "Λόγος (προαιρετικός):" : "Reason (optional):", "") ?? "";
              act("reject", { spin_id: id, reason });
            });
          });
        } catch { flash("⚠️ load failed", false); }
      }
      refresh();
      setInterval(refresh, 6000);

      // Scanner
      const scanBtn  = document.getElementById("scanBtn");
      const modal    = document.getElementById("scanModal");
      const video    = document.getElementById("scanVideo");
      const closeBtn = document.getElementById("closeScan");
      const scanMsg  = document.getElementById("scanMsg");
      let mediaStream = null, detector = null, scanning = false;

      async function startScan() {
        modal.showModal(); scanMsg.classList.add("hidden");
        try {
          mediaStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } });
          video.srcObject = mediaStream;
          if ("BarcodeDetector" in window) {
            detector = new window.BarcodeDetector({ formats: ["qr_code"] });
            scanning = true; loop();
          } else {
            scanMsg.textContent = isEl ? "Σάρωση δεν υποστηρίζεται — πάτα Έγκριση χειροκίνητα." : "Scanning not supported — use Approve instead.";
            scanMsg.classList.remove("hidden");
          }
        } catch (e) {
          scanMsg.textContent = "⚠️ " + (e.message || "camera failed"); scanMsg.classList.remove("hidden");
        }
      }
      async function loop() {
        if (!scanning || !detector) return;
        try {
          const codes = await detector.detect(video);
          for (const c of codes) {
            const m = (c.rawValue || "").match(/[?&]token=([a-f0-9]{16,64})/i);
            if (m) { scanning = false; await act("approve", { token: m[1] }); stopScan(); return; }
          }
        } catch {}
        requestAnimationFrame(loop);
      }
      function stopScan() {
        scanning = false;
        if (mediaStream) mediaStream.getTracks().forEach(t => t.stop());
        modal.close();
      }
      scanBtn?.addEventListener("click", startScan);
      closeBtn?.addEventListener("click", stopScan);
      modal.addEventListener("close", () => { if (mediaStream) mediaStream.getTracks().forEach(t => t.stop()); });

      if (tokenFromUrl) {
        if (confirm(isEl ? "Έγκριση αυτής της εξαργύρωσης;" : "Approve this redemption?")) act("approve", { token: tokenFromUrl });
      }
    </script>
  </body>
</html>
