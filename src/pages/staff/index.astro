---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import StaffPwa from "../../components/StaffPwa.astro";
import { supabaseAdmin, createSupabaseServerClient } from "../../lib/supabase";
import { dict, withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const t = dict[lang];
const isEl = lang === "el";
const user = Astro.locals.user;

// Get access token for authenticated realtime subscription
const { data: { session } } = await createSupabaseServerClient(Astro.request, Astro.cookies).auth.getSession();
const realtimeToken = session?.access_token ?? "";

const today = new Date();
today.setHours(0, 0, 0, 0);

// ── Fetch open sessions ────────────────────────────────────────────────────────
const { data: rawSessions } = await supabaseAdmin
  .from("table_sessions")
  .select("id, table_number, status, created_at, customer_user_id")
  .eq("status", "open")
  .gte("created_at", today.toISOString())
  .order("created_at", { ascending: true });

// ── Fetch all active orders today (pending/preparing/ready/delivered) ──────────
const { data: activeOrders } = await supabaseAdmin
  .from("orders")
  .select("id, session_id, round_number, table_number, items, status, note, total_cents, created_at")
  .not("status", "in", '("paid","cancelled")')
  .gte("created_at", today.toISOString())
  .order("round_number", { ascending: true });

// ── Fetch closed sessions today ────────────────────────────────────────────────
const { data: closedSessions } = await supabaseAdmin
  .from("table_sessions")
  .select("id, table_number, closed_at, created_at")
  .eq("status", "closed")
  .gte("created_at", today.toISOString())
  .order("closed_at", { ascending: false })
  .limit(15);

// Totals for closed sessions (paid orders)
const closedIds = (closedSessions ?? []).map(s => s.id);
const { data: closedOrderTotals } = closedIds.length
  ? await supabaseAdmin
      .from("orders")
      .select("session_id, total_cents, status")
      .in("session_id", closedIds)
  : { data: [] };

// ── Partial payments for open sessions ────────────────────────────────────────
const openIds = (rawSessions ?? []).map(s => s.id);
const { data: partialPayments } = openIds.length
  ? await supabaseAdmin
      .from("partial_payments")
      .select("session_id, amount_cents, items_snapshot")
      .in("session_id", openIds)
  : { data: [] };

const partialPaidMap = new Map<string, number>();
const partialPaidItemsMap = new Map<string, Map<string, number>>();
for (const pp of (partialPayments ?? [])) {
  partialPaidMap.set(pp.session_id, (partialPaidMap.get(pp.session_id) ?? 0) + pp.amount_cents);
  if (pp.items_snapshot) {
    const itemMap = partialPaidItemsMap.get(pp.session_id) ?? new Map<string, number>();
    for (const item of (pp.items_snapshot as any[])) {
      const qty = item.qty ?? item.quantity ?? 1;
      itemMap.set(item.name, (itemMap.get(item.name) ?? 0) + qty);
    }
    partialPaidItemsMap.set(pp.session_id, itemMap);
  }
}

// ── Legacy orders without session_id ──────────────────────────────────────────
const legacyActive = (activeOrders ?? []).filter((o: any) => !o.session_id);
const { data: legacyDone } = await supabaseAdmin
  .from("orders")
  .select("id, table_number, items, status, total_cents, created_at")
  .in("status", ["paid", "cancelled"])
  .is("session_id", null)
  .gte("created_at", today.toISOString())
  .order("created_at", { ascending: false })
  .limit(10);

// ── Build enriched sessions ────────────────────────────────────────────────────
const ordersBySession = new Map<string, any[]>();
for (const order of (activeOrders ?? [])) {
  if ((order as any).session_id) {
    const list = ordersBySession.get((order as any).session_id) ?? [];
    list.push(order);
    ordersBySession.set((order as any).session_id, list);
  }
}

type SessionData = {
  id: string; table_number: number; created_at: string;
  rounds: any[]; deliveredRounds: any[]; inProgressRounds: any[];
  awaitingCents: number; totalCents: number; alreadyCollected: number;
  availableItems: any[]; fullyPaidViaItems: boolean;
};

const sessions: SessionData[] = (rawSessions ?? []).map(session => {
  const rounds = (ordersBySession.get(session.id) ?? [])
    .sort((a: any, b: any) => a.round_number - b.round_number);
  const deliveredRounds = rounds.filter((r: any) => r.status === "delivered");
  const inProgressRounds = rounds.filter((r: any) => !["delivered", "paid", "cancelled"].includes(r.status));
  const awaitingCents = deliveredRounds.reduce((s: number, r: any) => s + (r.total_cents ?? 0), 0);
  const totalCents = rounds
    .filter((r: any) => r.status !== "cancelled")
    .reduce((s: number, r: any) => s + (r.total_cents ?? 0), 0);
  const alreadyCollected = partialPaidMap.get(session.id) ?? 0;

  // Compute remaining (unpaid) items by subtracting partial payment quantities
  const paidQtyTracker = new Map(partialPaidItemsMap.get(session.id) ?? new Map<string, number>());
  const availableItems: any[] = [];
  for (const round of deliveredRounds) {
    for (const item of (round.items as any[])) {
      const qty = item.qty ?? item.quantity ?? 1;
      const paidQty = paidQtyTracker.get(item.name) ?? 0;
      const remaining = Math.max(0, qty - paidQty);
      paidQtyTracker.set(item.name, Math.max(0, paidQty - qty));
      if (remaining > 0) {
        availableItems.push({ ...item, qty: remaining, roundNum: round.round_number });
      }
    }
  }

  const fullyPaidViaItems = deliveredRounds.length > 0 && availableItems.length === 0;
  return { ...session, rounds, deliveredRounds, inProgressRounds, awaitingCents, totalCents, alreadyCollected, availableItems, fullyPaidViaItems };
});

// Closed sessions totals
const closedTotalsMap = new Map<string, number>();
for (const o of (closedOrderTotals ?? [])) {
  if ((o as any).session_id && o.status === "paid") {
    const sid = (o as any).session_id;
    closedTotalsMap.set(sid, (closedTotalsMap.get(sid) ?? 0) + (o.total_cents ?? 0));
  }
}

// ── KPIs ──────────────────────────────────────────────────────────────────────
const activeTables    = sessions.length + legacyActive.filter((o: any) => o.status !== "delivered").length;
const awaitingCount   = sessions.filter(s => s.deliveredRounds.length > 0).length
                      + legacyActive.filter((o: any) => o.status === "delivered").length;
const paidTodayCount  = (closedSessions ?? []).length
                      + (legacyDone ?? []).filter((o: any) => o.status === "paid").length;

// ── Helpers ───────────────────────────────────────────────────────────────────
function statusBadge(status: string) {
  const map: Record<string, string> = {
    pending:   "bg-yellow-400/10 text-yellow-400 border border-yellow-400/20",
    preparing: "bg-blue-400/10 text-blue-400 border border-blue-400/20",
    ready:     "bg-green-400/10 text-green-400 border border-green-400/20",
    delivered: "bg-orange-400/10 text-orange-400 border border-orange-400/20",
    paid:      "bg-emerald-400/10 text-emerald-400 border border-emerald-400/20",
    cancelled: "bg-red-400/10 text-red-400 border border-red-400/20",
  };
  return map[status] ?? "bg-white/5 text-white/40";
}

function statusLabel(status: string) {
  if (isEl) {
    const m: Record<string, string> = {
      pending: "Εκκρεμής", preparing: "Ετοιμασία", ready: "Έτοιμη",
      delivered: "Παραδόθηκε", paid: "Πληρώθηκε", cancelled: "Ακυρώθηκε",
    };
    return m[status] ?? status;
  }
  const m: Record<string, string> = {
    pending: "Pending", preparing: "Preparing", ready: "Ready",
    delivered: "Delivered", paid: "Paid", cancelled: "Cancelled",
  };
  return m[status] ?? status;
}

function timeAgo(dateStr: string) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return t.staff.justNow;
  if (m < 60) return `${m}${t.staff.minAgo}`;
  return `${Math.floor(m / 60)}${t.staff.hmAgo} ${m % 60}${t.staff.hmMinAgo}`;
}

function fmtEur(cents: number) {
  return `€${(cents / 100).toFixed(2)}`;
}
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.staff.operations} — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
    <StaffPwa />
    <!-- Telegram Mini App SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
      .tg-app #site-header-wrap { display: none !important; }
      .tg-app .staff-subnav     { top: 0 !important; }
    </style>
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">

    <!-- Detect Telegram Mini App early to avoid layout flash -->
    <script is:inline>
      if (window.Telegram?.WebApp?.initData) {
        document.documentElement.classList.add('tg-app');
        Telegram.WebApp.ready();
        Telegram.WebApp.expand();
        Telegram.WebApp.setBackgroundColor('#0b0b10');
        Telegram.WebApp.setHeaderColor('#0b0b10');
        // No BackButton on the main operations page — swipe down closes the mini app
      }
    </script>

    <!-- Site header — hidden in Telegram Mini App -->
    <div id="site-header-wrap">
      <Header />
      <div class="h-20"></div>
    </div>

    <!-- Staff sub-nav -->
    <div class="staff-subnav sticky top-20 z-40 border-b border-sky-400/20 bg-[#0b0b10]/95 backdrop-blur">
      <div class="mx-auto max-w-4xl px-4 flex items-center justify-between">
        <nav class="flex items-center gap-1 py-2 text-sm">
          <span class="px-3 py-1.5 rounded-lg bg-sky-400/15 border border-sky-400/20 text-sky-400 font-medium">{t.staff.operations}</span>
          <a href={withLangPrefix(lang, "/staff/order")} class="px-3 py-1.5 rounded-lg text-white/50 hover:text-sky-400 hover:bg-sky-400/5 transition whitespace-nowrap">{t.staff.newOrder}</a>
        </nav>
        <div class="flex items-center gap-2 py-2">
          <span id="realtimeDot" class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse" title="Connecting…" data-token={realtimeToken}></span>
          <button id="refreshBtn" class="text-xs text-white/30 hover:text-white/60 transition">
            {t.staff.refresh}
          </button>
        </div>
      </div>
    </div>

    <!-- Live update banner (shown when order changes while payment modal is open) -->
    <div id="liveUpdateBanner" hidden class="sticky top-[4.5rem] z-50 mx-4 mt-2">
      <button onclick="window.location.reload()" class="w-full flex items-center justify-center gap-2 rounded-xl border border-sky-400/30 bg-sky-400/10 py-2.5 text-sm font-semibold text-sky-400 hover:bg-sky-400/20 transition">
        <span class="inline-block animate-spin">↻</span>
        {isEl ? "Νέα ενημέρωση — Πατήστε για ανανέωση" : "New update — tap to refresh"}
      </button>
    </div>

    <main class="mx-auto max-w-4xl px-4 py-6 space-y-8">

      <!-- KPI strip -->
      <div class="grid grid-cols-3 gap-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center">
          <p class="text-2xl font-bold text-white">{activeTables}</p>
          <p class="mt-1 text-xs text-white/40">{t.staff.activeTables}</p>
        </div>
        <div class="rounded-2xl border border-orange-400/20 bg-orange-400/5 p-4 text-center">
          <p class="text-2xl font-bold text-orange-400">{awaitingCount}</p>
          <p class="mt-1 text-xs text-orange-400/60">{t.staff.awaitingPayment}</p>
        </div>
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-4 text-center">
          <p class="text-2xl font-bold text-emerald-400">{paidTodayCount}</p>
          <p class="mt-1 text-xs text-emerald-400/60">{isEl ? "Πληρωμένα σήμερα" : "Paid today"}</p>
        </div>
      </div>

      <!-- ── Active table sessions ──────────────────────────────────────────── -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30">
            {isEl ? "Ενεργά τραπέζια" : "Active tables"}
            {sessions.length ? (
              <span class="ml-2 inline-flex items-center justify-center w-5 h-5 rounded-full bg-white/10 text-white text-xs">{sessions.length}</span>
            ) : null}
          </h2>
        </div>

        {!sessions.length && !legacyActive.length ? (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center">
            <p class="text-white/40 text-sm">{t.staff.noActiveTables}</p>
            <a href={withLangPrefix(lang, "/staff/order")} class="mt-4 inline-block text-sm text-white/60 hover:text-white transition underline underline-offset-2">
              {t.staff.takeNewOrder}
            </a>
          </div>
        ) : (
          <div class="space-y-4">
            {sessions.map((session) => {
              const roundWord = session.rounds.length === 1
                ? t.staff.roundSingular
                : t.staff.rounds;
              const remainingCents = session.awaitingCents - session.alreadyCollected;
              return (
                <div class="rounded-2xl border border-white/10 bg-white/5 overflow-hidden">
                  {/* Session header */}
                  <div class="flex items-start justify-between px-4 pt-4 pb-2">
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="text-xl font-bold text-white">{t.staff.tableLabel} {session.table_number}</span>
                        <span class="text-xs text-white/40 bg-white/8 rounded-full px-2 py-0.5">
                          {session.rounds.length} {roundWord}
                        </span>
                        {session.inProgressRounds.length > 0 && (
                          <span class="text-xs text-blue-400 bg-blue-400/10 rounded-full px-2 py-0.5">
                            {session.inProgressRounds.length} {isEl ? "σε εξέλιξη" : "in progress"}
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-white/30 mt-0.5">{timeAgo(session.created_at)}</p>
                      <div class="mt-1.5">
                        <button
                          type="button"
                          class="attach-customer-btn inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full border border-amber-400/30 text-amber-300 hover:bg-amber-400/10 transition"
                          data-session-id={session.id}
                          data-attached={session.customer_user_id ? "1" : ""}
                        >
                          {session.customer_user_id
                            ? (isEl ? "✓ Πελάτης συνδεδεμένος" : "✓ Customer attached")
                            : (isEl ? "📷 Σύνδεση κάρτας πιστότητας" : "📷 Attach loyalty card")}
                        </button>
                      </div>
                    </div>
                    {session.awaitingCents > 0 && (
                      <div class="text-right">
                        <div class="text-lg font-bold text-orange-400">{fmtEur(remainingCents > 0 ? remainingCents : session.awaitingCents)}</div>
                        <div class="text-xs text-orange-400/50">{isEl ? "αναμ. πληρωμή" : "to collect"}</div>
                        {session.alreadyCollected > 0 && (
                          <div class="text-xs text-emerald-400/60 mt-0.5">{isEl ? "ήδη" : "collected"} {fmtEur(session.alreadyCollected)}</div>
                        )}
                      </div>
                    )}
                  </div>

                  {/* Rounds list */}
                  <div class="px-4 pb-2 space-y-2">
                    {session.rounds.map((round: any) => (
                      <div class={`rounded-xl p-3 ${round.status === "delivered" ? "bg-orange-400/5 border border-orange-400/15" : "bg-white/3 border border-white/8"}`}>
                        <div class="flex items-center justify-between mb-1.5">
                          <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-white/30 w-5">{t.staff.roundShort}{round.round_number}</span>
                            <span class={`inline-flex px-2 py-0.5 rounded-full text-xs font-semibold ${statusBadge(round.status)}`}>
                              {statusLabel(round.status)}
                            </span>
                          </div>
                          <span class="text-sm font-semibold text-white/70">{fmtEur(round.total_cents ?? 0)}</span>
                        </div>
                        <div class="text-xs text-white/50 leading-relaxed">
                          {(round.items as any[]).map((i: any) => `${i.qty ?? i.quantity ?? 1}× ${i.name}`).join(" · ")}
                        </div>
                        {round.note && (
                          <div class="mt-1 text-xs text-amber-400/70">📝 {round.note}</div>
                        )}
                        {/* Per-round actions */}
                        <div class="flex items-center justify-between mt-2 pt-1.5 border-t border-white/5">
                          <span class="text-xs text-white/20">{timeAgo(round.created_at)}</span>
                          <div class="flex gap-1.5">
                            {round.status === "pending" && (
                              <button
                                class="cancel-btn text-xs text-red-400 border border-red-400/20 rounded-lg px-2.5 py-1 hover:bg-red-400/10 transition"
                                data-id={round.id}
                                data-table={session.table_number}
                              >
                                {t.staff.cancelRound}
                              </button>
                            )}
                            {round.status === "delivered" && !session.fullyPaidViaItems && (
                              <button
                                class="pay-round-btn text-xs text-emerald-400 border border-emerald-400/25 rounded-lg px-2.5 py-1 hover:bg-emerald-400/10 transition"
                                data-id={round.id}
                                data-table={session.table_number}
                                data-total={round.total_cents ?? 0}
                                data-session-id={session.id}
                                data-items={JSON.stringify(round.items)}
                              >
                                {t.staff.payThisRound}
                              </button>
                            )}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>

                  {/* Session actions */}
                  <div class="flex gap-2 px-4 pb-4 pt-3 border-t border-white/8">
                    <a
                      href={withLangPrefix(lang, `/staff/order?session=${session.id}`)}
                      class="flex-1 rounded-xl bg-sky-400/10 hover:bg-sky-400/20 border border-sky-400/20 py-2.5 text-center text-sm font-semibold text-sky-400 transition"
                    >
                      {t.staff.addRound}
                    </a>
                    {!session.fullyPaidViaItems && session.deliveredRounds.length > 0 && (
                      <>
                        {session.availableItems.length > 0 && (
                          <button
                            class="pay-items-btn flex-1 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 py-2.5 text-sm font-semibold text-white/60 transition"
                            data-session-id={session.id}
                            data-table={session.table_number}
                            data-all-items={JSON.stringify(session.availableItems)}
                          >
                            {t.staff.payItems}
                          </button>
                        )}
                        <button
                          class="pay-session-btn flex-1 rounded-xl bg-emerald-400/15 hover:bg-emerald-400/25 border border-emerald-400/30 py-2.5 text-sm font-bold text-emerald-400 transition"
                          data-session-id={session.id}
                          data-table={session.table_number}
                          data-total={session.awaitingCents}
                          data-already={session.alreadyCollected}
                        >
                          💰 {t.staff.payAll}
                        </button>
                      </>
                    )}
                  </div>
                </div>
              );
            })}

            {/* Legacy active orders (no session) */}
            {legacyActive.map((order: any) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-base font-bold text-white">{t.staff.tableLabel} {order.table_number}</span>
                  <span class={`inline-flex px-2.5 py-1 rounded-full text-xs font-semibold ${statusBadge(order.status)}`}>
                    {statusLabel(order.status)}
                  </span>
                </div>
                <div class="text-xs text-white/50">
                  {(order.items as any[]).map((i: any) => `${i.qty ?? i.quantity ?? 1}× ${i.name}`).join(" · ")}
                </div>
                <div class="flex items-center justify-between">
                  <p class="text-xs text-white/30">{timeAgo(order.created_at)}</p>
                  <div class="flex gap-2">
                    {order.status === "pending" && (
                      <button class="cancel-btn text-xs text-red-400 border border-red-400/20 rounded-lg px-2.5 py-1 hover:bg-red-400/10 transition"
                        data-id={order.id} data-table={order.table_number}>
                        {t.staff.cancelRound}
                      </button>
                    )}
                    {order.status === "delivered" && (
                      <button class="pay-round-btn text-xs text-emerald-400 border border-emerald-400/25 rounded-lg px-2.5 py-1 hover:bg-emerald-400/10 transition"
                        data-id={order.id} data-table={order.table_number}
                        data-total={order.total_cents ?? 0}
                        data-items={JSON.stringify(order.items)}>
                        💰 {isEl ? "Πλήρωσε" : "Mark Paid"}
                      </button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- ── Closed today ─────────────────────────────────────────────────────── -->
      {((closedSessions ?? []).length > 0 || (legacyDone ?? []).length > 0) && (
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">
            {t.staff.closedToday}
          </h2>
          <div class="rounded-2xl border border-white/10 overflow-hidden">
            <table class="w-full text-sm">
              <tbody>
                {(closedSessions ?? []).map(session => (
                  <tr class="border-b border-white/5 last:border-0">
                    <td class="px-4 py-3 font-semibold text-white/60">{t.staff.tableLabel} {session.table_number}</td>
                    <td class="px-4 py-3 text-white/30 text-xs">{fmtEur(closedTotalsMap.get(session.id) ?? 0)}</td>
                    <td class="px-4 py-3">
                      <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-400/10 text-emerald-400 border border-emerald-400/20">
                        {isEl ? "Πληρώθηκε" : "Paid"}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-white/30 text-xs text-right whitespace-nowrap">
                      {session.closed_at ? timeAgo(session.closed_at) : ""}
                    </td>
                  </tr>
                ))}
                {(legacyDone ?? []).map((order: any) => (
                  <tr class="border-b border-white/5 last:border-0">
                    <td class="px-4 py-3 font-semibold text-white/60">{t.staff.tableLabel} {order.table_number}</td>
                    <td class="px-4 py-3 text-white/30 text-xs">{fmtEur(order.total_cents ?? 0)}</td>
                    <td class="px-4 py-3">
                      <span class={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${statusBadge(order.status)}`}>
                        {statusLabel(order.status)}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-white/30 text-xs text-right whitespace-nowrap">{timeAgo(order.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

    </main>

    <!-- Payment modal (handles pay-round, pay-session, pay-items) -->
    <dialog id="payModal" style="background:#16161f;border:1px solid rgba(52,211,153,.2);border-radius:1.25rem;padding:0;width:min(24rem,95vw);color:#fff;max-height:95vh;overflow-y:auto;">
      <div style="padding:1.5rem;display:flex;flex-direction:column;gap:1rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <p id="payModalTitle" style="font-size:1rem;font-weight:700;"></p>
          <button id="payModalClose" style="background:none;border:none;color:rgba(255,255,255,.4);font-size:1.25rem;cursor:pointer;padding:.25rem;">✕</button>
        </div>

        <!-- Item checklist step (for pay-items mode) -->
        <div id="itemCheckStep" hidden>
          <p style="font-size:.875rem;color:rgba(255,255,255,.5);margin-bottom:.75rem;">{isEl ? t.staff.selectItemsToPay : t.staff.selectItemsToPay}</p>
          <div id="itemCheckList" style="display:flex;flex-direction:column;gap:.5rem;max-height:14rem;overflow-y:auto;"></div>
          <div style="margin-top:.75rem;padding:.75rem;background:rgba(255,255,255,.04);border-radius:.75rem;display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:.875rem;color:rgba(255,255,255,.5);">{isEl ? "Επιλεγμένο σύνολο" : "Selected total"}</span>
            <span id="itemCheckTotal" style="font-size:1.25rem;font-weight:700;color:#f97316;">€0.00</span>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin-top:.75rem;">
            <button id="itemCheckCancelBtn" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:.75rem;padding:.625rem;font-size:.875rem;color:rgba(255,255,255,.5);cursor:pointer;">{isEl ? "Πίσω" : "Back"}</button>
            <button id="itemCheckConfirmBtn" style="background:rgba(249,115,22,.15);border:1px solid rgba(249,115,22,.3);border-radius:.75rem;padding:.625rem;font-size:.875rem;font-weight:700;color:#f97316;cursor:pointer;">{isEl ? "Συνέχεια" : "Continue"}</button>
          </div>
        </div>

        <!-- Tip type step -->
        <div id="tipTypeStep">
          <p style="font-size:.875rem;color:rgba(255,255,255,.5);margin-bottom:.75rem;">{isEl ? "Λάβατε φιλοδώρημα;" : "Did you receive a tip?"}</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem;">
            <button id="tipCashBtn" style="background:rgba(250,204,21,.08);border:1px solid rgba(250,204,21,.2);border-radius:.75rem;padding:.75rem;font-size:.875rem;font-weight:600;color:#facc15;cursor:pointer;">💵 {isEl ? "Μετρητά" : "Cash"}</button>
            <button id="tipCardBtn" style="background:rgba(99,179,237,.08);border:1px solid rgba(99,179,237,.2);border-radius:.75rem;padding:.75rem;font-size:.875rem;font-weight:600;color:#63b3ed;cursor:pointer;">💳 {isEl ? "Κάρτα" : "Card"}</button>
          </div>
          <button id="tipNoTipBtn" style="margin-top:.5rem;width:100%;background:rgba(52,211,153,.1);border:1px solid rgba(52,211,153,.25);border-radius:.75rem;padding:.625rem;font-size:.875rem;font-weight:600;color:#34d399;cursor:pointer;">💰 {isEl ? "Πληρωμή χωρίς φιλοδώρημα" : "Pay — no tip"}</button>
          <button id="tipCancelBtn" style="margin-top:.375rem;width:100%;background:none;border:none;padding:.5rem;font-size:.8125rem;color:rgba(255,255,255,.25);cursor:pointer;">{isEl ? "Ακύρωση" : "Cancel"}</button>
        </div>

        <!-- Tip amount step -->
        <div id="tipAmountStep" hidden>
          <div style="text-align:center;margin-bottom:1rem;">
            <p style="font-size:.75rem;color:rgba(255,255,255,.4);margin-bottom:.25rem;">{isEl ? "Ποσό φιλοδωρήματος" : "Tip amount"}</p>
            <p style="font-size:2.5rem;font-weight:700;color:#34d399;">€<span id="tipDisplay">0.00</span></p>
          </div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:.375rem;margin-bottom:.375rem;">
            {[50,100,200,500,1000,2000,5000,10000].map(add => (
              <button class="tip-add" data-add={add} style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:.625rem;padding:.5rem .25rem;font-size:.75rem;font-weight:600;color:#fff;cursor:pointer;">
                +€{add >= 100 ? (add/100).toFixed(0) : (add/100).toFixed(2)}
              </button>
            ))}
          </div>
          <div style="display:flex;gap:.5rem;margin-bottom:.75rem;">
            <input id="tipManualInput" type="number" min="0" step="0.01" placeholder={isEl ? "Ή πληκτρολόγησε ποσό (€)" : "Or type amount (€)"}
              style="flex:1;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:.625rem;padding:.5rem .75rem;font-size:.875rem;color:#fff;outline:none;" />
            <button id="tipResetBtn" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:.625rem;padding:.5rem .75rem;font-size:.75rem;color:rgba(255,255,255,.5);cursor:pointer;">⟳</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem;">
            <button id="tipBackBtn" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:.75rem;padding:.625rem;font-size:.875rem;color:rgba(255,255,255,.5);cursor:pointer;">{isEl ? "Πίσω" : "Back"}</button>
            <button id="tipConfirmBtn" style="background:rgba(52,211,153,.15);border:1px solid rgba(52,211,153,.3);border-radius:.75rem;padding:.625rem;font-size:.875rem;font-weight:700;color:#34d399;cursor:pointer;">{isEl ? "Επιβεβαίωση" : "Confirm"}</button>
          </div>
        </div>
      </div>
    </dialog>

    <script is:inline define:vars={{ isEl }}>
      // Refresh button
      document.getElementById('refreshBtn').addEventListener('click', () => window.location.reload());

      // ── Cancel round ───────────────────────────────────────────────────────
      document.querySelectorAll('.cancel-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const table = btn.dataset.table;
          if (!confirm(isEl ? `Ακύρωση γύρου για Τραπέζι ${table};` : `Cancel round for Table ${table}?`)) return;
          btn.disabled = true;
          btn.textContent = isEl ? "Ακύρωση…" : "Cancelling…";
          try {
            const res = await fetch('/api/staff/orders', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: btn.dataset.id, action: 'cancel' }),
            });
            if (res.ok) { window.location.reload(); return; }
            const j = await res.json().catch(() => ({}));
            alert((isEl ? 'Σφάλμα: ' : 'Error: ') + (j.error ?? 'Unknown'));
          } catch { alert(isEl ? 'Σφάλμα δικτύου.' : 'Network error.'); }
          btn.disabled = false;
          btn.textContent = isEl ? 'Ακύρωση' : 'Cancel';
        });
      });

      // ── Payment modal state ────────────────────────────────────────────────
      const payModal       = document.getElementById('payModal');
      const tipTypeStep    = document.getElementById('tipTypeStep');
      const tipAmtStep     = document.getElementById('tipAmountStep');
      const itemCheckStep  = document.getElementById('itemCheckStep');
      const tipDisplay     = document.getElementById('tipDisplay');
      const tipConfirm     = document.getElementById('tipConfirmBtn');
      const tipManual      = document.getElementById('tipManualInput');
      const itemCheckList  = document.getElementById('itemCheckList');
      const itemCheckTotal = document.getElementById('itemCheckTotal');

      // mode: "round" | "session" | "items"
      let payMode        = 'round';
      let currentOrderId = null;   // for "round" mode
      let currentSessionId = null; // for "session" / "items" mode
      let currentPayAmount = 0;    // cents — what's being paid (calculated)
      let currentTipType = null;
      let tipCents = 0;
      let allSessionItems = [];    // for items mode

      function showStep(step) {
        itemCheckStep.hidden  = step !== 'items';
        tipTypeStep.hidden    = step !== 'tip-type';
        tipAmtStep.hidden     = step !== 'tip-amount';
      }

      function updateTipDisplay() {
        tipDisplay.textContent = (tipCents / 100).toFixed(2);
        tipConfirm.textContent = tipCents > 0
          ? (isEl ? `Επιβεβαίωση €${(tipCents/100).toFixed(2)}` : `Confirm €${(tipCents/100).toFixed(2)}`)
          : (isEl ? 'Επιβεβαίωση (χωρίς)' : 'Confirm (no tip)');
      }

      function resetModal() {
        currentTipType = null;
        tipCents = 0;
        tipManual.value = '';
        updateTipDisplay();
      }

      function openPayModal(title, mode, orderId, sessionId, amountCents, items) {
        document.getElementById('payModalTitle').textContent = title;
        payMode = mode;
        currentOrderId = orderId;
        currentSessionId = sessionId;
        currentPayAmount = amountCents;
        allSessionItems = items ?? [];
        resetModal();

        if (mode === 'items') {
          buildItemChecklist();
          showStep('items');
        } else {
          showStep('tip-type');
        }
        payModal.showModal();
      }

      // Build item checklist for "pay items" mode
      function buildItemChecklist() {
        itemCheckList.innerHTML = '';
        allSessionItems.forEach((item, idx) => {
          const price = (item.price_cents ?? 0) * (item.qty ?? item.quantity ?? 1);
          const row = document.createElement('label');
          row.style = 'display:flex;align-items:center;gap:.625rem;padding:.5rem .75rem;background:rgba(255,255,255,.04);border-radius:.625rem;cursor:pointer;';
          row.innerHTML = `
            <input type="checkbox" data-idx="${idx}" data-price="${price}" class="item-check"
              style="width:1rem;height:1rem;accent-color:#f97316;cursor:pointer;" />
            <span style="flex:1;font-size:.8125rem;color:rgba(255,255,255,.8);">
              <span style="background:rgba(255,255,255,.1);border-radius:.25rem;padding:.1rem .35rem;font-size:.7rem;margin-right:.375rem;">
                ${isEl ? 'Γ' : 'R'}${item.roundNum ?? ''}
              </span>
              ${item.qty ?? item.quantity ?? 1}× ${item.name}
            </span>
            <span style="font-size:.8125rem;color:rgba(255,255,255,.4);">€${(price/100).toFixed(2)}</span>
          `;
          itemCheckList.appendChild(row);
        });
        updateItemCheckTotal();
        // Wire checkboxes
        itemCheckList.querySelectorAll('.item-check').forEach(cb => {
          cb.addEventListener('change', updateItemCheckTotal);
        });
      }

      function updateItemCheckTotal() {
        let total = 0;
        itemCheckList.querySelectorAll('.item-check:checked').forEach(cb => {
          total += parseInt(cb.dataset.price ?? '0');
        });
        itemCheckTotal.textContent = `€${(total/100).toFixed(2)}`;
        document.getElementById('itemCheckConfirmBtn').dataset.total = total;
        const selectedItems = [];
        itemCheckList.querySelectorAll('.item-check:checked').forEach(cb => {
          const idx = parseInt(cb.dataset.idx);
          selectedItems.push(allSessionItems[idx]);
        });
        document.getElementById('itemCheckConfirmBtn').dataset.items = JSON.stringify(selectedItems);
      }

      // ── Wire pay-round buttons ─────────────────────────────────────────────
      document.querySelectorAll('.pay-round-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const table = btn.dataset.table;
          const total = parseInt(btn.dataset.total ?? '0');
          const title = `${isEl ? 'Τραπέζι' : 'Table'} ${table} — ${isEl ? 'Γύρος' : 'Round'} — €${(total/100).toFixed(2)}`;
          openPayModal(title, 'round', btn.dataset.id, btn.dataset.sessionId ?? null, total, null);
        });
      });

      // ── Wire pay-session buttons ───────────────────────────────────────────
      document.querySelectorAll('.pay-session-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const table  = btn.dataset.table;
          const total  = parseInt(btn.dataset.total ?? '0');
          const already = parseInt(btn.dataset.already ?? '0');
          const remaining = total - already;
          const displayAmt = remaining > 0 ? remaining : total;
          const title  = `${isEl ? 'Τραπέζι' : 'Table'} ${table} — €${(displayAmt/100).toFixed(2)}`;
          openPayModal(title, 'session', null, btn.dataset.sessionId, displayAmt, null);
        });
      });

      // ── Wire pay-items buttons ─────────────────────────────────────────────
      document.querySelectorAll('.pay-items-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const table = btn.dataset.table;
          let items = [];
          try { items = JSON.parse(btn.dataset.allItems ?? '[]'); } catch {}
          const title = `${isEl ? 'Τραπέζι' : 'Table'} ${table} — ${isEl ? 'Επιλογή ειδών' : 'Select items'}`;
          openPayModal(title, 'items', null, btn.dataset.sessionId, 0, items);
        });
      });

      // ── Modal close ────────────────────────────────────────────────────────
      document.getElementById('payModalClose').addEventListener('click', () => payModal.close());

      // ── Item checklist: continue → tip type ───────────────────────────────
      document.getElementById('itemCheckConfirmBtn').addEventListener('click', (e) => {
        const total = parseInt(e.target.dataset.total ?? '0');
        if (total <= 0) {
          alert(isEl ? 'Επιλέξτε τουλάχιστον ένα είδος.' : 'Select at least one item.');
          return;
        }
        currentPayAmount = total;
        try { allSessionItems = JSON.parse(e.target.dataset.items ?? '[]'); } catch {}
        showStep('tip-type');
      });
      document.getElementById('itemCheckCancelBtn').addEventListener('click', () => payModal.close());

      // ── Tip type selection ─────────────────────────────────────────────────
      document.getElementById('tipCashBtn').addEventListener('click', () => {
        currentTipType = 'cash';
        showStep('tip-amount');
      });
      document.getElementById('tipCardBtn').addEventListener('click', () => {
        currentTipType = 'card';
        showStep('tip-amount');
      });
      document.getElementById('tipNoTipBtn').addEventListener('click', () => {
        doSubmitPayment(0, null);
      });
      document.getElementById('tipCancelBtn').addEventListener('click', () => payModal.close());

      document.getElementById('tipBackBtn').addEventListener('click', () => {
        tipCents = 0;
        tipManual.value = '';
        updateTipDisplay();
        showStep(payMode === 'items' ? 'items' : 'tip-type');
      });

      document.querySelectorAll('.tip-add').forEach(btn => {
        btn.addEventListener('click', () => {
          tipCents = Math.min(tipCents + parseInt(btn.dataset.add), 99999);
          tipManual.value = '';
          updateTipDisplay();
        });
      });
      tipManual.addEventListener('input', () => {
        const v = parseFloat(tipManual.value);
        tipCents = isNaN(v) || v < 0 ? 0 : Math.min(Math.round(v * 100), 99999);
        updateTipDisplay();
      });
      document.getElementById('tipResetBtn').addEventListener('click', () => {
        tipCents = 0;
        tipManual.value = '';
        updateTipDisplay();
      });
      tipConfirm.addEventListener('click', () => {
        doSubmitPayment(tipCents, tipCents > 0 ? currentTipType : null);
      });

      // ── Submit payment ─────────────────────────────────────────────────────
      async function doSubmitPayment(tipAmt, tipType) {
        tipConfirm.disabled = true;
        document.getElementById('tipNoTipBtn').disabled = true;

        let body;
        if (payMode === 'round') {
          body = { id: currentOrderId, action: 'paid', tip_amount_cents: tipAmt, tip_type: tipType };
        } else if (payMode === 'session') {
          body = { action: 'pay_session', session_id: currentSessionId, tip_amount_cents: tipAmt, tip_type: tipType };
        } else {
          // pay-items: partial payment
          body = {
            action: 'partial_pay',
            session_id: currentSessionId,
            amount_cents: currentPayAmount,
            tip_amount_cents: tipAmt,
            tip_type: tipType,
            items_snapshot: allSessionItems,
          };
        }

        try {
          const res = await fetch('/api/staff/orders', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (res.ok) { payModal.close(); window.location.reload(); return; }
          const j = await res.json().catch(() => ({}));
          alert((isEl ? 'Σφάλμα: ' : 'Error: ') + (j.error ?? 'Unknown'));
        } catch {
          alert(isEl ? 'Σφάλμα δικτύου.' : 'Network error.');
        }
        tipConfirm.disabled = false;
        document.getElementById('tipNoTipBtn').disabled = false;
      }
    </script>
    <!-- Supabase Realtime: live-reload when any order changes -->
    <script>
      import { createClient } from '@supabase/supabase-js';

      const tipModal = document.getElementById('payModal') as HTMLDialogElement | null;
      const banner   = document.getElementById('liveUpdateBanner') as HTMLElement | null;
      const dot      = document.getElementById('realtimeDot') as HTMLElement | null;

      const token = dot?.dataset.token ?? '';
      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
        { realtime: { params: { eventsPerSecond: 10 } } }
      );
      // Authenticate the realtime connection with the user's session token
      // so RLS policies let events through
      if (token) supabase.realtime.setAuth(token);

      let reloadScheduled = false;

      function setDot(state: 'connecting' | 'live' | 'error') {
        if (!dot) return;
        dot.title = state === 'live' ? 'Live' : state === 'error' ? 'Disconnected' : 'Connecting…';
        dot.className = state === 'live'
          ? 'w-2 h-2 rounded-full bg-emerald-400'
          : state === 'error'
          ? 'w-2 h-2 rounded-full bg-red-400'
          : 'w-2 h-2 rounded-full bg-yellow-400 animate-pulse';
      }

      function handleOrderChange() {
        if (reloadScheduled) return;
        if (tipModal?.open) {
          if (banner) banner.hidden = false;
          return;
        }
        reloadScheduled = true;
        setTimeout(() => window.location.reload(), 600);
      }

      tipModal?.addEventListener('close', () => {
        if (banner && !banner.hidden) {
          window.location.reload();
        }
      });

      supabase
        .channel('staff-live')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'orders' }, handleOrderChange)
        .on('postgres_changes', { event: '*', schema: 'public', table: 'table_sessions' }, handleOrderChange)
        .subscribe((status) => {
          console.debug('[realtime] status:', status);
          if (status === 'SUBSCRIBED') setDot('live');
          else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT' || status === 'CLOSED') setDot('error');
          else setDot('connecting');
        });
    </script>

    <!-- Loyalty attach modal -->
    <dialog id="attachModal" class="rounded-2xl p-0 bg-[#14141c] text-white w-[min(92vw,420px)] border border-white/10 backdrop:bg-black/70">
      <div class="p-5 space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="font-semibold">Attach loyalty card</h3>
          <button type="button" id="attachClose" class="text-white/60 hover:text-white text-xl leading-none">×</button>
        </div>
        <video id="attachVideo" class="w-full rounded-xl bg-black aspect-square object-cover" playsinline muted></video>
        <div class="space-y-2">
          <label class="text-xs text-white/40 uppercase tracking-wider">Or paste code</label>
          <input id="attachManual" type="text" placeholder="loyalty:xxxxxxxx-xxxx-..." class="w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm" />
          <button type="button" id="attachSubmit" class="w-full px-4 py-2 rounded-xl bg-amber-400 text-black text-sm font-semibold hover:bg-amber-300 transition">Attach</button>
        </div>
        <p id="attachMsg" class="text-xs hidden"></p>
      </div>
    </dialog>

    <script>
      (() => {
        const modal = document.getElementById("attachModal") as HTMLDialogElement | null;
        if (!modal) return;
        const video = document.getElementById("attachVideo") as HTMLVideoElement;
        const manual = document.getElementById("attachManual") as HTMLInputElement;
        const submit = document.getElementById("attachSubmit") as HTMLButtonElement;
        const msg = document.getElementById("attachMsg") as HTMLElement;
        const closeBtn = document.getElementById("attachClose") as HTMLButtonElement;
        let currentSessionId: string | null = null;
        let stream: MediaStream | null = null;
        let scanRaf = 0;
        let detector: any = null;

        function setMsg(text: string, ok: boolean) {
          msg.textContent = text;
          msg.className = "text-xs block " + (ok ? "text-green-400" : "text-red-400");
        }

        async function startScan() {
          const BD = (window as any).BarcodeDetector;
          if (!BD) return;
          try {
            detector = new BD({ formats: ["qr_code"] });
            stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } });
            video.srcObject = stream;
            await video.play();
            const tick = async () => {
              if (!detector || !video.videoWidth) { scanRaf = requestAnimationFrame(tick); return; }
              try {
                const codes = await detector.detect(video);
                if (codes?.length) {
                  const raw = codes[0].rawValue as string;
                  if (raw?.startsWith("loyalty:")) {
                    await attach(raw);
                    return;
                  }
                }
              } catch {}
              scanRaf = requestAnimationFrame(tick);
            };
            scanRaf = requestAnimationFrame(tick);
          } catch (e) {
            console.warn("camera unavailable", e);
          }
        }

        function stopScan() {
          cancelAnimationFrame(scanRaf);
          if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
          video.srcObject = null;
        }

        async function attach(code: string) {
          if (!currentSessionId) return;
          submit.disabled = true;
          try {
            const res = await fetch("/api/staff/attach-customer", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ session_id: currentSessionId, loyalty_code: code }),
            });
            const json = await res.json().catch(() => ({}));
            if (res.ok) {
              setMsg(`✓ Attached ${json.customer?.name ?? ""}`, true);
              setTimeout(() => { modal.close(); stopScan(); window.location.reload(); }, 800);
            } else {
              setMsg(json.error ?? "Error", false);
            }
          } catch {
            setMsg("Network error", false);
          } finally {
            submit.disabled = false;
          }
        }

        document.querySelectorAll(".attach-customer-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            currentSessionId = (btn as HTMLElement).dataset.sessionId ?? null;
            manual.value = "";
            msg.className = "text-xs hidden";
            modal.showModal();
            startScan();
          });
        });

        submit.addEventListener("click", () => {
          const val = manual.value.trim();
          if (val) attach(val);
        });

        closeBtn.addEventListener("click", () => { modal.close(); stopScan(); });
        modal.addEventListener("close", stopScan);
      })();
    </script>
  </body>
</html>
