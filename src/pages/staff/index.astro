---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import { supabaseAdmin } from "../../lib/supabase";
import { dict, withLangPrefix } from "../../i18n";

const lang = Astro.locals.lang ?? "en";
const t = dict[lang];
const user = Astro.locals.user;
const displayName = user?.user_metadata?.full_name?.split(" ")[0] ?? user?.email?.split("@")[0] ?? "Staff";

const today = new Date();
today.setHours(0, 0, 0, 0);

// Active = anything not yet fully closed (pending/preparing/ready/delivered-awaiting-payment)
const { data: activeOrders } = await supabaseAdmin
  .from("orders")
  .select("id,table_number,items,status,note,total_cents,created_at")
  .not("status", "in", '("paid","cancelled")')
  .gte("created_at", today.toISOString())
  .order("created_at", { ascending: true });

// Completed today = paid + cancelled
const { data: recentDone } = await supabaseAdmin
  .from("orders")
  .select("id,table_number,items,status,created_at")
  .in("status", ["paid", "cancelled"])
  .gte("created_at", today.toISOString())
  .order("created_at", { ascending: false })
  .limit(10);

// Split active into "in progress" vs "delivered but unpaid"
const inProgress    = (activeOrders ?? []).filter(o => o.status !== "delivered");
const awaitingPayment = (activeOrders ?? []).filter(o => o.status === "delivered");

function statusBadge(status: string) {
  const map: Record<string, string> = {
    pending:   "bg-yellow-400/10 text-yellow-400 border border-yellow-400/20",
    preparing: "bg-blue-400/10 text-blue-400 border border-blue-400/20",
    ready:     "bg-green-400/10 text-green-400 border border-green-400/20",
    delivered: "bg-orange-400/10 text-orange-400 border border-orange-400/20",
    paid:      "bg-emerald-400/10 text-emerald-400 border border-emerald-400/20",
    cancelled: "bg-red-400/10 text-red-400 border border-red-400/20",
  };
  return map[status] ?? "bg-white/5 text-white/40";
}

function statusLabel(status: string, isEl: boolean) {
  if (isEl) {
    const m: Record<string, string> = {
      pending: "Εκκρεμής", preparing: "Ετοιμασία", ready: "Έτοιμη",
      delivered: "Παραδόθηκε", paid: "Πληρώθηκε", cancelled: "Ακυρώθηκε",
    };
    return m[status] ?? status;
  }
  const m: Record<string, string> = {
    pending: "Pending", preparing: "Preparing", ready: "Ready",
    delivered: "Delivered", paid: "Paid", cancelled: "Cancelled",
  };
  return m[status] ?? status;
}

const isEl = lang === "el";

function timeAgo(dateStr: string) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return t.staff.justNow;
  if (m < 60) return `${m}${t.staff.minAgo}`;
  return `${Math.floor(m / 60)}${t.staff.hmAgo} ${m % 60}${t.staff.hmMinAgo}`;
}
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.staff.operations} — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
    <!-- Telegram Mini App SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
      .tg-app #site-header-wrap { display: none !important; }
      .tg-app .staff-subnav     { top: 0 !important; }
    </style>
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">

    <!-- Detect Telegram Mini App early to avoid layout flash -->
    <script is:inline>
      if (window.Telegram?.WebApp?.initData) {
        document.documentElement.classList.add('tg-app');
        Telegram.WebApp.ready();
        Telegram.WebApp.expand();
        Telegram.WebApp.setBackgroundColor('#0b0b10');
        Telegram.WebApp.setHeaderColor('#0b0b10');
        // No BackButton on the main operations page — swipe down closes the mini app
      }
    </script>

    <!-- Site header — hidden in Telegram Mini App -->
    <div id="site-header-wrap">
      <Header />
      <div class="h-20"></div>
    </div>

    <!-- Staff sub-nav -->
    <div class="staff-subnav sticky top-20 z-40 border-b border-sky-400/20 bg-[#0b0b10]/95 backdrop-blur">
      <div class="mx-auto max-w-4xl px-4 flex items-center justify-between">
        <nav class="flex items-center gap-1 py-2 text-sm">
          <span class="px-3 py-1.5 rounded-lg bg-sky-400/15 border border-sky-400/20 text-sky-400 font-medium">{t.staff.operations}</span>
          <a href={withLangPrefix(lang, "/staff/order")} class="px-3 py-1.5 rounded-lg text-white/50 hover:text-sky-400 hover:bg-sky-400/5 transition whitespace-nowrap">{t.staff.newOrder}</a>
        </nav>
        <button id="refreshBtn" class="text-xs text-white/30 hover:text-white/60 transition py-2">
          {t.staff.refresh}
        </button>
      </div>
    </div>

    <main class="mx-auto max-w-4xl px-4 py-6 space-y-8">

      <!-- KPI strip -->
      <div class="grid grid-cols-3 gap-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center">
          <p class="text-2xl font-bold text-white">{inProgress.length}</p>
          <p class="mt-1 text-xs text-white/40">{isEl ? "Σε εξέλιξη" : "In progress"}</p>
        </div>
        <div class="rounded-2xl border border-orange-400/20 bg-orange-400/5 p-4 text-center">
          <p class="text-2xl font-bold text-orange-400">{awaitingPayment.length}</p>
          <p class="mt-1 text-xs text-orange-400/60">{isEl ? "Αναμ. πληρωμή" : "Awaiting payment"}</p>
        </div>
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-4 text-center">
          <p class="text-2xl font-bold text-emerald-400">{(recentDone ?? []).filter(o => o.status === "paid").length}</p>
          <p class="mt-1 text-xs text-emerald-400/60">{isEl ? "Πληρωμένες σήμερα" : "Paid today"}</p>
        </div>
      </div>

      <!-- In-progress orders -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30">
            {isEl ? "Σε εξέλιξη" : "In progress"}
            {inProgress.length ? (
              <span class="ml-2 inline-flex items-center justify-center w-5 h-5 rounded-full bg-white/10 text-white text-xs">
                {inProgress.length}
              </span>
            ) : null}
          </h2>
        </div>

        {!inProgress.length ? (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center">
            <p class="text-white/40 text-sm">{t.staff.noActiveOrders}</p>
            <a href={withLangPrefix(lang, "/staff/order")} class="mt-4 inline-block text-sm text-white/60 hover:text-white transition underline underline-offset-2">
              {t.staff.takeNewOrder}
            </a>
          </div>
        ) : (
          <div class="grid sm:grid-cols-2 gap-3">
            {inProgress.map((order) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-lg font-bold text-white">{t.staff.tableLabel} {order.table_number}</span>
                  <span class={`inline-flex px-2.5 py-1 rounded-full text-xs font-semibold ${statusBadge(order.status)}`}>
                    {statusLabel(order.status, isEl)}
                  </span>
                </div>
                <ul class="space-y-1">
                  {(order.items as any[]).map((item: any) => (
                    <li class="flex items-center gap-2 text-sm text-white/70">
                      <span class="w-6 h-6 flex items-center justify-center rounded-md bg-white/10 text-white text-xs font-semibold">{item.qty ?? item.quantity ?? 1}</span>
                      {item.name}
                    </li>
                  ))}
                </ul>
                {order.note && (
                  <p class="text-xs text-amber-400/70 bg-amber-400/5 border border-amber-400/10 rounded-lg px-3 py-2">
                    📝 {order.note}
                  </p>
                )}
                <p class="text-xs text-white/30">{timeAgo(order.created_at)}</p>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Awaiting payment -->
      {awaitingPayment.length > 0 && (
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-orange-400/60">
              💰 {isEl ? "Παραδόθηκαν — αναμένουν πληρωμή" : "Delivered — awaiting payment"}
            </h2>
            <span class="text-sm font-bold text-orange-400">
              {isEl ? "Σύνολο: " : "Total to collect: "}
              €{(awaitingPayment.reduce((s, o) => s + ((o as any).total_cents ?? 0), 0) / 100).toFixed(2)}
            </span>
          </div>
          <div class="grid sm:grid-cols-2 gap-3">
            {awaitingPayment.map((order) => (
              <div class="rounded-2xl border border-orange-400/25 bg-orange-400/5 p-5 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-lg font-bold text-white">{t.staff.tableLabel} {order.table_number}</span>
                  <span class="text-xl font-bold text-orange-400">
                    €{(((order as any).total_cents ?? 0) / 100).toFixed(2)}
                  </span>
                </div>
                <ul class="space-y-1">
                  {(order.items as any[]).map((item: any) => (
                    <li class="flex items-center gap-2 text-sm text-white/70">
                      <span class="w-6 h-6 flex items-center justify-center rounded-md bg-white/10 text-white text-xs font-semibold">{item.qty ?? item.quantity ?? 1}</span>
                      {item.name}
                      {item.price_cents && (
                        <span class="ml-auto text-xs text-white/30">€{((item.price_cents * (item.qty ?? item.quantity ?? 1)) / 100).toFixed(2)}</span>
                      )}
                    </li>
                  ))}
                </ul>
                <div class="flex items-center justify-between pt-1 border-t border-white/10">
                  <p class="text-xs text-white/30">{timeAgo(order.created_at)}</p>
                  <span class="text-xs font-semibold text-orange-400/80">
                    {isEl ? "Εισπράξτε: " : "Collect: "}€{(((order as any).total_cents ?? 0) / 100).toFixed(2)}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Completed today (paid + cancelled) -->
      {recentDone?.length ? (
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">
            {isEl ? "Ολοκληρώθηκαν σήμερα" : "Completed today"}
          </h2>
          <div class="rounded-2xl border border-white/10 overflow-hidden">
            <table class="w-full text-sm">
              <tbody>
                {recentDone.map((order) => (
                  <tr class="border-b border-white/5 last:border-0">
                    <td class="px-4 py-3 font-semibold text-white/60">{t.staff.tableLabel} {order.table_number}</td>
                    <td class="px-4 py-3 text-white/30 text-xs">
                      {(order.items as any[]).map((i: any) => `${i.qty ?? i.quantity ?? 1}× ${i.name}`).join(", ")}
                    </td>
                    <td class="px-4 py-3">
                      <span class={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${statusBadge(order.status)}`}>
                        {statusLabel(order.status, isEl)}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-white/30 text-xs text-right whitespace-nowrap">{timeAgo(order.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : null}

    </main>

    <script is:inline>
      const isTg = !!(window.Telegram?.WebApp?.initData);

      // Refresh button — always works
      document.getElementById('refreshBtn').addEventListener('click', () => window.location.reload());

      // Auto-refresh: only in browser (Telegram keeps the connection open)
      if (!isTg) {
        setTimeout(() => window.location.reload(), 30000);
      }
    </script>
  </body>
</html>
