---
import "../../styles/global.css";
import { supabaseAdmin } from "../../lib/supabase";

const user = Astro.locals.user;
const displayName = user?.user_metadata?.full_name?.split(" ")[0] ?? user?.email?.split("@")[0] ?? "Staff";

const today = new Date();
today.setHours(0, 0, 0, 0);

const { data: activeOrders } = await supabaseAdmin
  .from("orders")
  .select("id,table_number,items,status,note,created_at")
  .not("status", "in", '("delivered","cancelled")')
  .gte("created_at", today.toISOString())
  .order("created_at", { ascending: true });

const { data: recentDone } = await supabaseAdmin
  .from("orders")
  .select("id,table_number,items,status,created_at")
  .in("status", ["delivered", "cancelled"])
  .gte("created_at", today.toISOString())
  .order("created_at", { ascending: false })
  .limit(5);

function statusBadge(status: string) {
  const map: Record<string, string> = {
    pending:   "bg-yellow-400/10 text-yellow-400 border border-yellow-400/20",
    preparing: "bg-blue-400/10 text-blue-400 border border-blue-400/20",
    ready:     "bg-green-400/10 text-green-400 border border-green-400/20",
    delivered: "bg-white/5 text-white/30 border border-white/10",
    cancelled: "bg-red-400/10 text-red-400 border border-red-400/20",
  };
  return map[status] ?? "bg-white/5 text-white/40";
}

function timeAgo(dateStr: string) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  return `${Math.floor(m / 60)}h ${m % 60}m ago`;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Dashboard — Sally's Bar</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-[#0b0b10] text-white">

    <!-- Top nav -->
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0b0b10]/90 backdrop-blur">
      <div class="mx-auto max-w-4xl px-4 py-3 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <a href="/" class="text-white/50 hover:text-white transition text-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline -mt-0.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </a>
          <span class="text-sm font-semibold text-white/90">Operations</span>
        </div>
        <div class="flex items-center gap-2">
          <a href="/staff/order" class="rounded-lg bg-white px-4 py-1.5 text-sm font-semibold text-black hover:bg-white/90 transition">
            + New Order
          </a>
          <button onclick="window.location.reload()" class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-white/60 hover:bg-white/10 transition">
            Refresh
          </button>
          <span class="hidden sm:block text-sm text-white/30">{displayName}</span>
          <a href="/logout" class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-white/60 hover:bg-white/10 transition">Out</a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-6 space-y-6">

      <!-- Active orders -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30">
            Active orders
            {activeOrders?.length ? (
              <span class="ml-2 inline-flex items-center justify-center w-5 h-5 rounded-full bg-white/10 text-white text-xs">
                {activeOrders.length}
              </span>
            ) : null}
          </h2>
        </div>

        {!activeOrders?.length ? (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-10 text-center">
            <p class="text-white/40 text-sm">No active orders right now</p>
            <a href="/staff/order" class="mt-4 inline-block text-sm text-white/60 hover:text-white transition underline underline-offset-2">
              Take a new order
            </a>
          </div>
        ) : (
          <div class="grid sm:grid-cols-2 gap-3">
            {activeOrders.map((order) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-lg font-bold text-white">Table {order.table_number}</span>
                  <span class={`inline-flex px-2.5 py-1 rounded-full text-xs font-semibold ${statusBadge(order.status)}`}>
                    {order.status}
                  </span>
                </div>
                <ul class="space-y-1">
                  {(order.items as any[]).map((item: any) => (
                    <li class="flex items-center gap-2 text-sm text-white/70">
                      <span class="w-6 h-6 flex items-center justify-center rounded-md bg-white/10 text-white text-xs font-semibold">{item.quantity ?? 1}</span>
                      {item.name}
                    </li>
                  ))}
                </ul>
                {order.note && (
                  <p class="text-xs text-amber-400/70 bg-amber-400/5 border border-amber-400/10 rounded-lg px-3 py-2">
                    Note: {order.note}
                  </p>
                )}
                <p class="text-xs text-white/30">{timeAgo(order.created_at)}</p>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Recently done -->
      {recentDone?.length ? (
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">Completed today</h2>
          <div class="rounded-2xl border border-white/10 overflow-hidden">
            <table class="w-full text-sm">
              <tbody>
                {recentDone.map((order) => (
                  <tr class="border-b border-white/5 last:border-0">
                    <td class="px-4 py-3 font-medium text-white/50">#{order.table_number}</td>
                    <td class="px-4 py-3 text-white/30 text-xs">
                      {(order.items as any[]).map((i: any) => `${i.quantity ?? 1}× ${i.name}`).join(", ")}
                    </td>
                    <td class="px-4 py-3">
                      <span class={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${statusBadge(order.status)}`}>
                        {order.status}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-white/30 text-xs text-right whitespace-nowrap">{timeAgo(order.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : null}

    </main>

    <!-- Auto-refresh every 30s -->
    <script is:inline>
      setTimeout(() => window.location.reload(), 30000);
    </script>
  </body>
</html>
