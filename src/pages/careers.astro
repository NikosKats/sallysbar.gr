---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { supabaseAdmin } from "../lib/supabase";

import { site } from "../data/site";
import en from "../i18n/en";
import el from "../i18n/el";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";
const t = isEl ? el : en;

const title = `${t.careers.title} • ${site.name}`;
const canonical = isEl ? "https://sallysbar.gr/el/careers" : "https://sallysbar.gr/careers";

const { data: jobs } = await supabaseAdmin
  .from("job_listings")
  .select("id, title_en, title_el, department, employment_type, location, description_en, description_el, requirements_en, requirements_el, salary_range, apply_email")
  .eq("active", true)
  .order("sort_order", { ascending: true })
  .order("created_at", { ascending: false });

const empLabel = (k: string | null) => {
  if (!k) return "";
  const m: Record<string, [string, string]> = {
    full_time: ["Full-time", "Πλήρης"],
    part_time: ["Part-time", "Μερική"],
    seasonal:  ["Seasonal", "Εποχική"],
    contract:  ["Contract", "Συμβόλαιο"],
  };
  return m[k] ? (isEl ? m[k][1] : m[k][0]) : k;
};
const perks = isEl ? {
  join: "Έλα στην Ομάδα",
  p1Title: "Καλοκαίρι στην Κεφαλονιά", p1Text: "Περάστε τη σεζόν σε ένα από τα πιο όμορφα νησιά της Ελλάδας.",
  p2Title: "Φιλική ομάδα", p2Text: "Ντόπιοι, expats και ταξιδιώτες δουλεύουν μαζί κάθε βράδυ.",
  p3Title: "Καλά φιλοδωρήματα", p3Text: "Πολυσύχναστο μπαρ, γενναιόδωροι επισκέπτες — η προσπάθεια ανταμείβεται.",
} : {
  join: "Join The Team",
  p1Title: "Summer in Kefalonia", p1Text: "Spend the season on one of Greece's most beautiful islands.",
  p2Title: "Friendly team", p2Text: "Locals, expats, and travellers working side-by-side every night.",
  p3Title: "Great tips", p3Text: "Busy bar, generous guests — your hustle pays off.",
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <style>
      .share-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 34px; height: 34px; border-radius: 10px; color: white; font-weight: 700;
        font-size: 14px; text-decoration: none; cursor: pointer; border: 0; transition: transform .15s, opacity .15s;
      }
      .share-btn:hover { transform: translateY(-1px); opacity: .9; }
    </style>
  </head>

  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased overflow-x-hidden">
    <div class="pointer-events-none fixed inset-0 -z-10 opacity-70">
      <div class="hidden md:block absolute top-10 left-1/4 h-[560px] w-[560px] rounded-full bg-amber-400/10 blur-[160px]"></div>
      <div class="hidden md:block absolute bottom-10 right-10 h-[460px] w-[460px] rounded-full bg-fuchsia-500/10 blur-[140px]"></div>
    </div>

    <Header />

    <main class="mx-auto max-w-3xl px-6 py-16 pt-32">
      <div class="text-xs uppercase tracking-[0.28em] text-amber-200/80 mb-4">{perks.join}</div>
      <h1 class="font-heading text-5xl md:text-6xl font-bold leading-[0.95] bg-gradient-to-br from-white via-amber-50 to-amber-200/80 bg-clip-text text-transparent">
        {t.careers.title}
      </h1>
      <p class="mt-6 text-lg text-white/70 leading-relaxed max-w-2xl">{t.careers.subtitle}</p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-amber-200 to-amber-400 px-7 py-3.5 font-semibold text-black shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 hover:scale-[1.02] active:scale-[0.98] transition"
          href={site.socials.instagram}
          target="_blank"
        >
          <span class="relative z-10 flex items-center gap-2">✉️ {t.careers.msgInstagram}</span>
          <span class="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent opacity-0 group-hover:opacity-100 transition"></span>
        </a>

        <a
          class="rounded-2xl border border-white/25 bg-white/5 md:backdrop-blur px-7 py-3.5 font-semibold hover:bg-white/10 hover:border-white/40 transition"
          href={`tel:${site.phoneE164}`}
        >
          📞 {t.careers.call}
        </a>
      </div>

      <!-- Open positions -->
      {jobs && jobs.length > 0 && (
        <section class="mt-14 space-y-4">
          <h2 class="font-heading text-2xl font-semibold">{isEl ? "Ανοιχτές θέσεις" : "Open positions"}</h2>
          <div class="space-y-4">
            {jobs.map(j => {
              const jt    = isEl ? j.title_el : j.title_en;
              const jdesc = isEl ? j.description_el : j.description_en;
              const jreq  = (isEl ? j.requirements_el : j.requirements_en) ?? "";
              const reqs  = jreq.split("\n").map((s: string) => s.trim()).filter(Boolean);
              const jobUrl = `${canonical}#job-${j.id}`;
              const shareText = encodeURIComponent(`${jt} — ${site.name}`);
              const shareUrl  = encodeURIComponent(jobUrl);
              return (
                <article id={`job-${j.id}`} class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 scroll-mt-32">
                  <div class="flex items-start justify-between gap-3 flex-wrap">
                    <div>
                      <h3 class="font-heading text-xl font-semibold">{jt}</h3>
                      <p class="text-xs text-white/50 mt-1">
                        {j.department && <span class="mr-2">{j.department}</span>}
                        {j.employment_type && <span class="mr-2 inline-block px-2 py-0.5 rounded-full bg-amber-400/15 text-amber-300">{empLabel(j.employment_type)}</span>}
                        <span>📍 {j.location}</span>
                        {j.salary_range && <span class="ml-2">· 💰 {j.salary_range}</span>}
                      </p>
                    </div>
                    <button type="button" class="apply-btn shrink-0 rounded-xl bg-amber-400 text-black px-4 py-2 text-sm font-semibold hover:bg-amber-300 transition"
                      data-job-id={j.id} data-job-title={jt}>
                      {isEl ? "Αίτηση" : "Apply"}
                    </button>
                  </div>
                  {jdesc && <p class="mt-3 text-sm text-white/75 leading-relaxed whitespace-pre-line">{jdesc}</p>}
                  {reqs.length > 0 && (
                    <ul class="mt-3 space-y-1 text-sm text-white/70">
                      {reqs.map((r: string) => <li class="flex items-start gap-2"><span class="text-amber-300">•</span><span>{r}</span></li>)}
                    </ul>
                  )}

                  <div class="mt-4 pt-3 border-t border-white/10 flex items-center gap-2 flex-wrap">
                    <span class="text-xs text-white/40 mr-1">{isEl ? "Κοινοποίηση:" : "Share:"}</span>
                    <a aria-label="Facebook" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener" class="share-btn" style="background:#1877f2;">f</a>
                    <a aria-label="X / Twitter" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener" class="share-btn" style="background:#000;">𝕏</a>
                    <a aria-label="WhatsApp" href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" class="share-btn" style="background:#25d366;">W</a>
                    <a aria-label="Telegram" href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener" class="share-btn" style="background:#229ED9;">T</a>
                    <a aria-label="LinkedIn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener" class="share-btn" style="background:#0a66c2;">in</a>
                    <a aria-label="Email" href={`mailto:?subject=${shareText}&body=${shareUrl}`} class="share-btn" style="background:#64748b;">✉</a>
                    <button type="button" class="share-btn copy-btn" data-share-url={jobUrl} aria-label={isEl ? "Αντιγραφή συνδέσμου" : "Copy link"} style="background:rgba(255,255,255,0.1);">🔗</button>
                    <span class="copy-toast hidden text-xs text-green-400 ml-1">{isEl ? "Αντιγράφηκε!" : "Copied!"}</span>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

      <!-- Perks -->
      <div class="mt-16 grid gap-5 md:grid-cols-3">
        <div class="group relative rounded-3xl border border-white/10 bg-white/[0.03] p-6 overflow-hidden hover:border-amber-300/30 hover:-translate-y-1 transition duration-300">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-gradient-to-br from-amber-400/5 to-transparent transition"></div>
          <div class="relative">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-amber-300/15 text-xl mb-4">🌊</div>
            <h3 class="font-heading text-xl font-semibold">{perks.p1Title}</h3>
            <p class="mt-2 text-sm text-white/65 leading-relaxed">{perks.p1Text}</p>
          </div>
        </div>
        <div class="group relative rounded-3xl border border-white/10 bg-white/[0.03] p-6 overflow-hidden hover:border-sky-300/30 hover:-translate-y-1 transition duration-300">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-gradient-to-br from-sky-400/5 to-transparent transition"></div>
          <div class="relative">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-300/15 text-xl mb-4">🤝</div>
            <h3 class="font-heading text-xl font-semibold">{perks.p2Title}</h3>
            <p class="mt-2 text-sm text-white/65 leading-relaxed">{perks.p2Text}</p>
          </div>
        </div>
        <div class="group relative rounded-3xl border border-white/10 bg-white/[0.03] p-6 overflow-hidden hover:border-fuchsia-300/30 hover:-translate-y-1 transition duration-300">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-gradient-to-br from-fuchsia-400/5 to-transparent transition"></div>
          <div class="relative">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-fuchsia-300/15 text-xl mb-4">💸</div>
            <h3 class="font-heading text-xl font-semibold">{perks.p3Title}</h3>
            <p class="mt-2 text-sm text-white/65 leading-relaxed">{perks.p3Text}</p>
          </div>
        </div>
      </div>
    </main>

    <Footer />

    <!-- Apply modal -->
    <div id="applyModal" class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm p-0 sm:p-4">
      <div class="relative mx-auto w-full max-w-lg h-full sm:h-auto sm:max-h-[calc(100vh-2rem)] sm:my-4 rounded-none sm:rounded-2xl border border-white/10 bg-[#141420] flex flex-col">
        <div class="flex items-start justify-between p-5 border-b border-white/10 shrink-0">
          <div>
            <h3 class="text-lg font-bold text-amber-200">{isEl ? "Αίτηση Εργασίας" : "Apply for the role"}</h3>
            <p id="applyJobLabel" class="text-xs text-white/50 mt-1"></p>
          </div>
          <button id="applyCloseBtn" type="button" class="text-white/40 hover:text-white text-3xl leading-none px-2 -mt-1">×</button>
        </div>
        <form id="applyForm" class="flex-1 overflow-y-auto p-5 space-y-3">
          <input type="hidden" name="job_id" />
          <label class="block"><span class="text-xs text-white/50">{isEl ? "Ονοματεπώνυμο" : "Full name"} *</span>
            <input name="full_name" required minlength="2" maxlength="120"
              class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
          <label class="block"><span class="text-xs text-white/50">{isEl ? "Email" : "Email"} *</span>
            <input name="email" type="email" required
              class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
          <label class="block"><span class="text-xs text-white/50">{isEl ? "Τηλέφωνο (προαιρ.)" : "Phone (optional)"}</span>
            <input name="phone" type="tel" placeholder="+30..."
              class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50" /></label>
          <label class="block"><span class="text-xs text-white/50">{isEl ? "Μήνυμα / Εμπειρία" : "Message / Experience"}</span>
            <textarea name="message" rows="5" maxlength="2000" placeholder={isEl ? "Πείτε μας λίγα λόγια για εσάς…" : "Tell us a bit about yourself…"}
              class="w-full mt-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50"></textarea></label>
          <p id="applyMsg" class="text-xs hidden"></p>
        </form>
        <div class="shrink-0 border-t border-white/10 p-4 bg-[#141420] flex gap-3">
          <button id="applyCancelBtn" type="button" class="flex-1 rounded-xl border border-white/15 text-white/70 px-4 py-3 text-sm font-semibold hover:bg-white/5 transition">
            {isEl ? "Άκυρο" : "Cancel"}
          </button>
          <button id="applySubmitBtn" type="button" class="flex-[2] rounded-xl bg-amber-400 text-black px-4 py-3 text-sm font-semibold hover:bg-amber-300 transition disabled:opacity-40">
            {isEl ? "Υποβολή αίτησης" : "Submit application"}
          </button>
        </div>
      </div>
    </div>

    <script is:inline>
      const isEl = document.documentElement.lang === "el";

      document.querySelectorAll(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const url = btn.getAttribute("data-share-url") || window.location.href;
          try { await navigator.clipboard.writeText(url); } catch { return; }
          const toast = btn.nextElementSibling;
          if (toast && toast.classList.contains("copy-toast")) {
            toast.classList.remove("hidden");
            setTimeout(() => toast.classList.add("hidden"), 1800);
          }
        });
      });

      const modal = document.getElementById("applyModal");
      const form  = document.getElementById("applyForm");
      const label = document.getElementById("applyJobLabel");
      const msg   = document.getElementById("applyMsg");
      const submitBtn = document.getElementById("applySubmitBtn");
      function openApply(jobId, jobTitle) {
        form.reset();
        form.elements.job_id.value = jobId || "";
        label.textContent = jobTitle || "";
        msg.className = "text-xs hidden";
        submitBtn.disabled = false;
        submitBtn.textContent = isEl ? "Υποβολή αίτησης" : "Submit application";
        modal.classList.remove("hidden"); modal.classList.add("flex");
      }
      function closeApply() { modal.classList.add("hidden"); modal.classList.remove("flex"); }
      document.querySelectorAll(".apply-btn").forEach((b) => {
        b.addEventListener("click", () => openApply(b.getAttribute("data-job-id"), b.getAttribute("data-job-title")));
      });
      document.getElementById("applyCloseBtn").addEventListener("click", closeApply);
      document.getElementById("applyCancelBtn").addEventListener("click", closeApply);
      modal.addEventListener("click", (e) => { if (e.target === modal) closeApply(); });

      submitBtn.addEventListener("click", async () => {
        if (!form.reportValidity()) return;
        const fd = new FormData(form);
        const payload = Object.fromEntries(fd.entries());
        submitBtn.disabled = true;
        submitBtn.textContent = isEl ? "⏳ Αποστολή…" : "⏳ Sending…";
        msg.className = "text-xs hidden";
        try {
          const res = await fetch("/api/careers/apply", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            form.innerHTML = `<div class="py-10 text-center"><div class="text-4xl mb-3">✅</div><p class="text-lg font-semibold text-amber-200">${isEl ? "Η αίτησή σας στάλθηκε!" : "Your application was sent!"}</p><p class="text-sm text-white/60 mt-2">${isEl ? "Θα επικοινωνήσουμε σύντομα." : "We'll be in touch soon."}</p></div>`;
            submitBtn.style.display = "none";
            document.getElementById("applyCancelBtn").textContent = isEl ? "Κλείσιμο" : "Close";
          } else {
            const j = await res.json().catch(() => ({}));
            msg.textContent = (isEl ? "Σφάλμα: " : "Error: ") + (j.error ?? "unknown");
            msg.className = "text-xs text-red-400 block";
            submitBtn.disabled = false;
            submitBtn.textContent = isEl ? "Υποβολή αίτησης" : "Submit application";
          }
        } catch {
          msg.textContent = isEl ? "Σφάλμα δικτύου" : "Network error";
          msg.className = "text-xs text-red-400 block";
          submitBtn.disabled = false;
          submitBtn.textContent = isEl ? "Υποβολή αίτησης" : "Submit application";
        }
      });
    </script>
  </body>
</html>