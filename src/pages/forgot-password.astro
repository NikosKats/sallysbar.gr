---
import { getLangFromPath, withLangPrefix } from "../i18n";

const url = new URL(Astro.request.url);
const lang = getLangFromPath(url.pathname);
const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? "";

const isEl = lang === "el";
const t = {
  title:        isEl ? "Ξεχασμένος Κωδικός"            : "Forgot Password",
  subtitle:     isEl ? "Θα σου στείλουμε σύνδεσμο για επαναφορά." : "We'll send you a reset link.",
  email:        "Email",
  submit:       isEl ? "Αποστολή συνδέσμου"             : "Send Reset Link",
  submitting:   isEl ? "Αποστολή…"                       : "Sending…",
  successMsg:   isEl ? "Έλεγξε το email σου για τον σύνδεσμο επαναφοράς." : "Check your email for the reset link.",
  errorGeneric: isEl ? "Κάτι πήγε στραβά. Δοκίμασε ξανά." : "Something went wrong. Try again.",
  backToLogin:  isEl ? "← Πίσω στη σύνδεση"             : "← Back to sign in",
};

const loginHref = withLangPrefix(lang, "/login");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title} — Sally's Bar</title>
    <link rel="icon" href="/favicon/favicon.ico" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #0b0b10; color: #fff; font-family: Inter, system-ui, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 3rem 1rem; }
      .card { width: 100%; max-width: 24rem; }
      .brand { display: flex; align-items: center; justify-content: center; gap: .75rem; margin-bottom: 2rem; text-decoration: none; }
      .brand img { height: 2.25rem; width: 2.25rem; border-radius: .375rem; object-fit: contain; }
      .brand span { font-weight: 600; letter-spacing: .05em; color: rgba(255,255,255,.9); }
      .box { border-radius: 1rem; border: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.4); backdrop-filter: blur(12px); padding: 2rem; }
      h1 { font-size: 1.25rem; font-weight: 600; text-align: center; margin-bottom: .5rem; }
      .subtitle { font-size: .875rem; color: rgba(255,255,255,.5); text-align: center; margin-bottom: 1.5rem; }
      .field { display: flex; flex-direction: column; gap: .375rem; }
      label { font-size: .875rem; color: rgba(255,255,255,.6); }
      input { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; color: #fff; outline: none; width: 100%; transition: border-color .15s; }
      input::placeholder { color: rgba(255,255,255,.3); }
      input:focus { border-color: rgba(255,255,255,.3); }
      .form { display: flex; flex-direction: column; gap: 1rem; }
      .btn-primary { width: 100%; border-radius: .75rem; background: #fff; padding: .75rem 1rem; font-size: .875rem; font-weight: 600; color: #000; border: none; cursor: pointer; transition: opacity .15s; margin-top: .25rem; }
      .btn-primary:hover { opacity: .9; }
      .btn-primary:disabled { opacity: .5; cursor: not-allowed; }
      .back-link { display: block; margin-top: 1.5rem; text-align: center; font-size: .875rem; color: rgba(255,255,255,.5); text-decoration: none; }
      .back-link:hover { color: rgba(255,255,255,.8); }
      .alert { display: none; border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; margin-bottom: 1rem; }
      .alert.error { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.2); color: #f87171; }
      .alert.success { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.2); color: #4ade80; }
      .alert.visible { display: block; }
      .cf-turnstile { margin-top: .25rem; }
    </style>
  </head>
  <body>
    <div id="cfg"
      data-error-generic={t.errorGeneric}
      data-success-msg={t.successMsg}
      data-label-submit={t.submit}
      data-label-submitting={t.submitting}
      hidden></div>

    <div class="card">
      <a href={withLangPrefix(lang, "/")} class="brand">
        <img src="/logo/1-logo.png" alt="Sally's Bar" />
        <span>Sally's Bar</span>
      </a>

      <div class="box">
        <h1>{t.title}</h1>
        <p class="subtitle">{t.subtitle}</p>

        <div id="errorMsg"   class="alert error"></div>
        <div id="successMsg" class="alert success"></div>

        <form id="forgotForm" class="form">
          <div class="field">
            <label for="email">{t.email}</label>
            <input id="email" type="email" required autocomplete="email" placeholder="you@example.com" />
          </div>
          {turnstileSitekey && (
            <div
              id="turnstileWidget"
              class="cf-turnstile"
              data-sitekey={turnstileSitekey}
              data-theme="dark"
              data-callback="onTurnstileSuccess"
              data-expired-callback="onTurnstileExpired"
            ></div>
          )}
          <button type="submit" id="submitBtn" class="btn-primary" disabled={turnstileSitekey ? true : undefined}>{t.submit}</button>
        </form>

        <a href={loginHref} class="back-link">{t.backToLogin}</a>
      </div>
    </div>

    <script>
      import { createClient } from "@supabase/supabase-js";

      const cfg          = document.getElementById("cfg") as HTMLElement;
      const errorGeneric = cfg.dataset.errorGeneric!;
      const successMsg   = cfg.dataset.successMsg!;
      const labelSubmit  = cfg.dataset.labelSubmit!;
      const labelBusy    = cfg.dataset.labelSubmitting!;

      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      const form      = document.getElementById("forgotForm") as HTMLFormElement;
      const submitBtn = document.getElementById("submitBtn")  as HTMLButtonElement;
      const errorEl   = document.getElementById("errorMsg")   as HTMLElement;
      const successEl = document.getElementById("successMsg") as HTMLElement;

      let captchaToken = "";
      const widgetEl = document.getElementById("turnstileWidget");
      const isLocalhost = ["localhost", "127.0.0.1"].includes(window.location.hostname);

      if (widgetEl) {
        (window as any).onTurnstileSuccess = (token: string) => {
          captchaToken = token;
          submitBtn.disabled = false;
        };
        (window as any).onTurnstileExpired = () => {
          captchaToken = "";
          submitBtn.disabled = isLocalhost ? false : true;
        };
        // On localhost Turnstile may not complete — enable after 1.5s
        if (isLocalhost) {
          setTimeout(() => { submitBtn.disabled = false; }, 1500);
        }
      } else {
        submitBtn.disabled = false;
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.remove("visible");
        successEl.classList.remove("visible");
        submitBtn.disabled = true;
        submitBtn.textContent = labelBusy;

        const email = (document.getElementById("email") as HTMLInputElement).value;

        const resetOpts: Parameters<typeof supabase.auth.resetPasswordForEmail>[1] = {
          redirectTo: `${window.location.origin}/auth/reset-password`,
        };
        if (captchaToken) resetOpts.captchaToken = captchaToken;
        const { error } = await supabase.auth.resetPasswordForEmail(email, resetOpts);

        if (error) {
          errorEl.textContent = error.message || errorGeneric;
          errorEl.classList.add("visible");
          (window as any).turnstile?.reset();
          captchaToken = "";
          submitBtn.disabled = true;
          submitBtn.textContent = labelSubmit;
          return;
        }

        // Show success and hide form — don't reveal if email exists or not
        successEl.textContent = successMsg;
        successEl.classList.add("visible");
        form.style.display = "none";
      });
    </script>
  </body>
</html>
