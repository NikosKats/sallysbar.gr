---
import "../../styles/global.css";
import { site } from "../../data/site";
import { getMenu, formatPriceEUR } from "../../lib/menuService";

const { id } = Astro.params;
const tableNumber = Number(id);

if (!tableNumber || isNaN(tableNumber)) {
  return Astro.redirect("/");
}

const { categories, items } = await getMenu("en");
const byCategory = new Map<number, typeof items>();
for (const it of items) {
  const list = byCategory.get(it.category_id) ?? [];
  list.push(it);
  byCategory.set(it.category_id, list);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Table {tableNumber} — {site.name}</title>
    <meta name="robots" content="noindex" />
  </head>

  <body class="min-h-screen bg-[#0b0b10] text-white font-body pb-24">
    <!-- Header -->
    <div class="sticky top-0 z-50 border-b border-white/10 bg-[#0b0b10]/90 backdrop-blur px-6 py-4 flex items-center justify-between">
      <div>
        <div class="text-xs text-white/50 uppercase tracking-widest">{site.name}</div>
        <div class="text-sm font-semibold">Table {tableNumber}</div>
      </div>

      <button
        id="callWaiterBtn"
        class="rounded-full bg-white text-black font-semibold px-5 py-2.5 text-sm hover:bg-white/90 active:scale-95 transition"
      >
        Call Waiter
      </button>
    </div>

    <!-- Call waiter feedback -->
    <div
      id="callFeedback"
      class="hidden mx-6 mt-4 rounded-2xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400"
    >
      Your waiter has been notified and will be with you shortly.
    </div>

    <main class="mx-auto max-w-2xl px-6 py-8">
      <!-- Category jump chips -->
      <div class="flex flex-wrap gap-2 mb-8">
        {categories.map((c) => (
          <a
            href={`#${c.slug}`}
            class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs text-white/80 hover:text-white hover:bg-white/10 transition"
          >
            {c.name}
          </a>
        ))}
      </div>

      <!-- Menu sections -->
      <div class="space-y-10">
        {categories.map((c) => {
          const list = byCategory.get(c.id) ?? [];
          if (list.length === 0) return null;
          return (
            <section id={c.slug} class="scroll-mt-20">
              <h2 class="text-xl font-semibold mb-4">{c.name}</h2>
              <div class="rounded-2xl border border-white/10 bg-white/5 divide-y divide-white/10">
                {list.map((item) => (
                  <div class="flex items-start justify-between gap-6 p-4">
                    <div class="min-w-0">
                      <div class="font-medium">{item.name}</div>
                      {item.description && (
                        <p class="mt-1 text-xs text-white/60 leading-relaxed">
                          {item.description}
                        </p>
                      )}
                    </div>
                    <div class="shrink-0 rounded-full border border-white/10 bg-black/30 px-3 py-1 text-sm text-white/90">
                      {formatPriceEUR(item.price_cents)}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          );
        })}
      </div>

      <p class="mt-10 text-xs text-white/40 text-center">
        Allergies? Ask our staff. Prices may vary during events.
      </p>
    </main>

    <!-- Sticky call waiter bar -->
    <div class="fixed bottom-0 inset-x-0 border-t border-white/10 bg-[#0b0b10]/95 backdrop-blur px-6 py-4">
      <button
        id="callWaiterBtnBottom"
        class="w-full rounded-2xl bg-white text-black font-semibold py-3.5 text-sm hover:bg-white/90 active:scale-95 transition"
      >
        Call Waiter — Table {tableNumber}
      </button>
    </div>

    <script define:vars={{ tableNumber }}>
      async function callWaiter() {
        const btns = [
          document.getElementById("callWaiterBtn"),
          document.getElementById("callWaiterBtnBottom"),
        ];
        const feedback = document.getElementById("callFeedback");

        btns.forEach((b) => {
          if (b) {
            b.textContent = "Calling…";
            b.setAttribute("disabled", "true");
            b.style.opacity = "0.6";
          }
        });

        try {
          await fetch("/api/call-waiter", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ table: tableNumber }),
          });

          if (feedback) feedback.classList.remove("hidden");

          btns.forEach((b) => {
            if (b) b.textContent = "Waiter notified ✓";
          });

          // Re-enable after 30 seconds to prevent spam
          setTimeout(() => {
            btns.forEach((b) => {
              if (b) {
                b.textContent = b.id === "callWaiterBtn" ? "Call Waiter" : `Call Waiter — Table ${tableNumber}`;
                b.removeAttribute("disabled");
                b.style.opacity = "";
              }
            });
            if (feedback) feedback.classList.add("hidden");
          }, 30000);
        } catch {
          btns.forEach((b) => {
            if (b) {
              b.textContent = "Try again";
              b.removeAttribute("disabled");
              b.style.opacity = "";
            }
          });
        }
      }

      document.getElementById("callWaiterBtn")?.addEventListener("click", callWaiter);
      document.getElementById("callWaiterBtnBottom")?.addEventListener("click", callWaiter);
    </script>
  </body>
</html>
