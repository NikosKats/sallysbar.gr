---
import "../../styles/global.css";
import { site } from "../../data/site";
import { getMenu, formatPriceEUR } from "../../lib/menuService";

const { id } = Astro.params;
const tableNumber = Number(id);

if (!tableNumber || isNaN(tableNumber)) {
  return Astro.redirect("/");
}

const url   = new URL(Astro.request.url);
const lang  = url.searchParams.get("lang") === "el" ? "el" : "en";
const isEl  = lang === "el";

const switchLang  = isEl ? "en" : "el";
const switchLabel = isEl ? "English" : "Ελληνικά";

const t = {
  table:        isEl ? `Τραπέζι ${tableNumber}`           : `Table ${tableNumber}`,
  order:        isEl ? "Παραγγελία"                       : "Order",
  pay:          isEl ? "Πληρωμή"                          : "Pay",
  orderBottom:  isEl ? "Κάλεσε σερβιτόρο για παραγγελία"  : "Call Waiter to Order",
  payBottom:    isEl ? "Κάλεσε σερβιτόρο για πληρωμή"     : "Call Waiter to Pay",
  notified:     isEl ? "Ειδοποιήθηκε ✓"                  : "Notified ✓",
  calling:      isEl ? "Καλείται…"                        : "Calling…",
  tryAgain:     isEl ? "Δοκίμασε ξανά"                    : "Try again",
  rateLimit:    isEl ? "Πολλές κλήσεις. Δοκίμασε σε λίγο." : "Too many calls. Try again soon.",
  feedback:     isEl ? "Ο σερβιτόρος ειδοποιήθηκε και θα έρθει σύντομα." : "Your waiter has been notified and will be with you shortly.",
  howToPay:     isEl ? "Πώς θέλεις να πληρώσεις;"         : "How would you like to pay?",
  card:         isEl ? "Κάρτα"                             : "Card",
  cash:         isEl ? "Μετρητά"                           : "Cash",
  allergies:    isEl ? "Αλλεργίες; Ρώτησε το προσωπικό μας. Οι τιμές ενδέχεται να διαφέρουν κατά τη διάρκεια εκδηλώσεων." : "Allergies? Ask our staff. Prices may vary during events.",
  reviewTitle:  isEl ? "Σου άρεσε το Sally's Bar;"         : "Enjoying your time at Sally's Bar?",
  reviewSub:    isEl ? "Άφησέ μας μια κριτική — σημαίνει πολλά!" : "Leave us a review — it means a lot!",
  reviewBtn:    isEl ? "Γράψε κριτική στο Google"          : "Leave a Google review",
};

const menuSlug = new URL(Astro.request.url).searchParams.get("menu") ?? undefined;
const { menu: currentMenu, menus: activeMenus, categories, items } = await (async () => {
  const all = await getMenu(lang);
  if (menuSlug) {
    const pick = all.menus?.find(m => m.slug === menuSlug);
    if (pick && pick.id !== all.menu?.id) return await getMenu(lang, pick.id);
  }
  return all;
})();
const byCategory = new Map<number, typeof items>();
for (const it of items) {
  const list = byCategory.get(it.category_id) ?? [];
  list.push(it);
  byCategory.set(it.category_id, list);
}

// Build a global item number map for easy customer reference
const itemNumbers = new Map<number, number>();
let itemCounter = 1;
for (const c of categories) {
  for (const it of byCategory.get(c.id) ?? []) {
    itemNumbers.set(it.id, itemCounter++);
  }
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{t.table} — {site.name}</title>
    <meta name="robots" content="noindex" />
  </head>

  <body class="min-h-screen bg-[#0b0b10] text-white font-body pb-32">
    <!-- Header -->
    <div class="sticky top-0 z-50 border-b border-white/10 bg-[#0b0b10]/90 backdrop-blur px-4 py-3 flex items-center justify-between gap-2">
      <div>
        <div class="text-xs text-white/50 uppercase tracking-widest">{site.name}</div>
        <div class="text-sm font-semibold">{t.table}</div>
      </div>
      <div class="flex items-center gap-2">
        <a id="langBtn" href={`?lang=${switchLang}`}
          class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs text-white/80 hover:bg-white/10 transition">
          {switchLabel}
        </a>
        <button id="orderBtn" data-reason="order"
          class="waiter-btn rounded-full border border-white/20 bg-white/10 text-white font-semibold px-3 py-1.5 text-xs hover:bg-white/20 active:scale-95 transition">
          {t.order}
        </button>
        <button id="payBtn" data-reason="pay"
          class="waiter-btn rounded-full bg-white text-black font-semibold px-3 py-1.5 text-xs hover:bg-white/90 active:scale-95 transition">
          {t.pay}
        </button>
      </div>
    </div>

    <!-- Feedback banner -->
    <div id="callFeedback" class="hidden mx-6 mt-4 rounded-2xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400">
      {t.feedback}
    </div>
    <!-- Rate limit banner -->
    <div id="rateLimitMsg" class="hidden mx-6 mt-4 rounded-2xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-400">
      {t.rateLimit}
    </div>

    <main class="mx-auto max-w-2xl px-6 py-8">
      <!-- Category jump chips -->
      <div class="flex flex-wrap gap-2 mb-8">
        {categories.map((c) => (
          <a href={`#${c.slug}`}
            class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs text-white/80 hover:text-white hover:bg-white/10 transition">
            {c.name}
          </a>
        ))}
      </div>

      {activeMenus && activeMenus.length > 1 && (
        <div class="mb-6 flex flex-wrap gap-2">
          {activeMenus.map((m) => (
            <a href={`?menu=${m.slug}`}
              class={`rounded-full px-4 py-1.5 text-sm border transition ${currentMenu?.id === m.id ? "bg-amber-300/20 border-amber-300/50 text-amber-200" : "border-white/15 bg-white/5 text-white/70 hover:bg-white/10"}`}>
              {isEl ? m.name_el : m.name_en}
            </a>
          ))}
        </div>
      )}

      <!-- Menu sections -->
      <div class="space-y-10">
        {categories.map((c) => {
          const list = byCategory.get(c.id) ?? [];
          if (list.length === 0) return null;
          return (
            <section id={c.slug} class="scroll-mt-20">
              <h2 class="text-xl font-semibold mb-4">{c.name}</h2>
              <div class="rounded-2xl border border-white/10 bg-white/5 divide-y divide-white/10">
                {list.map((item) => (
                  <div class="flex items-start justify-between gap-4 p-4">
                    <div class="min-w-0 flex-1">
                      <div class="font-medium">
                        <span class="text-white/30 text-xs font-normal mr-1.5">#{itemNumbers.get(item.id)}</span>{item.name}
                      </div>
                      {item.description && (
                        <p class="mt-1 text-xs text-white/60 leading-relaxed">{item.description}</p>
                      )}
                    </div>
                    <div class="shrink-0 flex items-center gap-2">
                      <button
                        class="ask-item-btn text-white/40 hover:text-white/80 transition p-1"
                        data-item={item.name}
                        aria-label={isEl ? `Ρώτησε για ${item.name}` : `Ask about ${item.name}`}
                        title={isEl ? "Ρώτησε τον AI" : "Ask AI"}>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                      </button>
                      <div class="rounded-full border border-white/10 bg-black/30 px-3 py-1 text-sm text-white/90">
                        {formatPriceEUR(item.price_cents)}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          );
        })}
      </div>

      <p class="mt-10 text-xs text-white/40 text-center">{t.allergies}</p>

      <!-- Google review -->
      <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 p-6 text-center">
        <p class="text-sm text-white/60 mb-4">{t.reviewTitle}<br/>{t.reviewSub}</p>
        <a href="https://www.google.com/maps/place/Sally's+Bar/@38.0748829,18.5557617,8z/data=!4m8!3m7!1s0x13675f4867a5e573:0x842020188aa33527!8m2!3d38.0748829!4d20.7969726!9m1!1b1!16s%2Fg%2F11cnb3kb_m?entry=ttu&g_ep=EgoyMDI2MDMwMi4wIKXMDSoASAFQAw%3D%3D"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-black hover:bg-white/90 active:scale-95 transition">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          {t.reviewBtn}
        </a>
      </div>
    </main>

    <!-- Sticky bottom bar -->
    <div class="fixed bottom-0 inset-x-0 border-t border-white/10 bg-[#0b0b10]/95 backdrop-blur px-4 py-3">
      <div class="mx-auto max-w-2xl flex gap-3">
        <button id="orderBtnBottom" data-reason="order"
          class="waiter-btn flex-1 rounded-2xl border border-white/20 bg-white/10 text-white font-semibold py-3.5 text-sm hover:bg-white/20 active:scale-95 transition">
          {t.orderBottom}
        </button>
        <button id="payBtnBottom" data-reason="pay"
          class="waiter-btn flex-1 rounded-2xl bg-white text-black font-semibold py-3.5 text-sm hover:bg-white/90 active:scale-95 transition">
          {t.payBottom}
        </button>
      </div>
    </div>

    <!-- Pay method sheet -->
    <div id="paySheet" class="fixed inset-0 z-50 hidden">
      <div id="payBackdrop" class="absolute inset-0 bg-black/60"></div>
      <div class="absolute bottom-0 inset-x-0 rounded-t-3xl border-t border-white/10 bg-[#16161f] px-6 pt-6 pb-10">
        <div class="mx-auto mb-6 h-1 w-10 rounded-full bg-white/20"></div>
        <p class="text-center text-sm font-semibold mb-6">{t.howToPay}</p>
        <div class="flex gap-3">
          <button id="payCard" class="flex-1 flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-white/5 py-6 text-sm font-semibold hover:bg-white/10 active:scale-95 transition">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>
            </svg>
            {t.card}
          </button>
          <button id="payCash" class="flex-1 flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-white/5 py-6 text-sm font-semibold hover:bg-white/10 active:scale-95 transition">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/>
            </svg>
            {t.cash}
          </button>
        </div>
      </div>
    </div>

    <!-- AI Chat button -->
    <button id="chatOpenBtn"
      class="fixed bottom-24 right-4 z-40 flex items-center justify-center w-12 h-12 rounded-full bg-white text-black shadow-lg hover:bg-white/90 active:scale-95 transition"
      aria-label="Chat with AI">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </button>

    <!-- AI Chat panel -->
    <div id="chatPanel" class="fixed inset-0 z-50 hidden flex-col bg-[#0b0b10]">
      <!-- Chat header -->
      <div class="flex items-center justify-between px-4 py-3 border-b border-white/10 bg-[#0b0b10]/95">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold">{isEl ? "Βοηθός Μενού" : "Menu Assistant"}</div>
            <div class="text-xs text-white/40">{isEl ? "Ρώτησέ με για τον κατάλογο" : "Ask me about the menu"}</div>
          </div>
        </div>
        <button id="chatCloseBtn" class="p-2 text-white/60 hover:text-white transition">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Messages -->
      <div id="chatMessages" class="flex-1 overflow-y-auto px-4 py-4 space-y-3">
        <div class="flex justify-start">
          <div class="max-w-[80%] rounded-2xl rounded-tl-sm bg-white/10 px-4 py-2.5 text-sm text-white/90 leading-relaxed">
            {isEl ? "Γεια! Είμαι ο βοηθός του Sally's Bar. Ρώτησέ με οτιδήποτε για τον κατάλογο ή κάνε μου ερωτήσεις — χαίρομαι να βοηθήσω!" : "Hey! I'm Sally's Bar assistant. Ask me anything about the menu or what to order — happy to help!"}
          </div>
        </div>
      </div>

      <!-- Input bar -->
      <div class="px-4 py-3 border-t border-white/10 bg-[#0b0b10]/95 flex gap-2 items-end">
        <textarea id="chatInput"
          rows="1"
          placeholder={isEl ? "Ρώτησε κάτι…" : "Ask something…"}
          class="flex-1 resize-none rounded-2xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-white/30 focus:outline-none focus:border-white/30 max-h-28 overflow-y-auto"></textarea>
        <button id="chatSendBtn"
          class="shrink-0 w-9 h-9 rounded-full bg-white text-black flex items-center justify-center hover:bg-white/90 active:scale-95 transition disabled:opacity-40"
          disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>
      </div>
    </div>

    <script define:vars={{ tableNumber, switchLang, lang, labels: { order: { top: t.order, bottom: t.orderBottom }, pay: { top: t.pay, bottom: t.payBottom } }, notified: t.notified, calling: t.calling, tryAgain: t.tryAgain, rateLimit: t.rateLimit }}>
      const SESSION_KEY = `tbl_token_${tableNumber}`;

      // ── Token management ──────────────────────────────────────────────
      // On first load the QR URL has ?token=xxx. Store it in sessionStorage
      // and strip it from the address bar so copying the URL is useless.
      const urlParams = new URLSearchParams(window.location.search);
      const urlToken  = urlParams.get("token");
      if (urlToken) {
        sessionStorage.setItem(SESSION_KEY, urlToken);
        urlParams.delete("token");
        const clean = urlParams.toString() ? `?${urlParams}` : window.location.pathname;
        history.replaceState({}, "", clean);
      }
      const token = sessionStorage.getItem(SESSION_KEY) ?? "";

      // Keep the language-switch link token-free (sessionStorage survives navigation)
      // so the address bar stays clean on both languages.
      document.getElementById("langBtn").href = `?lang=${switchLang}`;

      // ── UI state ──────────────────────────────────────────────────────
      const cooldowns      = { order: false, pay: false };
      const paySheet       = document.getElementById("paySheet");
      const payBackdrop    = document.getElementById("payBackdrop");
      const feedbackEl     = document.getElementById("callFeedback");
      const rateLimitEl    = document.getElementById("rateLimitMsg");

      function openPaySheet()  { if (!cooldowns.pay) paySheet.classList.remove("hidden"); }
      function closePaySheet() { paySheet.classList.add("hidden"); }

      payBackdrop.addEventListener("click", closePaySheet);
      document.getElementById("payCard").addEventListener("click", () => { closePaySheet(); callWaiter("pay", "card"); });
      document.getElementById("payCash").addEventListener("click", () => { closePaySheet(); callWaiter("pay", "cash"); });

      // ── Call waiter ───────────────────────────────────────────────────
      async function callWaiter(reason, method) {
        if (cooldowns[reason]) return;
        cooldowns[reason] = true;

        const btns = document.querySelectorAll(`.waiter-btn[data-reason="${reason}"]`);
        rateLimitEl.classList.add("hidden");

        btns.forEach(b => {
          b.textContent = calling;
          b.setAttribute("disabled", "true");
          b.style.opacity = "0.6";
        });

        try {
          const res = await fetch("/api/call-waiter", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ table: tableNumber, reason, method, token }),
          });

          if (res.status === 429) {
            rateLimitEl.classList.remove("hidden");
            cooldowns[reason] = false;
            btns.forEach(b => {
              b.textContent = b.id.includes("Bottom") ? labels[reason].bottom : labels[reason].top;
              b.removeAttribute("disabled");
              b.style.opacity = "";
            });
            setTimeout(() => rateLimitEl.classList.add("hidden"), 8000);
            return;
          }

          feedbackEl.classList.remove("hidden");
          btns.forEach(b => { b.textContent = notified; });

          setTimeout(() => {
            cooldowns[reason] = false;
            btns.forEach(b => {
              b.textContent = b.id.includes("Bottom") ? labels[reason].bottom : labels[reason].top;
              b.removeAttribute("disabled");
              b.style.opacity = "";
            });
            feedbackEl.classList.add("hidden");
          }, 30000);
        } catch {
          cooldowns[reason] = false;
          btns.forEach(b => {
            b.textContent = tryAgain;
            b.removeAttribute("disabled");
            b.style.opacity = "";
          });
        }
      }

      document.querySelectorAll(".waiter-btn[data-reason='order']").forEach(btn => {
        btn.addEventListener("click", () => callWaiter("order"));
      });
      document.querySelectorAll(".waiter-btn[data-reason='pay']").forEach(btn => {
        btn.addEventListener("click", openPaySheet);
      });

      // ── AI Chat ───────────────────────────────────────────────────────
      const chatPanel    = document.getElementById("chatPanel");
      const chatMessages = document.getElementById("chatMessages");
      const chatInput    = document.getElementById("chatInput");
      const chatSendBtn  = document.getElementById("chatSendBtn");

      document.getElementById("chatOpenBtn").addEventListener("click", () => {
        chatPanel.classList.remove("hidden");
        chatPanel.classList.add("flex");
        chatInput.focus();
      });
      document.getElementById("chatCloseBtn").addEventListener("click", () => {
        chatPanel.classList.add("hidden");
        chatPanel.classList.remove("flex");
      });

      chatInput.addEventListener("input", () => {
        chatSendBtn.disabled = !chatInput.value.trim();
        chatInput.style.height = "auto";
        chatInput.style.height = Math.min(chatInput.scrollHeight, 112) + "px";
      });
      chatInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendChat(); }
      });
      chatSendBtn.addEventListener("click", sendChat);

      const chatHistory = [];
      let chatBusy = false;

      function appendBubble(role, text) {
        const wrap = document.createElement("div");
        wrap.className = "flex " + (role === "user" ? "justify-end" : "justify-start");
        const bubble = document.createElement("div");
        bubble.className = role === "user"
          ? "max-w-[80%] rounded-2xl rounded-tr-sm bg-white text-black px-4 py-2.5 text-sm leading-relaxed"
          : "max-w-[80%] rounded-2xl rounded-tl-sm bg-white/10 px-4 py-2.5 text-sm text-white/90 leading-relaxed whitespace-pre-wrap";
        bubble.textContent = text;
        wrap.appendChild(bubble);
        chatMessages.appendChild(wrap);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        return bubble;
      }

      async function sendChat(overrideText) {
        const text = overrideText ?? chatInput.value.trim();
        if (!text || chatBusy) return;

        chatBusy = true;
        chatHistory.push({ role: "user", content: text });
        appendBubble("user", text);
        if (!overrideText) {
          chatInput.value = "";
          chatInput.style.height = "auto";
        }
        chatSendBtn.disabled = true;

        const assistantBubble = appendBubble("assistant", "…");

        try {
          const res = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ table: tableNumber, token, lang, messages: chatHistory }),
          });

          const data = await res.json();

          if (!res.ok || data.error) {
            console.error("[chat] error:", data.error, "status:", res.status);
            assistantBubble.textContent = data.error ?? (lang === "el" ? "Κάτι πήγε στραβά." : "Something went wrong.");
            chatHistory.pop();
          } else if (data.text) {
            assistantBubble.textContent = data.text;
            chatHistory.push({ role: "assistant", content: data.text });
            chatMessages.scrollTop = chatMessages.scrollHeight;
          } else {
            assistantBubble.textContent = lang === "el" ? "Δεν έλαβα απάντηση." : "No response received.";
            chatHistory.pop();
          }
        } catch {
          assistantBubble.textContent = lang === "el" ? "Σφάλμα σύνδεσης." : "Connection error.";
          chatHistory.pop();
        } finally {
          chatBusy = false;
          chatSendBtn.disabled = !chatInput.value.trim();
        }
      }

      // ── Ask about a specific item ─────────────────────────────────────
      document.querySelectorAll(".ask-item-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const itemName = btn.getAttribute("data-item");
          const question = lang === "el"
            ? `Πες μου περισσότερα για το ${itemName}.`
            : `Tell me more about ${itemName}.`;
          chatPanel.classList.remove("hidden");
          chatPanel.classList.add("flex");
          sendChat(question);
        });
      });
    </script>
  </body>
</html>
