---
import { withLangPrefix } from "../i18n";

const url = new URL(Astro.request.url);
const lang = Astro.locals.lang ?? "en";
const nextUrl = url.searchParams.get("next") ?? "/dashboard";
const errorCode = url.searchParams.get("error");
const errorDetail = url.searchParams.get("msg");
const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? "";

const isEl = lang === "el";
const t = {
  title:        isEl ? "Σύνδεση"                           : "Sign In",
  email:        "Email",
  password:     isEl ? "Κωδικός"                           : "Password",
  submit:       isEl ? "Σύνδεση"                           : "Sign In",
  noAccount:    isEl ? "Δεν έχεις λογαριασμό;"             : "Don't have an account?",
  register:     isEl ? "Εγγραφή"                           : "Register",
  orDivider:    isEl ? "ή"                                  : "or",
  google:       isEl ? "Συνέχεια με Google"                 : "Continue with Google",
  errorInvalid:      isEl ? "Λάθος email ή κωδικός."                              : "Invalid email or password.",
  errorGeneric:      isEl ? "Κάτι πήγε στραβά. Δοκίμασε ξανά."                   : "Something went wrong. Try again.",
  errorUnconfirmed:  isEl ? "Επιβεβαίωσε πρώτα το email σου."                     : "Please confirm your email before signing in.",
};

const errorMsg = errorCode === "invalid"
  ? t.errorInvalid
  : errorCode === "unconfirmed"
  ? t.errorUnconfirmed
  : errorCode === "generic"
  ? t.errorGeneric
  : null;

const registerHref = withLangPrefix(lang, "/register");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title} — Sally's Bar</title>
    <link rel="icon" href="/favicon/favicon.ico" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #0b0b10; color: #fff; font-family: Inter, system-ui, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 3rem 1rem; }
      .card { width: 100%; max-width: 24rem; }
      .brand { display: flex; align-items: center; justify-content: center; gap: .75rem; margin-bottom: 2rem; text-decoration: none; }
      .brand img { height: 2.25rem; width: 2.25rem; border-radius: .375rem; object-fit: contain; }
      .brand span { font-weight: 600; letter-spacing: .05em; color: rgba(255,255,255,.9); }
      .box { border-radius: 1rem; border: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.4); backdrop-filter: blur(12px); padding: 2rem; }
      h1 { font-size: 1.25rem; font-weight: 600; text-align: center; margin-bottom: 1.5rem; }
      .field { display: flex; flex-direction: column; gap: .375rem; }
      label { font-size: .875rem; color: rgba(255,255,255,.6); }
      input { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; color: #fff; outline: none; width: 100%; transition: border-color .15s; }
      input::placeholder { color: rgba(255,255,255,.3); }
      input:focus { border-color: rgba(255,255,255,.3); }
      .form { display: flex; flex-direction: column; gap: 1rem; }
      .btn-primary { width: 100%; border-radius: .75rem; background: #fff; padding: .75rem 1rem; font-size: .875rem; font-weight: 600; color: #000; border: none; cursor: pointer; transition: opacity .15s; margin-top: .25rem; }
      .btn-primary:hover { opacity: .9; }
      .divider { display: flex; align-items: center; gap: .75rem; margin: 1.25rem 0; }
      .divider div { flex: 1; height: 1px; background: rgba(255,255,255,.1); }
      .divider span { font-size: .75rem; color: rgba(255,255,255,.3); }
      .btn-google { width: 100%; display: flex; align-items: center; justify-content: center; gap: .75rem; border-radius: .75rem; border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.05); padding: .75rem 1rem; font-size: .875rem; color: rgba(255,255,255,.9); cursor: pointer; transition: background .15s; }
      .btn-google:hover { background: rgba(255,255,255,.1); }
      .footer-link { margin-top: 1.5rem; text-align: center; font-size: .875rem; color: rgba(255,255,255,.4); }
      .footer-link a { color: rgba(255,255,255,.7); text-decoration: underline; text-underline-offset: 2px; }
      .forgot-link { display: block; margin-top: .75rem; text-align: right; font-size: .75rem; color: rgba(255,255,255,.4); text-decoration: none; }
      .forgot-link:hover { color: rgba(255,255,255,.7); }
      .alert { border-radius: .75rem; padding: .75rem 1rem; font-size: .875rem; margin-bottom: 1rem; background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.2); color: #f87171; }
      .cf-turnstile { margin-top: .25rem; }
      .captcha-hint { font-size: .75rem; color: rgba(255,255,255,.4); text-align: center; margin-top: .5rem; display: none; }
      .captcha-hint.visible { display: block; }
    </style>
  </head>
  <body>
    <div class="card">
      <a href={withLangPrefix(lang, "/")} class="brand">
        <img src="/logo/logo-128.webp" alt="Sally's Bar" width="64" height="64" loading="eager" />
        <span>Sally's Bar</span>
      </a>

      <div class="box">
        <h1>{t.title}</h1>

        {errorMsg && <div class="alert">{errorMsg}{errorDetail && ` (${errorDetail})`}</div>}

        <form class="form" method="POST" action="/api/auth/login">
          <input type="hidden" name="next" value={nextUrl} />
          <div class="field">
            <label for="email">{t.email}</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
          </div>
          <div class="field">
            <label for="password">{t.password}</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••" />
          </div>
          <input type="hidden" name="captchaToken" id="captchaTokenInput" />
          {turnstileSitekey && (
            <div
              id="turnstileWidget"
              class="cf-turnstile"
              data-sitekey={turnstileSitekey}
              data-theme="dark"
              data-callback="onTurnstileSuccess"
              data-expired-callback="onTurnstileExpired"
            ></div>
          )}
          <p id="captchaHint" class="captcha-hint" style="display:none">{isEl ? "Ολοκλήρωσε την επαλήθευση ασφαλείας παραπάνω." : "Complete the security check above to sign in."}</p>
          <button type="submit" id="loginSubmitBtn" class="btn-primary" disabled={turnstileSitekey ? true : undefined}>{t.submit}</button>
          <a href={withLangPrefix(lang, "/forgot-password")} class="forgot-link">
            {isEl ? "Ξέχασες τον κωδικό;" : "Forgot password?"}
          </a>
        </form>

        <div class="divider">
          <div></div><span>{t.orDivider}</span><div></div>
        </div>

        <button id="googleBtn" class="btn-google" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          {t.google}
        </button>

        <p class="footer-link">
          {t.noAccount}{" "}
          <a href={registerHref}>{t.register}</a>
        </p>
      </div>
    </div>

    <script>
      import { createBrowserClient } from "@supabase/ssr";

      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      const loginSubmitBtn = document.getElementById("loginSubmitBtn") as HTMLButtonElement;
      const captchaInput   = document.getElementById("captchaTokenInput") as HTMLInputElement;
      const captchaHint    = document.getElementById("captchaHint") as HTMLElement;
      const form           = document.querySelector("form.form") as HTMLFormElement;
      const widgetEl       = document.getElementById("turnstileWidget");
      const isLocalhost    = ["localhost", "127.0.0.1"].includes(window.location.hostname);

      if (widgetEl) {
        captchaHint.style.display = "block";

        (window as any).onTurnstileSuccess = (token: string) => {
          captchaInput.value = token;
          loginSubmitBtn.disabled = false;
          captchaHint.style.display = "none";
        };
        (window as any).onTurnstileExpired = () => {
          captchaInput.value = "";
          loginSubmitBtn.disabled = isLocalhost ? false : true;
          captchaHint.style.display = isLocalhost ? "none" : "block";
        };

        // On localhost Turnstile won't complete — enable after 1.5s
        if (isLocalhost) {
          setTimeout(() => {
            loginSubmitBtn.disabled = false;
            captchaHint.style.display = "none";
          }, 1500);
        }
      } else {
        loginSubmitBtn.disabled = false;
      }

      // Show loading state when form submits
      form?.addEventListener("submit", () => {
        loginSubmitBtn.disabled = true;
        loginSubmitBtn.textContent = "Signing in…";
      });

      // Scroll error into view if present
      const alertEl = document.querySelector(".alert");
      if (alertEl) alertEl.scrollIntoView({ behavior: "smooth", block: "nearest" });

      document.getElementById("googleBtn")?.addEventListener("click", async () => {
        const next = new URLSearchParams(window.location.search).get("next") ?? "/dashboard";
        await supabase.auth.signInWithOAuth({
          provider: "google",
          options: {
            redirectTo: `${window.location.origin}/auth/callback?next=${encodeURIComponent(next)}`,
          },
        });
      });
    </script>
  </body>
</html>
