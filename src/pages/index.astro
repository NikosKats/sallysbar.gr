        <div class="group relative rounded-3xl border border-white/10 bg-white/[0.03] p-7 overflow-hidden hover:border-fuchsia-300/30 hover:-translate-y-1 transition duration-300">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-gradient-to-br from-fuchsia-400/5 to-transparent transition"></div>
          <div class="relative">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-fuchsia-300/15 text-2xl mb-4">🌊</div>
