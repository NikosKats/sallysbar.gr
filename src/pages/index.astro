              <span class="shrink-0 grid place-items-center h-7 w-7 rounded-full border border-white/15 text-white/60 group-open:rotate-180 group-open:bg-amber-300/10 group-open:border-amber-300/30 group-open:text-amber-200 transition-transform transition">▾</span>
            </summary>
            <p class="px-6 pb-5 text-sm text-white/70 leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- LOCAL SEO TEXT BLOCK -->
    <section class="mx-auto max-w-6xl px-6 pb-20">
      <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] p-8 md:p-12">
        <div class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-amber-400/10 blur-3xl"></div>
        <div class="relative">
          <div class="text-xs uppercase tracking-[0.28em] text-amber-200/80 mb-3">{sectLabels.story}</div>
          <h2 class="font-heading text-3xl md:text-4xl font-bold mb-6">{sectLabels.storyTitle}</h2>
          <div class="text-white/70 leading-relaxed space-y-4 max-w-3xl">
            <p>{sectLabels.storyP1}</p>
            <p>{sectLabels.storyP2}</p>
            <p>{sectLabels.storyP3}</p>
          </div>
        </div>
