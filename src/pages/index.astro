---
import "../styles/global.css";
import Header from "../components/Header.astro";
import SeasonBanner from "../components/SeasonBanner.astro";
import StickyCta from "../components/StickyCta.astro";
import Footer from "../components/Footer.astro";

import { site, getSiteCopy } from "../data/site";
import en from "../i18n/en";
import el from "../i18n/el";

const lang = Astro.locals.lang ?? "en";
const isEl = lang === "el";
const t = isEl ? el : en;
const copy = getSiteCopy(lang);

const title = isEl
  ? "Sally's Bar Skala Κεφαλονιά | Κοκτέιλ & Νυχτερινή Ζωή"
  : "Sally's Bar Skala Kefalonia | Cocktails & Nightlife";
const desc = isEl
  ? "Το Sally's Bar είναι το κορυφαίο μπαρ κοκτέιλ στη Σκάλα Κεφαλονιάς. Premium κοκτέιλ από €5, φιλικό προσωπικό, ανοιχτό καθημερινά 6ΜΜ–2ΠΜ το καλοκαίρι. Χωρίς κράτηση."
  : "Sally's Bar is the best cocktail bar and nightlife spot in Skala, Kefalonia. Premium cocktails from €5, friendly staff, open daily 6PM–2AM in summer. Walk in — no reservation needed.";
const keywords = isEl
  ? "σκάλα κεφαλονιά νυχτερινή ζωή, μπαρ σκάλα κεφαλονιά, κοκτέιλ μπαρ κεφαλονιά, κεφαλονιά μπαρ, skala kefalonia nightlife, bar skala kefalonia, cocktail bar kefalonia, sally's bar kefalonia"
  : "skala kefalonia nightlife, bar skala kefalonia, cocktail bar kefalonia, kefalonia bars, kefalonia nightlife, skala bar, best bar kefalonia, sally's bar kefalonia, things to do skala kefalonia night, cocktails kefalonia";
const canonical = isEl ? "https://sallysbar.gr/el/" : "https://sallysbar.gr/";
const ogLocale = isEl ? "el_GR" : "en_GB";
const schemaAlt = isEl
  ? ["Sally's Bar Σκάλα", "Sally's Bar Κεφαλονιά", "Sallys Bar Skala Kefalonia"]
  : ["Sally's Bar Skala", "Sally's Bar Kefalonia", "Sallys Bar Skala Kefalonia"];
const schemaDesc = isEl
  ? "Το κορυφαίο μπαρ κοκτέιλ στη Σκάλα Κεφαλονιάς. Premium κοκτέιλ από €5, φιλικό κλίμα, ανοιχτό καθημερινά το καλοκαίρι."
  : "The best cocktail bar and nightlife venue in Skala, Kefalonia. Premium cocktails from €5, friendly atmosphere, open daily in summer.";

const faqs = isEl ? [
  { q: "Ποιο είναι το καλύτερο μπαρ στη Σκάλα Κεφαλονιάς;", a: "Το Sally's Bar θεωρείται το κορυφαίο μπαρ κοκτέιλ στη Σκάλα Κεφαλονιάς. Με βαθμολογία 4.4/5 στο Google και 174+ κριτικές, προσφέρει premium κοκτέιλ από €5, χαλαρή ατμόσφαιρα νωρίς το βράδυ και ζωντανή νυχτερινή ζωή αργότερα." },
  { q: "Τι ώρα ανοίγει το Sally's Bar;", a: "Ανοίγουμε καθημερινά στις 6ΜΜ και παραμένουμε ανοιχτά μέχρι τις 2ΠΜ κατά την καλοκαιρινή περίοδο. Νωρίς το βράδυ είναι ιδανικά για ένα κοκτέιλ μετά το δείπνο — η ενέργεια ανεβαίνει όσο προχωράει η νύχτα. Χωρίς κράτηση." },
  { q: "Πόσο κοστίζουν τα κοκτέιλ στη Σκάλα Κεφαλονιάς;", a: "Το Sally's Bar κρατάει τις τιμές δίκαιες: τα κοκτέιλ κυμαίνονται από €5 έως €10. Διαθέσιμα και μπύρα, κρασί και ποτά." },
  { q: "Πού βρίσκεται το Sally's Bar στη Σκάλα;", a: "Βρισκόμαστε στο κέντρο του χωριού της Σκάλας, Κεφαλονιά — λίγα βήματα από την παραλία και τα περισσότερα ξενοδοχεία και καταλύματα." },
  { q: "Χρειάζεται κράτηση στο Sally's Bar;", a: "Όχι! Το Sally's Bar δέχεται επισκέπτες χωρίς κράτηση. Απλώς ελάτε, βρείτε θέση και εμείς αναλαμβάνουμε τα υπόλοιπα. Παρέες πάντα ευπρόσδεκτες." },
] : [
  { q: "What is the best bar in Skala, Kefalonia?", a: "Sally's Bar is the top-rated cocktail bar and nightlife venue in Skala. With a 4.4 ⭐ Google rating and 174+ reviews, it's consistently recommended by travellers for premium drinks, a welcoming atmosphere, and great music." },
  { q: "What time does Sally's Bar open?", a: "We open daily at 6PM and stay open until 2AM throughout the summer season. Early evening is perfect for a sophisticated cocktail after dinner — the energy builds as the night goes on. No reservation needed." },
  { q: "How much are cocktails in Skala, Kefalonia?", a: "Sally's Bar keeps prices fair: cocktails range from €5 to €10. Beer, wine, and spirits are also available. You won't find better value for quality drinks in Kefalonia nightlife." },
  { q: "Where is Sally's Bar in Skala?", a: "We're in the heart of Skala village, Kefalonia — a short walk from the beach and most local hotels and apartments. Follow the signs or search 'Sally's Bar Skala Kefalonia' on Google Maps." },
  { q: "Do I need to book a table at Sally's Bar?", a: "No booking required! Sally's Bar is walk-in friendly. Just turn up, grab a seat, and let us take care of the rest. Groups are always welcome." },
];

const sectLabels = isEl ? {
  gallery: "Γκαλερί", why: "Γιατί Sally's", whyTitle: "Τρεις λόγοι για να μείνετε όλη τη νύχτα",
  findUs: "Βρείτε Μας", faq: "Συχνές Ερωτήσεις",
  faqTitle: "Νυχτερινή Ζωή στη Σκάλα Κεφαλονιάς — Οι Απαντήσεις",
  faqSub: "Όλα όσα θέλετε να ξέρετε για την επίσκεψή σας στο Sally's Bar στη Σκάλα.",
  story: "Η Ιστορία Μας", storyTitle: "Η Καρδιά της Νυχτερινής Ζωής στη Σκάλα Κεφαλονιάς",
  storyP1: "Αν ψάχνετε την καλύτερη νυχτερινή ζωή στη Σκάλα Κεφαλονιάς, το Sally's Bar είναι εδώ και χρόνια το αγαπημένο σημείο συνάντησης του χωριού. Λίγα βήματα από τον κεντρικό δρόμο, υποδεχόμαστε ντόπιους, expats και τουρίστες — ιδιαίτερα επισκέπτες από το UK και την Ιρλανδία που επιλέγουν τη Σκάλα για τις διακοπές τους.",
  storyP2: "Σερβίρουμε πάνω από 30 κοκτέιλ φτιαγμένα με premium ποτά, μαζί με πλήρη επιλογή μπύρας, κρασιού και αναψυκτικών. Είτε θέλετε ένα ήσυχο ποτό μετά το δείπνο είτε θέλετε να μείνετε μέχρι τις 2ΠΜ, το Sally's Bar προσαρμόζεται στη βραδιά σας. Ελάτε νωρίς για τη lounge διάθεση, μείνετε αργά για την ενέργεια.",
  storyP3: "Η Κεφαλονιά είναι από τα πιο όμορφα νησιά της Ελλάδας και η Σκάλα το πιο κοινωνικό χωριό της. Όταν πέφτει ο ήλιος, τα μπαρ γεμίζουν — και το Sally's είναι εκεί που καταλήγουν όλοι. Με κορυφαίες κριτικές σε TripAdvisor και Google, θα θέλαμε να σας δούμε αυτή τη σεζόν.",
  scroll: "Scroll",
} : {
  gallery: "Gallery", why: "Why Sally's", whyTitle: "Three reasons you'll stay all night",
  findUs: "Find Us", faq: "FAQ",
  faqTitle: "Skala Kefalonia Nightlife — Your Questions Answered",
  faqSub: "Everything you need to know about visiting Sally's Bar in Skala, Kefalonia.",
  story: "Our Story", storyTitle: "The Heart of Kefalonia Nightlife in Skala",
  storyP1: "If you're looking for the best nightlife in Skala, Kefalonia, Sally's Bar has been the village's favourite meeting point for years. Located steps from the main strip, we welcome locals, expats, and tourists — especially visitors from the UK and Ireland who make Skala their summer home.",
  storyP2: "We serve over 30 cocktails crafted with premium spirits, alongside a full selection of beers, wines, and soft drinks. Whether you're after a quiet drink after dinner or you want to stay out until 2AM, Sally's Bar adapts to your night. Come early for the lounge vibe, stay late for the energy.",
  storyP3: "Kefalonia is one of Greece's most beautiful islands, and Skala is its most social village. When the sun goes down, the bars fill up — and Sally's is where everyone ends up. Rated one of the top bars in Kefalonia on TripAdvisor and Google, we'd love to see you this season.",
  scroll: "Scroll",
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="preload" as="image" href="/hero/1-hero.jpg" />

    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href="https://sallysbar.gr/" />
    <link rel="alternate" hreflang="el" href="https://sallysbar.gr/el/" />
    <link rel="alternate" hreflang="x-default" href="https://sallysbar.gr/" />

    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://sallysbar.gr/photos/1.sallys-bar-cocktails-skala.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content="https://sallysbar.gr/photos/1.sallys-bar-cocktails-skala.jpg" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BarOrPub",
        name: "Sally's Bar",
        alternateName: schemaAlt,
        description: schemaDesc,
        url: "https://sallysbar.gr",
        telephone: site.phoneE164,
        priceRange: "€5–€10",
        servesCuisine: ["Cocktails", "Beer", "Wine", "Spirits"],
        image: [
          "https://sallysbar.gr/photos/1.sallys-bar-cocktails-skala.jpg",
          "https://sallysbar.gr/photos/3.sallys-bar-lounge.jpg",
          "https://sallysbar.gr/photos/5.premium-drinks.jpg",
        ],
        address: {
          "@type": "PostalAddress",
          streetAddress: "Skala Beach Road",
          addressLocality: "Skala",
          addressRegion: "Kefalonia",
          postalCode: "28086",
          addressCountry: "GR",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: 38.0748829,
          longitude: 20.7969726,
        },
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
            opens: "18:00",
            closes: "02:00",
          },
        ],
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: site.ratings.google.rating,
          reviewCount: site.ratings.google.count,
          bestRating: 5,
          worstRating: 1,
        },
        sameAs: [
          site.socials.instagram,
          site.socials.facebook,
          site.socials.tripadvisor,
        ],
        hasMap: site.mapsShareUrl,
        currenciesAccepted: "EUR",
        paymentAccepted: "Cash, Credit Card",
        amenityFeature: [
          { "@type": "LocationFeatureSpecification", name: "Outdoor Seating", value: true },
          { "@type": "LocationFeatureSpecification", name: "Bar Service", value: true },
        ],
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      })}
    />
  </head>

  <body class="min-h-screen bg-[#0a0a0f] text-white font-body antialiased overflow-x-hidden">
    <!-- Ambient backdrop -->
    <div class="pointer-events-none fixed inset-0 -z-10 opacity-60">
      <div class="absolute -top-40 left-1/3 h-[520px] w-[520px] rounded-full bg-amber-400/10 blur-[140px]"></div>
      <div class="absolute top-[40%] -right-40 h-[480px] w-[480px] rounded-full bg-sky-500/10 blur-[140px]"></div>
      <div class="absolute bottom-0 left-0 h-[420px] w-[420px] rounded-full bg-fuchsia-500/10 blur-[140px]"></div>
    </div>

    <Header />

    <!-- HERO -->
    <section class="relative overflow-hidden min-h-[92vh] flex items-center">
      <img
        id="hero-image"
        src="/hero/1-hero.jpg"
        alt={t.home.heroAlt}
        class="absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 opacity-100 scale-105"
        loading="eager"
      />

      <!-- Layered overlays for depth -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/55 to-[#0a0a0f]"></div>
      <div class="absolute inset-0 bg-gradient-to-tr from-amber-900/20 via-transparent to-sky-900/20 mix-blend-overlay"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(0,0,0,0.6)_100%)]"></div>

      <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-28 w-full">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-300/30 bg-amber-300/5 px-3 py-1 text-[11px] uppercase tracking-[0.28em] text-amber-200/90 backdrop-blur">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-300 animate-pulse"></span>
          {t.home.locationLine}
        </div>

        <!-- Title -->
        <div class="mt-6 flex items-center gap-4 md:gap-5">
          <img
            src="/logo/1-logo.png"
            alt="Sally's Bar logo"
            class="h-14 w-14 md:h-20 md:w-20 drop-shadow-[0_0_30px_rgba(251,191,36,0.3)]"
            loading="eager"
          />
          <h1 class="font-heading text-6xl md:text-8xl font-bold leading-[0.95] tracking-tight bg-gradient-to-br from-white via-amber-50 to-amber-200/80 bg-clip-text text-transparent">
            {site.name}
          </h1>
        </div>

        <!-- Tagline -->
        <p class="mt-8 max-w-2xl text-lg md:text-xl text-white/75 leading-relaxed">
          <span class="block font-heading text-2xl md:text-3xl text-white font-semibold italic mb-2">{copy.tagline}</span>
          {t.home.heroSubline}
        </p>

        <!-- Season + price pill -->
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <SeasonBanner
            isOpenNow={site.season.isOpenNow}
            opensFromText={copy.opensFromText}
          />
          <div class="rounded-full border border-amber-300/30 bg-amber-300/5 px-4 py-1.5 text-sm text-amber-200">
            {t.home.pricePill}
          </div>
        </div>

        <!-- Primary CTAs -->
        <div class="mt-8 flex flex-wrap gap-3 items-center">
          <a
            href={site.mapsShareUrl}
            target="_blank"
            class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-amber-200 to-amber-400 px-7 py-3.5 font-semibold text-black shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 hover:scale-[1.02] active:scale-[0.98] transition"
          >
            <span class="relative z-10 flex items-center gap-2">📍 {t.home.ctaDirections}</span>
            <span class="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent opacity-0 group-hover:opacity-100 transition"></span>
          </a>
          <a
            href={`tel:${site.phoneE164}`}
            class="rounded-2xl border border-white/25 bg-white/5 backdrop-blur px-7 py-3.5 font-semibold hover:bg-white/10 hover:border-white/40 transition"
          >
            📞 {t.home.ctaCall}
          </a>
        </div>

        <!-- Stat badges (tight) -->
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-white/75">
          <a href={site.reviews.googleUrl} target="_blank" class="flex items-center gap-1.5 hover:text-amber-200 transition">
            <span class="text-amber-300">★</span>
            <span class="font-semibold text-white">{site.ratings.google.rating}</span>
            <span>{t.home.googleRatingLabel}</span>
          </a>
          <span class="h-4 w-px bg-white/15"></span>
          <span>{copy.hoursText}</span>
          <span class="h-4 w-px bg-white/15 hidden md:inline"></span>
          <span class="hidden md:inline">{site.addressFull}</span>
        </div>

        <!-- Socials -->
        <div class="mt-6 flex flex-wrap gap-2 text-sm">
          <a href={site.socials.instagram} target="_blank" class="rounded-full border border-white/15 bg-white/5 backdrop-blur px-4 py-1.5 text-white/80 hover:text-white hover:border-white/30 hover:bg-white/10 transition">{t.home.linkInstagram}</a>
          <a href={site.socials.facebook} target="_blank" class="rounded-full border border-white/15 bg-white/5 backdrop-blur px-4 py-1.5 text-white/80 hover:text-white hover:border-white/30 hover:bg-white/10 transition">{t.home.linkFacebook}</a>
          <a href={site.socials.tripadvisor} target="_blank" class="rounded-full border border-white/15 bg-white/5 backdrop-blur px-4 py-1.5 text-white/80 hover:text-white hover:border-white/30 hover:bg-white/10 transition">{t.home.linkTripadvisor}</a>
          <a href={site.reviews.googleUrl} target="_blank" class="rounded-full border border-white/15 bg-white/5 backdrop-blur px-4 py-1.5 text-white/80 hover:text-white hover:border-white/30 hover:bg-white/10 transition">{t.home.linkGoogleReviews}</a>
        </div>

        <!-- Scroll cue -->
        <div class="mt-14 hidden md:flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-white/40">
          <span class="h-px w-10 bg-white/20"></span>
          <span>{sectLabels.scroll}</span>
        </div>
      </div>
    </section>

    <!-- EARLY / LATE MOOD CARDS -->
    <section class="relative mx-auto max-w-6xl px-6 -mt-10 md:-mt-16 z-10">
      <div class="grid gap-4 md:grid-cols-2">
        <div class="group rounded-3xl border border-amber-300/20 bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent p-6 backdrop-blur-xl hover:border-amber-300/40 transition">
          <div class="flex items-center gap-3">
            <div class="text-2xl">🌇</div>
            <h3 class="font-heading text-xl font-semibold text-amber-100">{t.home.earlyTitle}</h3>
          </div>
          <p class="mt-3 text-white/75 leading-relaxed">{t.home.earlyText}</p>
        </div>
        <div class="group rounded-3xl border border-fuchsia-300/20 bg-gradient-to-br from-fuchsia-500/10 via-fuchsia-500/5 to-transparent p-6 backdrop-blur-xl hover:border-fuchsia-300/40 transition">
          <div class="flex items-center gap-3">
            <div class="text-2xl">🌃</div>
            <h3 class="font-heading text-xl font-semibold text-fuchsia-100">{t.home.lateTitle}</h3>
          </div>
          <p class="mt-3 text-white/75 leading-relaxed">{t.home.lateText}</p>
        </div>
      </div>
      <p class="mt-5 text-center text-sm text-white/50 italic">{t.home.ukLine}</p>
    </section>

    <!-- PHOTO GALLERY -->
    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="mb-10">
        <div class="text-xs uppercase tracking-[0.28em] text-amber-200/80 mb-3">{sectLabels.gallery}</div>
        <h2 class="font-heading text-4xl md:text-5xl font-bold">{t.home.photoStripTitle}</h2>
      </div>

      <div class="grid gap-3 md:gap-4 md:grid-cols-4 md:grid-rows-2">
        <div class="gallery-img group relative col-span-2 row-span-2 cursor-zoom-in overflow-hidden rounded-3xl">
          <img src="/photos/5.premium-drinks.jpg" alt={t.home.photoAltPremium} class="h-full w-full object-cover transition duration-700 group-hover:scale-110" loading="eager" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition"></div>
        </div>
        <div class="gallery-img group relative cursor-zoom-in overflow-hidden rounded-3xl">
          <img src="/photos/1.sallys-bar-cocktails-skala.jpg" alt={t.home.photoAltSignature} class="h-full w-full object-cover transition duration-700 group-hover:scale-110" loading="eager" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition"></div>
        </div>
        <div class="gallery-img group relative cursor-zoom-in overflow-hidden rounded-3xl">
          <img src="/photos/3.sallys-bar-lounge.jpg" alt={t.home.photoAltLounge} class="h-full w-full object-cover transition duration-700 group-hover:scale-110" loading="eager" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition"></div>
        </div>
        <div class="gallery-img group relative cursor-zoom-in overflow-hidden rounded-3xl">
          <img src="/photos/5.signature-cocktails.jpg" alt={t.home.photoAltSignature2} class="h-full w-full object-cover transition duration-700 group-hover:scale-110" loading="eager" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition"></div>
        </div>
        <div class="gallery-img group relative cursor-zoom-in overflow-hidden rounded-3xl">
          <img src="/photos/5.bar-lighting.jpg" alt={t.home.photoAltLighting} class="h-full w-full object-cover transition duration-700 group-hover:scale-110" loading="eager" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition"></div>
        </div>
      </div>
    </section>

    <!-- WHY -->
    <section class="mx-auto max-w-6xl px-6 pb-20">
      <div class="mb-10">
        <div class="text-xs uppercase tracking-[0.28em] text-amber-200/80 mb-3">{sectLabels.why}</div>
        <h2 class="font-heading text-4xl md:text-5xl font-bold">{sectLabels.whyTitle}</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        <div class="group relative rounded-3xl border border-white/10 bg-white/[0.03] p-7 overflow-hidden hover:border-amber-300/30 hover:-translate-y-1 transition duration-300">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-gradient-to-br from-amber-400/5 to-transparent transition"></div>
          <div class="relative">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-300/15 text-2xl mb-4">🍸</div>
            <h3 class="font-heading text-2xl font-semibold">{t.home.why1Title}</h3>
            <p class="mt-3 text-white/70 leading-relaxed">{t.home.why1Text}</p>
          </div>
        </div>
        <div class="group relative rounded-3xl border border-white/10 bg-white/[0.03] p-7 overflow-hidden hover:border-sky-300/30 hover:-translate-y-1 transition duration-300">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-gradient-to-br from-sky-400/5 to-transparent transition"></div>
          <div class="relative">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-300/15 text-2xl mb-4">🎶</div>
            <h3 class="font-heading text-2xl font-semibold">{t.home.why2Title}</h3>
